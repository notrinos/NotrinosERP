# Composer-managed libraries (composer.json, composer.lock). PHP loads them from the filesystem through vendor/autoload.php;
# nothing here is a web asset, and the libraries ship command-line tools that must never run over HTTP.
# Verified by tests/php/test_release_web_deny_contract.php and tests/run_release_web_deny_probe.py.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from All
	Satisfy All
</IfModule>
