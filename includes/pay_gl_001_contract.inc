function pay_gl_001_validate_journal(array $j,&$e){$e=null;$r=array('company_id','legal_entity_id','payroll_group_id','payroll_period_id','result_set_sha256','approval_sha256','journal_date','currency_code','mapping_snapshot_sha256','line_set_sha256','allocation_set_sha256','debit_minor','credit_minor','prepared_by','prepared_at','journal_sha256');foreach($r as $k)if(!array_key_exists($k,$j))return pay_gl_001_fail($e,'journal_field_missing');if(pay_gl_001_uint($j['company_id'])===false||pay_gl_001_posint($j['legal_entity_id'])===false||pay_gl_001_posint($j['payroll_group_id'])===false||pay_gl_001_posint($j['payroll_period_id'])===false||pay_gl_001_posint($j['prepared_by'])===false)return pay_gl_001_fail($e,'journal_scope_invalid');foreach(array('result_set_sha256','approval_sha256','mapping_snapshot_sha256','line_set_sha256','allocation_set_sha256') as $k)if(!pay_gl_001_sha($j[$k]))return pay_gl_001_fail($e,'journal_hash_invalid');$d=pay_gl_001_posint($j['debit_minor']);$c=pay_gl_001_posint($j['credit_minor']);if($d===false||$c===false||$d!==$c)return pay_gl_001_fail($e,'journal_unbalanced');if(pay_gl_001_currency($j['currency_code'])===false||pay_gl_001_date($j['journal_date'])===false||pay_gl_001_time($j['prepared_at'])===false)return pay_gl_001_fail($e,'journal_format_invalid');$sha=pay_gl_001_journal_sha256($j);if(!pay_gl_001_sha($j['journal_sha256'])||!hash_equals($sha,$j['journal_sha256']))return pay_gl_001_fail($e,'journal_hash_mismatch');return true;}
