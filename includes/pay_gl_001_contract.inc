function pay_gl_001_canonicalize($v){if(!is_array($v))return $v;$keys=array_keys($v);$assoc=$keys!==range(0,count($v)-1);if($assoc)ksort($v,SORT_STRING);foreach($v as $k=>$x)$v[$k]=pay_gl_001_canonicalize($x);return $v;}
function pay_gl_001_hash($v){$j=json_encode(pay_gl_001_canonicalize($v),JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_PRESERVE_ZERO_FRACTION);return is_string($j)?hash('sha256',$j):false;}
function pay_gl_001_sha($v){return is_string($v)&&preg_match('/^[a-f0-9]{64}$/D',$v)===1;}
function pay_gl_001_token($v,$max=96){$v=trim((string)$v);return $v!==''&&strlen($v)<=$max&&preg_match('/^[A-Za-z0-9][A-Za-z0-9_.:\/-]*$/D',$v)===1;}
function pay_gl_001_uint($v){if(is_int($v))return $v>=0?$v:false;if(!is_string($v)&&!is_numeric($v))return false;$s=(string)$v;if(!preg_match('/^(?:0|[1-9][0-9]*)$/D',$s))return false;$n=(int)$s;return $n>=0&&((string)$n===$s||is_int($v))?$n:false;}
function pay_gl_001_posint($v){$n=pay_gl_001_uint($v);return $n!==false&&$n>0?$n:false;}
function pay_gl_001_currency($v){return is_string($v)&&preg_match('/^[A-Z]{3}$/D',$v)===1?$v:false;}
function pay_gl_001_date($v){return is_string($v)&&preg_match('/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/D',$v)===1?$v:false;}
function pay_gl_001_time($v){return is_string($v)&&preg_match('/^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/D',$v)===1?$v:false;}
