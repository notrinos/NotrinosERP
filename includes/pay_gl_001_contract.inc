/* Exact fixed-point split: weights must total 1,000,000 ppm; residual goes deterministically to the largest remainder then lowest index. */
function pay_gl_001_split_minor($amount_minor,array $weights,&$e=null){$e=null;$amount=pay_gl_001_posint($amount_minor);if($amount===false||empty($weights))return pay_gl_001_fail($e,'split_invalid');$sum=0;foreach($weights as $w){$n=pay_gl_001_posint($w);if($n===false||$n>1000000)return pay_gl_001_fail($e,'split_weight_invalid');$sum+=$n;}if($sum!==1000000)return pay_gl_001_fail($e,'split_weight_total_invalid');$out=array();$rema=array();$used=0;foreach(array_values($weights) as $i=>$w){$prod=$amount*(int)$w;$q=intdiv($prod,1000000);$out[$i]=$q;$rema[$i]=$prod%1000000;$used+=$q;}$left=$amount-$used;while($left>0){$best=0;foreach($rema as $i=>$r)if($r>$rema[$best]||($r===$rema[$best]&&$i<$best))$best=$i;$out[$best]++;$rema[$best]=-1;$left--;}return $out;}
function pay_gl_001_set_sha256(array $rows,$hash_key,$order_key){$items=array();foreach($rows as $r){if(!is_array($r)||!isset($r[$hash_key],$r[$order_key])||!pay_gl_001_sha($r[$hash_key]))return false;$items[]=array($order_key=>(int)$r[$order_key],$hash_key=>$r[$hash_key]);}usort($items,function($a,$b)use($order_key){return $a[$order_key]===$b[$order_key]?0:($a[$order_key]<$b[$order_key]?-1:1);});return pay_gl_001_hash($items);}
