function pay_pmt_001_reconciliation_sha256(array $x){$keys=array('payment_intent_sha256','batch_sha256','artifact_sha256','transmission_evidence_sha256','settlement_evidence_sha256','pay_gl_journal_sha256','currency_code','approved_minor','intent_minor','batch_minor','artifact_minor','settled_minor','status');$p=array();foreach($keys as $k){if(!array_key_exists($k,$x))return false;$p[$k]=$x[$k];}return pay_pmt_001_hash($p);}
