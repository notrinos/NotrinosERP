<?php
/** Attributable release of unconsumed demand after independent Transfer cancellation. */
require_once __DIR__.'/warehouse_material_transfer_link_db.inc';
require_once __DIR__.'/warehouse_transfer_terminal_db.inc';

/** Fingerprint complete immutable review rows using the native canonical representation. */
function material_transfer_release_history_hash($history)
{
    return material_core_source_fingerprint(array('header'=>array(),
        'lines'=>array_merge($history['drafts'], $history['actions'])));
}

/** Decode the exact versioned release envelope without granting source authority. */
function material_transfer_release_receipt($action)
{
    if (!is_array($action) || !isset($action['action_type'], $action['draft_data_snapshot'])
        || $action['action_type'] !== 'source_release') return false;
    $approval = get_approval_workflow_service();
    $receipt = $approval->decodeStoredDraftData($action['draft_data_snapshot']);
    $keys = array('schema','request_id','transfer_id','draft_id','material_company_sha256',
        'transfer_company_sha256','ordered_transition','ordered_source_sha256','source_sha256',
        'history_sha256','transfer_source_sha256','transfer_history_sha256','action_sha256');
    if (!is_array($receipt) || !isset($receipt['schema'])) return false;
    if ($receipt['schema'] === 'material-transfer-release-v2') {
        // New v2 custody is generated by native integer writers. Do not let a
        // JSON string, fractional ID, or malformed digest cross the read boundary.
        // Keep the historical v1 decoder byte-compatible.
        foreach (array('request_id','transfer_id','draft_id') as $id_key)
            if (!isset($receipt[$id_key]) || !is_int($receipt[$id_key])
                || $receipt[$id_key] <= 0) return false;
        foreach (array('material_company_sha256','transfer_company_sha256',
            'ordered_source_sha256','source_sha256','history_sha256',
            'transfer_source_sha256','transfer_history_sha256','action_sha256') as $digest_key)
            if (!isset($receipt[$digest_key]) || !is_string($receipt[$digest_key])
                || !preg_match('/^[a-f0-9]{64}$/D', $receipt[$digest_key])) return false;
        // The ordered snapshot is consumed by both current and historical
        // readers. Validate its complete native shape before either reader can
        // reconstruct a past state; do not coerce IDs or guess a clock.
        if (!isset($receipt['ordered_transition']) || !is_array($receipt['ordered_transition'])
            || array_keys($receipt['ordered_transition']) !== array('status','linked_doc_type','linked_doc_no','updated_at')) return false;
        $ordered = $receipt['ordered_transition'];
        if ($ordered['status'] !== 'ordered'
            || dimension_writer_reference_id($ordered['linked_doc_type']) !== ST_LOCTRANSFER
            || dimension_writer_reference_id($ordered['linked_doc_no']) !== $receipt['transfer_id']
            || !material_transfer_v2_timestamp($ordered['updated_at'])) return false;
        $keys[] = 'released_transition';
        if (!isset($receipt['released_transition']) || !is_array($receipt['released_transition'])
            || array_keys($receipt['released_transition']) !== array('status','linked_doc_type','linked_doc_no','updated_at')) return false;
        $transition = $receipt['released_transition'];
        if ($transition['status'] !== 'approved' || $transition['linked_doc_type'] !== null
            || $transition['linked_doc_no'] !== null
            || !material_transfer_v2_timestamp($transition['updated_at'])
            || $transition['updated_at'] < $ordered['updated_at']) return false;
    } elseif ($receipt['schema'] !== 'material-transfer-release-v1') return false;
    return array_keys($receipt) === $keys ? $receipt : false;
}

/**
 * Examine ordered persisted Material source-link/release events without granting
 * any replacement, approval, edit, or stock/GL authority. Each receipt is
 * compared to the complete earlier raw action prefix (including unrelated
 * approval events), never to a caller-supplied snapshot or a current pointer.
 *
 * Only version-two pairs can participate in a prospective replacement lineage.
 * Legacy v1 receipts remain readable by their original readers but have no
 * recoverable transition custody for reuse. A final unmatched v2 source link
 * is reported as pending, never misrepresented as a completed release.
 *
 * This is a pure historical witness: callers must still independently lock
 * native sources/children, approvals, cancellations, accounting and policy.
 */
function material_transfer_release_lineage($history, $request_id, $selected_event = null)
{
    $identity = dimension_writer_reference_id($request_id);
    $selected = $selected_event === null ? null : dimension_writer_reference_id($selected_event);
    if (!$identity || ($selected_event !== null && !$selected) || !is_array($history)
        || !isset($history['drafts'], $history['actions']) || !is_array($history['drafts'])
        || !is_array($history['actions'])) return false;
    $prior = array('drafts'=>$history['drafts'], 'actions'=>array());
    $previous_id = 0; $pending = false; $cycles = array(); $seen_transfers = array();
    $selected_cycle = null;
    // Link/release receipts cover distinct immutable cycles. An exact raw event
    // clock and each next approval must not precede the previous release.
    $last_released_at = null; $pending_approved_at = null; $pending_link_at = null;
    foreach ($history['actions'] as $action) {
        if (!is_array($action) || !isset($action['id'], $action['action_type'])
            || !($event_id = dimension_writer_reference_id($action['id']))
            || $event_id <= $previous_id) return false;
        $previous_id = $event_id;
        if ($action['action_type'] === 'source_transfer') {
            $link = material_transfer_link_receipt($action);
            if (!$link || $link['schema'] !== 'material-transfer-link-v2'
                || $pending !== false || $link['request_id'] !== $identity
                || !($to_id = dimension_writer_reference_id($link['transfer_id']))
                || isset($seen_transfers[$to_id])
                || !($draft_id = dimension_writer_reference_id($link['approved_draft_id']))
                || !($maker = dimension_writer_reference_id($link['maker_id']))
                || dimension_writer_reference_id($action['user_id']) !== $maker
                || dimension_writer_reference_id($action['draft_id']) !== $draft_id
                || !isset($link['approved_history_sha256'], $action['action_date'])
                || !material_transfer_v2_timestamp($action['action_date'])
                || $action['action_date'] < $link['approved_updated_at']
                || ($last_released_at !== null && $link['approved_updated_at'] < $last_released_at)
                || $link['approved_history_sha256'] !== material_transfer_release_history_hash($prior)) return false;
            $seen_transfers[$to_id] = true;
            $pending_approved_at = $link['approved_updated_at'];
            $pending_link_at = $action['action_date'];
            $pending = array('link_event_id'=>$event_id, 'transfer_id'=>$to_id,
                'draft_id'=>$draft_id, 'maker_id'=>$maker,
                'material_company_sha256'=>$link['material_company_sha256'],
                'transfer_company_sha256'=>$link['transfer_company_sha256']);
        } elseif ($action['action_type'] === 'source_release') {
            $receipt = material_transfer_release_receipt($action);
            if (!$pending || !$receipt || $receipt['schema'] !== 'material-transfer-release-v2'
                || $receipt['request_id'] !== $identity
                || $receipt['transfer_id'] !== $pending['transfer_id']
                || $receipt['draft_id'] !== $pending['draft_id']
                || !isset($action['draft_id'], $action['user_id'], $action['draft_data_snapshot'])
                || (string)$action['draft_id'] !== (string)$pending['draft_id']
                || (string)$action['user_id'] !== (string)$pending['maker_id']
                || $receipt['material_company_sha256'] !== $pending['material_company_sha256']
                || $receipt['transfer_company_sha256'] !== $pending['transfer_company_sha256']
                || $receipt['history_sha256'] !== material_transfer_release_history_hash($prior)
                || !is_array($receipt['ordered_transition'])
                || array_keys($receipt['ordered_transition']) !== array('status','linked_doc_type','linked_doc_no','updated_at')
                || $receipt['ordered_transition']['status'] !== 'ordered'
                || (string)$receipt['ordered_transition']['linked_doc_type'] !== (string)ST_LOCTRANSFER
                || (string)$receipt['ordered_transition']['linked_doc_no'] !== (string)$pending['transfer_id']
                || !material_transfer_v2_timestamp($receipt['ordered_transition']['updated_at'])
                || $receipt['ordered_transition']['updated_at'] < $pending_approved_at
                || $receipt['released_transition']['updated_at'] < $receipt['ordered_transition']['updated_at']
                // A later raw audit action cannot retroactively assert a release
                // transition before the source-link audit action was recorded.
                || $receipt['released_transition']['updated_at'] < $pending_link_at
                || !isset($action['action_date']) || !material_transfer_v2_timestamp($action['action_date'])
                || $action['action_date'] < $receipt['released_transition']['updated_at']
                || $action['action_date'] < $pending_link_at) return false;
            $unsigned = $action;
            $unsigned['draft_data_snapshot'] = null;
            if ($receipt['action_sha256'] !== material_core_source_fingerprint(array(
                    'header'=>$unsigned, 'lines'=>array()))) return false;
            $cycle = $pending;
            $cycle['release_event_id'] = $event_id;
            $cycle['release_receipt_sha256'] = hash('sha256', $action['draft_data_snapshot']);
            $cycles[] = $cycle;
            // The next approval cannot predate this immutable raw action, even
            // if the status transition was recorded earlier within this command.
            $last_released_at = $action['action_date'];
            $pending_approved_at = null; $pending_link_at = null;
            if ($selected !== null && $selected === $event_id) $selected_cycle = $cycle;
            $pending = false;
        }
        $prior['actions'][] = $action;
    }
    if ($selected !== null && $selected_cycle === null) return false;
    return array('cycles'=>$cycles, 'pending'=>$pending,
        'selected'=>$selected_cycle);
}

/**
 * Independently characterize the draft collection AS OF a signed v2 link.
 *
 * Native approval_drafts rows are mutable, so a later approval can invalidate
 * the earlier whole-history fingerprint. This narrow proof can recover a link's
 * exact unchanged draft prefix only when the current raw rows, SQL submission
 * clock and original link digest all agree. A changed earlier draft, backdated
 * later draft, interleaved action or missing row must DENY; neither timestamp
 * alone nor a caller-provided prefix is an authority. All actions BEFORE the
 * link are included in the exact immutable digest, including other workflows.
 *
 * This is NOT a replacement, current approval, release, GL or stock command.
 * In particular it does not authorize historical release projection or bypass
 * material_transfer_release_lineage()'s current full-history safety boundary.
 * Real disposable SQL, writer-race and browser gates are prerequisites to any
 * caller wiring. Legacy v1 is deliberately excluded from this v2 proof.
 */
function material_transfer_link_asof_draft_prefix($history, $request_id, $link_event_id)
{
    $identity = dimension_writer_reference_id($request_id);
    $event = dimension_writer_reference_id($link_event_id);
    if (!$identity || !$event || !is_array($history) || !isset($history['drafts'], $history['actions'])
        || !is_array($history['drafts']) || !is_array($history['actions'])) return false;
    $drafts = array(); $future = array(); $last_draft = 0;
    // Raw SQL auto-increment IDs are unique and returned in increasing order.
    // A new lower-ID draft cannot safely be retrospectively excluded.
    foreach ($history['drafts'] as $draft) {
        if (!is_array($draft) || !isset($draft['id'], $draft['submitted_date'], $draft['status'])
            || !array_key_exists('completed_date', $draft)
            || !($id = dimension_writer_reference_id($draft['id'])) || $id <= $last_draft
            || !material_transfer_v2_timestamp($draft['submitted_date'])
            || ($draft['completed_date'] !== null && !material_transfer_v2_timestamp($draft['completed_date']))
            || ($draft['completed_date'] !== null && $draft['completed_date'] < $draft['submitted_date'])) return false;
        $last_draft = $id;
    }
    $previous = 0; $previous_clock = null; $before = array(); $link_row = null;
    foreach ($history['actions'] as $action) {
        if (!is_array($action) || !isset($action['id'], $action['draft_id'], $action['action_type'], $action['action_date'])
            || !($action_id = dimension_writer_reference_id($action['id'])) || $action_id <= $previous
            || !dimension_writer_reference_id($action['draft_id'])
            || !material_transfer_v2_timestamp($action['action_date'])
            || ($previous_clock !== null && $action['action_date'] < $previous_clock)) return false;
        $previous = $action_id;
        $previous_clock = $action['action_date'];
        if ($action_id === $event) {
            if ($action['action_type'] !== 'source_transfer') return false;
            $link_row = $action;
            break;
        }
        $before[] = $action;
    }
    if ($link_row === null || !($receipt = material_transfer_link_receipt($link_row))
        || $receipt['schema'] !== 'material-transfer-link-v2' || $receipt['request_id'] !== $identity
        || dimension_writer_reference_id($link_row['user_id']) !== $receipt['maker_id']
        || $receipt['approved_updated_at'] > $link_row['action_date']) return false;
    $included_ids = array(); $excluded = false;
    foreach ($history['drafts'] as $draft) {
        $id = dimension_writer_reference_id($draft['id']);
        if ($draft['submitted_date'] <= $link_row['action_date']) {
            // Later or backdated drafts are not removable by caller choice.
            if ($excluded || ($draft['completed_date'] !== null
                && $draft['completed_date'] > $link_row['action_date'])) return false;
            $drafts[] = $draft;
            $included_ids[$id] = true;
        } else {
            $excluded = true;
            $future[] = $id;
        }
    }
    if (!$drafts || !isset($included_ids[$receipt['approved_draft_id']])) return false;
    $approved = null;
    foreach ($drafts as $draft) {
        if (dimension_writer_reference_id($draft['id']) === $receipt['approved_draft_id']) {
            $approved = $draft;
            break;
        }
    }
    // SQL status 1 = approved. A signed prefix by itself never establishes
    // that a pending/cancelled draft had independent terminal authority.
    if ($approved === null || !isset($approved['submitted_by'], $approved['approved_trans_no'])
        || (string)$approved['status'] !== '1' || $approved['completed_date'] === null
        || dimension_writer_reference_id($approved['submitted_by']) !== $receipt['maker_id']
        || dimension_writer_reference_id($approved['approved_trans_no']) !== $identity
        // Signed Material approval cannot predate the recorded independent
        // completion, even if a later link was created after that completion.
        || $approved['completed_date'] > $receipt['approved_updated_at']) return false;
    $terminal_review = null;
    foreach ($before as $action) {
        if ($action['action_date'] > $link_row['action_date']
            || !isset($included_ids[dimension_writer_reference_id($action['draft_id'])])) return false;
        // Later reject/cancel/edit/delegate/resubmit rows supersede an earlier
        // approve. Link/release custody events are not review decisions.
        // Only the last raw review decision of the selected draft can certify
        // an independently approved terminal state.
        if (dimension_writer_reference_id($action['draft_id']) === $receipt['approved_draft_id']
            && $action['action_type'] !== 'source_transfer'
            && $action['action_type'] !== 'source_release')
            $terminal_review = $action;
    }
    $terminal_approval = $terminal_review !== null && $terminal_review['action_type'] === 'approve'
        ? $terminal_review : null;
    if ($terminal_approval === null || !isset($terminal_approval['user_id'])
        || !($checker = dimension_writer_reference_id($terminal_approval['user_id']))
        || $checker === $receipt['maker_id']
        || $terminal_approval['action_date'] < $approved['submitted_date']
        || $terminal_approval['action_date'] > $approved['completed_date']
        || $receipt['approved_history_sha256'] !== material_transfer_release_history_hash(array(
            'drafts'=>$drafts, 'actions'=>$before))) return false;
    return array('drafts'=>$drafts, 'actions'=>$before, 'link_event_id'=>$event,
        'approved_draft_id'=>$receipt['approved_draft_id'], 'future_draft_ids'=>$future,
        'signed_history_sha256'=>$receipt['approved_history_sha256']);
}

/**
 * Reconstruct a signed v2 release prefix across successive DISTINCT approval
 * drafts. Diagnostic only: a hash-match is not independent SQL approval,
 * authorization, company isolation, stock, finance, or replacement authority.
 *
 * Unlike the legacy full-history reader, a historical link's draft collection
 * is reconstructed using the separately verified, raw signed as-of prefix.
 * Every intervening link and release is verified in order; a pending link,
 * draft added between its link/release, replayed Transfer or amended raw event
 * cannot be silently skipped. Never use this in an application command/read
 * path without independent persisted-DB provenance, locking and acceptance.
 */
function material_transfer_release_asof_draft_prefix($history, $request_id, $release_event_id)
{
    $identity = dimension_writer_reference_id($request_id);
    $selected = dimension_writer_reference_id($release_event_id);
    if (!$identity || !$selected || !is_array($history)
        || !isset($history['drafts'], $history['actions'])
        || !is_array($history['drafts']) || !is_array($history['actions'])) return false;
    $prior = array(); $pending = false; $cycles = array();
    $seen_transfers = array(); $seen_approved_drafts = array();
    $previous_id = 0; $previous_date = null; $released_date = null;
    foreach ($history['actions'] as $action) {
        if (!is_array($action) || !isset($action['id'], $action['draft_id'],
                $action['action_type'], $action['action_date'])
            || !($event_id = dimension_writer_reference_id($action['id']))
            || !dimension_writer_reference_id($action['draft_id'])
            || $event_id <= $previous_id
            || !material_transfer_v2_timestamp($action['action_date'])
            || ($previous_date !== null && $action['action_date'] < $previous_date)) return false;
        $previous_id = $event_id;
        $previous_date = $action['action_date'];
        if ($action['action_type'] === 'source_transfer') {
            if ($pending !== false) return false;
            $link = material_transfer_link_receipt($action);
            $proof = material_transfer_link_asof_draft_prefix($history, $identity, $event_id);
            if (!$link || !$proof || $link['schema'] !== 'material-transfer-link-v2'
                || $proof['actions'] !== $prior
                || $proof['approved_draft_id'] !== $link['approved_draft_id']
                || $link['request_id'] !== $identity
                || isset($seen_transfers[$link['transfer_id']])
                // A replacement cycle needs a newly approved draft, not just
                // a new Transfer number reusing a formerly signed review.
                || isset($seen_approved_drafts[$link['approved_draft_id']])
                || !isset($action['user_id'])
                || dimension_writer_reference_id($action['user_id']) !== $link['maker_id']
                || dimension_writer_reference_id($action['draft_id']) !== $link['approved_draft_id']
                || ($released_date !== null && $link['approved_updated_at'] < $released_date)
                || $action['action_date'] < $link['approved_updated_at']) return false;
            $pending = array('link'=>$link, 'proof'=>$proof, 'link_event_id'=>$event_id,
                'link_date'=>$action['action_date']);
            $seen_transfers[$link['transfer_id']] = true;
            $seen_approved_drafts[$link['approved_draft_id']] = true;
        } elseif ($action['action_type'] === 'source_release') {
            if (!$pending || !($receipt = material_transfer_release_receipt($action))
                || $receipt['schema'] !== 'material-transfer-release-v2') return false;
            $link = $pending['link'];
            // A second review started before the first release cannot be
            // dropped from an older envelope merely because it was approved
            // later. Only the exact link-bound draft collection is admitted.
            foreach ($history['drafts'] as $draft)
                if (!is_array($draft) || !isset($draft['submitted_date'])
                    || !material_transfer_v2_timestamp($draft['submitted_date'])
                    || ($draft['submitted_date'] <= $action['action_date']
                        && !in_array(dimension_writer_reference_id($draft['id']),
                            array_map('dimension_writer_reference_id',
                                array_column($pending['proof']['drafts'], 'id')), true))) return false;
            if ($receipt['request_id'] !== $identity
                || $receipt['transfer_id'] !== $link['transfer_id']
                || $receipt['draft_id'] !== $link['approved_draft_id']
                || !isset($action['user_id'])
                || dimension_writer_reference_id($action['user_id']) !== $link['maker_id']
                || dimension_writer_reference_id($action['draft_id']) !== $link['approved_draft_id']
                || $receipt['material_company_sha256'] !== $link['material_company_sha256']
                || $receipt['transfer_company_sha256'] !== $link['transfer_company_sha256']
                || $receipt['history_sha256'] !== material_transfer_release_history_hash(array(
                    'drafts'=>$pending['proof']['drafts'], 'actions'=>$prior))
                || $receipt['ordered_transition']['updated_at'] < $link['approved_updated_at']
                || $receipt['ordered_transition']['updated_at'] > $receipt['released_transition']['updated_at']
                || $receipt['released_transition']['updated_at'] < $pending['link_date']
                || $action['action_date'] < $receipt['released_transition']['updated_at']) return false;
            $unsigned = $action;
            $unsigned['draft_data_snapshot'] = null;
            if ($receipt['action_sha256'] !== material_core_source_fingerprint(array(
                'header'=>$unsigned, 'lines'=>array()))) return false;
            $cycle = array('link_event_id'=>$pending['link_event_id'],
                'release_event_id'=>$event_id, 'transfer_id'=>$link['transfer_id'],
                'draft_id'=>$link['approved_draft_id'], 'signed_history_sha256'=>$receipt['history_sha256'],
                'release_receipt_sha256'=>hash('sha256', $action['draft_data_snapshot']));
            $cycles[] = $cycle;
            $released_date = $action['action_date'];
            $pending = false;
            if ($event_id === $selected) return array('selected'=>$cycle,
                'cycles'=>$cycles, 'historical_prefix_actions'=>count($prior) + 1);
        }
        $prior[] = $action;
    }
    return false;
}

/**
 * Load one persisted v2 historical release by its exact immutable action identity.
 * Lock Material history/source before Transfer history/source. Restore only the
 * receipt's four transition fields and verify every other source/history byte.
 * Later actions are excluded only from this historical prefix; no current-link,
 * replacement, approval or financial command may use this read as admission.
 * v1 has no retained release timestamp and is deliberately not reconstructed.
 */
function material_historical_transfer_release($request_id, $action_id)
{
    $identity = dimension_writer_reference_id($request_id);
    $event = dimension_writer_reference_id($action_id);
    if (!$identity || !$event || !material_core_context() || !transfer_core_context()
        || empty($GLOBALS['transaction_level'])) return false;
    $history = material_core_history($identity);
    if (!$history) return false;
    $prefix = array('drafts'=>$history['drafts'], 'actions'=>array()); $receipt = false;
    foreach ($history['actions'] as $action) {
        $prefix['actions'][] = $action;
        if ((int)$action['id'] === $event) {
            $receipt = material_transfer_release_receipt($action); break;
        }
    }
    if (!$receipt || $receipt['schema'] !== 'material-transfer-release-v2'
        || !material_transfer_release_lineage($prefix, $identity, $event)
        || $receipt['request_id'] !== $identity
        || !($transfer_id = dimension_writer_reference_id($receipt['transfer_id']))
        || $receipt['material_company_sha256'] !== material_core_context(true)
        || $receipt['transfer_company_sha256'] !== transfer_core_context(true)) return false;
    $headers = material_core_rows('SELECT * FROM '.TB_PREF.'wh_material_requests WHERE request_id='.$identity.' FOR UPDATE');
    $lines = material_core_rows('SELECT * FROM '.TB_PREF.'wh_material_request_lines WHERE request_id='.$identity.' ORDER BY line_id FOR UPDATE');
    $to_history = transfer_core_history($transfer_id);
    $to_headers = transfer_core_rows('SELECT * FROM '.TB_PREF.'wh_transfer_orders WHERE transfer_id='.$transfer_id.' FOR UPDATE');
    $to_lines = transfer_core_rows('SELECT * FROM '.TB_PREF.'wh_transfer_order_lines WHERE transfer_id='.$transfer_id.' ORDER BY line_id FOR UPDATE');
    if (!$headers || count($headers) !== 1 || !$lines || !$to_history
        || !$to_headers || count($to_headers) !== 1 || !$to_lines) return false;
    $source = array('header'=>$headers[0], 'lines'=>$lines);
    foreach ($receipt['released_transition'] as $field=>$value) $source['header'][$field] = $value;
    return material_released_transfer_projection($identity, $source, $prefix,
        array('header'=>$to_headers[0], 'lines'=>$to_lines), $to_history);
}

/**
 * Read only a current, receipt-bound released source. Restore the former ordered
 * projection from its retained transition, then independently prove both original
 * approvals and cancellation. No supplied snapshots or current-link inference.
 * Replacement, editing, deletion and financial fulfillment remain separate gates.
 */
function material_released_transfer_custody($request_id)
{
    $identity = dimension_writer_reference_id($request_id);
    if (!$identity || !material_core_context() || !transfer_core_context()
        || empty($GLOBALS['transaction_level'])) return false;
    $history = material_core_history($identity);
    if (!$history || !$history['actions']) return false;
    $last = $history['actions'][count($history['actions'])-1];
    $approval = get_approval_workflow_service();
    $receipt = $last['draft_data_snapshot'] === null ? false
        : $approval->decodeStoredDraftData($last['draft_data_snapshot']);
    if (!is_array($receipt) || !isset($receipt['transfer_id'])
        || !($transfer_id = dimension_writer_reference_id($receipt['transfer_id']))) return false;
    $source = material_core_source($identity, 'approved');
    if (!$source || $source['header']['linked_doc_type'] !== null || $source['header']['linked_doc_no'] !== null
        || $source['header']['request_type'] !== 'transfer') return false;
    $ids = array(); foreach ($source['lines'] as $line) $ids[] = (int)$line['line_id'];
    $pairs = material_core_rows('SELECT id FROM '.TB_PREF.'purch_requisition_lines WHERE material_request_line_id IN ('
        .implode(',', $ids).') ORDER BY id FOR UPDATE');
    $to_history = transfer_core_history($transfer_id);
    $headers = transfer_core_rows('SELECT * FROM '.TB_PREF.'wh_transfer_orders WHERE transfer_id='.$transfer_id.' FOR UPDATE');
    $lines = transfer_core_rows('SELECT * FROM '.TB_PREF.'wh_transfer_order_lines WHERE transfer_id='.$transfer_id.' ORDER BY line_id FOR UPDATE');
    $links = material_core_rows('SELECT request_id FROM '.TB_PREF.'wh_material_requests WHERE linked_doc_type='
        .ST_LOCTRANSFER.' AND linked_doc_no='.$transfer_id.' ORDER BY request_id FOR UPDATE');
    if ($pairs !== array() || !$to_history || !$headers || count($headers) !== 1 || !$lines || $links !== array()) return false;
    $transfer = array('header'=>$headers[0], 'lines'=>$lines);
    return material_released_transfer_projection($identity, $source, $history, $transfer, $to_history);
}

/**
 * Compare an exact receipt-bound historical release independently of current links.
 * Callers must load/lock complete persisted rows and prove any reconstruction.
 * This comparison grants no reuse, replacement, approval or financial authority.
 */
function material_released_transfer_projection($request_id, $source, $history, $transfer, $to_history)
{
    $identity = dimension_writer_reference_id($request_id);
    if (!$identity || !material_core_context() || !transfer_core_context()
        || empty($GLOBALS['transaction_level'])) return false;
    foreach (array($source, $transfer) as $rows) {
        if (!is_array($rows) || !isset($rows['header'], $rows['lines'])
            || !is_array($rows['header']) || !is_array($rows['lines']) || !$rows['lines']) return false;
        foreach ($rows['lines'] as $line) if (!is_array($line)) return false;
    }
    foreach (array($history, $to_history) as $rows) {
        if (!is_array($rows) || !isset($rows['drafts'], $rows['actions'])
            || !is_array($rows['drafts']) || !is_array($rows['actions'])) return false;
        foreach (array_merge($rows['drafts'], $rows['actions']) as $row) if (!is_array($row)) return false;
    }
    foreach (array('request_id','status','request_type','linked_doc_type','linked_doc_no','requested_by','updated_at') as $field)
        if (!array_key_exists($field, $source['header'])) return false;
    foreach ($history['actions'] as $row)
        foreach (array('id','draft_id','action_type','user_id','level','draft_data_snapshot','action_date','ip_address') as $field)
            if (!array_key_exists($field, $row)) return false;
    if (dimension_writer_reference_id($source['header']['request_id']) !== $identity
        || $source['header']['status'] !== 'approved' || $source['header']['request_type'] !== 'transfer'
        || $source['header']['linked_doc_type'] !== null || $source['header']['linked_doc_no'] !== null) return false;
    if (!$history['actions']) return false;
    $prior = $history; $action = array_pop($prior['actions']);
    $receipt = material_transfer_release_receipt($action);
    if (!$receipt || $receipt['request_id'] !== $identity
        || !($transfer_id = dimension_writer_reference_id($receipt['transfer_id']))
        || $receipt['material_company_sha256'] !== material_core_context(true)
        || $receipt['transfer_company_sha256'] !== transfer_core_context(true)
        || !is_array($receipt['ordered_transition'])
        || array_keys($receipt['ordered_transition']) !== array('status','linked_doc_type','linked_doc_no','updated_at')
        || $receipt['ordered_transition']['status'] !== 'ordered'
        || (int)$receipt['ordered_transition']['linked_doc_type'] !== ST_LOCTRANSFER
        || dimension_writer_reference_id($receipt['ordered_transition']['linked_doc_no']) !== $transfer_id
        || !is_string($receipt['ordered_transition']['updated_at'])
        || !preg_match('/^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$/D', $receipt['ordered_transition']['updated_at'])
        || $action['action_type'] !== 'source_release') return false;
    if ($receipt['schema'] === 'material-transfer-release-v2') {
        // Both current and historical readers must prove the same complete raw
        // link/release chain. This is never a replacement or financial grant.
        $lineage = material_transfer_release_lineage($history, $identity, $action['id']);
        if (!$lineage || $lineage['selected'] === null
            || $lineage['selected']['transfer_id'] !== $transfer_id
            || !material_transfer_v2_timestamp($receipt['ordered_transition']['updated_at'])
            || $receipt['released_transition']['updated_at'] < $receipt['ordered_transition']['updated_at']) return false;
        $transition = array();
        foreach (array('status','linked_doc_type','linked_doc_no','updated_at') as $field)
            $transition[$field] = $source['header'][$field];
        if ($receipt['released_transition'] !== $transition) return false;
    }
    $ordered = $source;
    foreach ($receipt['ordered_transition'] as $field=>$value) $ordered['header'][$field] = $value;
    $origin = material_transfer_origin_projection($identity, $ordered, $prior, $transfer, $to_history);
    $binding = $origin ? material_transfer_origin_binding($origin) : false;
    $cancelled = $binding ? transfer_cancelled_projection_custody($transfer_id, $transfer, $to_history, $binding) : false;
    $draft = false;
    if ($origin) foreach ($origin['material_history']['drafts'] as $row)
        if ((int)$row['id'] === (int)$receipt['draft_id']) $draft = $row;
    $unsigned = $action; $unsigned['draft_data_snapshot'] = null;
    $clock = material_core_rows('SELECT NOW() AS now_');
    if (!$cancelled || !$clock || !$draft || $receipt['draft_id'] !== (int)$origin['receipt']['approved_draft_id']
        || (int)$action['draft_id'] !== $receipt['draft_id']
        || (int)$action['user_id'] !== (int)$source['header']['requested_by']
        || (int)$action['level'] !== (int)$draft['current_level']
        || !$source['header']['updated_at'] || !$action['action_date'] || $action['ip_address'] === null
        || $source['header']['updated_at'] < $cancelled['action']['action_date']
        || $action['action_date'] < $source['header']['updated_at'] || $action['action_date'] > $clock[0]['now_']
        || $receipt['ordered_source_sha256'] !== material_core_source_fingerprint($ordered)
        || $receipt['source_sha256'] !== material_core_source_fingerprint($source)
        || $receipt['history_sha256'] !== material_transfer_release_history_hash($prior)
        || $receipt['transfer_source_sha256'] !== transfer_core_source_fingerprint($transfer)
        || $receipt['transfer_history_sha256'] !== material_transfer_release_history_hash($to_history)
        || $receipt['action_sha256'] !== material_core_source_fingerprint(array('header'=>$unsigned, 'lines'=>array()))) return false;
    return array('source'=>$source, 'history'=>$history, 'origin'=>$origin,
        'cancelled'=>$cancelled, 'action'=>$action, 'receipt'=>$receipt);
}

/**
 * Original maker releases an exact v2 linked, independently cancelled Transfer.
 * Preserve all old decisions and financial rows, append one attributable receipt,
 * and reconcile complete current and historical projections before committing.
 * Repeated calls deny; legacy or ambiguous custody requires explicit recovery.
 */
function release_cancelled_material_transfer($request_id, $comments = '')
{
    $identity = dimension_writer_reference_id($request_id);
    $context = material_core_context(); $to_context = transfer_core_context();
    if (!$identity || !$context || !$to_context || !is_string($comments) || strpos($comments, "\0") !== false) return false;
    try {
        if (!begin_transaction()) return false;
        $origin = material_transfer_origin_custody($identity);
        $transfer_id = $origin ? (int)$origin['receipt']['transfer_id'] : 0;
        $cancelled = $transfer_id ? transfer_cancelled_linked_custody($transfer_id) : false;
        if (!$origin || !$cancelled || $origin['receipt']['schema'] !== 'material-transfer-link-v2'
            || (int)$origin['material']['header']['requested_by'] !== (int)$_SESSION['wa_current_user']->user
            || $cancelled['source'] !== $origin['transfer'] || $cancelled['history'] !== $origin['transfer_history']) {
            cancel_transaction(); return false;
        }
        $clock = material_core_rows('SELECT NOW() AS now_');
        if (!$clock || !db_query('UPDATE '.TB_PREF."wh_material_requests SET status='approved',linked_doc_type=NULL,linked_doc_no=NULL,updated_at=NOW() WHERE request_id="
            .$identity." AND status='ordered' AND linked_doc_type=".ST_LOCTRANSFER.' AND linked_doc_no='.$transfer_id)
            || db_num_affected_rows() !== 1) { cancel_transaction(); return false; }
        $source = material_core_source($identity, 'approved'); $expected = $origin['material'];
        $now = material_core_rows('SELECT NOW() AS now_');
        if (!$source || !$now || !$source['header']['updated_at'] || $source['header']['updated_at'] < $clock[0]['now_']
            || $source['header']['updated_at'] > $now[0]['now_']) { cancel_transaction(); return false; }
        $expected['header']['status'] = 'approved'; $expected['header']['linked_doc_type'] = null;
        $expected['header']['linked_doc_no'] = null; $expected['header']['updated_at'] = $source['header']['updated_at'];
        if ($source !== $expected) { cancel_transaction(); return false; }
        $draft_id = (int)$origin['receipt']['approved_draft_id'];
        $draft = false; foreach ($origin['material_history']['drafts'] as $row) if ((int)$row['id'] === $draft_id) $draft = $row;
        if (!$draft) { cancel_transaction(); return false; }
        $action_id = add_approval_action($draft_id, 'source_release', null, $draft['current_level'], $comments, null, null);
        $history = $action_id ? material_core_history($identity) : false;
        if (!$history || count($history['actions']) !== count($origin['material_history']['actions'])+1) { cancel_transaction(); return false; }
        $action = array_pop($history['actions']);
        $literal = material_core_rows('SELECT '.db_escape($comments, true).' AS comments,'.db_escape(isset($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : '').' AS ip,NOW() AS now_');
        if (!$literal || $history !== $origin['material_history'] || (int)$action['id'] !== (int)$action_id
            || (int)$action['draft_id'] !== $draft_id || $action['action_type'] !== 'source_release'
            || (int)$action['user_id'] !== (int)$_SESSION['wa_current_user']->user
            || (int)$action['level'] !== (int)$draft['current_level'] || $action['draft_data_snapshot'] !== null
            || $action['comments'] !== $literal[0]['comments'] || $action['ip_address'] !== $literal[0]['ip']
            || $action['action_date'] < $clock[0]['now_'] || $action['action_date'] > $literal[0]['now_']) { cancel_transaction(); return false; }
        $transition = array();
        foreach (array('status','linked_doc_type','linked_doc_no','updated_at') as $field)
            $transition[$field] = $origin['material']['header'][$field];
        $receipt = array('schema'=>'material-transfer-release-v2', 'request_id'=>$identity, 'transfer_id'=>$transfer_id,
            'draft_id'=>$draft_id, 'material_company_sha256'=>material_core_context(true),
            'transfer_company_sha256'=>transfer_core_context(true), 'ordered_transition'=>$transition,
            'ordered_source_sha256'=>material_core_source_fingerprint($origin['material']),
            'source_sha256'=>material_core_source_fingerprint($source),
            'history_sha256'=>material_transfer_release_history_hash($origin['material_history']),
            'transfer_source_sha256'=>transfer_core_source_fingerprint($origin['transfer']),
            'transfer_history_sha256'=>material_transfer_release_history_hash($origin['transfer_history']),
            'action_sha256'=>material_core_source_fingerprint(array('header'=>$action, 'lines'=>array())));
        $receipt['released_transition'] = array();
        foreach (array('status','linked_doc_type','linked_doc_no','updated_at') as $field)
            $receipt['released_transition'][$field] = $source['header'][$field];
        $snapshot = json_encode($receipt);
        if ($snapshot === false || !db_query('UPDATE '.TB_PREF.'approval_actions SET draft_data_snapshot='.db_escape($snapshot, true)
            .' WHERE id='.(int)$action_id.' AND draft_id='.$draft_id.' AND draft_data_snapshot IS NULL')
            || db_num_affected_rows() !== 1) { cancel_transaction(); return false; }
        $finished = material_released_transfer_custody($identity);
        if (!$finished || $finished['source'] !== $source || $finished['receipt'] !== $receipt
            || material_core_source_fingerprint($finished['origin']['material']) !== material_core_source_fingerprint($origin['material'])
            || $finished['origin']['material_history'] !== $origin['material_history'] || $finished['cancelled'] !== $cancelled
            || material_core_context() !== $context || transfer_core_context() !== $to_context
            || !commit_transaction()) { cancel_transaction(); return false; }
        return true;
    } catch (Exception $exception) { cancel_transaction(); return false;
    } catch (Throwable $exception) { cancel_transaction(); return false; }
}
