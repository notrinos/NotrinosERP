function hrm_ben_001_canonicalize($v){if(is_array($v)){if(array_keys($v)!==range(0,count($v)-1))ksort($v,SORT_STRING);foreach($v as $k=>$x)$v[$k]=hrm_ben_001_canonicalize($x);}return $v;}
function hrm_ben_001_hash($v){return hash('sha256',json_encode(hrm_ben_001_canonicalize($v),JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE));}
function hrm_ben_001_sha256($v){$v=strtolower(trim((string)$v));return preg_match('/^[0-9a-f]{64}$/D',$v)?$v:false;}
function hrm_ben_001_token($v,$max=96){$v=trim((string)$v);return $v!==''&&strlen($v)<=$max&&preg_match('/^[A-Za-z0-9][A-Za-z0-9_.:\/-]*$/D',$v)?$v:false;}
function hrm_ben_001_date($v){$v=trim((string)$v);$d=DateTimeImmutable::createFromFormat('!Y-m-d',$v);return $d&&$d->format('Y-m-d')===$v?$v:false;}
function hrm_ben_001_micros($v){$s=trim((string)$v);if(!preg_match('/^(-?)(\d+)(?:\.(\d{1,6}))?$/D',$s,$m))return false;$i=ltrim($m[2],'0');if($i==='')$i='0';if(strlen($i)>12)return false;$f=str_pad(isset($m[3])?$m[3]:'',6,'0');$n=((int)$i)*1000000+(int)$f;return ($m[1]==='-'?-1:1)*$n;}
function hrm_ben_001_decimal_from_micros($n){$n=(int)$n;$neg=$n<0;$n=abs($n);$whole=intdiv($n,1000000);$frac=str_pad((string)($n%1000000),6,'0',STR_PAD_LEFT);return ($neg?'-':'').$whole.'.'.$frac;}
function hrm_ben_001_decimal($v){$n=hrm_ben_001_micros($v);return $n===false?false:hrm_ben_001_decimal_from_micros($n);}
function hrm_ben_001_decimal_add($a,$b){$x=hrm_ben_001_micros($a);$y=hrm_ben_001_micros($b);return $x===false||$y===false?false:hrm_ben_001_decimal_from_micros($x+$y);}
function hrm_ben_001_decimal_subtract($a,$b){$x=hrm_ben_001_micros($a);$y=hrm_ben_001_micros($b);return $x===false||$y===false?false:hrm_ben_001_decimal_from_micros($x-$y);}
function hrm_ben_001_decimal_compare($a,$b){$x=hrm_ben_001_micros($a);$y=hrm_ben_001_micros($b);return $x===false||$y===false?false:($x<=>$y);}
function hrm_ben_001_currency($v){$v=strtoupper(trim((string)$v));return preg_match('/^[A-Z]{3}$/D',$v)?$v:false;}
function hrm_ben_001_effective($from,$to,$asof){$f=hrm_ben_001_date($from);$a=hrm_ben_001_date($asof);$t=$to===null||$to===''?null:hrm_ben_001_date($to);return $f!==false&&$a!==false&&($t===null||$t!==false)&&$f<=$a&&($t===null||$t>=$a);}
