<?php
/** Accessible HRM-ESS-002 presentation helpers. */
function hrm_ess_002_ui_status($text,$error=false){echo '<div class="ess2-status '.($error?'ess2-error':'ess2-ok').'" role="'.($error?'alert':'status').'" aria-live="polite">'.hrm_ess_002_h($text).'</div>';}
/** Localize known machine-state values while preserving domain-owned identifiers. */
function hrm_ess_002_ui_value_label($field,$value){$token=(string)$value;$labels=array('scope_origin'=>array('direct'=>_('Direct'),'delegated'=>_('Delegated')),'status_token'=>array('reviewed'=>_('Reviewed'),'approved'=>_('Approved')),'workflow_status'=>array('pending'=>_('Pending'),'auto_approved'=>_('Automatically approved')),'enrollment_state'=>array('enrolled'=>_('Enrolled'),'waived'=>_('Waived'),'terminated'=>_('Terminated')),'status'=>array('0'=>_('Pending'),'1'=>_('Approved'),'2'=>_('Rejected')),'is_read'=>array('0'=>_('Unread'),'1'=>_('Read')),'unit_code'=>array('day'=>_('Days'),'days'=>_('Days'),'hour'=>_('Hours'),'hours'=>_('Hours'),'minute'=>_('Minutes'),'minutes'=>_('Minutes')));return isset($labels[$field][$token])?$labels[$field][$token]:$value;}
function hrm_ess_002_ui_table($caption,array $headers,array $rows,array $keys){static $n=0;$n++;$id='ess2-table-caption-'.$n;echo '<div class="ess2-table-wrap" tabindex="0" role="region" aria-labelledby="'.$id.'"><table class="ess2-table"><caption id="'.$id.'">'.hrm_ess_002_h($caption).'</caption><thead><tr>';foreach($headers as $h)echo '<th scope="col">'.hrm_ess_002_h($h).'</th>';echo '</tr></thead><tbody>';if(!$rows)echo '<tr><td colspan="'.count($headers).'">'._('No records available.').'</td></tr>';foreach($rows as $row){echo '<tr>';foreach($keys as $k)echo '<td>'.hrm_ess_002_h(hrm_ess_002_ui_value_label($k,isset($row[$k])?$row[$k]:'' )).'</td>';echo '</tr>';}echo '</tbody></table></div>';}
function hrm_ess_002_ui_card_link($href,$title,$body){echo '<a class="ess2-card" href="'.hrm_ess_002_h($href).'"><strong>'.hrm_ess_002_h($title).'</strong><span>'.hrm_ess_002_h($body).'</span></a>';}
?>
