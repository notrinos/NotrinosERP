<?php
/** PAY-RULE-006 activation eligibility, immutable command chain and production formula adapter. */
include_once(dirname(__FILE__).'/pay_rule_006_shadow.inc');

function hrm_pay_rule_006_current_company_id(){if(function_exists('user_company'))return (int)user_company();return isset($_SESSION['wa_current_user']->company)?(int)$_SESSION['wa_current_user']->company:0;}
function hrm_pay_rule_006_period_scope($period_id)
{
    static $cache=array();$period_id=(int)$period_id;if($period_id<=0)return false;if(array_key_exists($period_id,$cache))return $cache[$period_id];
    if(!function_exists('get_payroll_period'))return $cache[$period_id]=false;$p=get_payroll_period($period_id);if(!is_array($p)||empty($p['period_id'])||empty($p['department_id']))return $cache[$period_id]=false;
    return $cache[$period_id]=array('company_id'=>hrm_pay_rule_006_current_company_id(),'department_id'=>(int)$p['department_id'],'from_date'=>(string)$p['from_date'],'to_date'=>(string)$p['to_date']);
}

function hrm_pay_rule_006_scope_leaf($company_id,$department_id,$for_update=false)
{
    $sql='SELECT command_id,sequence_no,predecessor_command_id,command_type,source_state_sha256,effective_from,eligibility_id,command_sha256 FROM '.TB_PREF.'hrm_pay_rule_activation_commands WHERE company_id='.(int)$company_id.' AND department_id='.(int)$department_id.' ORDER BY sequence_no'.($for_update?' FOR UPDATE':'');$q=db_query($sql);if(!$q)return false;$rows=array();while($r=db_fetch_assoc($q)){$r['command_id']=(int)$r['command_id'];$r['sequence_no']=(int)$r['sequence_no'];$r['predecessor_command_id']=$r['predecessor_command_id']===null?null:(int)$r['predecessor_command_id'];$rows[]=$r;}$error=null;$state=hrm_pay_rule_006_command_state($rows,$error);if($state===false)return false;return array('state'=>$state,'leaf'=>empty($rows)?null:end($rows),'commands'=>$rows);
}

/** Resolve immutable command state as of one date; future activation/failback commands never take effect early. */
function hrm_pay_rule_006_scope_state_as_of($company_id,$department_id,$as_of_date)
{
    if(hrm_pay_rule_006_iso_date($as_of_date)===false)return false;$leaf=hrm_pay_rule_006_scope_leaf($company_id,$department_id,false);if($leaf===false)return false;$state='legacy';$active_leaf=null;$last_effective=null;
    foreach($leaf['commands'] as $row){$effective=(string)$row['effective_from'];if(hrm_pay_rule_006_iso_date($effective)===false)return false;if($last_effective!==null&&strcmp($effective,$last_effective)<0)return false;$last_effective=$effective;if(strcmp($effective,$as_of_date)>0)continue;$state=$row['command_type']==='activate'?'governed':'legacy';$active_leaf=$row;}
    return array('state'=>$state,'leaf'=>$active_leaf,'commands'=>$leaf['commands']);
}

/** Prove complete migration/binding/shadow/jurisdiction/rollback prerequisites for one non-global department scope. */
function hrm_pay_rule_006_create_eligibility(array $scope,&$error=null)
{
    $error=null;$actor=hrm_pay_rule_006_actor_id();if($actor<=0||!hrm_pay_rule_006_access('SA_HRM_APPROVE_PAY_RULE_ACTIVATION')){$error='access_denied';return false;}
    foreach(array('company_id','department_id','effective_from','maker_id','reviewer_id','executor_id','jurisdiction_evidence_sha256') as $k)if(!isset($scope[$k])){$error='scope_incomplete';return false;}$source=hrm_pay_rule_006_source_state_sha256();
    $q=db_query('SELECT COUNT(*) total,SUM(CASE WHEN c.classification_token IN (\'unsupported\',\'manual_review\',\'prohibited\',\'duplicate_obsolete\') THEN 1 ELSE 0 END) unsupported,SUM(CASE WHEN b.binding_id IS NOT NULL THEN 1 ELSE 0 END) bound FROM '.TB_PREF.'hrm_pay_rule_migration_candidates c LEFT JOIN '.TB_PREF.'hrm_pay_rule_translation_bindings b ON b.candidate_id=c.candidate_id');$m=$q?db_fetch_assoc($q):false;if(!$m||(int)$m['total']<1){$error='migration_inventory_incomplete';return false;}
    $q=db_query('SELECT COUNT(*) total,COUNT(DISTINCT c.candidate_id) compared_candidates,SUM(CASE WHEN c.outcome_token IN (\'mismatch\',\'unsupported\') THEN 1 ELSE 0 END) unresolved FROM '.TB_PREF.'hrm_pay_rule_shadow_comparisons c INNER JOIN '.TB_PREF.'hrm_pay_rule_shadow_runs r ON r.run_id=c.run_id INNER JOIN '.TB_PREF.'hrm_pay_rule_translation_bindings b ON b.candidate_id=c.candidate_id AND b.rule_version_id=c.rule_version_id WHERE r.company_id='.(int)$scope['company_id'].' AND r.department_id='.(int)$scope['department_id'].' AND r.source_state_sha256='.db_escape($source));$sh=$q?db_fetch_assoc($q):false;if(!$sh||(int)$sh['total']<1){$error='shadow_evidence_incomplete';return false;}
    $env=array('company_id'=>(int)$scope['company_id'],'department_id'=>(int)$scope['department_id'],'effective_from'=>$scope['effective_from'],'source_state_sha256'=>$source,'migration_set_sha256'=>hrm_pay_rule_006_hash(array('candidate_count'=>(int)$m['total'],'bound_count'=>(int)$m['bound'],'unsupported_count'=>(int)$m['unsupported'])),'shadow_evidence_sha256'=>hrm_pay_rule_006_hash(array('comparison_count'=>(int)$sh['total'],'compared_candidate_count'=>(int)$sh['compared_candidates'],'unresolved'=>(int)$sh['unresolved'])),'jurisdiction_evidence_sha256'=>$scope['jurisdiction_evidence_sha256'],'candidate_count'=>(int)$m['total'],'published_binding_count'=>(int)$m['bound'],'compared_candidate_count'=>(int)$sh['compared_candidates'],'comparison_count'=>(int)$sh['total'],'unresolved_count'=>(int)$sh['unresolved'],'unsupported_count'=>(int)$m['unsupported'],'rollback_ready'=>true,'maker_id'=>(int)$scope['maker_id'],'reviewer_id'=>(int)$scope['reviewer_id'],'approver_id'=>$actor,'executor_id'=>(int)$scope['executor_id']);if(!hrm_pay_rule_006_validate_activation_envelope($env,$error))return false;
    $hash=hrm_pay_rule_006_hash($env);$manage=empty($GLOBALS['transaction_level']);if($manage)begin_transaction();$ok=true;$id=false;$new=false;$q=db_query('SELECT eligibility_id,eligibility_sha256 FROM '.TB_PREF.'hrm_pay_rule_activation_eligibility WHERE eligibility_sha256='.db_escape($hash).' LIMIT 2 FOR UPDATE');if($q&&db_num_rows($q)===1){$x=db_fetch_assoc($q);$id=(int)$x['eligibility_id'];}elseif(!$q||db_num_rows($q)>1){$ok=false;$error='eligibility_replay_ambiguous';}
    if($ok&&$id===false){$sql='INSERT INTO '.TB_PREF.'hrm_pay_rule_activation_eligibility (company_id,department_id,effective_from,source_state_sha256,migration_set_sha256,shadow_evidence_sha256,jurisdiction_evidence_sha256,candidate_count,published_binding_count,compared_candidate_count,comparison_count,unresolved_count,unsupported_count,rollback_ready,maker_id,reviewer_id,approver_id,executor_id,eligibility_sha256) VALUES ('.$env['company_id'].','.$env['department_id'].','.db_escape($env['effective_from']).','.db_escape($source).','.db_escape($env['migration_set_sha256']).','.db_escape($env['shadow_evidence_sha256']).','.db_escape($env['jurisdiction_evidence_sha256']).','.$env['candidate_count'].','.$env['published_binding_count'].','.$env['compared_candidate_count'].','.$env['comparison_count'].','.$env['unresolved_count'].','.$env['unsupported_count'].',1,'.$env['maker_id'].','.$env['reviewer_id'].','.$env['approver_id'].','.$env['executor_id'].','.db_escape($hash).')';if(!db_query($sql,'could not append PAY-RULE-006 activation eligibility')){$ok=false;$error='eligibility_insert_failed';}else{$id=(int)db_insert_id();$new=true;}}
    if($ok&&$new&&hrm_pay_rule_006_audit('pay_rule_006_activation_eligibility',array('eligibility_id'=>$id,'company_id'=>$env['company_id'],'department_id'=>$env['department_id']),'pay.rule_006.activation_eligibility_recorded','pay_rule_006_activation_eligibility',array('eligibility_sha256'=>$hash,'candidate_count'=>$env['candidate_count'],'comparison_count'=>$env['comparison_count'],'unresolved_count'=>0,'unsupported_count'=>0,'rollback_ready'=>true,'production_activated'=>false),$env['company_id'])===false){$ok=false;$error='audit_failed';}
    if($manage){if($ok)commit_transaction();else cancel_transaction();}return $ok?$id:false;
}

function hrm_pay_rule_006_append_command($eligibility_id,$type,$reason_token,&$error=null)
{
    $error=null;$actor=hrm_pay_rule_006_actor_id();$permission=$type==='failback'?'SA_HRM_FAILBACK_PAY_RULE':'SA_HRM_EXECUTE_PAY_RULE_ACTIVATION';if($actor<=0||!hrm_pay_rule_006_access($permission)){$error='access_denied';return false;}$reason_token=hrm_pay_rule_006_token($reason_token,120);if($reason_token===false||!in_array($type,array('activate','failback'),true))return false;$manage=empty($GLOBALS['transaction_level']);if($manage)begin_transaction();$ok=true;$id=false;
    $q=db_query('SELECT * FROM '.TB_PREF.'hrm_pay_rule_activation_eligibility WHERE eligibility_id='.(int)$eligibility_id.' LIMIT 2 FOR UPDATE');$e=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$e||!hash_equals((string)$e['source_state_sha256'],hrm_pay_rule_006_source_state_sha256())||(int)$e['executor_id']!==$actor)$ok=false;
    $leaf=$ok?hrm_pay_rule_006_scope_leaf((int)$e['company_id'],(int)$e['department_id'],true):false;if($ok&&$leaf===false)$ok=false;if($ok&&$leaf['leaf']!==null&&strcmp((string)$e['effective_from'],(string)$leaf['leaf']['effective_from'])<0){$error='effective_date_precedes_predecessor';$ok=false;}if($ok&&$type==='activate'&&$leaf['state']==='governed'){$error='already_active';$ok=false;}if($ok&&$type==='failback'&&$leaf['state']!=='governed'){$error='not_active';$ok=false;}
    if($ok){$sequence=count($leaf['commands'])+1;$pred=$leaf['leaf']===null?null:(int)$leaf['leaf']['command_id'];$payload=array('company_id'=>(int)$e['company_id'],'department_id'=>(int)$e['department_id'],'effective_from'=>(string)$e['effective_from'],'sequence_no'=>$sequence,'predecessor_command_id'=>$pred,'command_type'=>$type,'eligibility_id'=>(int)$eligibility_id,'source_state_sha256'=>(string)$e['source_state_sha256'],'executor_id'=>$actor,'reason_token'=>$reason_token);$hash=hrm_pay_rule_006_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_pay_rule_activation_commands (company_id,department_id,effective_from,sequence_no,predecessor_command_id,command_type,eligibility_id,source_state_sha256,executor_id,reason_token,command_sha256) VALUES ('.$payload['company_id'].','.$payload['department_id'].','.db_escape($payload['effective_from']).','.$sequence.','.($pred===null?'NULL':$pred).','.db_escape($type).','.(int)$eligibility_id.','.db_escape($payload['source_state_sha256']).','.$actor.','.db_escape($reason_token).','.db_escape($hash).')';if(!db_query($sql,'could not append PAY-RULE-006 activation command')){$ok=false;$error='command_insert_failed';}else{$id=(int)db_insert_id();if(hrm_pay_rule_006_audit('pay_rule_006_activation_command',array('command_id'=>$id,'company_id'=>$payload['company_id'],'department_id'=>$payload['department_id']),'pay.rule_006.'.$type.'_executed',$reason_token,array('command_sha256'=>$hash,'eligibility_id'=>(int)$eligibility_id,'source_state_sha256'=>$payload['source_state_sha256'],'historical_payroll_rewritten'=>false,'accounting_rewritten'=>false),$payload['company_id'])===false){$ok=false;$error='audit_failed';}}}
    if($manage){if($ok)commit_transaction();else cancel_transaction();}return $ok?$id:false;
}

/** Resolve governed formula target only for an active exact department scope and unambiguous formula hash binding. */
function hrm_pay_rule_006_active_formula_target($company_id,$department_id,$formula,$as_of_date,&$error=null)
{
    $error=null;if((int)$department_id<=0||hrm_pay_rule_006_iso_date($as_of_date)===false){return false;}if(function_exists('payroll_table_exists')&&!payroll_table_exists('hrm_pay_rule_activation_commands'))return false;$leaf=hrm_pay_rule_006_scope_state_as_of($company_id,$department_id,$as_of_date);if($leaf===false||$leaf['state']!=='governed'||$leaf['leaf']===null)return false;$cmd=$leaf['leaf'];if(!hash_equals((string)$cmd['source_state_sha256'],hrm_pay_rule_006_source_state_sha256())){$error='active_source_state_stale';return null;}
    $source_hash=hash('sha256',trim((string)$formula));$q=db_query('SELECT DISTINCT b.target_sha256,c.classification_token,c.translated_sha256 FROM '.TB_PREF.'hrm_pay_rule_migration_candidates c INNER JOIN '.TB_PREF.'hrm_pay_rule_translation_bindings b ON b.candidate_id=c.candidate_id WHERE c.source_payload_sha256='.db_escape($source_hash));if(!$q){$error='binding_lookup_failed';return null;}$targets=array();while($r=db_fetch_assoc($q))$targets[$r['target_sha256']]=$r;if(count($targets)!==1){$error='binding_ambiguous_or_missing';return null;}$row=reset($targets);$target=$row['classification_token']==='translated'?hrm_legacy_formula_translate_for_facade($formula):trim((string)$formula);if($target===false||!hash_equals(hash('sha256',$target),(string)$row['target_sha256'])){$error='target_hash_mismatch';return null;}return $target;
}

/** Production adapter: no active command means legacy; an active governed scope must evaluate governed or fail closed. */
function hrm_pay_rule_006_evaluate_production_formula($company_id,$department_id,$formula,$as_of_date,array $legacy_context,$period_start,$period_end,$legacy_engine,&$mode=null,&$error=null)
{
    $mode='legacy';$error=null;$target=hrm_pay_rule_006_active_formula_target($company_id,$department_id,$formula,$as_of_date,$error);if($target===false)return $legacy_engine->evaluate($formula);if($target===null)return false;$receipt=null;$value=hrm_payroll_formula_safe_evaluate($target,hrm_pay_rule_006_formula_context($legacy_context,$period_start,$period_end),$receipt,$error);if($value===false)return false;$mode='governed';return (float)$value->decimalString();
}
