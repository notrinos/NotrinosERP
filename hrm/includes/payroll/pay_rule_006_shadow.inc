<?php
/** PAY-RULE-006 deterministic non-authoritative shadow comparison custody. */
include_once(dirname(__FILE__).'/pay_rule_006_migration.inc');

function hrm_pay_rule_006_formula_context(array $legacy,$period_start,$period_end)
{
    $out=$legacy;$out['PERIOD_START']=$period_start;$out['PERIOD_END']=$period_end;return $out;
}
function hrm_pay_rule_006_shadow_compare_formula($legacy_formula,$target_formula,array $legacy_context,$period_start,$period_end,$policy=null,&$error=null)
{
    $error=null;$legacy=hrm_legacy_formula_evaluate_for_differential($legacy_formula,$legacy_context);if(!is_numeric($legacy)){$error='legacy_evaluation_failed';return false;}
    $receipt=null;$safe_error=null;$value=hrm_payroll_formula_safe_evaluate($target_formula,hrm_pay_rule_006_formula_context($legacy_context,$period_start,$period_end),$receipt,$safe_error);if($value===false){$error='governed_evaluation_failed:'.$safe_error;return false;}$governed=(float)$value->decimalString();$detail=null;$equivalent=hrm_pay_rule_006_compare_decimal($legacy,$governed,$policy,$detail);if(!is_array($detail)){$error='comparison_policy_invalid';return false;}
    return array('legacy_value'=>(float)$legacy,'governed_value'=>$governed,'legacy_result_sha256'=>hash('sha256',sprintf('%.17g',(float)$legacy)),'governed_result_sha256'=>hash('sha256',sprintf('%.17g',$governed)),'outcome'=>$detail['outcome'],'delta'=>$detail['delta'],'comparison_policy'=>$detail['policy'],'equivalent'=>$equivalent===true,'runtime_receipt'=>$receipt);
}

function hrm_pay_rule_006_record_shadow_run(array $scope,array $comparisons,&$error=null)
{
    $error=null;$actor=hrm_pay_rule_006_actor_id();if($actor<=0||!hrm_pay_rule_006_access('SA_HRM_RUN_PAY_RULE_SHADOW')){$error='access_denied';return false;}
    foreach(array('company_id','payroll_period_id','department_id','source_state_sha256','jurisdiction_evidence_sha256','idempotency_sha256') as $k)if(!isset($scope[$k])){$error='scope_incomplete';return false;}
    if((int)$scope['company_id']<0||(int)$scope['payroll_period_id']<=0||(int)$scope['department_id']<=0||hrm_pay_rule_006_sha($scope['source_state_sha256'])===false||hrm_pay_rule_006_sha($scope['jurisdiction_evidence_sha256'])===false||hrm_pay_rule_006_sha($scope['idempotency_sha256'])===false){$error='scope_invalid';return false;}
    if(!hash_equals((string)$scope['source_state_sha256'],hrm_pay_rule_006_source_state_sha256())){$error='stale_source_state';return false;}
    $normalized=array();foreach($comparisons as $c){if(!is_array($c)){ $error='comparison_invalid';return false;}foreach(array('employee_id','candidate_id','rule_version_id','legacy_result_sha256','governed_result_sha256','outcome_token') as $k)if(!isset($c[$k])){$error='comparison_incomplete';return false;}$employee=hrm_pay_rule_006_token((string)$c['employee_id'],64);$legacy=hrm_pay_rule_006_sha($c['legacy_result_sha256']);$governed=hrm_pay_rule_006_sha($c['governed_result_sha256']);$candidate=(int)$c['candidate_id'];$rule=(int)$c['rule_version_id'];$outcome=(string)$c['outcome_token'];$tol=(int)($c['tolerance_policy_id']??0);if($employee===false||$candidate<=0||$rule<=0||$legacy===false||$governed===false||$tol<0||!in_array($outcome,array('exact','tolerated','mismatch','unsupported'),true)){$error='comparison_invalid';return false;}$normalized[]=array('employee_id'=>$employee,'candidate_id'=>$candidate,'rule_version_id'=>$rule,'legacy_result_sha256'=>$legacy,'governed_result_sha256'=>$governed,'outcome_token'=>$outcome,'tolerance_policy_id'=>$tol);}
    if(empty($normalized)){$error='comparison_population_empty';return false;}
    $run_hash=hrm_pay_rule_006_hash(array('scope'=>$scope,'comparison_policy'=>HRM_PAY_RULE_006_COMPARISON_POLICY_VERSION));$manage=empty($GLOBALS['transaction_level']);if($manage)begin_transaction();$ok=true;$run_id=false;$new_run=false;
    $q=db_query('SELECT run_id,run_sha256 FROM '.TB_PREF.'hrm_pay_rule_shadow_runs WHERE idempotency_sha256='.db_escape($scope['idempotency_sha256']).' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){$ok=false;$error='shadow_replay_ambiguous';}elseif(db_num_rows($q)===1){$x=db_fetch_assoc($q);if(!hash_equals($run_hash,(string)$x['run_sha256'])){$ok=false;$error='shadow_replay_diverged';}else$run_id=(int)$x['run_id'];}
    if($ok&&$run_id===false){$sql='INSERT INTO '.TB_PREF.'hrm_pay_rule_shadow_runs (company_id,payroll_period_id,department_id,source_state_sha256,jurisdiction_evidence_sha256,comparison_policy_version,idempotency_sha256,run_sha256,executed_by) VALUES ('.(int)$scope['company_id'].','.(int)$scope['payroll_period_id'].','.(int)$scope['department_id'].','.db_escape($scope['source_state_sha256']).','.db_escape($scope['jurisdiction_evidence_sha256']).','.db_escape(HRM_PAY_RULE_006_COMPARISON_POLICY_VERSION).','.db_escape($scope['idempotency_sha256']).','.db_escape($run_hash).','.$actor.')';if(!db_query($sql,'could not append PAY-RULE-006 shadow run')){$ok=false;$error='shadow_run_insert_failed';}else{$run_id=(int)db_insert_id();$new_run=true;}}
    $expected=array();if($ok){foreach($normalized as $c){$h=hrm_pay_rule_006_hash(array('run_id'=>$run_id,'employee_id'=>$c['employee_id'],'candidate_id'=>$c['candidate_id'],'rule_version_id'=>$c['rule_version_id'],'legacy'=>$c['legacy_result_sha256'],'governed'=>$c['governed_result_sha256'],'outcome'=>$c['outcome_token'],'tolerance_policy_id'=>$c['tolerance_policy_id']));$expected[$h]=$c;}if(count($expected)!==count($normalized)){$ok=false;$error='comparison_duplicate';}}
    $existing_hashes=array();if($ok){$existing=db_query('SELECT comparison_sha256 FROM '.TB_PREF.'hrm_pay_rule_shadow_comparisons WHERE run_id='.$run_id.' ORDER BY comparison_sha256 FOR UPDATE');if(!$existing){$ok=false;$error='comparison_lookup_failed';}else while($x=db_fetch_assoc($existing))$existing_hashes[(string)$x['comparison_sha256']]=true;}
    if($ok&&empty($existing_hashes)){foreach($expected as $hash=>$c){$sql='INSERT INTO '.TB_PREF.'hrm_pay_rule_shadow_comparisons (run_id,employee_id,candidate_id,rule_version_id,legacy_result_sha256,governed_result_sha256,outcome_token,tolerance_policy_id,comparison_sha256) VALUES ('.$run_id.','.db_escape($c['employee_id']).','.$c['candidate_id'].','.$c['rule_version_id'].','.db_escape($c['legacy_result_sha256']).','.db_escape($c['governed_result_sha256']).','.db_escape($c['outcome_token']).','.($c['tolerance_policy_id']>0?$c['tolerance_policy_id']:'NULL').','.db_escape($hash).')';if(!db_query($sql,'could not append PAY-RULE-006 shadow comparison')){$ok=false;$error='comparison_insert_failed';break;}}}
    elseif($ok){if(count($existing_hashes)!==count($expected)||array_diff_key($existing_hashes,$expected)||array_diff_key($expected,$existing_hashes)){$ok=false;$error='shadow_replay_comparison_diverged';}}
    if($ok&&$new_run&&hrm_pay_rule_006_audit('pay_rule_006_shadow_run',array('run_id'=>$run_id,'company_id'=>(int)$scope['company_id'],'department_id'=>(int)$scope['department_id'],'payroll_period_id'=>(int)$scope['payroll_period_id']),'pay.rule_006.shadow_recorded','pay_rule_006_shadow_execution',array('run_sha256'=>$run_hash,'comparison_count'=>count($normalized),'non_authoritative'=>true,'posting_mutated'=>false,'accounting_mutated'=>false,'bank_mutated'=>false,'tax_submission_mutated'=>false))===false){$ok=false;$error='audit_failed';}
    if($manage){if($ok)commit_transaction();else cancel_transaction();}return $ok?$run_id:false;
}
