<?php
/** Explicit immutable-evidence source adapters for PAY-CORE-007. No mutable-current inference. */
include_once(dirname(__FILE__).'/pay_core_007_contract.inc');
function hrm_pay_core_007_adapter_event($family,array $source,array $scope,&$error=null){$error=null;foreach(array('source_system','source_type','source_key','source_sha256','effective_from','evidence_sha256') as $k)if(!array_key_exists($k,$source)){$error='adapter_source_incomplete';return false;}$x=array_merge($scope,$source,array('source_family'=>$family));return hrm_pay_core_007_event($x,$error);}
function hrm_pay_core_007_adapt_approved_input_correction(array $s,array $scope,&$error=null){if(empty($s['approved_input_id'])||!hrm_pay_core_007_is_sha256($s['input_sha256']??'')){$error='approved_input_evidence_invalid';return false;}$s['source_system']='pay_core_003';$s['source_type']='approved_input';$s['source_key']='approved_input:'.(int)$s['approved_input_id'];$s['source_sha256']=$s['input_sha256'];return hrm_pay_core_007_adapter_event('approved_payroll_input_correction',$s,$scope,$error);}
function hrm_pay_core_007_adapt_element_version_correction(array $s,array $scope,&$error=null){if(empty($s['element_version_id'])||!hrm_pay_core_007_is_sha256($s['version_sha256']??'')){$error='element_version_evidence_invalid';return false;}$s['source_system']='pay_core_003';$s['source_type']='element_version';$s['source_key']='element_version:'.(int)$s['element_version_id'];$s['source_sha256']=$s['version_sha256'];return hrm_pay_core_007_adapter_event('element_version_correction',$s,$scope,$error);}
function hrm_pay_core_007_adapt_rule_jurisdiction_change(array $s,array $scope,&$error=null){if(empty($s['resolution_id'])||!hrm_pay_core_007_is_sha256($s['resolution_sha256']??'')){$error='jurisdiction_resolution_evidence_invalid';return false;}$s['source_system']='pay_rule_005';$s['source_type']='jurisdiction_resolution';$s['source_key']='resolution:'.(int)$s['resolution_id'];$s['source_sha256']=$s['resolution_sha256'];return hrm_pay_core_007_adapter_event('rule_jurisdiction_retroactive_change',$s,$scope,$error);}
function hrm_pay_core_007_adapt_prior_correction_reversal(array $s,array $scope,&$error=null){if(empty($s['lineage_id'])||!hrm_pay_core_007_is_sha256($s['lineage_sha256']??'')){$error='prior_lineage_evidence_invalid';return false;}$s['source_system']='pay_core_004';$s['source_type']='correction_lineage';$s['source_key']='lineage:'.(int)$s['lineage_id'];$s['source_sha256']=$s['lineage_sha256'];return hrm_pay_core_007_adapter_event('prior_payroll_correction_reversal',$s,$scope,$error);}
function hrm_pay_core_007_adapt_upstream_immutable_change($family,array $s,array $scope,&$error=null){if(!in_array($family,array('employment_assignment_effective_change','leave_time_overtime_correction'),true)){$error='upstream_family_denied';return false;}if(!hrm_pay_core_007_is_sha256($s['source_sha256']??'')||!hrm_pay_core_007_is_sha256($s['evidence_sha256']??'')){$error='upstream_immutable_evidence_required';return false;}return hrm_pay_core_007_adapter_event($family,$s,$scope,$error);}
?>
