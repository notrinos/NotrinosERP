function hrm_lve_001_project_movements(array $movements,$scale=6,&$error=null){$error=null;$s=array('gross'=>0.0,'reserved'=>0.0,'consumed'=>0.0,'accrued'=>0.0,'carried'=>0.0,'expired'=>0.0,'donated'=>0.0,'cashed_out'=>0.0);$ids=array();foreach($movements as $m){$e=hrm_lve_001_movement_effect($m['movement_kind'],$m['units'],$error);if($e===false)return false;foreach($s as $k=>$v)$s[$k]+=$e[$k];if(isset($m['movement_sha256']))$ids[]=$m['movement_sha256'];}$out=array('available_units'=>hrm_lve_001_decimal($s['gross']-$s['reserved'],$scale),'reserved_units'=>hrm_lve_001_decimal($s['reserved'],$scale),'consumed_units'=>hrm_lve_001_decimal($s['consumed'],$scale),'accrued_units'=>hrm_lve_001_decimal($s['accrued'],$scale),'carried_units'=>hrm_lve_001_decimal($s['carried'],$scale),'expired_units'=>hrm_lve_001_decimal($s['expired'],$scale),'donated_units'=>hrm_lve_001_decimal($s['donated'],$scale),'cashed_out_units'=>hrm_lve_001_decimal($s['cashed_out'],$scale));sort($ids,SORT_STRING);$out['movement_set_sha256']=hrm_tim_001_hash($ids);return $out;}
