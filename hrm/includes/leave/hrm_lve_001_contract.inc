function hrm_lve_001_policy_specificity(array $p){$n=0;foreach(array('employment_type','grade_id','assignment_id','work_location_id') as $k)if(isset($p[$k])&&$p[$k]!==null&&$p[$k]!=='')$n++;return $n;}
function hrm_lve_001_resolve_policy_candidates(array $rows,&$error=null){$error=null;if(count($rows)===0){$error='policy_not_configured';return false;}usort($rows,function($a,$b){$pa=(int)$a['priority_rank'];$pb=(int)$b['priority_rank'];if($pa!==$pb)return $pa>$pb?-1:1;$sa=hrm_lve_001_policy_specificity($a);$sb=hrm_lve_001_policy_specificity($b);if($sa!==$sb)return $sa>$sb?-1:1;return strcmp((string)$a['policy_sha256'],(string)$b['policy_sha256']);});if(count($rows)>1&&(int)$rows[0]['priority_rank']===(int)$rows[1]['priority_rank']&&hrm_lve_001_policy_specificity($rows[0])===hrm_lve_001_policy_specificity($rows[1])){$error='policy_ambiguous';return false;}return $rows[0];}
function hrm_lve_001_cycle_bounds($basis,$effective_date,$employment_start,$fiscal_start,$fiscal_end,&$error=null){$error=null;$d=hrm_tim_001_date($effective_date);if($d===false){$error='cycle_date_invalid';return false;}if($basis==='fiscal'){if(hrm_tim_001_date($fiscal_start)===false||hrm_tim_001_date($fiscal_end)===false||$d<$fiscal_start||$d>$fiscal_end){$error='fiscal_cycle_missing';return false;}return array($fiscal_start,$fiscal_end);}if($basis!=='anniversary'||hrm_tim_001_date($employment_start)===false){$error='anniversary_cycle_missing';return false;}$md=substr($employment_start,5,5);$year=(int)substr($d,0,4);$start=sprintf('%04d-%s',$year,$md);if($start>$d)$start=sprintf('%04d-%s',$year-1,$md);$dt=DateTimeImmutable::createFromFormat('!Y-m-d',$start,new DateTimeZone('UTC'));if(!$dt){$error='anniversary_cycle_invalid';return false;}$end=$dt->modify('+1 year -1 day')->format('Y-m-d');return array($start,$end);}
function hrm_lve_001_entitlement_units(array $policy,array $context,&$error=null){$error=null;$scale=(int)$policy['rounding_scale'];$base=(float)$policy['entitlement_units'];$service=(int)($context['service_days']??-1);if($service<0){$error='service_days_missing';return false;}if($service<(int)$policy['waiting_days'])return hrm_lve_001_decimal(0,$scale);$factor=1.0;if($policy['proration_mode']==='service_fraction'){$eligible=(int)($context['eligible_days']??-1);$cycle=(int)($context['cycle_days']??-1);if($eligible<0||$cycle<=0||$eligible>$cycle){$error='service_proration_context_invalid';return false;}$factor=$eligible/$cycle;}elseif($policy['proration_mode']==='work_schedule_fraction'){$actual=(int)($context['scheduled_minutes']??-1);$reference=(int)($context['reference_minutes']??-1);if($actual<0||$reference<=0){$error='schedule_proration_context_invalid';return false;}$factor=$actual/$reference;}if($policy['entitlement_mode']==='accrual'){$elapsed=(int)($context['elapsed_periods']??-1);$periods=$policy['accrual_period']==='monthly'?12:($policy['accrual_period']==='quarterly'?4:0);if($elapsed<0||$periods<=0||$elapsed>$periods){$error='accrual_context_invalid';return false;}$base=$base*($elapsed/$periods);}return hrm_lve_001_decimal($base*$factor,$scale);}
