function pay_eco_001_artifact_admission_iso($sql_value,&$error)
{
    $epoch=strtotime((string)$sql_value.' UTC');
    if($epoch===false)return pay_eco_001_fail($error,'artifact_admission_time_state_invalid');
    return gmdate('Y-m-d\TH:i:s\Z',$epoch);
}
function pay_eco_001_artifact_admission_effective($from,$to,$now_epoch)
{
    $f=strtotime((string)$from.' UTC');$t=$to===null?null:strtotime((string)$to.' UTC');
    return $f!==false&&($to===null||$t!==false)&&$f<=(int)$now_epoch&&($t===null||$t>=(int)$now_epoch);
}

