function hrm_cmp_001_table_columns($table){if(!hrm_migration_table_exists($table))return false;$q=db_query('SHOW COLUMNS FROM '.TB_PREF.$table);if(!$q)return false;$out=array();while($r=db_fetch_assoc($q))$out[]=(string)$r['Field'];return $out;}
function hrm_cmp_001_table_indexes($table){$q=db_query('SHOW INDEX FROM '.TB_PREF.$table);if(!$q)return false;$out=array();while($r=db_fetch_assoc($q)){$name=(string)$r['Key_name'];if($name==='PRIMARY')continue;if(!isset($out[$name]))$out[$name]=array('unique'=>(int)$r['Non_unique']===0,'columns'=>array());$out[$name]['columns'][(int)$r['Seq_in_index']]=(string)$r['Column_name'];}foreach($out as $n=>$x){ksort($x['columns']);$out[$n]['columns']=array_values($x['columns']);}return $out;}
function hrm_cmp_001_trigger_name($code,$op){$p=hrm_migration_active_table_prefix();if($p===false)return false;return $p.'cmp1_'.$code.'_'.(strtoupper($op)==='UPDATE'?'u':'d');}
function hrm_cmp_001_trigger_exists($table,$code,$op){$physical=hrm_migration_physical_table_name($table);$name=hrm_cmp_001_trigger_name($code,$op);if($physical===false||$name===false)return false;$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);$stmt=(string)$r['ACTION_STATEMENT'];return strtoupper((string)$r['EVENT_MANIPULATION'])===strtoupper($op)&&(string)$r['EVENT_OBJECT_TABLE']===$physical&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&strpos($stmt,"SIGNAL SQLSTATE '45000'")!==false&&strpos($stmt,'HRM-CMP-001')!==false;}
function hrm_cmp_001_require_schema($patch,$triggers=true){foreach(hrm_cmp_001_schema_columns() as $table=>$columns){if(hrm_cmp_001_table_columns($table)!==$columns)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-CMP-001 table projection mismatch: '.$table);$actual=hrm_cmp_001_table_indexes($table);if($actual===false)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-CMP-001 indexes unreadable: '.$table);foreach(hrm_cmp_001_required_indexes()[$table] as $name=>$expect){if(!isset($actual[$name])||($actual[$name]['unique']?1:0)!==(int)$expect[0]||$actual[$name]['columns']!==$expect[1])return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-CMP-001 index projection mismatch: '.$table.'.'.$name);}if($triggers&&isset(hrm_cmp_001_trigger_codes()[$table])){foreach(array('UPDATE','DELETE') as $op){if($table==='hrm_comp_award_commands'&&$op==='UPDATE')continue;if(!hrm_cmp_001_trigger_exists($table,hrm_cmp_001_trigger_codes()[$table],$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-CMP-001 immutable trigger mismatch: '.$table.'.'.$op);}}}return true;}
function hrm_cmp_001_install_schema($patch){global $path_to_root;$present=0;foreach(hrm_cmp_001_schema_columns() as $table=>$x)if(hrm_migration_table_exists($table))$present++;if($present===count(hrm_cmp_001_schema_columns()))return hrm_cmp_001_require_schema($patch,true);if($present!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-CMP-001 schema is partially installed; forward recovery required.');$src=@file_get_contents($path_to_root.'/sql/upgrade_hrm_cmp_001_schema.sql');if(!is_string($src)||$src==='')return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-CMP-001 schema SQL missing.');$prefix=hrm_migration_active_table_prefix();if($prefix===false)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-CMP-001 table prefix invalid.');$src=str_replace('`0_','`'.$prefix,$src);$stmts=preg_split('/;\s*(?:\r?\n|$)/',$src);foreach($stmts as $stmt){$stmt=trim($stmt);if($stmt!==''&&!db_query($stmt))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-CMP-001 schema statement failed.');}return hrm_cmp_001_require_schema($patch,true);}
