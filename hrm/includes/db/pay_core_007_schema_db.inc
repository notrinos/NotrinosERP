function hrm_pay_core_007_schema_columns($table){if(!hrm_migration_table_exists($table))return false;$r=db_query('SHOW COLUMNS FROM '.TB_PREF.$table);if(!$r)return false;$o=array();while($x=db_fetch_assoc($r))$o[]=(string)$x['Field'];return $o;}
function hrm_pay_core_007_schema_engine_innodb($table){$p=hrm_migration_physical_table_name($table);if($p===false)return false;$r=db_query('SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($p));$x=$r?db_fetch_assoc($r):false;return $x&&strcasecmp((string)$x['ENGINE'],'InnoDB')===0;}
function hrm_pay_core_007_trigger_name($code,$op){$p=hrm_migration_active_table_prefix();$s=strtoupper($op)==='UPDATE'?'u':'d';if($p===false||!preg_match('/^[a-z0-9_]{1,12}$/D',$code))return false;$n=$p.'pc7_'.$code.'_'.$s;return strlen($n)<=64?$n:false;}
function hrm_pay_core_007_trigger_exists($table,$code,$op){$p=hrm_migration_physical_table_name($table);$n=hrm_pay_core_007_trigger_name($code,$op);if($p===false||$n===false)return false;$r=db_query('SELECT COUNT(*) n FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($n).' AND EVENT_OBJECT_TABLE='.db_escape($p).' AND EVENT_MANIPULATION='.db_escape(strtoupper($op)));$x=$r?db_fetch_assoc($r):false;return $x&&(int)$x['n']===1;}
function hrm_pay_core_007_ensure_triggers($patch,$tables){foreach($tables as $t=>$c)foreach(array('UPDATE','DELETE') as $op){if(hrm_pay_core_007_trigger_exists($t,$c,$op))continue;$n=hrm_pay_core_007_trigger_name($c,$op);$sql='CREATE TRIGGER `'.$n.'` BEFORE '.$op.' ON `'.TB_PREF.$t.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape('PAY-CORE-007 immutable custody denies '.strtolower($op).' on '.$t);if(!$n||!db_query($sql,'could not create PAY-CORE-007 immutable trigger'))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-CORE-007 immutable trigger creation failed.');}return true;}
function hrm_pay_core_007_install_tables($patch,$sql_file,$expected,$codes){global $path_to_root;$src=@file_get_contents($path_to_root.'/sql/'.$sql_file);if($src===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-CORE-007 custody SQL missing.');preg_match_all('/CREATE TABLE `0_([^`]+)`.*?;(?=\s|$)/s',$src,$m,PREG_SET_ORDER);if(count($m)!==count($expected))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-CORE-007 custody SQL table count mismatch.');foreach($m as $x){if(!isset($expected[$x[1]]))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'Unexpected PAY-CORE-007 table '.$x[1].'.');if(!hrm_migration_table_exists($x[1])&&!db_query(str_replace('0_',TB_PREF,$x[0]),'could not create PAY-CORE-007 table'))return false;}foreach($expected as $t=>$cols)if(hrm_pay_core_007_schema_columns($t)!==$cols||!hrm_pay_core_007_schema_engine_innodb($t))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CORE-007 custody schema mismatch for '.$t.'.');return hrm_pay_core_007_ensure_triggers($patch,$codes);}
function hrm_pay_core_007_require_zero_rows($patch,$tables){foreach($tables as $t){$r=db_query('SELECT COUNT(*) n FROM '.TB_PREF.$t);$x=$r?db_fetch_assoc($r):false;if(!$x||(int)$x['n']!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CORE-007 custody must activate with zero rows in '.$t.'.');}return true;}
