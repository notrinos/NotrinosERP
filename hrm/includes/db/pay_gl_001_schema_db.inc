function pay_gl_001_trigger_code($t){$m=array('hrm_pay_gl_001_journal_intents'=>'ji','hrm_pay_gl_001_journal_lines'=>'jl','hrm_pay_gl_001_allocations'=>'al','hrm_pay_gl_001_allocation_axes'=>'ax');return isset($m[$t])?$m[$t]:false;}
function pay_gl_001_table_columns($t){if(!hrm_migration_table_exists($t))return false;$q=db_query('SHOW COLUMNS FROM '.TB_PREF.$t);if(!$q)return false;$a=array();while($r=db_fetch_assoc($q))$a[]=(string)$r['Field'];return $a;}
function pay_gl_001_table_innodb($t){$p=hrm_migration_physical_table_name($t);if($p===false)return false;$q=db_query('SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($p));$r=$q?db_fetch_assoc($q):false;return $r&&strcasecmp((string)$r['ENGINE'],'InnoDB')===0;}
function pay_gl_001_trigger_name($t,$op){$p=hrm_migration_active_table_prefix();$c=pay_gl_001_trigger_code($t);if($p===false||$c===false)return false;return $p.'pgl1_'.$c.'_'.(strtoupper($op)==='UPDATE'?'u':'d');}
function pay_gl_001_trigger_valid($t,$op){$name=pay_gl_001_trigger_name($t,$op);$phys=hrm_migration_physical_table_name($t);if($name===false||$phys===false)return false;$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);return strtoupper((string)$r['EVENT_MANIPULATION'])===strtoupper($op)&&(string)$r['EVENT_OBJECT_TABLE']===$phys&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&strpos((string)$r['ACTION_STATEMENT'],'PAY-GL-001 immutable')!==false;}
function pay_gl_001_require_schema($patch){$cols=pay_gl_001_schema_columns();$ix=pay_gl_001_schema_indexes();foreach(pay_gl_001_schema_tables() as $t){if(pay_gl_001_table_columns($t)!==$cols[$t]||!pay_gl_001_table_innodb($t))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-GL-001 table projection mismatch: '.$t);$actual=hrm_migration_index_names($t);if(!is_array($actual))return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-GL-001 index metadata unavailable: '.$t);foreach($ix[$t] as $n)if(!isset($actual[$n]))return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-GL-001 required index missing: '.$t.'.'.$n);foreach(array('UPDATE','DELETE') as $op)if(!pay_gl_001_trigger_valid($t,$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-GL-001 immutable trigger mismatch: '.$t.'.'.$op);}return true;}
function pay_gl_001_install_schema($patch){global $path_to_root;$raw=@file_get_contents($path_to_root.'/sql/upgrade_pay_gl_001_journal_intent_schema.sql');if(!is_string($raw)||strpos($raw,'-- PAY-GL-001 GROUP journal_intent')===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-GL-001 schema source missing.');$p=hrm_migration_active_table_prefix();if($p===false)return false;$raw=preg_replace('/^--.*$/m','',$raw);$stmts=preg_split('/;\s*(?:\r?\n|$)/',$raw);foreach($stmts as $s){$s=trim($s);if($s===''||strpos($s,'--')===0||strpos($s,'CREATE TRIGGER')===0)continue;$s=str_replace('`0_','`'.$p,$s);if(!db_query($s))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-GL-001 schema statement failed.');}foreach(pay_gl_001_schema_tables() as $t)foreach(array('UPDATE','DELETE') as $op){if(pay_gl_001_trigger_valid($t,$op))continue;$name=pay_gl_001_trigger_name($t,$op);$phys=hrm_migration_physical_table_name($t);$msg='PAY-GL-001 immutable '.$t.' row cannot be '.strtolower($op).'d';$sql='CREATE TRIGGER `'.$name.'` BEFORE '.$op.' ON `'.$phys.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape($msg);if(!db_query($sql))return false;}return pay_gl_001_require_schema($patch);}
function pay_gl_001_require_zero_rows($patch){foreach(pay_gl_001_schema_tables() as $t){$q=db_query('SELECT COUNT(*) n FROM '.TB_PREF.$t);$r=$q?db_fetch_assoc($q):false;if(!$r||(int)$r['n']!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-GL-001 foundation must activate zero-seed: '.$t);}return true;}
