<?php
/** PAY-CORE-002 explicit legacy-period mapping, bounded conversion and reconciliation. */
include_once(dirname(__FILE__).'/pay_core_002_governance_db.inc');
function hrm_pay_core_002_legacy_period_source_sha(array $r){$keys=array('period_id','period_name','from_date','to_date','pay_date','department_id','status','total_gross','total_deductions','total_net','total_employer_cost','approved_by','approval_date','gl_trans_no','created_by','created_date','notes');$x=array();foreach($keys as $k){if(!array_key_exists($k,$r))return false;$x[$k]=$r[$k];}return hash('sha256',json_encode($x,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE));}
function hrm_pay_core_002_propose_mapping(array $legacy,array $target,&$error=null){$error=null;$maker=hrm_pay_core_002_actor();if($maker<=0||!hrm_pay_core_002_access('SA_HRM_MANAGE_PAY_CORE')){$error='access_denied';return false;}$source=hrm_pay_core_002_legacy_period_source_sha($legacy);if($source===false||(int)$legacy['period_id']<=0){$error='legacy_source_invalid';return false;}foreach(array('calendar_version_id','group_version_id','legal_entity_id','currency_code','period_key','period_start','period_end','cutoff_date','pay_date','post_date','file_date') as $k)if(!array_key_exists($k,$target)){$error='target_incomplete';return false;}if((int)$target['calendar_version_id']<=0||(int)$target['group_version_id']<=0||(int)$target['legal_entity_id']<=0||hrm_pay_core_002_currency($target['currency_code'])===false||hrm_pay_core_002_token($target['period_key'],80)===false||!hrm_pay_core_002_validate_period_contract(array_merge($target,array('run_type'=>'regular')))){$error='target_invalid';return false;}$aq=db_query('SELECT g.legal_entity_id,gv.calendar_version_id,sx.currency_code FROM '.TB_PREF.'hrm_payroll_group_versions gv INNER JOIN '.TB_PREF.'hrm_payroll_groups g ON g.payroll_group_id=gv.payroll_group_id INNER JOIN '.TB_PREF.'hrm_payroll_seed_executions sx ON sx.group_version_id=gv.group_version_id WHERE gv.group_version_id='.(int)$target['group_version_id'].' LIMIT 2');$a=$aq&&db_num_rows($aq)===1?db_fetch_assoc($aq):false;if(!$a||(int)$a['calendar_version_id']!==(int)$target['calendar_version_id']||(int)$a['legal_entity_id']!==(int)$target['legal_entity_id']||$a['currency_code']!==$target['currency_code']){$error='target_authority_mismatch';return false;}$payload=array('legacy_period_id'=>(int)$legacy['period_id'],'source_period_sha256'=>$source,'calendar_version_id'=>(int)$target['calendar_version_id'],'group_version_id'=>(int)$target['group_version_id'],'legal_entity_id'=>(int)$target['legal_entity_id'],'currency_code'=>$target['currency_code'],'period_key'=>$target['period_key'],'period_start'=>$target['period_start'],'period_end'=>$target['period_end'],'cutoff_date'=>$target['cutoff_date'],'pay_date'=>$target['pay_date'],'post_date'=>$target['post_date'],'file_date'=>$target['file_date'],'maker_id'=>$maker);$h=hrm_pay_core_002_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_payroll_legacy_period_mapping_plans (legacy_period_id,source_period_sha256,calendar_version_id,group_version_id,legal_entity_id,currency_code,period_key,period_start,period_end,cutoff_date,pay_date,post_date,file_date,mapping_plan_sha256,maker_id) VALUES ('.(int)$legacy['period_id'].','.db_escape($source).','.(int)$target['calendar_version_id'].','.(int)$target['group_version_id'].','.(int)$target['legal_entity_id'].','.db_escape($target['currency_code']).','.db_escape($target['period_key']).','.db_escape($target['period_start']).','.db_escape($target['period_end']).','.db_escape($target['cutoff_date']).','.db_escape($target['pay_date']).','.db_escape($target['post_date']).','.db_escape($target['file_date']).','.db_escape($h).','.$maker.')';return hrm_pay_core_002_insert_idempotent('hrm_payroll_legacy_period_mapping_plans','mapping_plan_sha256',$h,$sql,'mapping_plan_id',$error);}
function hrm_pay_core_002_approve_mapping($plan_id,$evidence_sha256,&$error=null){$error=null;$checker=hrm_pay_core_002_actor();$evidence_sha256=hrm_pay_core_002_sha($evidence_sha256);if($checker<=0||!hrm_pay_core_002_access('SA_HRM_REVIEW_PAY_CORE')||$evidence_sha256===false){$error='access_or_evidence_invalid';return false;}$q=db_query('SELECT mapping_plan_sha256,maker_id FROM '.TB_PREF.'hrm_payroll_legacy_period_mapping_plans WHERE mapping_plan_id='.(int)$plan_id.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||(int)$p['maker_id']===$checker){$error='distinct_checker_required';return false;}$h=hrm_pay_core_002_hash(array('mapping_plan_id'=>(int)$plan_id,'mapping_plan_sha256'=>$p['mapping_plan_sha256'],'evidence_sha256'=>$evidence_sha256,'checker_id'=>$checker));$sql='INSERT INTO '.TB_PREF.'hrm_payroll_legacy_period_mapping_approvals (mapping_plan_id,mapping_plan_sha256,evidence_sha256,approval_sha256,checker_id) VALUES ('.(int)$plan_id.','.db_escape($p['mapping_plan_sha256']).','.db_escape($evidence_sha256).','.db_escape($h).','.$checker.')';return hrm_pay_core_002_insert_idempotent('hrm_payroll_legacy_period_mapping_approvals','approval_sha256',$h,$sql,'mapping_approval_id',$error);}
/** Conversion re-hashes the exact locked 17-column legacy row and INSERTs only successor custody. It never UPDATEs/DELETEs payroll_periods. */
function hrm_pay_core_002_execute_mapping($plan_id,&$error=null){$error=null;$executor=hrm_pay_core_002_actor();if($executor<=0||!hrm_pay_core_002_access('SA_HRM_EXECUTE_PAY_CORE')){$error='access_denied';return false;}$q=db_query('SELECT p.*,a.mapping_approval_id,a.approval_sha256,a.checker_id FROM '.TB_PREF.'hrm_payroll_legacy_period_mapping_plans p INNER JOIN '.TB_PREF.'hrm_payroll_legacy_period_mapping_approvals a ON a.mapping_plan_id=p.mapping_plan_id AND a.mapping_plan_sha256=p.mapping_plan_sha256 WHERE p.mapping_plan_id='.(int)$plan_id.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||$executor===(int)$p['maker_id']||$executor===(int)$p['checker_id']){$error='three_party_separation_required';return false;}$q=db_query('SELECT conversion_receipt_id,executor_id FROM '.TB_PREF.'hrm_payroll_legacy_period_conversion_receipts WHERE mapping_plan_id='.(int)$plan_id.' LIMIT 2 FOR UPDATE');if($q&&db_num_rows($q)===1){$x=db_fetch_assoc($q);if((int)$x['executor_id']!==$executor){$error='replay_executor_mismatch';return false;}return (int)$x['conversion_receipt_id'];}
    $fields='period_id,period_name,from_date,to_date,pay_date,department_id,status,total_gross,total_deductions,total_net,total_employer_cost,approved_by,approval_date,gl_trans_no,created_by,created_date,notes';$q=db_query('SELECT '.$fields.' FROM '.TB_PREF.'payroll_periods WHERE period_id='.(int)$p['legacy_period_id'].' LIMIT 2 FOR UPDATE');$legacy=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$legacy||!hash_equals((string)$p['source_period_sha256'],(string)hrm_pay_core_002_legacy_period_source_sha($legacy))){$error='legacy_source_changed';return false;}
    $manage=empty($GLOBALS['transaction_level']);if($manage)begin_transaction();$ok=true;$pid=0;$id=0;
    $ph=hrm_pay_core_002_hash(array('calendar_version_id'=>(int)$p['calendar_version_id'],'period_key'=>$p['period_key'],'period_start'=>$p['period_start'],'period_end'=>$p['period_end'],'cutoff_date'=>$p['cutoff_date'],'pay_date'=>$p['pay_date'],'post_date'=>$p['post_date'],'file_date'=>$p['file_date'],'run_type'=>'regular'));if(!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_calendar_periods (calendar_version_id,period_key,period_start,period_end,cutoff_date,pay_date,post_date,file_date,run_type,period_sha256,created_by) VALUES ('.(int)$p['calendar_version_id'].','.db_escape($p['period_key']).','.db_escape($p['period_start']).','.db_escape($p['period_end']).','.db_escape($p['cutoff_date']).','.db_escape($p['pay_date']).','.db_escape($p['post_date']).','.db_escape($p['file_date']).",'regular',".db_escape($ph).','.$executor.')')){$ok=false;$error='target_period_insert_failed';}else{$pid=(int)db_insert_id();}
    $h=$ok?hrm_pay_core_002_hash(array('mapping_plan_sha256'=>$p['mapping_plan_sha256'],'approval_sha256'=>$p['approval_sha256'],'source_period_sha256'=>$p['source_period_sha256'],'calendar_period_id'=>$pid,'executor_id'=>$executor)):false;if($ok&&!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_legacy_period_conversion_receipts (mapping_plan_id,mapping_approval_id,legacy_period_id,source_period_sha256,calendar_period_id,conversion_sha256,executor_id) VALUES ('.(int)$plan_id.','.(int)$p['mapping_approval_id'].','.(int)$p['legacy_period_id'].','.db_escape($p['source_period_sha256']).','.$pid.','.db_escape($h).','.$executor.')')){$ok=false;$error='conversion_receipt_failed';}else if($ok){$id=(int)db_insert_id();}
    if($manage){if($ok)commit_transaction();else cancel_transaction();}return $ok?$id:false;}
function hrm_pay_core_002_reconcile_mapping($receipt_id,$evidence_sha256,&$error=null){$error=null;$reviewer=hrm_pay_core_002_actor();$evidence_sha256=hrm_pay_core_002_sha($evidence_sha256);if($reviewer<=0||!hrm_pay_core_002_access('SA_HRM_REVIEW_PAY_CORE')||$evidence_sha256===false){$error='access_or_evidence_invalid';return false;}$q=db_query('SELECT r.*,p.period_sha256 FROM '.TB_PREF.'hrm_payroll_legacy_period_conversion_receipts r INNER JOIN '.TB_PREF.'hrm_payroll_calendar_periods p ON p.calendar_period_id=r.calendar_period_id WHERE r.conversion_receipt_id='.(int)$receipt_id.' LIMIT 2');$r=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$r||$reviewer===(int)$r['executor_id']){$error='distinct_reviewer_required';return false;}$h=hrm_pay_core_002_hash(array('conversion_receipt_id'=>(int)$receipt_id,'source_period_sha256'=>$r['source_period_sha256'],'target_period_sha256'=>$r['period_sha256'],'status_token'=>'reconciled','evidence_sha256'=>$evidence_sha256,'reviewer_id'=>$reviewer));$sql='INSERT INTO '.TB_PREF.'hrm_payroll_legacy_period_reconciliations (conversion_receipt_id,legacy_period_id,source_period_sha256,target_period_sha256,status_token,evidence_sha256,reconciliation_sha256,reviewer_id) VALUES ('.(int)$receipt_id.','.(int)$r['legacy_period_id'].','.db_escape($r['source_period_sha256']).','.db_escape($r['period_sha256']).",'reconciled',".db_escape($evidence_sha256).','.db_escape($h).','.$reviewer.')';return hrm_pay_core_002_insert_idempotent('hrm_payroll_legacy_period_reconciliations','reconciliation_sha256',$h,$sql,'reconciliation_id',$error);}
