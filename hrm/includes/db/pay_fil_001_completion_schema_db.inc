function pay_fil_001_completion_trigger_valid($t,$op){$p=hrm_migration_active_table_prefix();$c=pay_fil_001_completion_trigger_code($t);$phys=hrm_migration_physical_table_name($t);if($p===false||$c===false||$phys===false)return false;$name=$p.'pfl1_'.$c.'_'.(strtoupper($op)==='UPDATE'?'u':'d');$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);return strtoupper((string)$r['EVENT_MANIPULATION'])===strtoupper($op)&&(string)$r['EVENT_OBJECT_TABLE']===$phys&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&strpos((string)$r['ACTION_STATEMENT'],'PAY-FIL-001 immutable')!==false;}
function pay_fil_001_completion_require_table($patch,$t,$cols){if(pay_fil_001_table_columns($t)!==$cols||!pay_fil_001_table_innodb($t))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-FIL-001 completion table projection mismatch: '.$t);$specs=pay_fil_001_completion_index_specs();$actual=pay_fil_001_table_index_projection($t);$want=$specs[$t];ksort($want,SORT_STRING);if(!is_array($actual)||$actual!==$want)return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-FIL-001 completion exact index projection mismatch: '.$t);$fks=pay_fil_001_completion_foreign_keys();$actual_fk=pay_fil_001_table_foreign_key_projection($t);$want_fk=$fks[$t];$prefix=hrm_migration_active_table_prefix();if($prefix===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-FIL-001 completion table prefix unavailable.');foreach($want_fk as $name=>$spec)$want_fk[$name]['referenced_table']=$prefix.$spec['referenced_table'];ksort($want_fk,SORT_STRING);if(!is_array($actual_fk)||$actual_fk!==$want_fk)return hrm_migration_fail($patch,HRM_MIGRATION_FK_MISMATCH,'PAY-FIL-001 completion exact foreign-key projection mismatch: '.$t);foreach(array('UPDATE','DELETE') as $op)if(!pay_fil_001_completion_trigger_valid($t,$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-FIL-001 completion immutable trigger mismatch: '.$t.'.'.$op);return true;}
function pay_fil_001_completion_require_groups($patch,array $names){if(!pay_fil_001_require_schema($patch))return false;$groups=pay_fil_001_completion_groups();foreach($names as $name){if(!isset($groups[$name]))return false;foreach($groups[$name]['tables'] as $t=>$cols)if(!pay_fil_001_completion_require_table($patch,$t,$cols))return false;}return true;}
function pay_fil_001_completion_install_group($patch,$name){global $path_to_root;$groups=pay_fil_001_completion_groups();if(!isset($groups[$name]))return false;$raw=@file_get_contents($path_to_root.'/'.$groups[$name]['sql']);if(!is_string($raw)||strpos($raw,'-- PAY-FIL-001 GROUP '.$name)===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-FIL-001 completion schema source missing: '.$name);$p=hrm_migration_active_table_prefix();if($p===false)return false;$raw=preg_replace('/^--.*$/m','',$raw);$stmts=preg_split('/;\s*(?:\r?\n|$)/',$raw);foreach($stmts as $s){$s=trim($s);if($s===''||strpos($s,'CREATE TRIGGER')===0)continue;$s=str_replace('`0_','`'.$p,$s);if(!db_query($s))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-FIL-001 completion schema statement failed: '.$name);}foreach($groups[$name]['tables'] as $t=>$cols)foreach(array('UPDATE','DELETE') as $op){if(pay_fil_001_completion_trigger_valid($t,$op))continue;$code=pay_fil_001_completion_trigger_code($t);$tn=$p.'pfl1_'.$code.'_'.($op==='UPDATE'?'u':'d');$phys=hrm_migration_physical_table_name($t);$msg='PAY-FIL-001 immutable '.$t.' row cannot be '.strtolower($op).'d';$sql='CREATE TRIGGER `'.$tn.'` BEFORE '.$op.' ON `'.$phys.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape($msg);if(!db_query($sql))return false;}return pay_fil_001_completion_require_groups($patch,array($name));}
