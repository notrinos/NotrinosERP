function hrm_ben_001_append_contribution_version(array $x,&$error=null){$error=null;$a=hrm_ben_001_actor();foreach(array('plan_version_id','effective_from','currency_code','unit_code','calculation_kind','employee_fixed_amount','employer_fixed_amount','rounding_contract_sha256','source_evidence_sha256') as $k)if(!isset($x[$k])){$error='contribution_field_missing';return false;}$from=hrm_ben_001_date($x['effective_from']);$to=empty($x['effective_to'])?null:hrm_ben_001_date($x['effective_to']);$cost=hrm_ben_001_cost($x);if($a<=0||!hrm_ben_001_access('SA_HRM_EXECUTE_BENEFIT_COSTING')||(int)$x['plan_version_id']<=0||$from===false||($to!==null&&($to===false||$to<$from))||$x['calculation_kind']!=='fixed_amount'||$cost===false||hrm_ben_001_sha256($x['rounding_contract_sha256'])===false||hrm_ben_001_sha256($x['source_evidence_sha256'])===false){$error='contribution_invalid_or_unauthorized';return false;}$pred=empty($x['predecessor_contribution_version_id'])?null:(int)$x['predecessor_contribution_version_id'];$adapter=empty($x['costing_adapter_version_id'])?null:(int)$x['costing_adapter_version_id'];$p=array('plan_version_id'=>(int)$x['plan_version_id'],'effective_from'=>$from,'effective_to'=>$to,'currency_code'=>$cost['currency_code'],'unit_code'=>$cost['unit_code'],'calculation_kind'=>'fixed_amount','employee_fixed_amount'=>$cost['employee_amount'],'employer_fixed_amount'=>$cost['employer_amount'],'costing_adapter_version_id'=>$adapter,'rounding_contract_sha256'=>strtolower($x['rounding_contract_sha256']),'source_evidence_sha256'=>strtolower($x['source_evidence_sha256']),'predecessor_contribution_version_id'=>$pred);$sha=hrm_ben_001_hash($p);begin_transaction();$q=db_query('SELECT contribution_version_id FROM '.TB_PREF.'hrm_ben_contribution_versions WHERE plan_version_id='.$p['plan_version_id'].' AND effective_from='.db_escape($from).' LIMIT 1 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='contribution_effective_date_conflict';return false;}if($pred!==null){$q=db_query('SELECT plan_version_id,effective_from FROM '.TB_PREF.'hrm_ben_contribution_versions WHERE contribution_version_id='.$pred.' LIMIT 2 FOR UPDATE');$old=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$old||(int)$old['plan_version_id']!==$p['plan_version_id']||$from<=(string)$old['effective_from']){cancel_transaction();$error='contribution_predecessor_scope_or_order_mismatch';return false;}}$sql='INSERT INTO '.TB_PREF.'hrm_ben_contribution_versions (plan_version_id,effective_from,effective_to,currency_code,unit_code,calculation_kind,employee_fixed_amount,employer_fixed_amount,costing_adapter_version_id,rounding_contract_sha256,source_evidence_sha256,predecessor_contribution_version_id,contribution_sha256,created_by) VALUES ('.$p['plan_version_id'].','.db_escape($from).','.($to===null?'NULL':db_escape($to)).','.db_escape($p['currency_code']).','.db_escape($p['unit_code']).',\'fixed_amount\','.db_escape($p['employee_fixed_amount']).','.db_escape($p['employer_fixed_amount']).','.($adapter===null?'NULL':$adapter).','.db_escape($p['rounding_contract_sha256']).','.db_escape($p['source_evidence_sha256']).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_contribution_versions','contribution_version_id','contribution_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('contribution_version_id'=>$id,'contribution_sha256'=>$sha);}
function hrm_ben_001_create_contribution_receipt($enrollment_id,$start,$end,$effective_date,$idempotency_key,&$error=null){$error=null;$a=hrm_ben_001_actor();$s=hrm_ben_001_date($start);$e=hrm_ben_001_date($end);$d=hrm_ben_001_date($effective_date);$idem=hrm_ben_001_token($idempotency_key,160);if($a<=0||!hrm_ben_001_access('SA_HRM_EXECUTE_BENEFIT_COSTING')||(int)$enrollment_id<=0||$s===false||$e===false||$e<$s||$d===false||$idem===false){$error='contribution_receipt_invalid_or_unauthorized';return false;}begin_transaction();$q=db_query('SELECT * FROM '.TB_PREF.'hrm_ben_enrollments WHERE enrollment_id='.(int)$enrollment_id.' AND enrollment_state=\'enrolled\' AND effective_from<='.db_escape($d).' AND (effective_to IS NULL OR effective_to>='.db_escape($d).') LIMIT 2 FOR UPDATE');$en=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$en){cancel_transaction();$error='active_enrollment_missing';return false;}$q=db_query('SELECT * FROM '.TB_PREF.'hrm_ben_contribution_versions WHERE plan_version_id='.(int)$en['plan_version_id'].' AND effective_from<='.db_escape($d).' AND (effective_to IS NULL OR effective_to>='.db_escape($d).') ORDER BY effective_from DESC LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)<1){cancel_transaction();$error='contribution_version_missing';return false;}$cv=db_fetch_assoc($q);if(db_num_rows($q)===2){$n=db_fetch_assoc($q);if($n['effective_from']===$cv['effective_from']){cancel_transaction();$error='contribution_version_ambiguous';return false;}}$cost=hrm_ben_001_cost($cv);if($cost===false){cancel_transaction();$error='contribution_cost_invalid';return false;}$source=hrm_ben_001_hash(array('enrollment_sha256'=>$en['enrollment_sha256'],'contribution_sha256'=>$cv['contribution_sha256'],'coverage_period_start'=>$s,'coverage_period_end'=>$e,'effective_date'=>$d));$ih=hash('sha256',$idem);$p=array('enrollment_id'=>(int)$enrollment_id,'contribution_version_id'=>(int)$cv['contribution_version_id'],'coverage_period_start'=>$s,'coverage_period_end'=>$e,'effective_date'=>$d,'employee_amount'=>$cost['employee_amount'],'employer_amount'=>$cost['employer_amount'],'currency_code'=>$cost['currency_code'],'unit_code'=>$cost['unit_code'],'source_sha256'=>$source,'idempotency_hash'=>$ih);$sha=hrm_ben_001_hash($p);$sql='INSERT INTO '.TB_PREF.'hrm_ben_contribution_receipts (enrollment_id,contribution_version_id,coverage_period_start,coverage_period_end,effective_date,employee_amount,employer_amount,currency_code,unit_code,source_sha256,idempotency_hash,receipt_sha256,created_by) VALUES ('.(int)$enrollment_id.','.(int)$cv['contribution_version_id'].','.db_escape($s).','.db_escape($e).','.db_escape($d).','.db_escape($cost['employee_amount']).','.db_escape($cost['employer_amount']).','.db_escape($cost['currency_code']).','.db_escape($cost['unit_code']).','.db_escape($source).','.db_escape($ih).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_contribution_receipts','contribution_receipt_id','receipt_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('contribution_receipt_id'=>$id,'receipt_sha256'=>$sha,'employee_amount'=>$cost['employee_amount'],'employer_amount'=>$cost['employer_amount'],'currency_code'=>$cost['currency_code'],'unit_code'=>$cost['unit_code']);}
function hrm_ben_001_open_arrears($receipt_id,$portion_code,$reason_code,$source_obligation_sha256,&$error=null){$error=null;$a=hrm_ben_001_actor();if($a<=0||!hrm_ben_001_access('SA_HRM_EXECUTE_BENEFIT_COSTING')||!in_array($portion_code,array('employee','employer'),true)||hrm_ben_001_token($reason_code,64)===false||hrm_ben_001_sha256($source_obligation_sha256)===false){$error='arrears_invalid_or_unauthorized';return false;}begin_transaction();$q=db_query('SELECT * FROM '.TB_PREF.'hrm_ben_contribution_receipts WHERE contribution_receipt_id='.(int)$receipt_id.' LIMIT 2 FOR UPDATE');$r=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$r){cancel_transaction();$error='receipt_missing';return false;}$amount=$portion_code==='employee'?$r['employee_amount']:$r['employer_amount'];$p=array('contribution_receipt_id'=>(int)$receipt_id,'portion_code'=>$portion_code,'period_start'=>$r['coverage_period_start'],'period_end'=>$r['coverage_period_end'],'amount'=>hrm_ben_001_decimal($amount),'currency_code'=>$r['currency_code'],'unit_code'=>$r['unit_code'],'reason_code'=>$reason_code,'source_obligation_sha256'=>strtolower($source_obligation_sha256));$sha=hrm_ben_001_hash($p);$sql='INSERT INTO '.TB_PREF.'hrm_ben_arrears (contribution_receipt_id,portion_code,period_start,period_end,amount,currency_code,unit_code,reason_code,source_obligation_sha256,obligation_sha256,created_by) VALUES ('.$p['contribution_receipt_id'].','.db_escape($portion_code).','.db_escape($p['period_start']).','.db_escape($p['period_end']).','.db_escape($p['amount']).','.db_escape($p['currency_code']).','.db_escape($p['unit_code']).','.db_escape($reason_code).','.db_escape($p['source_obligation_sha256']).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_arrears','arrears_id','obligation_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('arrears_id'=>$id,'obligation_sha256'=>$sha,'amount'=>$p['amount']);}
function hrm_ben_001_arrears_outstanding($arrears_id,&$error=null){$error=null;$q=db_query('SELECT amount FROM '.TB_PREF.'hrm_ben_arrears WHERE arrears_id='.(int)$arrears_id.' LIMIT 2');$a=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$a){$error='arrears_missing';return false;}$n=hrm_ben_001_micros($a['amount']);$q=db_query('SELECT movement_kind,amount FROM '.TB_PREF.'hrm_ben_arrears_movements WHERE arrears_id='.(int)$arrears_id.' ORDER BY arrears_movement_id');if(!$q){$error='arrears_movements_unreadable';return false;}while($m=db_fetch_assoc($q)){$v=hrm_ben_001_micros($m['amount']);if($v===false){$error='arrears_movement_amount_invalid';return false;}$n+=($m['movement_kind']==='increase'||$m['movement_kind']==='recovery_reversal')?$v:-$v;}return hrm_ben_001_decimal_from_micros($n);}
function hrm_ben_001_append_arrears_movement($arrears_id,$kind,$amount,$effective_date,$source_sha256,$predecessor=null,&$error=null){$error=null;$a=hrm_ben_001_actor();$d=hrm_ben_001_date($effective_date);$v=hrm_ben_001_decimal($amount);if($a<=0||!hrm_ben_001_access('SA_HRM_EXECUTE_BENEFIT_COSTING')||!in_array($kind,array('increase','recovery','settlement','recovery_reversal'),true)||$d===false||$v===false||hrm_ben_001_decimal_compare($v,'0')<=0||hrm_ben_001_sha256($source_sha256)===false){$error='arrears_movement_invalid_or_unauthorized';return false;}begin_transaction();$q=db_query('SELECT * FROM '.TB_PREF.'hrm_ben_arrears WHERE arrears_id='.(int)$arrears_id.' LIMIT 2 FOR UPDATE');$arr=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$arr){cancel_transaction();$error='arrears_missing';return false;}$pred=$predecessor? (int)$predecessor:null;if($kind==='recovery_reversal'){if($pred===null){cancel_transaction();$error='reversal_predecessor_required';return false;}$q=db_query('SELECT arrears_id,movement_kind,amount FROM '.TB_PREF.'hrm_ben_arrears_movements WHERE arrears_movement_id='.$pred.' LIMIT 2 FOR UPDATE');$old=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$old||(int)$old['arrears_id']!==(int)$arrears_id||!in_array($old['movement_kind'],array('recovery','settlement'),true)||hrm_ben_001_decimal_compare($old['amount'],$v)!==0){cancel_transaction();$error='reversal_predecessor_mismatch';return false;}}elseif($pred!==null){cancel_transaction();$error='predecessor_only_allowed_for_reversal';return false;}$out=hrm_ben_001_arrears_outstanding($arrears_id,$error);if($out===false){cancel_transaction();return false;}if(in_array($kind,array('recovery','settlement'),true)&&hrm_ben_001_decimal_compare($v,$out)>0){cancel_transaction();$error='arrears_recovery_exceeds_outstanding';return false;}$p=array('arrears_id'=>(int)$arrears_id,'movement_kind'=>$kind,'amount'=>$v,'effective_date'=>$d,'source_sha256'=>strtolower($source_sha256),'predecessor_movement_id'=>$pred);$sha=hrm_ben_001_hash($p);$sql='INSERT INTO '.TB_PREF.'hrm_ben_arrears_movements (arrears_id,movement_kind,amount,effective_date,source_sha256,payroll_handoff_id,predecessor_movement_id,movement_sha256,created_by) VALUES ('.(int)$arrears_id.','.db_escape($kind).','.db_escape($v).','.db_escape($d).','.db_escape(strtolower($source_sha256)).',NULL,'.($pred===null?'NULL':$pred).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_arrears_movements','arrears_movement_id','movement_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('arrears_movement_id'=>$id,'movement_sha256'=>$sha);}
function hrm_ben_001_append_continuation(array $x,&$error=null){$error=null;$a=hrm_ben_001_actor();foreach(array('enrollment_id','pack_adapter_version_id','effective_from','effective_to','status_change_evidence_sha256','entitlement_evidence_sha256') as $k)if(!isset($x[$k])){$error='continuation_field_missing';return false;}$f=hrm_ben_001_date($x['effective_from']);$t=hrm_ben_001_date($x['effective_to']);if($a<=0||!hrm_ben_001_access('SA_HRM_MANAGE_BENEFITS')||(int)$x['enrollment_id']<=0||(int)$x['pack_adapter_version_id']<=0||$f===false||$t===false||$t<$f||hrm_ben_001_sha256($x['status_change_evidence_sha256'])===false||hrm_ben_001_sha256($x['entitlement_evidence_sha256'])===false){$error='continuation_invalid_or_unauthorized';return false;}$pred=empty($x['predecessor_continuation_id'])?null:(int)$x['predecessor_continuation_id'];$p=array('enrollment_id'=>(int)$x['enrollment_id'],'pack_adapter_version_id'=>(int)$x['pack_adapter_version_id'],'effective_from'=>$f,'effective_to'=>$t,'status_change_evidence_sha256'=>strtolower($x['status_change_evidence_sha256']),'entitlement_evidence_sha256'=>strtolower($x['entitlement_evidence_sha256']),'predecessor_continuation_id'=>$pred);$sha=hrm_ben_001_hash($p);begin_transaction();$q=db_query('SELECT pack_adapter_version_id FROM '.TB_PREF.'hrm_ben_pack_adapter_versions WHERE pack_adapter_version_id='.(int)$x['pack_adapter_version_id'].' AND effective_from<='.db_escape($f).' AND (effective_to IS NULL OR effective_to>='.db_escape($f).') LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)!==1){cancel_transaction();$error='continuation_pack_configuration_missing';return false;}$sql='INSERT INTO '.TB_PREF.'hrm_ben_continuations (enrollment_id,pack_adapter_version_id,effective_from,effective_to,status_change_evidence_sha256,entitlement_evidence_sha256,predecessor_continuation_id,continuation_sha256,created_by) VALUES ('.$p['enrollment_id'].','.$p['pack_adapter_version_id'].','.db_escape($f).','.db_escape($t).','.db_escape($p['status_change_evidence_sha256']).','.db_escape($p['entitlement_evidence_sha256']).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_continuations','continuation_id','continuation_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('continuation_id'=>$id,'continuation_sha256'=>$sha);}
