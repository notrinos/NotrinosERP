function hrm_pay_core_009_require_schema($patch,$include_events=true){$expected=$include_events?hrm_pay_core_009_all_columns():hrm_pay_core_009_state_columns();$indexes=hrm_pay_core_009_required_indexes();foreach($expected as $table=>$cols){if(hrm_pay_core_009_schema_columns($table)!==$cols||!hrm_pay_core_009_schema_engine_innodb($table))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CORE-009 custody schema mismatch for '.$table.'.');$actual=hrm_migration_index_names($table);if(!is_array($actual))return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-CORE-009 index metadata unavailable for '.$table.'.');foreach($indexes[$table] as $name)if(!isset($actual[$name]))return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-CORE-009 required index '.$name.' missing on '.$table.'.');}if($include_events)foreach(hrm_pay_core_009_trigger_codes() as $table=>$code)foreach(array('UPDATE','DELETE') as $op)if(!hrm_pay_core_009_trigger_exists($table,$code,$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-CORE-009 immutable denial trigger missing for '.$table.' '.$op.'.');return true;}
