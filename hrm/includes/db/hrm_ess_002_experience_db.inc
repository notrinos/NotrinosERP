function hrm_ess_002_self_benefits($as_of=null){$c=get_hrm_ess_002_current_self_context($as_of);if(!$c)return false;$d=db_escape($c['as_of']);$sql='SELECT p.plan_id,p.plan_code,pv.plan_version_id,pv.version_token,pv.coverage_basis_code,e.enrollment_id,e.enrollment_state,e.effective_from,e.effective_to FROM '.TB_PREF.'hrm_ben_plans p INNER JOIN '.TB_PREF.'hrm_ben_plan_versions pv ON pv.plan_id=p.plan_id AND pv.effective_from<='.$d.' AND (pv.effective_to IS NULL OR pv.effective_to>='.$d.') LEFT JOIN '.TB_PREF.'hrm_ben_enrollments e ON e.plan_id=p.plan_id AND e.worker_id='.(int)$c['worker_id'].' AND e.assignment_id='.(int)$c['assignment_id'].' AND e.effective_from<='.$d.' AND (e.effective_to IS NULL OR e.effective_to>='.$d.') WHERE p.legal_entity_id='.(int)$c['legal_entity_id'].' AND pv.status_token=\'active\' ORDER BY p.plan_code,pv.plan_version_id DESC';$rows=hrm_ess_002_rows(db_query($sql,'could not read ESS benefits'));if(!is_array($rows))return false;$scope_error=null;$scope=hrm_ben_001_resolve_assignment_scope((int)$c['assignment_id'],$c['as_of'],false,$scope_error);if($scope===false)return array();$eligible=array();foreach($rows as $row){$error=null;$version=hrm_ben_001_resolve_plan_version((int)$row['plan_id'],$c['as_of'],false,$error);if($version===false||(int)$version['plan_version_id']!==(int)$row['plan_version_id']||(int)$version['legal_entity_id']!==(int)$c['legal_entity_id'])continue;$elig=hrm_ben_001_resolve_eligibility($scope,(int)$version['plan_version_id'],$c['as_of'],false,$error);if($elig===false)continue;$windows=hrm_ess_002_self_benefit_windows((int)$row['plan_id'],$c['as_of'],(int)$version['plan_version_id']);if((is_array($windows)&&count($windows)>0)||!empty($row['enrollment_id']))$eligible[]=$row;}return $eligible;}
function hrm_ess_002_self_benefit_windows($plan_id,$as_of=null,$plan_version_id=null){$c=get_hrm_ess_002_current_self_context($as_of);if(!$c)return false;$d=db_escape($c['as_of']);$version_sql=(int)$plan_version_id>0?' AND pv.plan_version_id='.(int)$plan_version_id:'';$sql='SELECT w.window_id,w.plan_version_id,w.window_code,w.window_start,w.window_end,w.qualifying_basis_code FROM '.TB_PREF.'hrm_ben_enrollment_windows w INNER JOIN '.TB_PREF.'hrm_ben_plan_versions pv ON pv.plan_version_id=w.plan_version_id INNER JOIN '.TB_PREF.'hrm_ben_plans p ON p.plan_id=pv.plan_id WHERE p.plan_id='.(int)$plan_id.' AND p.legal_entity_id='.(int)$c['legal_entity_id'].' AND pv.status_token=\'active\' AND pv.effective_from<='.$d.' AND (pv.effective_to IS NULL OR pv.effective_to>='.$d.')'.$version_sql.' AND w.window_start<='.$d.' AND w.window_end>='.$d.' ORDER BY w.window_id';return hrm_ess_002_rows(db_query($sql,'could not read ESS benefit windows'));}
function hrm_ess_002_self_payslips($from=null,$to=null,$as_of=null){$c=get_hrm_ess_002_current_self_context($as_of);if(!$c||!hrm_ess_002_access('SA_HRM_ESS_VIEW_PAY'))return false;return hrm_ess_002_rows(get_payslips_for_employee((string)$c['employee_id'],$from,$to));}
function hrm_ess_002_self_documents($as_of=null){$c=get_hrm_ess_002_current_self_context($as_of);if(!$c||!hrm_ess_002_access('SA_HRM_ESS_VIEW_DOCUMENTS'))return false;$q=get_employee_documents((string)$c['employee_id']);$rows=hrm_ess_002_rows($q);if($rows===false)return false;$out=array();foreach($rows as $row){if(empty($row['access_key']))continue;$out[]=array('doc_id'=>$row['doc_id'],'doc_name'=>$row['doc_name'],'type_name'=>isset($row['type_name'])?$row['type_name']:'','expiry_date'=>isset($row['expiry_date'])?$row['expiry_date']:'','access_key'=>$row['access_key'],'has_attachment'=>!empty($row['attachment_id']));}return $out;}
function hrm_ess_002_self_notifications(){if(!hrm_ess_002_access('SA_HRM_ESS_VIEW_SELF'))return false;$actor=hrm_ess_002_actor_id();if($actor<=0)return false;$sql='SELECT n.id,n.draft_id,n.notification_type,n.is_read,n.created_date,d.trans_type,d.reference FROM '.TB_PREF.'approval_notifications n INNER JOIN '.TB_PREF.'approval_drafts d ON d.id=n.draft_id WHERE n.user_id='.$actor.' ORDER BY n.created_date DESC,n.id DESC LIMIT 100';return hrm_ess_002_rows(db_query($sql,'could not read ESS action inbox'));}
function hrm_ess_002_submit_overtime($overtime_id,$date,$hours,$reason,$nonce,&$error=null){
 $error=null;if(!hrm_ess_002_access('SA_HRM_ESS_REQUEST_TIME')){$error='overtime_request_unauthorized';return false;}
 $date=hrm_ess_002_date($date);$hours=(float)$hours;$reason=trim(strip_tags((string)$reason));
 if($date===false||(int)$overtime_id<=0||$hours<=0||$hours>24||$reason===''||strlen($reason)>255||!hrm_ess_002_action_nonce_format_valid($nonce)){$error='overtime_request_invalid';return false;}
 $c=get_hrm_ess_002_current_self_context($date);if(!$c){$error='overtime_assignment_scope_ambiguous';return false;}
 $payload=array('overtime_id'=>(int)$overtime_id,'date'=>$date,'hours'=>$hours,'reason'=>$reason);$m=hrm_ess_002_receipt_material('overtime',$c,$payload,$nonce);if($m===false){$error='overtime_idempotency_invalid';return false;}
 begin_transaction();$replay=hrm_ess_002_receipt_replay($m,$error);if($replay===false){cancel_transaction();return false;}if(is_array($replay)){commit_transaction();return $replay;}
 if(!hrm_ess_002_consume_action_nonce('overtime',$nonce)){cancel_transaction();$error='overtime_request_unauthorized_or_replayed';return false;}
 $type_table=overtime_type_table();$type_q=db_query('SELECT overtime_id FROM '.TB_PREF.$type_table.' WHERE overtime_id='.(int)$overtime_id.' AND inactive=0 LIMIT 2 FOR UPDATE');if(!$type_q||db_num_rows($type_q)!==1){cancel_transaction();$error='overtime_type_missing_or_inactive';return false;}
 $request_id=add_overtime_request($c['employee_id'],(int)$overtime_id,$date,$hours,$reason);if($request_id<=0){cancel_transaction();$error='overtime_insert_failed';return false;}
 $draft_data=$payload+array('request_id'=>$request_id,'employee_id'=>$c['employee_id']);$row=get_overtime_request($request_id);if($row){$draft_data['employee_name']=$row['employee_name'];$draft_data['overtime_name']=$row['overtime_name'];}$svc=get_approval_workflow_service();$ar=$svc->isApprovalRequired(ST_OVERTIME_REQUEST,$hours)?$svc->submit(ST_OVERTIME_REQUEST,$draft_data,$hours,array('summary'=>sprintf(_('Overtime: %s, %.1f hours'),$date,$hours))):false;if($ar!==false&&$ar['status']!=='pending'&&$ar['status']!=='auto_approved'){cancel_transaction();$error='overtime_workflow_submit_failed';return false;}if($ar===false&&execute_approved_overtime_request($draft_data,0,0)===false){cancel_transaction();$error='overtime_direct_execution_failed';return false;}$result=array('request_id'=>$request_id,'workflow_status'=>$ar===false?'auto_approved':$ar['status'],'draft_id'=>isset($ar['draft_id'])?$ar['draft_id']:null);if(!hrm_ess_002_receipt_record($m,$c,$result,$error)){cancel_transaction();return false;}commit_transaction();return $result;
}
function hrm_ess_002_submit_leave($leave_id,$from,$to,$half_day,$reason,$nonce,&$error=null){
 $error=null;if(!hrm_ess_002_access('SA_HRM_ESS_REQUEST_LEAVE')){$error='leave_request_unauthorized';return false;}
 $half_day_raw=is_int($half_day)?(string)$half_day:(is_string($half_day)?$half_day:'');if(!preg_match('/^(0|1|2)$/D',$half_day_raw)){$error='leave_request_invalid';return false;}$half_day=(int)$half_day;
 $from=hrm_ess_002_date($from);$to=hrm_ess_002_date($to);$reason=trim(strip_tags((string)$reason));if($from===false||$to===false||$to<$from||($half_day!==0&&$from!==$to)||strlen($reason)>1000||!hrm_ess_002_action_nonce_format_valid($nonce)){$error='leave_request_invalid';return false;}
 $c=get_hrm_ess_002_current_self_context($from);$end=get_hrm_ess_002_current_self_context($to);if(!$c||!$end||(int)$c['assignment_id']!==(int)$end['assignment_id']||(int)$c['employment_id']!==(int)$end['employment_id']||(int)$c['legal_entity_id']!==(int)$end['legal_entity_id']){$error='leave_range_scope_changed_or_ambiguous';return false;}
 $days=(strtotime($to)-strtotime($from))/86400+1;if($half_day!==0)$days=.5;$payload=array('leave_id'=>(int)$leave_id,'from'=>$from,'to'=>$to,'days'=>$days,'half_day'=>$half_day,'reason'=>$reason);$m=hrm_ess_002_receipt_material('leave',$c,$payload,$nonce);if($m===false){$error='leave_idempotency_invalid';return false;}
 begin_transaction();$replay=hrm_ess_002_receipt_replay($m,$error);if($replay===false){cancel_transaction();return false;}if(is_array($replay)){commit_transaction();return $replay;}if(!hrm_ess_002_consume_action_nonce('leave',$nonce)){cancel_transaction();$error='leave_request_unauthorized_or_replayed';return false;}
 $request_id=add_leave_request($c['employee_id'],(int)$leave_id,$from,$to,$days,$half_day,$reason);$le=null;if($request_id<=0||hrm_lve_001_reserve_request($request_id,$le)===false){cancel_transaction();$error=$le?:'leave_reservation_failed';return false;}$draft_data=array('request_id'=>$request_id,'employee_id'=>$c['employee_id'],'leave_id'=>(int)$leave_id,'from_date'=>$from,'to_date'=>$to,'days'=>$days,'half_day'=>$half_day,'reason'=>$reason);$row=get_leave_request($request_id);if($row){$draft_data['employee_name']=$row['employee_name'];$draft_data['leave_name']=$row['leave_name'];}$svc=get_approval_workflow_service();$ar=$svc->isApprovalRequired(ST_LEAVE_REQUEST,$days)?$svc->submit(ST_LEAVE_REQUEST,$draft_data,$days,array('summary'=>sprintf(_('Leave: %s, %s days'),$from,$days))):false;if($ar!==false&&$ar['status']!=='pending'&&$ar['status']!=='auto_approved'){cancel_transaction();$error='leave_workflow_submit_failed';return false;}if($ar===false&&execute_approved_leave_request($draft_data,0,0)===false){cancel_transaction();$error='leave_direct_execution_failed';return false;}$result=array('request_id'=>$request_id,'workflow_status'=>$ar===false?'auto_approved':$ar['status'],'draft_id'=>isset($ar['draft_id'])?$ar['draft_id']:null);if(!hrm_ess_002_receipt_record($m,$c,$result,$error)){cancel_transaction();return false;}commit_transaction();return $result;
}
function hrm_ess_002_submit_benefit($plan_id,$window_id,$state,$basis,$evidence_sha,$nonce,&$error=null){
 $error=null;if(!hrm_ess_002_access('SA_HRM_ESS_ENROLL_BENEFITS')||!hrm_ess_002_access('SA_HRM_ENROLL_BENEFITS')){$error='benefit_request_unauthorized';return false;}$c=get_hrm_ess_002_current_self_context();$state=(string)$state;$basis=hrm_ess_002_token($basis,64);$evidence=hrm_ess_002_sha256($evidence_sha);if(!$c||(int)$plan_id<=0||(int)$window_id<=0||!in_array($state,array('enrolled','waived'),true)||$basis===false||$evidence===false||!hrm_ess_002_action_nonce_format_valid($nonce)){$error='benefit_request_invalid';return false;}
 $payload=array('plan_id'=>(int)$plan_id,'window_id'=>(int)$window_id,'state'=>$state,'basis'=>$basis,'evidence'=>$evidence);$m=hrm_ess_002_receipt_material('benefit',$c,$payload,$nonce);if($m===false){$error='benefit_idempotency_invalid';return false;}
 begin_transaction();$replay=hrm_ess_002_receipt_replay($m,$error);if($replay===false){cancel_transaction();return false;}if(is_array($replay)){commit_transaction();return $replay;}if(!hrm_ess_002_consume_action_nonce('benefit',$nonce)){cancel_transaction();$error='benefit_request_unauthorized_or_replayed';return false;}
 $r=hrm_ben_001_enroll(array('assignment_id'=>$c['assignment_id'],'plan_id'=>(int)$plan_id,'effective_from'=>$c['as_of'],'window_id'=>(int)$window_id,'enrollment_state'=>$state,'qualifying_basis_code'=>$basis,'election_evidence_sha256'=>$evidence,'idempotency_key'=>'ess2:'.$m['idempotency_hash']),$error);if($r===false){cancel_transaction();return false;}$result=array('enrollment_id'=>(int)$r['enrollment_id'],'enrollment_sha256'=>isset($r['enrollment_sha256'])?$r['enrollment_sha256']:'');if(!hrm_ess_002_receipt_record($m,$c,$result,$error)){cancel_transaction();return false;}commit_transaction();return $result;
}
function hrm_ess_002_team_subject_for_employee($employee_id,$as_of,$capability){$scope=get_hrm_ess_002_current_manager_scope($as_of,$capability);if(!is_array($scope))return false;foreach($scope as $row){$q=db_query('SELECT employee_id FROM '.TB_PREF.'hrm_employee_worker_map WHERE worker_id='.(int)$row['worker_id'].' AND retired_at IS NULL ORDER BY mapping_id');if(!$q||db_num_rows($q)!==1)return false;$m=db_fetch_assoc($q);if(hash_equals((string)$m['employee_id'],(string)$employee_id))return $row;}return false;}
function hrm_ess_002_team_pending_requests($as_of,$kind){$cap=$kind==='leave'?'team_leave_approve':($kind==='overtime'?'team_time_approve':'team_request_review');$scope=get_hrm_ess_002_current_manager_scope($as_of,$cap);if(!is_array($scope))return false;$ids=array();foreach($scope as $row){$q=db_query('SELECT employee_id FROM '.TB_PREF.'hrm_employee_worker_map WHERE worker_id='.(int)$row['worker_id'].' AND retired_at IS NULL ORDER BY mapping_id');if(!$q||db_num_rows($q)!==1)return false;$m=db_fetch_assoc($q);$ids[]=(string)$m['employee_id'];}if(!$ids)return array();$esc=array_map('db_escape',$ids);$table=$kind==='leave'?'leave_requests':'overtime_requests';$q=db_query('SELECT * FROM '.TB_PREF.$table.' WHERE status=0 AND employee_id IN ('.implode(',',$esc).') ORDER BY request_date,request_id','could not read scoped team requests');return hrm_ess_002_rows($q);}
function hrm_ess_002_team_act_on_request($kind,$request_id,$decision,$remarks,$as_of,&$error=null){$error=null;if(!hrm_ess_002_access('SA_HRM_ESS_APPROVE_TEAM')||!in_array($kind,array('leave','overtime'),true)||!in_array($decision,array('approve','reject'),true)){$error='team_action_unauthorized';return false;}$request=$kind==='leave'?get_leave_request((int)$request_id):get_overtime_request((int)$request_id);if(!$request||(int)$request['status']!==0){$error='team_request_not_pending';return false;}$cap=$kind==='leave'?'team_leave_approve':'team_time_approve';if(!hrm_ess_002_team_subject_for_employee($request['employee_id'],$as_of,$cap)){$error='team_scope_denied';return false;}$type=$kind==='leave'?ST_LEAVE_REQUEST:ST_OVERTIME_REQUEST;$draft=find_approval_draft_for_hrm_request($type,(int)$request_id);if(!$draft){$error='approval_draft_missing';return false;}$svc=get_approval_workflow_service();if(!$svc->canActOnDraft((int)$draft['draft_id'])){$error='approval_authority_denied';return false;}$remarks=trim(strip_tags((string)$remarks));$result=$decision==='approve'?$svc->approve((int)$draft['draft_id'],$remarks):$svc->reject((int)$draft['draft_id'],$remarks);if(!is_array($result)||(isset($result['status'])?$result['status']:'')==='error'){$error='approval_action_failed';return false;}return $result;}
