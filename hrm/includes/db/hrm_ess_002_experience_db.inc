function hrm_ess_002_self_leave($as_of=null){$c=get_hrm_ess_002_current_self_context($as_of);if(!$c)return false;$d=db_escape($c['as_of']);$q=db_query('SELECT entitlement_id,leave_id,cycle_start,cycle_end,unit_code FROM '.TB_PREF.'hrm_leave_entitlements WHERE worker_id='.(int)$c['worker_id'].' AND employment_id='.(int)$c['employment_id'].' AND assignment_id='.(int)$c['assignment_id'].' AND legal_entity_id='.(int)$c['legal_entity_id'].' AND cycle_start<='.$d.' AND cycle_end>='.$d.' ORDER BY leave_id,entitlement_id');if(!$q)return false;$out=array();while($row=db_fetch_assoc($q)){$error=null;$p=hrm_lve_001_projection((int)$row['entitlement_id'],$c['as_of'],$error);if($p===false)return false;$out[]=array('leave_id'=>$row['leave_id'],'unit_code'=>$row['unit_code'],'available_units'=>isset($p['available_units'])?$p['available_units']:'0','reserved_units'=>isset($p['reserved_units'])?$p['reserved_units']:'0','consumed_units'=>isset($p['consumed_units'])?$p['consumed_units']:'0','accrued_units'=>isset($p['accrued_units'])?$p['accrued_units']:'0','cycle_start'=>$row['cycle_start'],'cycle_end'=>$row['cycle_end']);}return $out;}
