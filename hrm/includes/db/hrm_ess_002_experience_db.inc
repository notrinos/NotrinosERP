function hrm_ess_002_rows($q){if(!$q)return false;$o=array();while($r=db_fetch_assoc($q))$o[]=$r;return $o;}
function hrm_ess_002_self_time($as_of=null){$c=get_hrm_ess_002_current_self_context($as_of);if(!$c)return false;$q=db_query('SELECT r.reviewed_entry_id,r.work_date,r.duration_minutes,a.approval_id,CASE WHEN a.approval_id IS NULL THEN \'reviewed\' ELSE \'approved\' END AS status_token FROM '.TB_PREF.'hrm_time_reviewed_entries r LEFT JOIN '.TB_PREF.'hrm_time_approvals a ON a.reviewed_entry_id=r.reviewed_entry_id WHERE r.worker_id='.(int)$c['worker_id'].' AND r.assignment_id='.(int)$c['assignment_id'].' AND r.legal_entity_id='.(int)$c['legal_entity_id'].' ORDER BY r.work_date DESC,r.reviewed_entry_id DESC LIMIT 90','could not read ESS time');return hrm_ess_002_rows($q);}
