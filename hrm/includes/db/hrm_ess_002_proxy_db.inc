<?php
/** Explicit effective-dated capability narrowing and revocation for ESS-001 direct-team delegations. */
include_once($path_to_root.'/hrm/includes/hrm_ess_002_contract.inc');
include_once($path_to_root.'/hrm/includes/db/ess_self_scope_db.inc');
include_once($path_to_root.'/hrm/includes/db/ess_manager_scope_db.inc');
function hrm_ess_002_proxy_tables_ready(){foreach(array('hrm_ess_manager_delegations','hrm_ess_002_delegation_capabilities','hrm_ess_002_delegation_revocations') as $t){$q=db_query("SHOW TABLES LIKE '".TB_PREF.db_escape_function($t)."'");if(!$q||db_num_rows($q)!==1)return false;}return true;}
function hrm_ess_002_grant_proxy_capability($delegation_id,$legal_entity_id,$capability,$from,$to,$reason_sha256,&$error=null){
 $error=null;$actor=hrm_ess_002_actor_id();$self=get_hrm_ess_current_self_scope();$from=hrm_ess_002_date($from);$to=hrm_ess_002_date($to);$reason=hrm_ess_002_sha256($reason_sha256);
 if($actor<=0||!hrm_ess_002_access('SA_HRM_ESS_MANAGE_PROXY')||!is_array($self)||!hrm_ess_002_capability_valid($capability)||$from===false||$to===false||$to<$from||$reason===false||!hrm_ess_002_proxy_tables_ready()){$error='proxy_grant_invalid_or_unauthorized';return false;}
 begin_transaction();$q=db_query('SELECT * FROM '.TB_PREF.'hrm_ess_manager_delegations WHERE delegation_id='.(int)$delegation_id.' LIMIT 2 FOR UPDATE');$d=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;$valid_parent=false;if($d&&isset($d['delegate_worker_id'])){$approved=hrm_ess_active_delegated_manager_workers((int)$d['delegate_worker_id'],$from);if(is_array($approved))foreach($approved as $parent)if((int)$parent['delegation_id']===(int)$delegation_id){$valid_parent=true;break;}}
 if(!$d||!$valid_parent||(int)$d['delegator_worker_id']!==(int)$self['worker_id']||(string)$d['scope_code']!=='direct_team'||$from<(string)$d['effective_from']||$to>(string)$d['effective_to']){cancel_transaction();$error='proxy_delegation_scope_denied';return false;}
 $legal_entity_id=(int)$legal_entity_id;$rows=hrm_ess_manager_assignment_ids_as_of((int)$self['worker_id'],$from);$owns=false;if(is_array($rows))foreach($rows as $row)if((int)$row['legal_entity_id']===$legal_entity_id){$owns=true;break;}if(!$owns){cancel_transaction();$error='proxy_legal_entity_scope_denied';return false;}
 $payload=array('delegation_id'=>(int)$delegation_id,'legal_entity_id'=>$legal_entity_id,'capability_code'=>$capability,'effective_from'=>$from,'effective_to'=>$to,'grant_reason_sha256'=>$reason,'granted_by'=>$actor);$sha=hash('sha256',json_encode($payload,JSON_UNESCAPED_SLASHES));
 $q=db_query('SELECT * FROM '.TB_PREF.'hrm_ess_002_delegation_capabilities WHERE capability_sha256='.db_escape($sha).' LIMIT 2 FOR UPDATE');if($q&&db_num_rows($q)===1){$old=db_fetch_assoc($q);commit_transaction();return array('capability_id'=>(int)$old['capability_id'],'capability_sha256'=>$sha);}
 $sql='INSERT INTO '.TB_PREF.'hrm_ess_002_delegation_capabilities (delegation_id,legal_entity_id,capability_code,effective_from,effective_to,grant_reason_sha256,capability_sha256,granted_by,created_at) VALUES ('.(int)$delegation_id.','.$legal_entity_id.','.db_escape($capability).','.db_escape($from).','.db_escape($to).','.db_escape($reason).','.db_escape($sha).','.$actor.',UTC_TIMESTAMP())';if(!db_query($sql)){cancel_transaction();$error='proxy_grant_insert_failed_or_duplicate';return false;}$id=(int)db_insert_id();commit_transaction();return array('capability_id'=>$id,'capability_sha256'=>$sha);
}
function hrm_ess_002_revoke_proxy_capability($capability_id,$reason_sha256,&$error=null){
 $error=null;$actor=hrm_ess_002_actor_id();$self=get_hrm_ess_current_self_scope();$reason=hrm_ess_002_sha256($reason_sha256);if($actor<=0||!hrm_ess_002_access('SA_HRM_ESS_MANAGE_PROXY')||!is_array($self)||$reason===false||!hrm_ess_002_proxy_tables_ready()){$error='proxy_revoke_invalid_or_unauthorized';return false;}
 begin_transaction();$q=db_query('SELECT c.*,d.delegator_worker_id FROM '.TB_PREF.'hrm_ess_002_delegation_capabilities c INNER JOIN '.TB_PREF.'hrm_ess_manager_delegations d ON d.delegation_id=c.delegation_id WHERE c.capability_id='.(int)$capability_id.' LIMIT 2 FOR UPDATE');$c=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$c||(int)$c['delegator_worker_id']!==(int)$self['worker_id']){cancel_transaction();$error='proxy_revoke_scope_denied';return false;}
 $q=db_query('SELECT * FROM '.TB_PREF.'hrm_ess_002_delegation_revocations WHERE capability_id='.(int)$capability_id.' LIMIT 2 FOR UPDATE');if($q&&db_num_rows($q)===1){$old=db_fetch_assoc($q);if(!hash_equals((string)$old['reason_sha256'],$reason)){cancel_transaction();$error='proxy_revoke_replay_mismatch';return false;}commit_transaction();return array('revocation_id'=>(int)$old['revocation_id'],'revocation_sha256'=>(string)$old['revocation_sha256']);}
 $sha=hash('sha256',json_encode(array('capability_sha256'=>$c['capability_sha256'],'reason_sha256'=>$reason,'revoked_by'=>$actor),JSON_UNESCAPED_SLASHES));$sql='INSERT INTO '.TB_PREF.'hrm_ess_002_delegation_revocations (capability_id,revoked_at,reason_sha256,revocation_sha256,revoked_by,created_at) VALUES ('.(int)$capability_id.',UTC_TIMESTAMP(),'.db_escape($reason).','.db_escape($sha).','.$actor.',UTC_TIMESTAMP())';if(!db_query($sql)){cancel_transaction();$error='proxy_revoke_insert_failed';return false;}$id=(int)db_insert_id();commit_transaction();return array('revocation_id'=>$id,'revocation_sha256'=>$sha);
}
function hrm_ess_002_active_delegated_managers($delegate_worker_id,$as_of,$capability){
 $delegate_worker_id=(int)$delegate_worker_id;$as_of=hrm_ess_002_date($as_of);if($delegate_worker_id<=0||$as_of===false||!hrm_ess_002_capability_valid($capability)||!hrm_ess_002_proxy_tables_ready())return false;$d=db_escape($as_of);
 $approved=hrm_ess_active_delegated_manager_workers($delegate_worker_id,$as_of);if($approved===false)return false;$principals=array();foreach($approved as $row)$principals[(int)$row['delegation_id']]=(int)$row['manager_worker_id'];if(!$principals)return array();
 $sql='SELECT c.*,dg.delegator_worker_id,dg.effective_from AS delegation_from,dg.effective_to AS delegation_to,r.revocation_id,r.revoked_at,r.reason_sha256,r.revocation_sha256,r.revoked_by FROM '.TB_PREF.'hrm_ess_002_delegation_capabilities c INNER JOIN '.TB_PREF.'hrm_ess_manager_delegations dg ON dg.delegation_id=c.delegation_id LEFT JOIN '.TB_PREF.'hrm_ess_002_delegation_revocations r ON r.capability_id=c.capability_id WHERE dg.delegate_worker_id='.$delegate_worker_id.' AND c.capability_code='.db_escape($capability).' AND c.effective_from<='.$d.' AND c.effective_to>='.$d.' ORDER BY c.capability_id';
 $q=db_query($sql,'could not resolve effective ESS-002 delegated capabilities');if(!$q)return false;$out=array();while($row=db_fetch_assoc($q)){$id=(int)$row['delegation_id'];if(!isset($principals[$id]))continue;$from=hrm_ess_002_date($row['effective_from']);$to=hrm_ess_002_date($row['effective_to']);$reason=hrm_ess_002_sha256((string)$row['grant_reason_sha256']);$granted=(int)$row['granted_by'];$payload=array('delegation_id'=>$id,'legal_entity_id'=>(int)$row['legal_entity_id'],'capability_code'=>(string)$row['capability_code'],'effective_from'=>$row['effective_from'],'effective_to'=>$row['effective_to'],'grant_reason_sha256'=>$reason,'granted_by'=>$granted);$sha=hash('sha256',json_encode($payload,JSON_UNESCAPED_SLASHES));if((int)$row['capability_id']<=0||(int)$row['legal_entity_id']<=0||$from===false||$to===false||$to<$from||$from<(string)$row['delegation_from']||$to>(string)$row['delegation_to']||$reason===false||$granted<=0||!hash_equals((string)$row['capability_sha256'],$sha))return false;
  if($row['revocation_id']!==null){$rev_reason=hrm_ess_002_sha256((string)$row['reason_sha256']);$revoked=(int)$row['revoked_by'];$rev_payload=array('capability_sha256'=>$sha,'reason_sha256'=>$rev_reason,'revoked_by'=>$revoked);$rev_sha=hash('sha256',json_encode($rev_payload,JSON_UNESCAPED_SLASHES));if((int)$row['revocation_id']<=0||$rev_reason===false||$revoked<=0||!hash_equals((string)$row['revocation_sha256'],$rev_sha)||hrm_ess_002_date(substr((string)$row['revoked_at'],0,10))===false)return false;if(substr((string)$row['revoked_at'],0,10)<=$as_of)continue;}
  $out[]=array('capability_id'=>(int)$row['capability_id'],'delegation_id'=>$id,'legal_entity_id'=>(int)$row['legal_entity_id'],'manager_worker_id'=>$principals[$id]);}return $out;
}
