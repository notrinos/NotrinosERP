function pay_ctry_004_install_schema_group($patch,$group){$groups=pay_ctry_004_schema_groups();if(!isset($groups[$group]))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CTRY-004 schema group unknown: '.$group);$block=pay_ctry_004_schema_group_block($group);if($block===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-CTRY-004 schema source missing: '.$group);$prefix=hrm_migration_active_table_prefix();if($prefix===false)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CTRY-004 table prefix invalid.');$statements=preg_split('/;\s*(?:\r?\n|$)/',$block);foreach($statements as $statement){$statement=trim($statement);if($statement===''||strpos($statement,'CREATE TRIGGER')===0)continue;$statement=str_replace('`0_','`'.$prefix,$statement);if(!db_query($statement))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CTRY-004 schema statement failed for group '.$group.'.');}foreach($groups[$group] as $table){foreach(array('UPDATE','DELETE') as $op)if(!pay_ctry_004_create_trigger($patch,$table,$op))return false;if(!pay_ctry_004_require_table_shape($patch,$table))return false;}return true;}
