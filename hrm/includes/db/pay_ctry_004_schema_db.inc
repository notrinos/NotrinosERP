function pay_ctry_004_trigger_state($table,$operation){$physical=hrm_migration_physical_table_name($table);$name=pay_ctry_004_trigger_name($table,$operation);if($physical===false||$name===false)return false;$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q)return false;if(db_num_rows($q)===0)return 'absent';if(db_num_rows($q)!==1)return 'conflict';$r=db_fetch_assoc($q);$actual=strtoupper(rtrim(preg_replace('/\s+/',' ',trim((string)$r['ACTION_STATEMENT'])),';'));$expected=strtoupper("SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='".pay_ctry_004_trigger_message($table,$operation)."'");return strtoupper((string)$r['EVENT_MANIPULATION'])===strtoupper($operation)&&(string)$r['EVENT_OBJECT_TABLE']===$physical&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&$actual===$expected?'valid':'conflict';}
function pay_ctry_004_create_trigger($patch,$table,$operation){$state=pay_ctry_004_trigger_state($table,$operation);if($state==='valid')return true;if($state!=='absent')return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-CTRY-004 immutable trigger conflict: '.$table.'.'.$operation);$physical=hrm_migration_physical_table_name($table);$name=pay_ctry_004_trigger_name($table,$operation);$sql='CREATE TRIGGER `'.$name.'` BEFORE '.strtoupper($operation).' ON `'.$physical.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape(pay_ctry_004_trigger_message($table,$operation));if(!db_query($sql))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CTRY-004 immutable trigger creation failed: '.$table.'.'.$operation);return pay_ctry_004_trigger_state($table,$operation)==='valid';}
