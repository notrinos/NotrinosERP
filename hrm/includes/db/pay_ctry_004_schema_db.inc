function pay_ctry_004_table_engine($table){$physical=hrm_migration_physical_table_name($table);if($physical===false)return false;$q=db_query('SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical).' LIMIT 1');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);return $r?(string)$r['ENGINE']:false;}
