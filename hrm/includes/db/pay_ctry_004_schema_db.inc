function pay_ctry_004_table_columns($table){$physical=hrm_migration_physical_table_name($table);if($physical===false)return false;$q=db_query('SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical).' ORDER BY ORDINAL_POSITION');if(!$q)return false;$out=array();while($r=db_fetch_assoc($q))$out[]=(string)$r['COLUMN_NAME'];return $out;}
