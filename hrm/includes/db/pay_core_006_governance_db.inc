function hrm_pay_core_006_record_reconciliation($balance_snapshot_id,$accumulator_kind,$source_type,$source_sha256,$expected_amount,$evidence_sha256,&$error=null)
{
    $error=null;$reviewer=hrm_pay_core_006_actor();$sid=(int)$balance_snapshot_id;$kind=(string)$accumulator_kind;$source=hrm_pay_core_006_token($source_type,32);if($reviewer<=0||!hrm_pay_core_006_access('SA_HRM_REVIEW_PAY_CORE_BALANCE')||$sid<=0||!in_array($kind,hrm_pay_core_006_accumulator_kinds(),true)||!$source||!hrm_pay_core_006_is_sha256($source_sha256)||!hrm_pay_core_006_is_sha256($evidence_sha256)){$error='reconciliation_input_invalid';return false;}try{$expected=hrm_pay_core_006_decimal($expected_amount);}catch(Throwable $e){$error='reconciliation_amount_invalid';return false;}
    $manage=hrm_pay_core_006_manage_transaction();if($manage)begin_transaction();$snap=hrm_pay_core_006_one('SELECT '.$kind.'_amount actual_amount,built_by,snapshot_sha256 FROM '.TB_PREF.'hrm_pay_balance_snapshots WHERE balance_snapshot_id='.$sid.' LIMIT 2 FOR UPDATE');if(!$snap){if($manage)cancel_transaction();$error='snapshot_missing';return false;}if($reviewer===(int)$snap['built_by']){if($manage)cancel_transaction();$error='builder_reviewer_separation_required';return false;}$actual=hrm_pay_core_006_decimal($snap['actual_amount']);$difference=hrm_pay_core_006_sub($actual,$expected);$state=hrm_pay_core_006_compare($difference,'0')===0?'reconciled':'mismatch';$material=array('balance_snapshot_id'=>$sid,'snapshot_sha256'=>$snap['snapshot_sha256'],'accumulator_kind'=>$kind,'source_type'=>$source,'source_sha256'=>$source_sha256,'expected_amount'=>$expected,'actual_amount'=>$actual,'difference_amount'=>$difference,'reconciliation_state'=>$state,'evidence_sha256'=>$evidence_sha256,'reviewed_by'=>$reviewer);$sha=hrm_pay_core_006_hash($material);$existing=hrm_pay_core_006_one('SELECT reconciliation_id FROM '.TB_PREF.'hrm_pay_balance_reconciliations WHERE reconciliation_sha256='.db_escape($sha).' LIMIT 2 FOR UPDATE');if($existing){$same=(int)$existing['reconciliation_id'];if($manage)commit_transaction();return $same;}
    $sql='INSERT INTO '.TB_PREF.'hrm_pay_balance_reconciliations (balance_snapshot_id,accumulator_kind,source_type,source_sha256,expected_amount,actual_amount,difference_amount,reconciliation_state,evidence_sha256,reconciliation_sha256,reviewed_by) VALUES ('.$sid.','.db_escape($kind).','.db_escape($source).','.db_escape($source_sha256).','.db_escape($expected).','.db_escape($actual).','.db_escape($difference).','.db_escape($state).','.db_escape($evidence_sha256).','.db_escape($sha).','.$reviewer.')';if(!db_query($sql)){if($manage)cancel_transaction();$error='reconciliation_insert_failed';return false;}$new=(int)db_insert_id();if($manage)commit_transaction();return $new;
