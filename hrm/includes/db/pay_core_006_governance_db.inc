function hrm_pay_core_006_actor(){return isset($_SESSION['wa_current_user']->user)?(int)$_SESSION['wa_current_user']->user:0;}
function hrm_pay_core_006_access($p){return function_exists('user_check_access')&&user_check_access($p);}
function hrm_pay_core_006_manage_transaction(){return empty($GLOBALS['transaction_level']);}
function hrm_pay_core_006_one($sql){$r=db_query($sql);if(!$r)return false;$x=db_fetch_assoc($r);if(!$x)return false;if(db_fetch_assoc($r))return false;return $x;}
function hrm_pay_core_006_sql_nullable_id($v){return $v===null?'NULL':(string)(int)$v;}
function hrm_pay_core_006_sql_nullable_token($v){return $v===null?'NULL':db_escape($v);}
function hrm_pay_core_006_sql_null_match($column,$value){return $value===null?$column.' IS NULL':$column.'='.(int)$value;}
function hrm_pay_core_006_sql_null_token_match($column,$value){return $value===null?$column.' IS NULL':$column.'='.db_escape($value);}

function hrm_pay_core_006_assert_object_scope(array $scope,&$error=null)
{
    $error=null;$s=hrm_pay_core_006_scope($scope,$error);if($s===false)return false;
    $rel=hrm_pay_core_006_one('SELECT worker_id,legal_entity_id FROM '.TB_PREF.'hrm_payroll_relationships WHERE payroll_relationship_id='.(int)$s['payroll_relationship_id'].' LIMIT 2');
    if(!$rel){$error='payroll_relationship_missing';return false;}
    if((int)$rel['legal_entity_id']!==(int)$s['legal_entity_id']){$error='legal_entity_scope_mismatch';return false;}
    if($s['worker_id']!==null&&(int)$rel['worker_id']!==(int)$s['worker_id']){$error='worker_scope_mismatch';return false;}
    $worker_id=$s['worker_id']!==null?$s['worker_id']:(int)$rel['worker_id'];
    if($s['person_id']!==null){$w=hrm_pay_core_006_one('SELECT person_id FROM '.TB_PREF.'hrm_workers WHERE worker_id='.(int)$worker_id.' LIMIT 2');if(!$w||(int)$w['person_id']!==(int)$s['person_id']){$error='person_scope_mismatch';return false;}}
    if($s['assignment_id']!==null){$m=hrm_pay_core_006_one('SELECT relationship_member_id FROM '.TB_PREF.'hrm_payroll_relationship_members WHERE payroll_relationship_id='.(int)$s['payroll_relationship_id'].' AND assignment_id='.(int)$s['assignment_id'].' LIMIT 2');if(!$m){$error='assignment_scope_mismatch';return false;}}
    return $s;
}

function hrm_pay_core_006_definition_from_row(array $row,&$error=null)
