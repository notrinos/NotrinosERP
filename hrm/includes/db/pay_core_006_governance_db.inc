function hrm_pay_core_006_record_recovery($reconciliation_id,$action_token,$source_sha256,$evidence_sha256,&$error=null)
{
    $error=null;$executor=hrm_pay_core_006_actor();$rid=(int)$reconciliation_id;$action=hrm_pay_core_006_token($action_token,64);if($executor<=0||!hrm_pay_core_006_access('SA_HRM_EXECUTE_PAY_CORE_BALANCE')||$rid<=0||!$action||!hrm_pay_core_006_is_sha256($source_sha256)||!hrm_pay_core_006_is_sha256($evidence_sha256)){$error='recovery_input_invalid';return false;}
    $manage=hrm_pay_core_006_manage_transaction();if($manage)begin_transaction();$recon=hrm_pay_core_006_one('SELECT reconciliation_state,reconciliation_sha256,reviewed_by FROM '.TB_PREF.'hrm_pay_balance_reconciliations WHERE reconciliation_id='.$rid.' LIMIT 2 FOR UPDATE');if(!$recon){if($manage)cancel_transaction();$error='reconciliation_missing';return false;}if($executor===(int)$recon['reviewed_by']){if($manage)cancel_transaction();$error='reviewer_executor_separation_required';return false;}if($recon['reconciliation_state']!=='mismatch'){if($manage)cancel_transaction();$error='recovery_requires_mismatch';return false;}
