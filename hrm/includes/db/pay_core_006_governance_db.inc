    $sql='INSERT INTO '.TB_PREF.'hrm_pay_balance_definitions (balance_code,version_no,unit_code,currency_code,dimension_mask,accumulator_mask,reset_policy,reset_month,reset_day,expiry_policy,expiry_date,expiry_days,carry_forward_allowed,effective_from,effective_to,definition_sha256,status,created_by) VALUES ('.db_escape($d['balance_code']).','.(int)$d['version_no'].','.db_escape($d['unit_code']).','.hrm_pay_core_006_sql_nullable_token($d['currency_code']).','.db_escape(implode(',',$d['dimensions'])).','.db_escape(implode(',',$d['accumulators'])).','.db_escape($d['reset_policy']).','.hrm_pay_core_006_sql_nullable_id($d['reset_month']).','.hrm_pay_core_006_sql_nullable_id($d['reset_day']).','.db_escape($d['expiry_policy']).','.hrm_pay_core_006_sql_nullable_token($d['expiry_date']).','.hrm_pay_core_006_sql_nullable_id($d['expiry_days']).','.(!empty($d['carry_forward_allowed'])?1:0).','.db_escape($d['effective_from']).','.hrm_pay_core_006_sql_nullable_token($d['effective_to']).','.db_escape($d['definition_sha256']).',\'active\','.$actor.')';
    if(!db_query($sql)){$same=hrm_pay_core_006_one('SELECT balance_definition_id FROM '.TB_PREF.'hrm_pay_balance_definitions WHERE definition_sha256='.db_escape($d['definition_sha256']).' LIMIT 2');if($same)return (int)$same['balance_definition_id'];$error='definition_insert_failed';return false;}return (int)db_insert_id();
