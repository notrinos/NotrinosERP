    $sql='INSERT INTO '.TB_PREF.'hrm_pay_balance_recovery_evidence (reconciliation_id,action_token,source_sha256,evidence_sha256,recovery_sha256,executed_by) VALUES ('.$rid.','.db_escape($action).','.db_escape($source_sha256).','.db_escape($evidence_sha256).','.db_escape($sha).','.$executor.')';if(!db_query($sql)){if($manage)cancel_transaction();$error='recovery_insert_failed';return false;}$new=(int)db_insert_id();if($manage)commit_transaction();return $new;
