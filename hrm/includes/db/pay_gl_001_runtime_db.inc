function pay_gl_001_runtime_fail(&$error,$code){$error=$code;return false;}
function pay_gl_001_current_actor(){return isset($_SESSION['wa_current_user']->user)?(int)$_SESSION['wa_current_user']->user:0;}
function pay_gl_001_current_company(){return isset($_SESSION['wa_current_user']->company)?(int)$_SESSION['wa_current_user']->company:0;}
function pay_gl_001_has_access($permission){return function_exists('user_check_access')&&user_check_access($permission);}
function pay_gl_001_require_access($permission,&$error){return pay_gl_001_has_access($permission)?true:pay_gl_001_runtime_fail($error,'permission_denied');}
function pay_gl_001_now(){return date('Y-m-d H:i:s');}
function pay_gl_001_db_one($sql){$q=db_query($sql);if(!$q||db_num_rows($q)!==1)return false;return db_fetch_assoc($q);}
function pay_gl_001_db_rows($sql){$q=db_query($sql);if(!$q)return false;$rows=array();while($r=db_fetch_assoc($q))$rows[]=$r;return $rows;}
function pay_gl_001_minor_decimal($minor){return number_format(((int)$minor)/100,2,'.','');}
function pay_gl_001_scope_lock($company){return db_query("SELECT value FROM ".TB_PREF."sys_prefs WHERE name='coy_name' AND category='setup.company' FOR UPDATE")!==false;}
function pay_gl_001_assert_scope($company,&$error){return (int)$company===pay_gl_001_current_company()?true:pay_gl_001_runtime_fail($error,'company_scope_denied');}
function pay_gl_001_account_exists($account){$q=db_query("SELECT account_code FROM ".TB_PREF."chart_master WHERE account_code=".db_escape($account)." LIMIT 2");return $q&&db_num_rows($q)===1;}
function pay_gl_001_dimension_open($id){$id=(int)$id;return $id===0||(!dimension_is_closed($id));}

/** Publish one immutable effective-dated mapping snapshot after maker/checker review. */
function pay_gl_001_publish_mapping(array $spec,&$error=null){
 $error=null;if(!pay_gl_001_require_access(PAY_GL_001_REVIEW_PERMISSION,$error))return false;
 $company=(int)($spec['company_id']??-1);$legal=(int)($spec['legal_entity_id']??0);$maker=(int)($spec['maker_id']??0);$checker=pay_gl_001_current_actor();
 if(!pay_gl_001_assert_scope($company,$error)||$legal<=0||$maker<=0||$checker<=0||$maker===$checker)return pay_gl_001_runtime_fail($error,'mapping_maker_checker_invalid');
 $mapping_key=(string)($spec['mapping_key']??'');$from=(string)($spec['effective_from']??'');$to=array_key_exists('effective_to',$spec)?$spec['effective_to']:null;$rules=$spec['rules']??array();
 if(!pay_gl_001_token($mapping_key,96)||!pay_gl_001_date($from)||($to!==null&&!pay_gl_001_date($to))||!is_array($rules)||!count($rules))return pay_gl_001_runtime_fail($error,'mapping_scope_invalid');
 $canon=array();foreach(array_values($rules) as $i=>$r){if(!is_array($r))return pay_gl_001_runtime_fail($error,'mapping_rule_invalid');$r=array_merge($r,array('company_id'=>$company,'legal_entity_id'=>$legal,'mapping_key'=>$mapping_key,'effective_from'=>$from,'effective_to'=>$to,'maker_id'=>$maker,'checker_id'=>$checker));if(!pay_gl_001_validate_mapping_rule($r,$error))return false;$r['rule_sha256']=pay_gl_001_mapping_rule_sha256($r);$r['rule_no']=$i+1;$canon[]=$r;}
 $snapshot=pay_gl_001_mapping_snapshot($canon,$error);if($snapshot===false)return false;
 begin_transaction();if(!pay_gl_001_scope_lock($company)){rollback_transaction();return pay_gl_001_runtime_fail($error,'mapping_lock_failed');}
 $existing=pay_gl_001_db_one("SELECT mapping_version_id,mapping_snapshot_sha256 FROM ".TB_PREF."hrm_pay_gl_001_mapping_versions WHERE mapping_snapshot_sha256=".db_escape($snapshot)." LIMIT 2");
 if($existing){commit_transaction();return array('mapping_version_id'=>(int)$existing['mapping_version_id'],'mapping_snapshot_sha256'=>$snapshot,'idempotent'=>true);}
 $overlap=pay_gl_001_db_rows("SELECT mapping_version_id FROM ".TB_PREF."hrm_pay_gl_001_mapping_versions WHERE company_id=".db_escape($company)." AND legal_entity_id=".db_escape($legal)." AND mapping_key=".db_escape($mapping_key)." AND effective_from<=".db_escape($to===null?'9999-12-31':$to)." AND (effective_to IS NULL OR effective_to>=".db_escape($from).") FOR UPDATE");
 if($overlap===false||count($overlap)){rollback_transaction();return pay_gl_001_runtime_fail($error,'mapping_ambiguous');}
 $now=pay_gl_001_now();
 $sql="INSERT INTO ".TB_PREF."hrm_pay_gl_001_mapping_versions (company_id,legal_entity_id,mapping_key,effective_from,effective_to,maker_id,checker_id,approved_at,mapping_snapshot_sha256,created_at) VALUES (".db_escape($company).",".db_escape($legal).",".db_escape($mapping_key).",".db_escape($from).",".($to===null?'NULL':db_escape($to)).",".db_escape($maker).",".db_escape($checker).",".db_escape($now).",".db_escape($snapshot).",".db_escape($now).")";
 if(!db_query($sql)){rollback_transaction();return pay_gl_001_runtime_fail($error,'mapping_insert_failed');}$vid=(int)db_insert_id();
 foreach($canon as $r){$sql="INSERT INTO ".TB_PREF."hrm_pay_gl_001_mapping_rules (mapping_version_id,rule_no,source_kind,source_key,entry_side,account_code,dimension1_axis_code,dimension2_axis_code,suspense_allowed,rule_sha256,created_at) VALUES (".db_escape($vid).",".db_escape($r['rule_no']).",".db_escape($r['source_kind']).",".db_escape($r['source_key']).",".db_escape($r['entry_side']).",".db_escape($r['account_code']).",".($r['dimension1_axis_code']===null?'NULL':db_escape($r['dimension1_axis_code'])).",".($r['dimension2_axis_code']===null?'NULL':db_escape($r['dimension2_axis_code'])).",".db_escape(!empty($r['suspense_allowed'])?1:0).",".db_escape($r['rule_sha256']).",".db_escape($now).")";if(!db_query($sql)){rollback_transaction();return pay_gl_001_runtime_fail($error,'mapping_rule_insert_failed');}}
 commit_transaction();return array('mapping_version_id'=>$vid,'mapping_snapshot_sha256'=>$snapshot,'idempotent'=>false);
}

/** Load and reconstitute the exact immutable mapping snapshot; ambiguity/missing is fail-closed. */
function pay_gl_001_load_mapping_snapshot($sha,$company,$legal,$date,&$error=null){
 $error=null;if(!pay_gl_001_sha($sha)||!pay_gl_001_date($date)||!pay_gl_001_assert_scope($company,$error))return false;
 $v=pay_gl_001_db_one("SELECT * FROM ".TB_PREF."hrm_pay_gl_001_mapping_versions WHERE mapping_snapshot_sha256=".db_escape($sha)." AND company_id=".db_escape((int)$company)." AND legal_entity_id=".db_escape((int)$legal)." AND effective_from<=".db_escape($date)." AND (effective_to IS NULL OR effective_to>=".db_escape($date).") LIMIT 2");
 if(!$v)return pay_gl_001_runtime_fail($error,'mapping_missing_or_inactive');
 $rows=pay_gl_001_db_rows("SELECT * FROM ".TB_PREF."hrm_pay_gl_001_mapping_rules WHERE mapping_version_id=".db_escape((int)$v['mapping_version_id'])." ORDER BY rule_no");
 if($rows===false||!count($rows))return pay_gl_001_runtime_fail($error,'mapping_missing');
 $rules=array();foreach($rows as $r){$x=array('company_id'=>(int)$company,'legal_entity_id'=>(int)$legal,'mapping_key'=>$v['mapping_key'],'effective_from'=>$v['effective_from'],'effective_to'=>$v['effective_to'],'source_kind'=>$r['source_kind'],'source_key'=>$r['source_key'],'entry_side'=>$r['entry_side'],'account_code'=>$r['account_code'],'dimension1_axis_code'=>$r['dimension1_axis_code'],'dimension2_axis_code'=>$r['dimension2_axis_code'],'suspense_allowed'=>(int)$r['suspense_allowed'],'maker_id'=>(int)$v['maker_id'],'checker_id'=>(int)$v['checker_id']);if(!pay_gl_001_validate_mapping_rule($x,$error)||!hash_equals(pay_gl_001_mapping_rule_sha256($x),$r['rule_sha256']))return pay_gl_001_runtime_fail($error,'mapping_rule_hash_mismatch');$x['rule_sha256']=$r['rule_sha256'];$rules[]=$x;}
 if(!hash_equals(pay_gl_001_mapping_snapshot($rules,$error),$sha))return pay_gl_001_runtime_fail($error,'mapping_snapshot_hash_mismatch');
 return array('version'=>$v,'rules'=>$rules);
}

/** Verify an unsuperseded immutable PAY-CORE-010 approval for the exact result custody. */
function pay_gl_001_require_core_010_approval(array $p,&$error){
 $sql="SELECT a.approval_id,a.approval_intent_id,a.approval_sha256,a.decision_token,a.approver_id,a.projection_set_sha256,i.payroll_period_id,i.payroll_group_id,i.legal_entity_id,i.result_set_sha256,i.intent_sha256 FROM ".TB_PREF."hrm_pay_core_010_approvals a JOIN ".TB_PREF."hrm_pay_core_010_approval_intents i ON i.approval_intent_id=a.approval_intent_id WHERE a.approval_sha256=".db_escape($p['approval_sha256'])." AND a.result_set_sha256=".db_escape($p['result_set_sha256'])." AND i.result_set_sha256=".db_escape($p['result_set_sha256'])." AND i.payroll_period_id=".db_escape((int)$p['payroll_period_id'])." AND i.payroll_group_id=".db_escape((int)$p['payroll_group_id'])." AND i.legal_entity_id=".db_escape((int)$p['legal_entity_id'])." LIMIT 2";
 $a=pay_gl_001_db_one($sql);if(!$a||strtolower((string)$a['decision_token'])!=='approved')return pay_gl_001_runtime_fail($error,'core_010_approval_mismatch');
 $newer=pay_gl_001_db_rows("SELECT a2.approval_id FROM ".TB_PREF."hrm_pay_core_010_approvals a2 JOIN ".TB_PREF."hrm_pay_core_010_approval_intents i2 ON i2.approval_intent_id=a2.approval_intent_id WHERE i2.payroll_period_id=".db_escape((int)$p['payroll_period_id'])." AND i2.payroll_group_id=".db_escape((int)$p['payroll_group_id'])." AND i2.legal_entity_id=".db_escape((int)$p['legal_entity_id'])." AND a2.approval_id>".db_escape((int)$a['approval_id'])." AND LOWER(a2.decision_token)='approved' LIMIT 1");
 if($newer===false)return pay_gl_001_runtime_fail($error,'core_010_approval_check_failed');if(count($newer))return pay_gl_001_runtime_fail($error,'stale_or_superseded_payroll_result');
 return $a;
}

