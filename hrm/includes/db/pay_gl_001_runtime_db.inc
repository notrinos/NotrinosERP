 $mapping=pay_gl_001_load_mapping_snapshot($p['mapping_snapshot_sha256'],(int)$p['company_id'],(int)$p['legal_entity_id'],$p['journal_date'],$error);if(!$mapping)return false;
 $prepared=pay_gl_001_current_actor();if($prepared<=0)return pay_gl_001_runtime_fail($error,'actor_missing');$at=pay_gl_001_now();
 $basis=array('company_id'=>(int)$p['company_id'],'legal_entity_id'=>(int)$p['legal_entity_id'],'payroll_group_id'=>(int)$p['payroll_group_id'],'payroll_period_id'=>(int)$p['payroll_period_id'],'result_set_sha256'=>$p['result_set_sha256'],'approval_sha256'=>$p['approval_sha256'],'journal_date'=>$p['journal_date'],'currency_code'=>$p['currency_code'],'mapping_snapshot_sha256'=>$p['mapping_snapshot_sha256'],'prepared_by'=>$prepared,'prepared_at'=>$at);
 $basisSha=pay_gl_001_journal_basis_sha256($basis);$lines=array();$allocs=array();$axesByAlloc=array();$debit=0;$credit=0;
 $source=array_values($p['source_lines']);usort($source,function($a,$b){$c=strcmp((string)($a['source_result_sha256']??''),(string)($b['source_result_sha256']??''));return $c!==0?$c:strcmp((string)($a['source_line_key']??''),(string)($b['source_line_key']??''));});
