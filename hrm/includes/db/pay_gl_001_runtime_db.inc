  $line=array('journal_basis_sha256'=>$basisSha,'source_result_sha256'=>$src['source_result_sha256'],'source_line_key'=>$src['source_line_key'],'line_no'=>$li+1,'account_code'=>$rule['account_code'],'entry_side'=>$src['entry_side'],'amount_minor'=>(int)$src['amount_minor'],'memo_code'=>$src['memo_code'],'exception_reason_code'=>$exception,'exception_approved_by'=>$exceptionApprovedBy,'mapping_rule_sha256'=>$rule['rule_sha256']);$line['canonical_line_sha256']=pay_gl_001_line_sha256($line);if(!pay_gl_001_validate_line($line,$error))return false;$lines[]=$line;
