 $sql="INSERT INTO ".TB_PREF."hrm_pay_gl_001_journal_intents (company_id,legal_entity_id,payroll_group_id,payroll_period_id,result_set_sha256,approval_sha256,journal_date,currency_code,mapping_snapshot_sha256,line_set_sha256,allocation_set_sha256,debit_minor,credit_minor,journal_sha256,prepared_by,prepared_at,created_at) VALUES (".implode(',',array_map('db_escape',array($journal['company_id'],$journal['legal_entity_id'],$journal['payroll_group_id'],$journal['payroll_period_id'],$journal['result_set_sha256'],$journal['approval_sha256'],$journal['journal_date'],$journal['currency_code'],$journal['mapping_snapshot_sha256'],$journal['line_set_sha256'],$journal['allocation_set_sha256'],$journal['debit_minor'],$journal['credit_minor'],$journal['journal_sha256'],$journal['prepared_by'],$journal['prepared_at'],$journal['prepared_at']))).")";
