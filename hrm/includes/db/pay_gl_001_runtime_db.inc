/** Recompute journal, allocations and explicit two-slot projections independently before finance review. */
function pay_gl_001_reconcile_intent($journal_intent_id,&$error=null){
 $error=null;if(!pay_gl_001_require_access(PAY_GL_001_REVIEW_PERMISSION,$error))return false;$jid=(int)$journal_intent_id;
 $j=pay_gl_001_db_one("SELECT * FROM ".TB_PREF."hrm_pay_gl_001_journal_intents WHERE journal_intent_id=".db_escape($jid)." LIMIT 2");if(!$j||!pay_gl_001_assert_scope((int)$j['company_id'],$error))return pay_gl_001_runtime_fail($error,'journal_missing_or_scope_denied');
