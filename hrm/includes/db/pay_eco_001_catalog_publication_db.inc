        $decision=pay_eco_001_catalog_publication_exact_row('SELECT * FROM '.TB_PREF.'pay_eco_001_catalog_decisions WHERE catalog_candidate_id='.(int)$candidate['catalog_candidate_id'].' LIMIT 2 FOR UPDATE',$error,false);if($decision===false)break;
        $decisionPayload=array('catalog_candidate_id'=>(int)$decision['catalog_candidate_id'],'decision'=>(string)$decision['decision'],'trust_snapshot_sha256'=>(string)$decision['trust_snapshot_sha256'],'certification_snapshot_sha256'=>(string)$decision['certification_snapshot_sha256'],'compatibility_snapshot_sha256'=>(string)$decision['compatibility_snapshot_sha256'],'vulnerability_snapshot_sha256'=>(string)$decision['vulnerability_snapshot_sha256'],'decision_reason_sha256'=>(string)$decision['decision_reason_sha256'],'maker_id'=>(int)$decision['maker_id'],'checker_id'=>(int)$decision['checker_id'],'decided_at'=>pay_eco_001_catalog_publication_iso($decision['decided_at'],$error),'decision_sha256'=>(string)$decision['decision_sha256']);if($decisionPayload['decided_at']===false||!pay_eco_001_validate_catalog_decision($decisionPayload,$error)||$decisionPayload['decision']!=='admit_for_review'){$error='catalog_publication_decision_not_admitted';break;}
        $admission=pay_eco_001_catalog_publication_exact_row('SELECT aa.*,vc.vulnerability_snapshot_id,vc.result AS vulnerability_result,vs.snapshot_sha256,vs.issued_at,vs.expires_at FROM '.TB_PREF.'pay_eco_001_artifact_admissions aa INNER JOIN '.TB_PREF.'pay_eco_001_vulnerability_correlations vc ON vc.vulnerability_correlation_id=aa.vulnerability_correlation_id INNER JOIN '.TB_PREF.'pay_eco_001_vulnerability_snapshots vs ON vs.vulnerability_snapshot_id=vc.vulnerability_snapshot_id WHERE aa.catalog_candidate_id='.(int)$candidate['catalog_candidate_id']." AND aa.result='admitted' AND vc.result='passed' ORDER BY aa.artifact_admission_id DESC LIMIT 1 FOR UPDATE",$error,false);if($admission===false)break;
