/** Validate current PAY-CTRY certification publication for the exact candidate pack. */
function pay_eco_001_catalog_publication_certification($publication_id,$pack_version_id,$semantic_root,$evidence_root,$now_epoch,&$error,$locked=false)
{
    $suffix=$locked?' FOR UPDATE':'';
    $row=pay_eco_001_catalog_publication_exact_row('SELECT pb.*,ce.pack_version_id,ce.to_status,ce.semantic_root,ce.evidence_root,ce.expires_at,cc.effective_from,cc.effective_to,cc.certification_event_id AS claim_event_id FROM '.TB_PREF.'pay_ctry_publication_records pb INNER JOIN '.TB_PREF.'pay_ctry_certification_events ce ON ce.certification_event_id=pb.certification_event_id INNER JOIN '.TB_PREF.'pay_ctry_certification_claims cc ON cc.certification_claim_id=pb.certification_claim_id WHERE pb.publication_id='.(int)$publication_id.' LIMIT 2'.$suffix,$error,false);if($row===false)return false;
    $event=array('certification_event_id'=>(int)$row['certification_event_id'],'certification_claim_id'=>(int)$row['certification_claim_id'],'publication_event'=>(string)$row['publication_event'],'predecessor_publication_id'=>$row['predecessor_publication_id']===null?null:(int)$row['predecessor_publication_id'],'published_at'=>pay_eco_001_catalog_publication_iso($row['published_at'],$error),'support_until'=>$row['support_until']===null?null:pay_eco_001_catalog_publication_iso($row['support_until'],$error),'publication_sha256'=>(string)$row['publication_sha256'],'actor_id'=>(int)$row['actor_id'],'actor_role'=>(string)$row['actor_role'],'assurance_sha256'=>(string)$row['assurance_sha256']);if($event['published_at']===false||($row['support_until']!==null&&$event['support_until']===false)||!pay_ctry_004_validate_publication_event($event,$error))return false;
    if($event['publication_event']!=='Published'||(int)$row['pack_version_id']!==(int)$pack_version_id||(int)$row['claim_event_id']!==(int)$row['certification_event_id']||(string)$row['to_status']!=='Certified'||!hash_equals((string)$row['semantic_root'],(string)$semantic_root)||!hash_equals((string)$row['evidence_root'],(string)$evidence_root))return pay_eco_001_fail($error,'catalog_publication_certification_not_current');
    $nowSql=gmdate('Y-m-d H:i:s',$now_epoch);if((!empty($row['expires_at'])&&strtotime((string)$row['expires_at'].' UTC')<$now_epoch)||strtotime((string)$row['effective_from'].' UTC')>$now_epoch||strtotime((string)$row['effective_to'].' UTC')<=$now_epoch)return pay_eco_001_fail($error,'catalog_publication_certification_not_current');
    $later=pay_eco_001_catalog_publication_exact_row('SELECT publication_id,publication_event FROM '.TB_PREF.'pay_ctry_publication_records WHERE certification_claim_id='.(int)$row['certification_claim_id'].' AND publication_id>'.(int)$publication_id.' ORDER BY publication_id DESC LIMIT 1'.$suffix,$error,true);if($later===false)return false;if(is_array($later))return pay_eco_001_fail($error,'catalog_publication_certification_not_current');
    $emergency=pay_eco_001_catalog_publication_exact_row('SELECT emergency_action_id FROM '.TB_PREF.'pay_ctry_certification_emergency_actions WHERE certification_event_id='.(int)$row['certification_event_id'].' AND (certification_claim_id IS NULL OR certification_claim_id='.(int)$row['certification_claim_id'].') AND effective_at<='.pay_ctry_001_sql_hex($nowSql).' LIMIT 2'.$suffix,$error,true);if($emergency===false)return false;if(is_array($emergency))return pay_eco_001_fail($error,'catalog_publication_certification_not_current');
    return array('row'=>$row,'event'=>$event);
}

/** Append one immutable catalog publication after all trust/certification/signed-root evidence is revalidated. */
function pay_eco_001_write_catalog_publication($request,&$error,$now_epoch=null)
