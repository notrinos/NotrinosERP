    $event=append_domain_audit_event(array(
        'company_id'=>PAY_CTRY_001_SITE_COMPANY_ID,'legal_entity_id'=>0,
        'entity_type'=>'pay_eco_catalog_publication','entity_key'=>array('catalog_publication_id'=>(int)$publication['catalog_publication_id']),
        'action'=>'pay.eco.catalog_publication.appended','reason_code'=>'signed_catalog_publication_recorded',
        'before'=>array(),'after'=>array(
            'catalog_candidate_id'=>(int)$publication['catalog_candidate_id'],'catalog_decision_id'=>(int)$publication['catalog_decision_id'],
            'artifact_admission_id'=>(int)$publication['artifact_admission_id'],'certification_publication_id'=>(int)$publication['certification_publication_id'],
            'catalog_release_id'=>(int)$publication['catalog_release_id'],'catalog_admission_id'=>(int)$publication['catalog_admission_id'],
            'catalog_root_sha256'=>(string)$publication['catalog_root_sha256'],'publication_sha256'=>(string)$publication['publication_sha256'],
            'marketplace_publication'=>true,'automatic_catalog_admission'=>false,'pack_installation'=>false,'company_activation'=>false,
            'external_network_delivery'=>false,'payroll_execution'=>false,'historical_payroll_accounting_rows_rewritten'=>0),
        'restricted_diff'=>array('actor_id'=>(int)$actor,'append_only'=>true,'marketplace_publication'=>true,'automatic_catalog_admission'=>false,
            'pack_installation'=>false,'company_activation'=>false,'external_network_delivery'=>false,'payroll_execution'=>false,
            'historical_payroll_accounting_rows_rewritten'=>0)
    ));
    return $event===false?pay_eco_001_fail($error,'catalog_publication_audit_failed'):true;
}

/** Load and cryptographically reverify one admitted immutable PAY-CTRY signed catalog release. */
function pay_eco_001_catalog_publication_verify_release($release_id,$admission_id,$now_epoch,&$error,$locked=false)
{
    $suffix=$locked?' FOR UPDATE':'';
    $release=pay_eco_001_catalog_publication_exact_row(
        'SELECT r.*,p.publisher_code,p.valid_from AS publisher_valid_from,p.valid_to AS publisher_valid_to,s.signer_code,s.publisher_id AS signer_publisher_id,k.key_id,k.algorithm,k.public_key_pem,k.public_key_sha256,k.key_sha256,k.valid_from AS key_valid_from,k.valid_to AS key_valid_to,k.trusted_at '.
        'FROM '.TB_PREF.'pay_ctry_catalog_releases r INNER JOIN '.TB_PREF.'pay_ctry_publishers p ON p.publisher_id=r.publisher_id INNER JOIN '.TB_PREF.'pay_ctry_signers s ON s.signer_id=r.signer_id INNER JOIN '.TB_PREF.'pay_ctry_trust_keys k ON k.trust_key_id=r.trust_key_id WHERE r.catalog_release_id='.(int)$release_id.' LIMIT 2'.$suffix,$error,false);
    if($release===false)return false;
    $admission=pay_eco_001_catalog_publication_exact_row('SELECT * FROM '.TB_PREF.'pay_ctry_catalog_release_admissions WHERE catalog_admission_id='.(int)$admission_id.' AND catalog_release_id='.(int)$release_id.' LIMIT 2'.$suffix,$error,false);
    if($admission===false)return false;
    $admissionPayload=array('catalog_release_sha256'=>(string)$release['release_sha256'],'decision'=>(string)$admission['decision'],'signature_verified'=>(int)$admission['signature_verified'],'trust_snapshot_sha256'=>(string)$admission['trust_snapshot_sha256'],'evidence_sha256'=>(string)$admission['evidence_sha256'],'maker_id'=>(int)$admission['maker_id'],'checker_id'=>(int)$admission['checker_id'],'decided_at'=>pay_eco_001_catalog_publication_iso($admission['decided_at'],$error),'admission_sha256'=>(string)$admission['admission_sha256']);
    if($admissionPayload['decided_at']===false||!pay_ctry_007_validate_catalog_admission($admissionPayload,$error)||$admissionPayload['decision']!=='accepted'||$admissionPayload['signature_verified']!==1)return pay_eco_001_fail($error,'catalog_publication_catalog_admission_invalid');
    $predecessor=null;
    if((int)$release['release_no']>1){
        if(empty($release['predecessor_catalog_release_id']))return pay_eco_001_fail($error,'catalog_publication_catalog_predecessor_missing');
        $pr=pay_eco_001_catalog_publication_exact_row('SELECT catalog_code,release_no,catalog_root_sha256,released_at,release_sha256 FROM '.TB_PREF.'pay_ctry_catalog_releases WHERE catalog_release_id='.(int)$release['predecessor_catalog_release_id'].' LIMIT 2'.$suffix,$error,false);if($pr===false)return false;
        $predecessor=array('catalog_code'=>(string)$pr['catalog_code'],'release_no'=>(int)$pr['release_no'],'catalog_root_sha256'=>(string)$pr['catalog_root_sha256'],'released_at'=>pay_eco_001_catalog_publication_iso($pr['released_at'],$error),'release_sha256'=>(string)$pr['release_sha256']);if($predecessor['released_at']===false)return false;
    }
    $releasePayload=array('catalog_code'=>(string)$release['catalog_code'],'release_no'=>(int)$release['release_no'],'predecessor_release_sha256'=>$release['predecessor_release_sha256']===null?null:(string)$release['predecessor_release_sha256'],'catalog_root_sha256'=>(string)$release['catalog_root_sha256'],'released_at'=>pay_eco_001_catalog_publication_iso($release['released_at'],$error),'publisher_code'=>(string)$release['publisher_code'],'signer_code'=>(string)$release['signer_code'],'key_id'=>(string)$release['key_id'],'signature_algorithm'=>(string)$release['signature_algorithm'],'release_sha256'=>(string)$release['release_sha256'],'signature_payload_sha256'=>(string)$release['signature_payload_sha256'],'signature_base64'=>(string)$release['signature_base64']);
    if($releasePayload['released_at']===false)return false;
    $publisherRevoked=pay_eco_001_catalog_publication_exact_row('SELECT publisher_revocation_id FROM '.TB_PREF.'pay_ctry_publisher_revocations WHERE publisher_id='.(int)$release['publisher_id'].' AND effective_at<='.pay_ctry_001_sql_hex(gmdate('Y-m-d H:i:s',$now_epoch)).' LIMIT 2'.$suffix,$error,true);if($publisherRevoked===false)return false;
    $keyRevoked=pay_eco_001_catalog_publication_exact_row('SELECT key_revocation_id FROM '.TB_PREF.'pay_ctry_trust_key_revocations WHERE trust_key_id='.(int)$release['trust_key_id'].' AND effective_at<='.pay_ctry_001_sql_hex(gmdate('Y-m-d H:i:s',$now_epoch)).' LIMIT 2'.$suffix,$error,true);if($keyRevoked===false)return false;
    if(is_array($publisherRevoked)||is_array($keyRevoked))return pay_eco_001_fail($error,'catalog_publication_signing_authority_revoked');
    $sup=pay_eco_001_catalog_publication_exact_row('SELECT predecessor_key_id,successor_key_id,effective_at,supersession_sha256 FROM '.TB_PREF.'pay_ctry_trust_key_supersessions WHERE predecessor_key_id='.(int)$release['trust_key_id'].' LIMIT 2'.$suffix,$error,true);if($sup===false)return false;
    $key=array('trust_key_id'=>(int)$release['trust_key_id'],'signer_id'=>(int)$release['signer_id'],'key_id'=>(string)$release['key_id'],'algorithm'=>(string)$release['algorithm'],'public_key_pem'=>(string)$release['public_key_pem'],'public_key_sha256'=>(string)$release['public_key_sha256'],'key_sha256'=>(string)$release['key_sha256'],'valid_from'=>pay_eco_001_catalog_publication_iso($release['key_valid_from'],$error),'valid_to'=>$release['key_valid_to']===null?null:pay_eco_001_catalog_publication_iso($release['key_valid_to'],$error),'trusted_at'=>pay_eco_001_catalog_publication_iso($release['trusted_at'],$error),'supersession'=>null);if($key['valid_from']===false||($release['key_valid_to']!==null&&$key['valid_to']===false)||$key['trusted_at']===false)return false;
    if(is_array($sup)){$key['supersession']=array('predecessor_key_id'=>(int)$sup['predecessor_key_id'],'successor_key_id'=>(int)$sup['successor_key_id'],'effective_at'=>pay_eco_001_catalog_publication_iso($sup['effective_at'],$error),'supersession_sha256'=>(string)$sup['supersession_sha256']);if($key['supersession']['effective_at']===false)return false;}
    $ctx=array('publisher'=>array('publisher_id'=>(int)$release['publisher_id'],'publisher_code'=>(string)$release['publisher_code'],'valid_from'=>pay_eco_001_catalog_publication_iso($release['publisher_valid_from'],$error),'valid_to'=>$release['publisher_valid_to']===null?null:pay_eco_001_catalog_publication_iso($release['publisher_valid_to'],$error)),'signer'=>array('signer_id'=>(int)$release['signer_id'],'publisher_id'=>(int)$release['signer_publisher_id'],'signer_code'=>(string)$release['signer_code']),'key'=>$key,'trusted_now'=>(int)$now_epoch,'publisher_revoked'=>false,'key_revoked'=>false);
    if($ctx['publisher']['valid_from']===false||($release['publisher_valid_to']!==null&&$ctx['publisher']['valid_to']===false)||!pay_ctry_007_verify_catalog_signature($releasePayload,$ctx,$predecessor,$error))return false;
    return array('release'=>$release,'admission'=>$admission,'release_payload'=>$releasePayload,'admission_payload'=>$admissionPayload);
