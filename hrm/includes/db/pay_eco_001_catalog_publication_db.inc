        $nowSql=gmdate('Y-m-d H:i:s',$now_epoch);$currentSnapshot=pay_eco_001_catalog_publication_exact_row('SELECT vulnerability_snapshot_id,snapshot_sha256 FROM '.TB_PREF.'pay_eco_001_vulnerability_snapshots WHERE issued_at<='.pay_ctry_001_sql_hex($nowSql).' AND expires_at>='.pay_ctry_001_sql_hex($nowSql).' ORDER BY issued_at DESC,vulnerability_snapshot_id DESC LIMIT 1 FOR UPDATE',$error,false);if($currentSnapshot===false)break;if((int)$currentSnapshot['vulnerability_snapshot_id']!==(int)$admission['vulnerability_snapshot_id']||!hash_equals((string)$currentSnapshot['snapshot_sha256'],(string)$admission['snapshot_sha256'])){$error='catalog_publication_vulnerability_snapshot_not_current';break;}
        $pubFrom=strtotime((string)$candidate['valid_from'].' UTC');$pubTo=$candidate['valid_to']===null?null:strtotime((string)$candidate['valid_to'].' UTC');if($pubFrom===false||$pubFrom>$now_epoch||($pubTo!==null&&$pubTo<$now_epoch)){$error='catalog_publication_pack_publisher_not_effective';break;}
        $publisherRevoked=pay_eco_001_catalog_publication_exact_row('SELECT publisher_revocation_id FROM '.TB_PREF.'pay_ctry_publisher_revocations WHERE publisher_id='.(int)$candidate['publisher_id'].' AND effective_at<='.pay_ctry_001_sql_hex($nowSql).' LIMIT 2 FOR UPDATE',$error,true);if($publisherRevoked===false)break;if(is_array($publisherRevoked)){$error='catalog_publication_pack_publisher_revoked';break;}
        $signing=pay_eco_001_catalog_publication_exact_row('SELECT s.signer_id,k.trust_key_id,k.key_sha256,k.valid_from,k.valid_to FROM '.TB_PREF.'pay_ctry_signers s INNER JOIN '.TB_PREF.'pay_ctry_trust_keys k ON k.signer_id=s.signer_id WHERE s.publisher_id='.(int)$candidate['publisher_id'].' AND s.signer_code='.pay_ctry_001_sql_hex((string)$candidate['signer_code']).' AND k.key_id='.pay_ctry_001_sql_hex((string)$candidate['key_id']).' LIMIT 2 FOR UPDATE',$error,false);if($signing===false)break;
        $keyRevoked=pay_eco_001_catalog_publication_exact_row('SELECT key_revocation_id FROM '.TB_PREF.'pay_ctry_trust_key_revocations WHERE trust_key_id='.(int)$signing['trust_key_id'].' AND effective_at<='.pay_ctry_001_sql_hex($nowSql).' LIMIT 2 FOR UPDATE',$error,true);if($keyRevoked===false)break;if(is_array($keyRevoked)){$error='catalog_publication_signing_authority_revoked';break;}
        $currentTrustSnapshot=pay_eco_001_hash(array('publisher_id'=>(int)$candidate['publisher_id'],'publisher_identity_sha256'=>(string)$candidate['publisher_identity_sha256'],'publisher_valid_from'=>(string)$candidate['valid_from'],'publisher_valid_to'=>$candidate['valid_to']===null?null:(string)$candidate['valid_to'],'publisher_effective'=>true,'publisher_revoked'=>false,'trust_key_id'=>(int)$signing['trust_key_id'],'key_sha256'=>(string)$signing['key_sha256'],'key_revoked'=>false));if(!hash_equals((string)$admission['trust_snapshot_sha256'],$currentTrustSnapshot)){$error='catalog_publication_trust_snapshot_drift';break;}
        $cert=pay_eco_001_catalog_publication_certification((int)$request['certification_publication_id'],(int)$candidate['pack_version_id'],(string)$candidate['pack_semantic_root'],(string)$candidate['pack_evidence_root'],$now_epoch,$error,true);if($cert===false)break;
