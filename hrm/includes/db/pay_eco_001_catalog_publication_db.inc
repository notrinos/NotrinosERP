function pay_eco_001_catalog_publication_iso($sql_value,&$error)
{
    $epoch=strtotime((string)$sql_value.' UTC');
    if($epoch===false)return pay_eco_001_fail($error,'catalog_publication_time_state_invalid');
    return gmdate('Y-m-d\TH:i:s\Z',$epoch);
}
function pay_eco_001_catalog_publication_exact_row($sql,&$error,$allow_none=false)
{
    return pay_eco_001_onboarding_exact_row($sql,$error,$allow_none);
}
