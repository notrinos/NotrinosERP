        $entryRoot=pay_eco_001_catalog_publication_entry_sha256($entry);if(!hash_equals($entryRoot,(string)$catalog['release']['catalog_root_sha256'])){$error='catalog_publication_catalog_root_mismatch';break;}
        $existing=pay_eco_001_catalog_publication_exact_row('SELECT * FROM '.TB_PREF.'pay_eco_001_catalog_publications WHERE catalog_candidate_id='.(int)$candidate['catalog_candidate_id'].' LIMIT 2 FOR UPDATE',$error,true);if($existing===false)break;
        if(is_array($existing)){
            if((int)$existing['catalog_decision_id']!==(int)$decision['catalog_decision_id']||(int)$existing['artifact_admission_id']!==(int)$admission['artifact_admission_id']||(int)$existing['certification_publication_id']!==(int)$request['certification_publication_id']||(int)$existing['catalog_release_id']!==(int)$request['catalog_release_id']||(int)$existing['catalog_admission_id']!==(int)$request['catalog_admission_id']||(int)$existing['published_by']!==$actor||!hash_equals((string)$existing['catalog_root_sha256'],$entryRoot)){$error='catalog_publication_replay_conflict';break;}
