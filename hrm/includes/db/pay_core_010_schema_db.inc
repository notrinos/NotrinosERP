function hrm_pay_core_010_require_zero_rows($patch,array $groups=null){$wanted=$groups===null?array_keys(hrm_pay_core_010_schema_groups()):$groups;$map=hrm_pay_core_010_schema_groups();foreach($wanted as $group)foreach($map[$group] as $table){$q=db_query('SELECT COUNT(*) n FROM '.TB_PREF.$table);$r=$q?db_fetch_assoc($q):false;if(!$r||(int)$r['n']!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-CORE-010 custody must activate with zero rows in '.$table.'.');}return true;}
