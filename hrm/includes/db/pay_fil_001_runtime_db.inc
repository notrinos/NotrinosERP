<?php
/** PAY-FIL-001 governed pre-submission runtime: approved source binding, internal rendering and validation evidence. */
include_once($path_to_root.'/includes/pay_fil_001_contract.inc');
include_once($path_to_root.'/hrm/includes/db/pay_core_010_governance_db.inc');

function pay_fil_001_runtime_fail(&$error,$code){$error=$code;return false;}
function pay_fil_001_actor(){return isset($_SESSION['wa_current_user']->user)?(int)$_SESSION['wa_current_user']->user:0;}
function pay_fil_001_company(){return isset($_SESSION['wa_current_user']->company)?(int)$_SESSION['wa_current_user']->company:-1;}
function pay_fil_001_access($permission){return function_exists('user_check_access')&&user_check_access($permission);}
function pay_fil_001_require_access($permission,&$error){return pay_fil_001_access($permission)?true:pay_fil_001_runtime_fail($error,'permission_denied');}
function pay_fil_001_now(){return gmdate('Y-m-d H:i:s');}
function pay_fil_001_one($sql){$q=db_query($sql);if(!$q||db_num_rows($q)!==1)return false;return db_fetch_assoc($q);}
function pay_fil_001_rows($sql){$q=db_query($sql);if(!$q)return false;$rows=array();while($r=db_fetch_assoc($q))$rows[]=$r;return $rows;}
function pay_fil_001_sql_nullable($v){return $v===null?'NULL':db_escape($v);}
function pay_fil_001_begin_owned(&$error){global $transaction_level;if(!empty($transaction_level))return pay_fil_001_runtime_fail($error,'owned_transaction_required');begin_transaction();return true;}

function pay_fil_001_obligation_replay_matches(array $row,array $ob)
{
    foreach(array('company_id','legal_entity_id') as $k)if((int)$row[$k]!== (int)$ob[$k])return false;
    foreach(array('jurisdiction_code','obligation_type','period_start','period_end','due_date','filing_frequency','country_pack_id','country_pack_version','schema_id','schema_version','connector_id','connector_version','obligation_sha256') as $k)if((string)$row[$k]!== (string)$ob[$k])return false;
    return true;
}
function pay_fil_001_source_set_replay_matches(array $set,$ob_id,$set_sha,array $links,&$error)
{
    if((int)$set['filing_obligation_id']!==(int)$ob_id||!hash_equals((string)$set['source_set_sha256'],(string)$set_sha))return pay_fil_001_runtime_fail($error,'filing_source_set_replay_mismatch');
    $counts=array('run'=>0,'result'=>0,'line'=>0,'balance'=>0,'liability'=>0);foreach($links as $link)$counts[$link['source_kind']]++;
    foreach(array('run','result','line','balance','liability') as $kind)if((int)$set[$kind.'_count']!==$counts[$kind])return pay_fil_001_runtime_fail($error,'filing_source_set_replay_mismatch');
    $currency=(string)$links[0]['currency_code'];if((string)$set['currency_code']!==$currency||(int)$set['liability_total_minor']!==0)return pay_fil_001_runtime_fail($error,'filing_source_set_replay_mismatch');
    $rows=pay_fil_001_rows('SELECT link_no,source_kind,source_key,source_sha256,predecessor_source_sha256,run_kind,currency_code,amount_minor,source_link_sha256 FROM '.TB_PREF.'hrm_pay_fil_001_source_links WHERE filing_source_set_id='.(int)$set['filing_source_set_id'].' ORDER BY link_no');
    if($rows===false||count($rows)!==count($links))return pay_fil_001_runtime_fail($error,'filing_source_link_replay_mismatch');
    foreach($links as $i=>$link){$link['source_set_sha256']=$set_sha;$expected=pay_fil_001_validate_source_link($link,$le);if($expected===false)return pay_fil_001_runtime_fail($error,$le?$le:'filing_source_link_replay_invalid');$row=$rows[$i];foreach(array('link_no','amount_minor') as $k)if((int)$row[$k]!== (int)$expected[$k])return pay_fil_001_runtime_fail($error,'filing_source_link_replay_mismatch');foreach(array('source_kind','source_key','source_sha256','run_kind','currency_code','source_link_sha256') as $k)if((string)$row[$k]!== (string)$expected[$k])return pay_fil_001_runtime_fail($error,'filing_source_link_replay_mismatch');$pred=is_null($row['predecessor_source_sha256'])?'':(string)$row['predecessor_source_sha256'];if($pred!==(string)$expected['predecessor_source_sha256'])return pay_fil_001_runtime_fail($error,'filing_source_link_replay_mismatch');}
    return true;
}

/** Require one current approved PAY-CORE-010 result set and return exact approval/result custody. */
function pay_fil_001_current_approved_run($period_id,$for_update=false,&$error=null)
{
    $error=null;$period_id=(int)$period_id;
    $results=hrm_pay_core_010_result_set_for_period($period_id,$for_update,$error);if($results===false)return false;
    $scope=$results['scope'];
    $state=hrm_pay_core_010_state_for_scope(array('payroll_group_id'=>(int)$scope['payroll_group_id'],'legal_entity_id'=>(int)$scope['legal_entity_id']),$for_update,$se);
    if($state===false||$state['state']!=='active_new'||!hrm_pay_core_010_is_sha256($state['transition_sha256']))return pay_fil_001_runtime_fail($error,$se?$se:'pay_core_010_not_active_new');
    $projection=hrm_pay_core_010_existing_projection_set($period_id,$pe);if($projection===false)return pay_fil_001_runtime_fail($error,$pe?$pe:'projection_missing');
    $sql='SELECT a.approval_id,a.result_set_sha256,a.projection_set_sha256,a.intent_sha256,a.approval_sha256,a.approver_id,i.maker_id '
        .'FROM '.TB_PREF.'hrm_pay_core_010_approvals a INNER JOIN '.TB_PREF.'hrm_pay_core_010_approval_intents i ON i.approval_intent_id=a.approval_intent_id '
        .'WHERE a.payroll_period_id='.$period_id." AND LOWER(a.decision_token)='approved' ORDER BY a.approval_id DESC LIMIT 2".($for_update?' FOR UPDATE':'');
    $rows=pay_fil_001_rows($sql);if($rows===false||count($rows)!==1)return pay_fil_001_runtime_fail($error,'approved_result_ambiguous_or_missing');$approval=$rows[0];
    if(!hash_equals((string)$approval['result_set_sha256'],(string)$results['set']['result_set_sha256'])||!hash_equals((string)$approval['projection_set_sha256'],(string)$projection['projection_set_sha256']))return pay_fil_001_runtime_fail($error,'approved_result_custody_mismatch');
    if((int)$approval['maker_id']<1||(int)$approval['approver_id']<1||(int)$approval['maker_id']===(int)$approval['approver_id'])return pay_fil_001_runtime_fail($error,'approved_result_maker_checker_invalid');
    return array('period_id'=>$period_id,'scope'=>$scope,'state'=>$state,'results'=>$results,'projection'=>$projection,'approval'=>$approval);
}

/** Deterministically derive immutable run/result links from approved PAY-CORE-010 custody only. */
function pay_fil_001_derive_approved_sources(array $obligation,array $periods,&$error=null)
{
    $error=null;if(count($periods)<1)return pay_fil_001_runtime_fail($error,'filing_periods_missing');$links=array();$seen=array();$currency=null;$link_no=0;
    foreach($periods as $spec){
        if(!is_array($spec)||!isset($spec['period_id'])||!isset($spec['run_kind'])||!in_array($spec['run_kind'],array('regular','offcycle','correction'),true))return pay_fil_001_runtime_fail($error,'filing_period_spec_invalid');
        $pid=pay_fil_001_posint($spec['period_id']);if($pid===false||isset($seen[$pid]))return pay_fil_001_runtime_fail($error,'filing_period_duplicate_or_invalid');$seen[$pid]=true;
        $run=pay_fil_001_current_approved_run($pid,true,$re);if($run===false)return pay_fil_001_runtime_fail($error,$re?$re:'approved_run_missing');$scope=$run['scope'];
        if((int)$scope['legal_entity_id']!==(int)$obligation['legal_entity_id']||(string)$scope['from_date']<(string)$obligation['period_start']||(string)$scope['to_date']>(string)$obligation['period_end'])return pay_fil_001_runtime_fail($error,'filing_period_scope_mismatch');
        $run_basis=array('period_id'=>$pid,'calendar_period_id'=>(int)$scope['calendar_period_id'],'payroll_group_id'=>(int)$scope['payroll_group_id'],'legal_entity_id'=>(int)$scope['legal_entity_id'],'period_sha256'=>(string)$scope['period_sha256'],'result_set_sha256'=>(string)$run['results']['set']['result_set_sha256'],'projection_set_sha256'=>(string)$run['projection']['projection_set_sha256'],'approval_sha256'=>(string)$run['approval']['approval_sha256'],'cutover_transition_sha256'=>(string)$run['state']['transition_sha256']);
        $link_no++;$links[]=array('link_no'=>$link_no,'source_kind'=>'run','source_key'=>'period:'.$pid,'source_sha256'=>pay_fil_001_hash($run_basis),'predecessor_source_sha256'=>'','run_kind'=>$spec['run_kind'],'currency_code'=>'XXX','amount_minor'=>0);
        foreach($run['results']['rows'] as $row){$cc=strtoupper((string)$row['currency']);if(!preg_match('/^[A-Z]{3}$/D',$cc))return pay_fil_001_runtime_fail($error,'filing_result_currency_invalid');if($currency===null)$currency=$cc;if($currency!==$cc)return pay_fil_001_runtime_fail($error,'filing_multi_currency_source_set_denied');$link_no++;$links[]=array('link_no'=>$link_no,'source_kind'=>'result','source_key'=>'result:'.(int)$row['result_id'],'source_sha256'=>(string)$row['result_sha256'],'predecessor_source_sha256'=>'','run_kind'=>$spec['run_kind'],'currency_code'=>$cc,'amount_minor'=>0);}
    }
    if($currency===null)return pay_fil_001_runtime_fail($error,'filing_result_set_empty');foreach($links as $i=>$link)if($link['currency_code']==='XXX')$links[$i]['currency_code']=$currency;
    return $links;
}

/** Create or replay one immutable filing obligation and exact approved run/result source set. */
function pay_fil_001_prepare_obligation_sources(array $obligation,array $periods,&$error=null)
{
    $error=null;if(!pay_fil_001_require_access(PAY_FIL_001_PREPARE_PERMISSION,$error))return false;$actor=pay_fil_001_actor();$company=pay_fil_001_company();if($actor<=0||$company<0)return pay_fil_001_runtime_fail($error,'actor_or_company_missing');
    $obligation['company_id']=$company;$ob=pay_fil_001_validate_obligation($obligation,$oe);if($ob===false)return pay_fil_001_runtime_fail($error,$oe?$oe:'filing_obligation_invalid');
    if($ob['schema_id']!=='internal-reconciliation-only'||$ob['schema_version']!=='1'||$ob['connector_id']!=='none'||$ob['connector_version']!=='0')return pay_fil_001_runtime_fail($error,'official_schema_or_connector_not_enabled');
    if(!pay_fil_001_begin_owned($error))return false;$ok=false;
    $links=pay_fil_001_derive_approved_sources($ob,$periods,$error);if($links===false){rollback_transaction();return false;}
    $at=pay_fil_001_now();$existing=pay_fil_001_one('SELECT * FROM '.TB_PREF.'hrm_pay_fil_001_obligations WHERE obligation_sha256='.db_escape($ob['obligation_sha256']).' LIMIT 2');
    if($existing){if(!pay_fil_001_obligation_replay_matches($existing,$ob)){rollback_transaction();return pay_fil_001_runtime_fail($error,'filing_obligation_replay_mismatch');}$ob_id=(int)$existing['filing_obligation_id'];}else{
        $sem=pay_fil_001_rows('SELECT filing_obligation_id,obligation_sha256 FROM '.TB_PREF.'hrm_pay_fil_001_obligations WHERE company_id='.$company.' AND legal_entity_id='.(int)$ob['legal_entity_id'].' AND jurisdiction_code='.db_escape($ob['jurisdiction_code']).' AND obligation_type='.db_escape($ob['obligation_type']).' AND period_end='.db_escape($ob['period_end']).' AND country_pack_version='.db_escape($ob['country_pack_version']).' AND schema_version='.db_escape($ob['schema_version']).' LIMIT 2 FOR UPDATE');
        if($sem===false||count($sem)>0){rollback_transaction();return pay_fil_001_runtime_fail($error,'filing_obligation_semantic_conflict');}
        $sql='INSERT INTO '.TB_PREF.'hrm_pay_fil_001_obligations (company_id,legal_entity_id,jurisdiction_code,obligation_type,period_start,period_end,due_date,filing_frequency,country_pack_id,country_pack_version,schema_id,schema_version,connector_id,connector_version,obligation_sha256,prepared_by,prepared_at,created_at) VALUES ('.(int)$company.','.(int)$ob['legal_entity_id'].','.db_escape($ob['jurisdiction_code']).','.db_escape($ob['obligation_type']).','.db_escape($ob['period_start']).','.db_escape($ob['period_end']).','.db_escape($ob['due_date']).','.db_escape($ob['filing_frequency']).','.db_escape($ob['country_pack_id']).','.db_escape($ob['country_pack_version']).','.db_escape($ob['schema_id']).','.db_escape($ob['schema_version']).','.db_escape($ob['connector_id']).','.db_escape($ob['connector_version']).','.db_escape($ob['obligation_sha256']).','.$actor.','.db_escape($at).','.db_escape($at).')';
        if(!db_query($sql)){rollback_transaction();return pay_fil_001_runtime_fail($error,'filing_obligation_insert_failed');}$ob_id=(int)db_insert_id();
    }
    $basis=array('obligation_sha256'=>$ob['obligation_sha256'],'source_links'=>$links);$set_sha=pay_fil_001_hash($basis);$set=pay_fil_001_one('SELECT * FROM '.TB_PREF.'hrm_pay_fil_001_source_sets WHERE source_set_sha256='.db_escape($set_sha).' LIMIT 2');if($set){if(!pay_fil_001_source_set_replay_matches($set,$ob_id,$set_sha,$links,$error)){rollback_transaction();return false;}commit_transaction();return array('filing_obligation_id'=>$ob_id,'filing_source_set_id'=>(int)$set['filing_source_set_id'],'obligation_sha256'=>$ob['obligation_sha256'],'source_set_sha256'=>$set_sha,'replayed'=>true);}
    $counts=array('run'=>0,'result'=>0,'line'=>0,'balance'=>0,'liability'=>0);foreach($links as $link)$counts[$link['source_kind']]++;
    $currency=$links[0]['currency_code'];$sql='INSERT INTO '.TB_PREF.'hrm_pay_fil_001_source_sets (filing_obligation_id,source_set_sha256,run_count,result_count,line_count,balance_count,liability_count,currency_code,liability_total_minor,bound_by,bound_at,created_at) VALUES ('.$ob_id.','.db_escape($set_sha).','.$counts['run'].','.$counts['result'].','.$counts['line'].','.$counts['balance'].','.$counts['liability'].','.db_escape($currency).',0,'.$actor.','.db_escape($at).','.db_escape($at).')';if(!db_query($sql)){rollback_transaction();return pay_fil_001_runtime_fail($error,'filing_source_set_insert_failed');}$set_id=(int)db_insert_id();
    foreach($links as $link){$link['source_set_sha256']=$set_sha;$v=pay_fil_001_validate_source_link($link,$le);if($v===false){rollback_transaction();return pay_fil_001_runtime_fail($error,$le?$le:'filing_source_link_invalid');}$pred=$v['predecessor_source_sha256']===''?null:$v['predecessor_source_sha256'];$sql='INSERT INTO '.TB_PREF.'hrm_pay_fil_001_source_links (filing_source_set_id,link_no,source_kind,source_key,source_sha256,predecessor_source_sha256,run_kind,currency_code,amount_minor,source_link_sha256,created_at) VALUES ('.$set_id.','.(int)$v['link_no'].','.db_escape($v['source_kind']).','.db_escape($v['source_key']).','.db_escape($v['source_sha256']).','.pay_fil_001_sql_nullable($pred).','.db_escape($v['run_kind']).','.db_escape($v['currency_code']).','.(int)$v['amount_minor'].','.db_escape($v['source_link_sha256']).','.db_escape($at).')';if(!db_query($sql)){rollback_transaction();return pay_fil_001_runtime_fail($error,'filing_source_link_insert_failed');}}
    commit_transaction();return array('filing_obligation_id'=>$ob_id,'filing_source_set_id'=>$set_id,'obligation_sha256'=>$ob['obligation_sha256'],'source_set_sha256'=>$set_sha,'replayed'=>false);
}

/** Render a data-minimized internal reconciliation envelope; this is never an official filing form. */
function pay_fil_001_render_internal_envelope($filing_source_set_id,&$error=null)
{
    $error=null;if(!pay_fil_001_require_access(PAY_FIL_001_REVIEW_PERMISSION,$error))return false;$actor=pay_fil_001_actor();$company=pay_fil_001_company();if($actor<=0||$company<0)return pay_fil_001_runtime_fail($error,'actor_or_company_missing');
    $sql='SELECT s.*,o.company_id,o.legal_entity_id,o.jurisdiction_code,o.obligation_type,o.period_start,o.period_end,o.due_date,o.country_pack_id,o.country_pack_version,o.schema_id,o.schema_version,o.connector_id,o.connector_version,o.obligation_sha256 FROM '.TB_PREF.'hrm_pay_fil_001_source_sets s INNER JOIN '.TB_PREF.'hrm_pay_fil_001_obligations o ON o.filing_obligation_id=s.filing_obligation_id WHERE s.filing_source_set_id='.(int)$filing_source_set_id.' LIMIT 2';$s=pay_fil_001_one($sql);if(!$s||(int)$s['company_id']!==$company)return pay_fil_001_runtime_fail($error,'filing_source_set_missing_or_scope_denied');
    if($s['schema_id']!=='internal-reconciliation-only'||$s['schema_version']!=='1'||$s['connector_id']!=='none'||$s['connector_version']!=='0')return pay_fil_001_runtime_fail($error,'official_schema_or_connector_not_enabled');
    $links=pay_fil_001_rows('SELECT link_no,source_kind,source_key,source_sha256,predecessor_source_sha256,run_kind,currency_code,amount_minor,source_link_sha256 FROM '.TB_PREF.'hrm_pay_fil_001_source_links WHERE filing_source_set_id='.(int)$filing_source_set_id.' ORDER BY link_no');if($links===false||count($links)!==(int)$s['run_count']+(int)$s['result_count']+(int)$s['line_count']+(int)$s['balance_count']+(int)$s['liability_count'])return pay_fil_001_runtime_fail($error,'filing_source_link_count_mismatch');
    $basis_links=array();foreach($links as $row){$base=array('link_no'=>(int)$row['link_no'],'source_kind'=>(string)$row['source_kind'],'source_key'=>(string)$row['source_key'],'source_sha256'=>(string)$row['source_sha256'],'predecessor_source_sha256'=>is_null($row['predecessor_source_sha256'])?'':(string)$row['predecessor_source_sha256'],'run_kind'=>(string)$row['run_kind'],'currency_code'=>(string)$row['currency_code'],'amount_minor'=>(int)$row['amount_minor']);$check=$base;$check['source_set_sha256']=(string)$s['source_set_sha256'];$valid=pay_fil_001_validate_source_link($check,$ve);if($valid===false||!hash_equals((string)$row['source_link_sha256'],(string)$valid['source_link_sha256']))return pay_fil_001_runtime_fail($error,'filing_source_link_custody_mismatch');$basis_links[]=$base;}if(!hash_equals((string)$s['source_set_sha256'],(string)pay_fil_001_hash(array('obligation_sha256'=>(string)$s['obligation_sha256'],'source_links'=>$basis_links))))return pay_fil_001_runtime_fail($error,'filing_source_set_custody_mismatch');
    $envelope=array('format'=>'pay-fil-001.internal-source-envelope','version'=>'1.0','authority'=>'non-authoritative-internal-reconciliation-only','company_id'=>$company,'legal_entity_id'=>(int)$s['legal_entity_id'],'jurisdiction_code'=>$s['jurisdiction_code'],'obligation_type'=>$s['obligation_type'],'period_start'=>$s['period_start'],'period_end'=>$s['period_end'],'due_date'=>$s['due_date'],'obligation_sha256'=>$s['obligation_sha256'],'source_set_sha256'=>$s['source_set_sha256'],'country_pack_id'=>$s['country_pack_id'],'country_pack_version'=>$s['country_pack_version'],'schema_id'=>$s['schema_id'],'schema_version'=>$s['schema_version'],'connector_id'=>'none','connector_version'=>'0','currency_code'=>$s['currency_code'],'links'=>$links);
    $payload=json_encode(pay_fil_001_canonicalize($envelope),JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_PRESERVE_ZERO_FRACTION);if(!is_string($payload))return pay_fil_001_runtime_fail($error,'filing_internal_render_failed');$payload_sha=hash('sha256',$payload);
    $artifact_basis=array('obligation_sha256'=>$s['obligation_sha256'],'source_set_sha256'=>$s['source_set_sha256'],'renderer_id'=>'pay-fil-001.internal-source-envelope','renderer_version'=>'1.0','schema_id'=>$s['schema_id'],'schema_version'=>$s['schema_version'],'media_type'=>'application/json','payload_sha256'=>$payload_sha,'byte_length'=>strlen($payload));$artifact_sha=pay_fil_001_hash($artifact_basis);$at=pay_fil_001_now();
    $existing=pay_fil_001_one('SELECT * FROM '.TB_PREF.'hrm_pay_fil_001_artifacts WHERE artifact_sha256='.db_escape($artifact_sha).' LIMIT 2');if(!$existing){$sql='INSERT INTO '.TB_PREF.'hrm_pay_fil_001_artifacts (filing_obligation_id,filing_source_set_id,obligation_sha256,source_set_sha256,renderer_id,renderer_version,schema_id,schema_version,media_type,payload_sha256,byte_length,artifact_sha256,rendered_by,rendered_at,created_at) VALUES ('.(int)$s['filing_obligation_id'].','.(int)$s['filing_source_set_id'].','.db_escape($s['obligation_sha256']).','.db_escape($s['source_set_sha256']).',\'pay-fil-001.internal-source-envelope\',\'1.0\','.db_escape($s['schema_id']).','.db_escape($s['schema_version']).',\'application/json\','.db_escape($payload_sha).','.strlen($payload).','.db_escape($artifact_sha).','.$actor.','.db_escape($at).','.db_escape($at).')';if(!db_query($sql)){$existing=pay_fil_001_one('SELECT * FROM '.TB_PREF.'hrm_pay_fil_001_artifacts WHERE artifact_sha256='.db_escape($artifact_sha).' LIMIT 2');if(!$existing)return pay_fil_001_runtime_fail($error,'filing_artifact_insert_failed');}$artifact_id=$existing?(int)$existing['filing_artifact_id']:(int)db_insert_id();}else $artifact_id=(int)$existing['filing_artifact_id'];if($existing&&((int)$existing['filing_obligation_id']!==(int)$s['filing_obligation_id']||(int)$existing['filing_source_set_id']!==(int)$s['filing_source_set_id']||!hash_equals((string)$existing['obligation_sha256'],(string)$s['obligation_sha256'])||!hash_equals((string)$existing['source_set_sha256'],(string)$s['source_set_sha256'])||(string)$existing['renderer_id']!=='pay-fil-001.internal-source-envelope'||(string)$existing['renderer_version']!=='1.0'||(string)$existing['schema_id']!==(string)$s['schema_id']||(string)$existing['schema_version']!==(string)$s['schema_version']||(string)$existing['media_type']!=='application/json'||!hash_equals((string)$existing['payload_sha256'],$payload_sha)||(int)$existing['byte_length']!==strlen($payload)))return pay_fil_001_runtime_fail($error,'filing_artifact_replay_mismatch');
    return array('filing_artifact_id'=>$artifact_id,'artifact_sha256'=>$artifact_sha,'payload_sha256'=>$payload_sha,'payload'=>$payload,'official_form'=>false,'submission_authorized'=>false);
}

/** Recompute and append internal validation evidence. Validation never authorizes or submits. */
function pay_fil_001_validate_internal_artifact($filing_artifact_id,$payload,&$error=null)
{
