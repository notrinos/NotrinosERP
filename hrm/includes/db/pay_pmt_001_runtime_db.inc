/** Independently reconcile approved result -> intent -> batch -> artifact -> transmission -> settlement -> PAY-GL hash. */
function pay_pmt_001_reconcile_payment($outbox_id,$payment_settlement_id=null,&$error=null){
 $error=null;
 if(!pay_pmt_001_require_access(PAY_PMT_001_REVIEW_PERMISSION,$error))return false;
 $actor=pay_pmt_001_current_actor();
 $sql='SELECT o.outbox_id,o.payment_artifact_id,o.artifact_sha256,a.batch_release_id,a.total_minor artifact_minor,br.payment_batch_id,b.batch_sha256,b.total_minor batch_minor,b.currency_code,b.prepared_by,bi.payment_item_id,it.source_result_sha256,it.payment_intent_id,pi.intent_sha256,pi.total_minor intent_minor,pi.payroll_period_id,pi.result_set_sha256,pi.approval_sha256,pi.pay_gl_journal_sha256,pi.prepared_by intent_prepared_by FROM '.TB_PREF.'hrm_pay_pmt_001_outbox o JOIN '.TB_PREF.'hrm_pay_pmt_001_artifacts a ON a.payment_artifact_id=o.payment_artifact_id JOIN '.TB_PREF.'hrm_pay_pmt_001_batch_releases br ON br.batch_release_id=a.batch_release_id JOIN '.TB_PREF.'hrm_pay_pmt_001_batches b ON b.payment_batch_id=br.payment_batch_id JOIN '.TB_PREF.'hrm_pay_pmt_001_batch_items bi ON bi.payment_batch_id=b.payment_batch_id JOIN '.TB_PREF.'hrm_pay_pmt_001_payment_items it ON it.payment_item_id=bi.payment_item_id JOIN '.TB_PREF.'hrm_pay_pmt_001_payment_intents pi ON pi.payment_intent_id=it.payment_intent_id WHERE o.outbox_id='.(int)$outbox_id.' ORDER BY pi.payment_intent_id,bi.batch_item_no';
 $rows=pay_pmt_001_db_rows($sql);
 if($rows===false||!count($rows)||$actor<=0)return pay_pmt_001_runtime_fail($error,'reconciliation_scope_missing');
 $intentIds=array_values(array_unique(array_map(function($x){return (int)$x['payment_intent_id'];},$rows)));
 if(count($intentIds)!==1)return pay_pmt_001_runtime_fail($error,'reconciliation_requires_single_intent_batch');
 $r=$rows[0];
 if($actor===(int)$r['prepared_by']||$actor===(int)$r['intent_prepared_by'])return pay_pmt_001_runtime_fail($error,'independent_reviewer_required');

 /* Re-resolve the current approved immutable payroll result set rather than trusting PAY-PMT totals. */
 $core=pay_pmt_001_current_approval((int)$r['payroll_period_id'],false,$ce);
 if($core===false)return pay_pmt_001_runtime_fail($error,$ce?:'current_approved_result_missing');
 if(!hash_equals((string)$core['results']['set']['result_set_sha256'],(string)$r['result_set_sha256'])||!hash_equals((string)$core['approval']['approval_sha256'],(string)$r['approval_sha256']))return pay_pmt_001_runtime_fail($error,'reconciliation_payroll_custody_stale');
 $currentSource=array();$approved=0;
 foreach($core['results']['rows'] as $result){
  $currency=pay_pmt_001_currency($result['currency']);
  if($currency===false)return pay_pmt_001_runtime_fail($error,'reconciliation_currency_invalid');
  if($currency!==(string)$r['currency_code'])continue;
  $minor=pay_pmt_001_decimal_to_minor($result['net_amount'],$me);
  if($minor===false)return pay_pmt_001_runtime_fail($error,$me?:'reconciliation_approved_amount_invalid');
  $approved+=$minor;$currentSource[]=(string)$result['result_sha256'];
 }
 sort($currentSource,SORT_STRING);
 $custodySource=array_values(array_unique(array_map(function($x){return (string)$x['source_result_sha256'];},$rows)));
 sort($custodySource,SORT_STRING);
 if(empty($currentSource)||$currentSource!==$custodySource)return pay_pmt_001_runtime_fail($error,'reconciliation_result_membership_mismatch');
 $journal=pay_pmt_001_current_gl_journal($core,(string)$r['currency_code'],$ge);
 if($journal===false)return pay_pmt_001_runtime_fail($error,$ge?:'reconciliation_pay_gl_binding_missing');
 if(!hash_equals((string)$journal['journal_sha256'],(string)$r['pay_gl_journal_sha256']))return pay_pmt_001_runtime_fail($error,'reconciliation_pay_gl_binding_stale');

 $attempts=pay_pmt_001_db_rows('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_transmission_attempts WHERE outbox_id='.(int)$outbox_id.' ORDER BY attempt_no DESC LIMIT 1');
 if($attempts===false||count($attempts)!==1)return pay_pmt_001_runtime_fail($error,'transmission_evidence_missing');
 $attempt=$attempts[0];
 $settlement=null;$settled=0;$settleEvidence=null;
 if($payment_settlement_id!==null){
  $settlement=pay_pmt_001_db_one('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_settlements WHERE payment_settlement_id='.(int)$payment_settlement_id.' AND outbox_id='.(int)$outbox_id.' LIMIT 2');
  if(!$settlement)return pay_pmt_001_runtime_fail($error,'settlement_evidence_missing');
  if((string)$settlement['currency_code']!==(string)$r['currency_code'])return pay_pmt_001_runtime_fail($error,'settlement_currency_mismatch');
  $settled=(int)$settlement['settled_minor'];$settleEvidence=$settlement['evidence_sha256'];
 }
 $status=($payment_settlement_id!==null&&$attempt['attempt_status']==='acknowledged'&&$approved===(int)$r['intent_minor']&&$approved===(int)$r['batch_minor']&&$approved===(int)$r['artifact_minor']&&$approved===$settled)?'reconciled':'discrepancy';
 $disc=$status==='reconciled'?null:'amount_or_evidence_mismatch';
 $basis=array('payment_intent_sha256'=>$r['intent_sha256'],'batch_sha256'=>$r['batch_sha256'],'artifact_sha256'=>$r['artifact_sha256'],'transmission_evidence_sha256'=>$attempt['result_evidence_sha256'],'settlement_evidence_sha256'=>$settleEvidence,'pay_gl_journal_sha256'=>$journal['journal_sha256'],'currency_code'=>$r['currency_code'],'approved_minor'=>$approved,'intent_minor'=>(int)$r['intent_minor'],'batch_minor'=>(int)$r['batch_minor'],'artifact_minor'=>(int)$r['artifact_minor'],'settled_minor'=>$settled,'status'=>$status);
 $sha=pay_pmt_001_reconciliation_sha256($basis);
 $existing=pay_pmt_001_db_one('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_reconciliations WHERE reconciliation_sha256='.db_escape($sha).' LIMIT 2');
 if($existing)return $existing;
 $at=pay_pmt_001_now();
 $sql='INSERT INTO '.TB_PREF.'hrm_pay_pmt_001_reconciliations (payment_intent_id,payment_batch_id,payment_artifact_id,outbox_id,payment_settlement_id,payment_intent_sha256,batch_sha256,artifact_sha256,transmission_evidence_sha256,settlement_evidence_sha256,pay_gl_journal_sha256,currency_code,approved_minor,intent_minor,batch_minor,artifact_minor,settled_minor,status,discrepancy_code,reconciliation_sha256,reviewer_id,reviewed_at,created_at) VALUES ('.(int)$r['payment_intent_id'].','.(int)$r['payment_batch_id'].','.(int)$r['payment_artifact_id'].','.(int)$outbox_id.','.($payment_settlement_id===null?'NULL':(int)$payment_settlement_id).','.db_escape($basis['payment_intent_sha256']).','.db_escape($basis['batch_sha256']).','.db_escape($basis['artifact_sha256']).','.db_escape($basis['transmission_evidence_sha256']).','.pay_pmt_001_sql_nullable($basis['settlement_evidence_sha256']).','.db_escape($basis['pay_gl_journal_sha256']).','.db_escape($basis['currency_code']).','.$basis['approved_minor'].','.$basis['intent_minor'].','.$basis['batch_minor'].','.$basis['artifact_minor'].','.$basis['settled_minor'].','.db_escape($status).','.pay_pmt_001_sql_nullable($disc).','.db_escape($sha).','.$actor.','.db_escape($at).','.db_escape($at).')';
 if(!db_query($sql))return pay_pmt_001_runtime_fail($error,'reconciliation_insert_failed');
 return array('payment_reconciliation_id'=>(int)db_insert_id(),'reconciliation_sha256'=>$sha,'status'=>$status,'discrepancy_code'=>$disc);
}

/** Maker stage for final legacy payment cutover, persisted in existing PAY-AUD append-only custody. */
function pay_pmt_001_prepare_cutover($legal_entity_id,$payroll_group_id,$effective_from,&$error=null){
 $error=null;if(!pay_pmt_001_require_access(PAY_PMT_001_RECOVER_PERMISSION,$error))return false;$actor=pay_pmt_001_current_actor();$company=pay_pmt_001_current_company();$date=pay_pmt_001_date($effective_from);if($actor<=0||$company<0||(int)$legal_entity_id<=0||(int)$payroll_group_id<=0||$date===false)return pay_pmt_001_runtime_fail($error,'cutover_scope_invalid');$proposal=pay_pmt_001_hash(array('company_id'=>$company,'legal_entity_id'=>(int)$legal_entity_id,'payroll_group_id'=>(int)$payroll_group_id,'effective_from'=>$date,'maker_id'=>$actor));$event=append_domain_audit_event(array('company_id'=>$company,'legal_entity_id'=>(int)$legal_entity_id,'entity_type'=>'pay-pmt-001-cutover','entity_key'=>$proposal,'action'=>'prepared','reason_code'=>'pay-pmt-001-cutover-prepared','restricted_diff'=>array('proposal_sha256'=>$proposal,'payroll_group_id'=>(int)$payroll_group_id,'effective_from'=>$date,'maker_id'=>$actor,'historical_payment_rows_rewritten'=>0)));if(!is_array($event)||empty($event['event_hash']))return pay_pmt_001_runtime_fail($error,'cutover_proposal_audit_failed');return array('proposal_sha256'=>$proposal,'maker_id'=>$actor,'maker_evidence_sha256'=>$event['event_hash']);
}

/** Checker approves cutover. No historical payment rows are rewritten. */
function pay_pmt_001_approve_cutover($legal_entity_id,$payroll_group_id,$effective_from,$proposal_sha256,$assurance_event_sha256,&$error=null){
 $error=null;if(!pay_pmt_001_require_access(PAY_PMT_001_RELEASE_PERMISSION,$error))return false;$actor=pay_pmt_001_current_actor();$company=pay_pmt_001_current_company();$date=pay_pmt_001_date($effective_from);if($actor<=0||$date===false||!pay_pmt_001_sha($proposal_sha256)||!pay_pmt_001_sha($assurance_event_sha256))return pay_pmt_001_runtime_fail($error,'cutover_approval_input_invalid');$rows=pay_pmt_001_db_rows('SELECT actor_user_id,restricted_diff,event_hash FROM '.TB_PREF.'domain_audit_events WHERE company_id='.$company.' AND legal_entity_id='.(int)$legal_entity_id." AND entity_type='pay-pmt-001-cutover' AND action='prepared' AND reason_code='pay-pmt-001-cutover-prepared' ORDER BY event_id DESC LIMIT 10");if($rows===false)return pay_pmt_001_runtime_fail($error,'cutover_proposal_lookup_failed');$maker=0;foreach($rows as $r){$d=json_decode((string)$r['restricted_diff'],true);if(is_array($d)&&isset($d['proposal_sha256'])&&hash_equals((string)$d['proposal_sha256'],$proposal_sha256)){$maker=(int)$r['actor_user_id'];break;}}if($maker<=0||$maker===$actor)return pay_pmt_001_runtime_fail($error,'cutover_maker_checker_required');$basis=array('company_id'=>$company,'legal_entity_id'=>(int)$legal_entity_id,'payroll_group_id'=>(int)$payroll_group_id,'effective_from'=>$date,'proposal_sha256'=>$proposal_sha256,'maker_id'=>$maker,'checker_id'=>$actor,'assurance_event_sha256'=>$assurance_event_sha256);$sha=pay_pmt_001_cutover_sha256($basis);$existing=pay_pmt_001_db_one('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_cutovers WHERE cutover_sha256='.db_escape($sha).' LIMIT 2');if($existing)return $existing;$sql='INSERT INTO '.TB_PREF.'hrm_pay_pmt_001_cutovers (company_id,legal_entity_id,payroll_group_id,effective_from,proposal_sha256,maker_id,checker_id,assurance_event_sha256,cutover_sha256,created_at) VALUES ('.implode(',',array_map('db_escape',array($company,$legal_entity_id,$payroll_group_id,$date,$proposal_sha256,$maker,$actor,$assurance_event_sha256,$sha,pay_pmt_001_now()))).')';if(!db_query($sql))return pay_pmt_001_runtime_fail($error,'cutover_insert_failed');return array('payment_cutover_id'=>(int)db_insert_id(),'cutover_sha256'=>$sha,'maker_id'=>$maker,'checker_id'=>$actor);
}

/** Shared compatibility guard used by the historical direct-bank payment path. */
function pay_pmt_001_legacy_payment_allowed($period_id,&$error=null){
 $error=null;$scope=hrm_pay_core_010_period_scope((int)$period_id,false,$error);if($scope===false)return false;if(!function_exists('hrm_migration_table_exists')||!hrm_migration_table_exists('hrm_pay_pmt_001_cutovers'))return true;$company=pay_pmt_001_current_company();$sql='SELECT payment_cutover_id,effective_from FROM '.TB_PREF.'hrm_pay_pmt_001_cutovers WHERE company_id='.$company.' AND legal_entity_id='.(int)$scope['legal_entity_id'].' AND payroll_group_id='.(int)$scope['payroll_group_id'].' AND effective_from<='.db_escape($scope['to_date']).' ORDER BY effective_from DESC,payment_cutover_id DESC LIMIT 1';$q=db_query($sql);if(!$q)return pay_pmt_001_runtime_fail($error,'pay_pmt_cutover_lookup_failed');if(db_num_rows($q)>0)return pay_pmt_001_runtime_fail($error,'pay_pmt_active_denies_legacy_payment_writer');return true;
}
