 $error=null;$period_id=(int)$period_id;$results=hrm_pay_core_010_result_set_for_period($period_id,$for_update,$error);if($results===false)return false;$scope=$results['scope'];$state=hrm_pay_core_010_state_for_scope(array('payroll_group_id'=>(int)$scope['payroll_group_id'],'legal_entity_id'=>(int)$scope['legal_entity_id']),$for_update,$se);if($state===false||$state['state']!=='active_new'||!hrm_pay_core_010_is_sha256($state['transition_sha256']))return pay_pmt_001_runtime_fail($error,$se?:'pay_core_010_not_active_new');
 $sql="SELECT a.approval_id,a.approval_intent_id,a.payroll_period_id,a.result_set_sha256,a.projection_set_sha256,a.intent_sha256,a.approval_draft_id,a.decision_token,a.approver_id,a.approval_sha256,i.maker_id FROM ".TB_PREF."hrm_pay_core_010_approvals a JOIN ".TB_PREF."hrm_pay_core_010_approval_intents i ON i.approval_intent_id=a.approval_intent_id WHERE a.payroll_period_id=".$period_id." AND i.payroll_group_id=".(int)$scope['payroll_group_id']." AND i.legal_entity_id=".(int)$scope['legal_entity_id']." AND LOWER(a.decision_token)='approved' ORDER BY a.approval_id DESC LIMIT 2".($for_update?' FOR UPDATE':'');
 $rows=pay_pmt_001_db_rows($sql);if($rows===false||count($rows)<1)return pay_pmt_001_runtime_fail($error,'approved_payroll_result_missing');$a=$rows[0];if(!hash_equals((string)$results['set']['result_set_sha256'],(string)$a['result_set_sha256']))return pay_pmt_001_runtime_fail($error,'stale_or_superseded_payroll_result');
 $proof=hrm_pay_core_010_approval(array('intent_id'=>(int)$a['approval_intent_id'],'payroll_period_id'=>$period_id,'result_set_sha256'=>$a['result_set_sha256'],'projection_set_sha256'=>$a['projection_set_sha256'],'intent_sha256'=>$a['intent_sha256'],'approval_draft_id'=>(int)$a['approval_draft_id'],'decision_token'=>'approved','approver_id'=>(int)$a['approver_id'],'maker_id'=>(int)$a['maker_id']),$ae);if($proof===false||!hash_equals((string)$proof['approval_sha256'],(string)$a['approval_sha256']))return pay_pmt_001_runtime_fail($error,'approval_hash_mismatch');
 $projectionRows=pay_pmt_001_db_rows('SELECT result_id,result_sha256,projection_sha256 FROM '.TB_PREF.'hrm_pay_core_010_projections WHERE payroll_period_id='.$period_id.' ORDER BY result_id');$projection=$projectionRows===false?false:hrm_pay_core_010_projection_set($projectionRows,$pe);if($projection===false||!hash_equals((string)$projection['projection_set_sha256'],(string)$a['projection_set_sha256'])||(int)$projection['projection_count']!==(int)$results['set']['result_count'])return pay_pmt_001_runtime_fail($error,'current_projection_custody_mismatch');
 return array('scope'=>$scope,'state'=>$state,'results'=>$results,'approval'=>$a);
}

/** Require one independently reviewed PAY-GL journal for the exact approved result set/currency. */
function pay_pmt_001_current_gl_journal(array $core,$currency,&$error=null){
 $error=null;$currency=pay_pmt_001_currency($currency);if($currency===false)return pay_pmt_001_runtime_fail($error,'currency_invalid');$s=$core['scope'];$a=$core['approval'];$r=$core['results'];$sql="SELECT j.journal_intent_id,j.company_id,j.legal_entity_id,j.payroll_group_id,j.payroll_period_id,j.result_set_sha256,j.approval_sha256,j.currency_code,j.debit_minor,j.credit_minor,j.journal_sha256,rc.reconciliation_id,rc.status reconciliation_status,rv.review_id,rv.decision review_decision FROM ".TB_PREF."hrm_pay_gl_001_journal_intents j JOIN ".TB_PREF."hrm_pay_gl_001_reconciliations rc ON rc.journal_intent_id=j.journal_intent_id AND rc.journal_sha256=j.journal_sha256 JOIN ".TB_PREF."hrm_pay_gl_001_reviews rv ON rv.reconciliation_id=rc.reconciliation_id WHERE j.payroll_period_id=".(int)$s['period_id']." AND j.payroll_group_id=".(int)$s['payroll_group_id']." AND j.legal_entity_id=".(int)$s['legal_entity_id']." AND j.result_set_sha256=".db_escape($r['set']['result_set_sha256'])." AND j.approval_sha256=".db_escape($a['approval_sha256'])." AND j.currency_code=".db_escape($currency)." AND rc.status='reconciled' AND rv.decision='approved' ORDER BY rv.review_id DESC LIMIT 2";$rows=pay_pmt_001_db_rows($sql);if($rows===false||count($rows)!==1)return pay_pmt_001_runtime_fail($error,'pay_gl_reconciliation_binding_missing_or_ambiguous');$j=$rows[0];if((int)$j['company_id']!==pay_pmt_001_current_company()||(int)$j['debit_minor']!==(int)$j['credit_minor']||!pay_pmt_001_sha($j['journal_sha256']))return pay_pmt_001_runtime_fail($error,'pay_gl_reconciliation_binding_invalid');return $j;
}

/** Resolve the canonical Person for one immutable result without touching legacy bank fields. */
function pay_pmt_001_person_for_result(array $result,&$error=null){
 $error=null;$relationship=(int)$result['payroll_relationship_id'];if($relationship<=0)return pay_pmt_001_runtime_fail($error,'payroll_relationship_missing');$row=pay_pmt_001_db_one('SELECT w.person_id,pr.worker_id FROM '.TB_PREF.'hrm_payroll_relationships pr JOIN '.TB_PREF.'hrm_workers w ON w.worker_id=pr.worker_id WHERE pr.payroll_relationship_id='.$relationship.' LIMIT 2');if(!$row||(int)$row['person_id']<=0)return pay_pmt_001_runtime_fail($error,'person_scope_ambiguous_or_missing');return (int)$row['person_id'];
}

/** Deny duplicate execution if the same result has PAY-PMT custody or a historical paid legacy effect. */
function pay_pmt_001_assert_result_unpaid(array $result,$period_id,&$error=null){
 $error=null;$sha=(string)$result['result_sha256'];$q=db_query('SELECT payment_item_id FROM '.TB_PREF.'hrm_pay_pmt_001_payment_items WHERE source_result_sha256='.db_escape($sha).' LIMIT 1');if(!$q)return pay_pmt_001_runtime_fail($error,'payment_duplicate_check_failed');if(db_num_rows($q)>0)return pay_pmt_001_runtime_fail($error,'duplicate_payment_effect_denied');
 $period=hrm_pay_core_010_period_scope((int)$period_id,false,$pe);$employee=$period===false?false:hrm_pay_core_010_employee_for_result($result,$period,$ee);if($employee!==false){$table=function_exists('payslip_header_table')?payslip_header_table():'payslips';$sql='SELECT payslip_id,status,payment_trans_no FROM '.TB_PREF.$table.' WHERE payroll_period_id='.(int)$period_id.' AND employee_id='.db_escape($employee['employee_id']).' AND (status=3 OR payment_trans_no IS NOT NULL AND payment_trans_no<>0) LIMIT 1';$legacy=db_query($sql);if(!$legacy)return pay_pmt_001_runtime_fail($error,'legacy_payment_duplicate_check_failed');if(db_num_rows($legacy)>0)return pay_pmt_001_runtime_fail($error,'legacy_already_paid_effect_denied');}
 return true;
}

/** Convert one approved result to a deterministic payment item + version-bound bank allocations. */
