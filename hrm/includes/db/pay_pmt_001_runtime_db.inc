 $error=null;$currency=pay_pmt_001_currency($result['currency']);$minor=pay_pmt_001_decimal_to_minor($result['net_amount'],$me);if($currency===false||$minor===false)return pay_pmt_001_runtime_fail($error,$currency===false?'currency_invalid':$me);if(!pay_pmt_001_assert_result_unpaid($result,$period_id,$error))return false;$person=pay_pmt_001_person_for_result($result,$error);if($person===false)return false;$binding=get_hrm_person_bank_payment_instruction_binding($person,$currency,$value_at_utc);if(!is_array($binding)||!pay_pmt_001_sha($binding['allocation_hash']))return pay_pmt_001_runtime_fail($error,'approved_bank_election_binding_missing');$percent=array();foreach($binding['allocations'] as $row)$percent[]=$row['allocation_value'];$weights=pay_pmt_001_normalize_percentage_weights($percent,$we);if($weights===false)return pay_pmt_001_runtime_fail($error,$we);$split=pay_pmt_001_split_minor($minor,$weights,$se);if($split===false)return pay_pmt_001_runtime_fail($error,$se);
 $item=pay_pmt_001_validate_item(array('beneficiary_subject_sha256'=>hash('sha256','person:'.$person),'source_result_sha256'=>$result['result_sha256'],'source_line_key'=>'pay-core-result:'.(int)$result['result_id'],'currency_code'=>$currency,'amount_minor'=>$minor,'payment_election_id'=>(int)$binding['payment_election_id'],'payment_election_row_version'=>(int)$binding['payment_election_row_version'],'bank_allocation_sha256'=>$binding['allocation_hash']),$ie);if($item===false)return pay_pmt_001_runtime_fail($error,$ie);$alloc=array();foreach(array_values($binding['allocations']) as $i=>$row){$token=pay_pmt_001_hash(array('person_id'=>$person,'payment_election_id'=>(int)$binding['payment_election_id'],'payment_election_row_version'=>(int)$binding['payment_election_row_version'],'payment_allocation_id'=>(int)$row['payment_allocation_id'],'person_bank_account_id'=>(int)$row['person_bank_account_id'],'bank_account_row_version'=>(int)$row['bank_account_row_version']));$alloc[]=array('allocation_no'=>$i+1,'person_bank_account_id'=>(int)$row['person_bank_account_id'],'bank_account_row_version'=>(int)$row['bank_account_row_version'],'allocation_weight_ppm'=>(int)$weights[$i],'allocated_amount_minor'=>(int)$split[$i],'beneficiary_token_sha256'=>$token);}$alloc=pay_pmt_001_validate_allocations($alloc,$minor,$ae);if($alloc===false)return pay_pmt_001_runtime_fail($error,$ae);return array('item_no'=>(int)$item_no,'person_id'=>$person,'item'=>$item,'allocations'=>$alloc,'binding'=>$binding);
}

/** Create one immutable intent per currency for the exact current approved result set. */
function pay_pmt_001_create_payment_intents_for_period($period_id,$value_at_utc,&$error=null){
 $error=null;if(!pay_pmt_001_require_access(PAY_PMT_001_PREPARE_PERMISSION,$error))return false;$actor=pay_pmt_001_current_actor();if($actor<=0||pay_pmt_001_time($value_at_utc)===false)return pay_pmt_001_runtime_fail($error,'intent_input_invalid');$core=pay_pmt_001_current_approval($period_id,false,$error);if($core===false||!pay_pmt_001_assert_company(pay_pmt_001_current_company(),$error))return false;$scope=$core['scope'];$groups=array();foreach($core['results']['rows'] as $r){$c=pay_pmt_001_currency($r['currency']);if($c===false)return pay_pmt_001_runtime_fail($error,'result_currency_invalid');$groups[$c][]=$r;}if(!pay_pmt_001_begin_owned_transaction($error))return false;$out=array();$ok=false;do{foreach($groups as $currency=>$rows){$existingByApproval=pay_pmt_001_db_one('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_payment_intents WHERE result_set_sha256='.db_escape($core['results']['set']['result_set_sha256']).' AND approval_sha256='.db_escape($core['approval']['approval_sha256']).' AND currency_code='.db_escape($currency).' LIMIT 2');if($existingByApproval){if(!pay_pmt_001_revalidate_intent($existingByApproval,$value_at_utc,$error))break 2;$out[]=$existingByApproval;continue;}$gl=pay_pmt_001_current_gl_journal($core,$currency,$error);if($gl===false)break 2;$items=array();$allAlloc=array();$total=0;$n=1;foreach($rows as $r){$built=pay_pmt_001_build_item($r,$period_id,$value_at_utc,$n++,$error);if($built===false)break 3;$items[]=$built;$total+=(int)$built['item']['amount_minor'];foreach($built['allocations'] as $a)$allAlloc[]=$a['allocation_sha256'];}$itemHashes=array();foreach($items as $x)$itemHashes[]=$x['item']['item_sha256'];sort($itemHashes,SORT_STRING);sort($allAlloc,SORT_STRING);$basis=array('company_id'=>pay_pmt_001_current_company(),'legal_entity_id'=>(int)$scope['legal_entity_id'],'payroll_group_id'=>(int)$scope['payroll_group_id'],'payroll_period_id'=>(int)$period_id,'result_set_sha256'=>$core['results']['set']['result_set_sha256'],'approval_sha256'=>$core['approval']['approval_sha256'],'pay_gl_journal_sha256'=>$gl['journal_sha256'],'currency_code'=>$currency,'total_minor'=>$total,'item_set_sha256'=>pay_pmt_001_hash($itemHashes),'allocation_set_sha256'=>pay_pmt_001_hash($allAlloc));$intentSha=pay_pmt_001_intent_sha256($basis);if($intentSha===false){$error='intent_hash_failed';break 2;}$existing=pay_pmt_001_db_one('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_payment_intents WHERE intent_sha256='.db_escape($intentSha).' LIMIT 2');if($existing){$out[]=$existing;continue;}$at=pay_pmt_001_now();$sql='INSERT INTO '.TB_PREF.'hrm_pay_pmt_001_payment_intents (company_id,legal_entity_id,payroll_group_id,payroll_period_id,result_set_sha256,approval_sha256,pay_gl_journal_sha256,currency_code,total_minor,item_set_sha256,allocation_set_sha256,intent_sha256,prepared_by,prepared_at,created_at) VALUES ('.implode(',',array_map('db_escape',array($basis['company_id'],$basis['legal_entity_id'],$basis['payroll_group_id'],$basis['payroll_period_id'],$basis['result_set_sha256'],$basis['approval_sha256'],$basis['pay_gl_journal_sha256'],$basis['currency_code'],$basis['total_minor'],$basis['item_set_sha256'],$basis['allocation_set_sha256'],$intentSha,$actor,$at,$at))).')';if(!db_query($sql)){$error='intent_insert_failed';break 2;}$intentId=(int)db_insert_id();foreach($items as $x){$it=$x['item'];$sql='INSERT INTO '.TB_PREF.'hrm_pay_pmt_001_payment_items (payment_intent_id,item_no,beneficiary_subject_sha256,source_result_sha256,source_line_key,currency_code,amount_minor,payment_election_id,payment_election_row_version,bank_allocation_sha256,item_sha256,created_at) VALUES ('.implode(',',array_map('db_escape',array($intentId,$x['item_no'],$it['beneficiary_subject_sha256'],$it['source_result_sha256'],$it['source_line_key'],$it['currency_code'],$it['amount_minor'],$it['payment_election_id'],$it['payment_election_row_version'],$it['bank_allocation_sha256'],$it['item_sha256'],$at))).')';if(!db_query($sql)){$error='payment_item_insert_failed';break 3;}$itemId=(int)db_insert_id();foreach($x['allocations'] as $a){$sql='INSERT INTO '.TB_PREF.'hrm_pay_pmt_001_item_allocations (payment_item_id,allocation_no,person_bank_account_id,bank_account_row_version,allocation_weight_ppm,allocated_amount_minor,beneficiary_token_sha256,allocation_sha256,created_at) VALUES ('.implode(',',array_map('db_escape',array($itemId,$a['allocation_no'],$a['person_bank_account_id'],$a['bank_account_row_version'],$a['allocation_weight_ppm'],$a['allocated_amount_minor'],$a['beneficiary_token_sha256'],$a['allocation_sha256'],$at))).')';if(!db_query($sql)){$error='payment_allocation_insert_failed';break 4;}}}$out[]=array('payment_intent_id'=>$intentId,'intent_sha256'=>$intentSha,'currency_code'=>$currency,'total_minor'=>$total);}$ok=true;}while(false);if($ok)commit_transaction();else cancel_transaction();return $ok?$out:false;
