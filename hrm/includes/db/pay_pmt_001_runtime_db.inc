/** Revalidate result approval and every bank/election version captured by an intent. */
function pay_pmt_001_revalidate_intent($intent,$value_at_utc,&$error=null){
 $error=null;if(!is_array($intent)||pay_pmt_001_time($value_at_utc)===false)return pay_pmt_001_runtime_fail($error,'intent_revalidation_input_invalid');$core=pay_pmt_001_current_approval((int)$intent['payroll_period_id'],false,$error);if($core===false||!hash_equals((string)$core['results']['set']['result_set_sha256'],(string)$intent['result_set_sha256'])||!hash_equals((string)$core['approval']['approval_sha256'],(string)$intent['approval_sha256']))return pay_pmt_001_runtime_fail($error,'stale_or_superseded_approval_denied');$current=array();foreach($core['results']['rows'] as $r)$current[$r['result_sha256']]=$r;$items=pay_pmt_001_db_rows('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_payment_items WHERE payment_intent_id='.(int)$intent['payment_intent_id'].' ORDER BY item_no');if($items===false||!count($items))return pay_pmt_001_runtime_fail($error,'payment_items_missing');foreach($items as $it){if(!isset($current[$it['source_result_sha256']]))return pay_pmt_001_runtime_fail($error,'stale_result_member_denied');$person=pay_pmt_001_person_for_result($current[$it['source_result_sha256']],$error);if($person===false)return false;$binding=get_hrm_person_bank_payment_instruction_binding($person,$it['currency_code'],$value_at_utc);if(!is_array($binding)||(int)$binding['payment_election_id']!==(int)$it['payment_election_id']||(int)$binding['payment_election_row_version']!==(int)$it['payment_election_row_version']||!hash_equals((string)$binding['allocation_hash'],(string)$it['bank_allocation_sha256']))return pay_pmt_001_runtime_fail($error,'stale_bank_or_election_denied');}$gl=pay_pmt_001_current_gl_journal($core,$intent['currency_code'],$error);if($gl===false||!hash_equals((string)$gl['journal_sha256'],(string)$intent['pay_gl_journal_sha256']))return pay_pmt_001_runtime_fail($error,'pay_gl_binding_stale');return true;
}

/** Prepare deterministic batch membership. Preparation never releases or transmits. */
function pay_pmt_001_prepare_batch(array $intent_ids,$payment_date,&$error=null){
 $error=null;if(!pay_pmt_001_require_access(PAY_PMT_001_PREPARE_PERMISSION,$error))return false;$actor=pay_pmt_001_current_actor();$payment_date=pay_pmt_001_date($payment_date);if($actor<=0||$payment_date===false||empty($intent_ids))return pay_pmt_001_runtime_fail($error,'batch_input_invalid');$ids=array_values(array_unique(array_map('intval',$intent_ids)));sort($ids,SORT_NUMERIC);if(count($ids)!==1)return pay_pmt_001_runtime_fail($error,'batch_requires_single_currency_intent');foreach($ids as $id)if($id<=0)return pay_pmt_001_runtime_fail($error,'batch_intent_invalid');$rows=pay_pmt_001_db_rows('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_payment_intents WHERE payment_intent_id IN ('.implode(',',$ids).') ORDER BY payment_intent_id');if($rows===false||count($rows)!==count($ids))return pay_pmt_001_runtime_fail($error,'batch_intent_missing');$first=$rows[0];if(!pay_pmt_001_assert_company((int)$first['company_id'],$error))return false;$itemRows=array();$total=0;$intentHashes=array();foreach($rows as $intent){foreach(array('company_id','legal_entity_id','payroll_group_id','payroll_period_id','currency_code') as $k)if((string)$intent[$k]!== (string)$first[$k])return pay_pmt_001_runtime_fail($error,'batch_scope_mixed');if(!pay_pmt_001_revalidate_intent($intent,$payment_date.' 12:00:00',$error))return false;$intentHashes[]=$intent['intent_sha256'];$its=pay_pmt_001_db_rows('SELECT payment_item_id,item_sha256,amount_minor FROM '.TB_PREF.'hrm_pay_pmt_001_payment_items WHERE payment_intent_id='.(int)$intent['payment_intent_id'].' ORDER BY payment_item_id');if($its===false||!count($its))return pay_pmt_001_runtime_fail($error,'batch_item_missing');foreach($its as $it){$itemRows[]=$it;$total+=(int)$it['amount_minor'];}}sort($intentHashes,SORT_STRING);$itemHashes=array_column($itemRows,'item_sha256');sort($itemHashes,SORT_STRING);$basis=array('company_id'=>(int)$first['company_id'],'legal_entity_id'=>(int)$first['legal_entity_id'],'payroll_group_id'=>(int)$first['payroll_group_id'],'payroll_period_id'=>(int)$first['payroll_period_id'],'payment_date'=>$payment_date,'currency_code'=>$first['currency_code'],'intent_set_sha256'=>pay_pmt_001_hash($intentHashes),'item_set_sha256'=>pay_pmt_001_hash($itemHashes),'total_minor'=>$total);$sha=pay_pmt_001_batch_sha256($basis);if($sha===false)return pay_pmt_001_runtime_fail($error,'batch_hash_failed');$existing=pay_pmt_001_db_one('SELECT * FROM '.TB_PREF.'hrm_pay_pmt_001_batches WHERE batch_sha256='.db_escape($sha).' LIMIT 2');if($existing)return $existing;if(!pay_pmt_001_begin_owned_transaction($error))return false;$at=pay_pmt_001_now();$sql='INSERT INTO '.TB_PREF.'hrm_pay_pmt_001_batches (company_id,legal_entity_id,payroll_group_id,payroll_period_id,payment_date,currency_code,intent_set_sha256,item_set_sha256,total_minor,batch_sha256,prepared_by,prepared_at,created_at) VALUES ('.implode(',',array_map('db_escape',array($basis['company_id'],$basis['legal_entity_id'],$basis['payroll_group_id'],$basis['payroll_period_id'],$basis['payment_date'],$basis['currency_code'],$basis['intent_set_sha256'],$basis['item_set_sha256'],$basis['total_minor'],$sha,$actor,$at,$at))).')';if(!db_query($sql)){cancel_transaction();return pay_pmt_001_runtime_fail($error,'batch_insert_failed');}$batchId=(int)db_insert_id();$n=1;foreach($itemRows as $it){$bi=pay_pmt_001_hash(array('payment_batch_id'=>$batchId,'payment_item_id'=>(int)$it['payment_item_id'],'batch_item_no'=>$n,'payment_item_sha256'=>$it['item_sha256']));$sql='INSERT INTO '.TB_PREF.'hrm_pay_pmt_001_batch_items (payment_batch_id,payment_item_id,batch_item_no,payment_item_sha256,batch_item_sha256,created_at) VALUES ('.implode(',',array_map('db_escape',array($batchId,$it['payment_item_id'],$n,$it['item_sha256'],$bi,$at))).')';if(!db_query($sql)){cancel_transaction();return pay_pmt_001_runtime_fail($error,'batch_item_insert_failed');}$n++;}commit_transaction();return array('payment_batch_id'=>$batchId,'batch_sha256'=>$sha,'total_minor'=>$total,'prepared_by'=>$actor);
}

