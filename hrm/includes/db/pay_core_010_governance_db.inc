    $doc->gross_salary=(float)$result['gross_amount'];$doc->total_deductions=(float)$result['deduction_amount'];$doc->net_salary=(float)$result['net_amount'];$doc->total_earnings=0.0;$doc->basic_salary=0.0;$doc->employer_contributions=0.0;
