ntity_id'=>$scope['legal_entity_id'],'result_set_sha256'=>$rs['set']['result_set_sha256'],'candidate_projection_set_sha256'=>$candidate_sha,'legacy_projection_set_sha256'=>$legacy['set_sha256'],'parity_status'=>$status,'mismatch_count'=>$mismatch,'evidence_sha256'=>$evidence_sha256,'reviewer_id'=>$reviewer),$pe);if($p===false){$error=$pe;return false;}$sql='INSERT INTO '.TB_PREF.'hrm_pay_core_010_parity_evidence (payroll_period_id,payroll_group_id,group_version_id,legal_entity_id,result_set_sha256,candidate_projection_set_sha256,legacy_projection_set_sha256,parity_status,mismatch_count,evidence_sha256,parity_sha256,reviewer_id) VALUES ('.(int)$period_id.','.(int)$scope['payroll_group_id'].','.(int)$scope['group_version_id'].','.(int)$scope['legal_entity_id'].','.db_escape($p['result_set_sha256']).','.db_escape($p['candidate_projection_set_sha256']).','.db_escape($p['legacy_projection_set_sha256']).','.db_escape($status).','.$mismatch.','.db_escape($evidence_sha256).','.db_escape($p['parity_sha256']).','.$reviewer.')';if(!db_query($sql,'could not append PAY-CORE-010 parity evidence')){$q=db_query('SELECT parity_id,parity_sha256 FROM '.TB_PREF.'hrm_pay_core_010_parity_evidence WHERE parity_sha256='.db_escape($p['parity_sha256']).' LIMIT 2');if(!$q||db_num_rows($q)!==1){$error='parity_insert_failed';return false;}$x=db_fetch_assoc($q);return array('parity_id'=>(int)$x['parity_id'],'status'=>$status,'mismatch_count'=>$mismatch,'parity_sha256'=>$x['parity_sha256'],'replayed'=>true);}return array('parity_id'=>(int)db_insert_id(),'status'=>$status,'mismatch_count'=>$mismatch,'parity_sha256'=>$p['parity_sha256'],'replayed'=>false);
}

function hrm_pay_core_010_transition_scope($payroll_group_id,$target,$expected_sequence_no,$command_key,$parity_id=null,&$error=null)
{
    $error=null;$actor=hrm_pay_core_010_actor();$target=(string)$target;$expected_sequence_no=(int)$expected_sequence_no;$cmd=hrm_pay_core_010_token($command_key,128);
    if($actor<=0||$cmd===false||!in_array($target,hrm_pay_core_010_states(),true)){$error='transition_request_invalid';return false;}
    $access=array('shadow'=>'SA_HRM_MANAGE_PAY_CORE_PROJECTION','legacy'=>'SA_HRM_MANAGE_PAY_CORE_PROJECTION','cutover_ready'=>'SA_HRM_REVIEW_PAY_CORE_PROJECTION','active_new'=>'SA_HRM_ACTIVATE_PAY_CORE_PROJECTION','fallback'=>'SA_HRM_FALLBACK_PAY_CORE_PROJECTION');
    if(!isset($access[$target])||!hrm_pay_core_010_access($access[$target])){$error='transition_access_denied';return false;}
    $manage=hrm_pay_core_010_manage_transaction();if($manage)begin_transaction();
    $g=hrm_pay_core_010_one('SELECT payroll_group_id,legal_entity_id FROM '.TB_PREF.'hrm_payroll_groups WHERE payroll_group_id='.(int)$payroll_group_id.' LIMIT 2 FOR UPDATE','could not lock PAY-CORE-010 payroll group');
    if(!$g){if($manage)cancel_transaction();$error='transition_group_missing';return false;}
    $scope=array('payroll_group_id'=>(int)$g['payroll_group_id'],'legal_entity_id'=>(int)$g['legal_entity_id']);

    // An accepted command replays from its immutable original payload, not from today's state.
    $sameq=db_query('SELECT transition_id,sequence_no,from_state,to_state,expected_sequence_no,parity_id,command_sha256,predecessor_transition_sha256,transition_sha256,actor_id FROM '.TB_PREF.'hrm_pay_core_010_cutover_transitions WHERE payroll_group_id='.(int)$scope['payroll_group_id'].' AND command_key='.db_escape($cmd).' LIMIT 2 FOR UPDATE','could not read PAY-CORE-010 transition replay');
    if(!$sameq){if($manage)cancel_transaction();$error='transition_replay_lookup_failed';return false;}
    if(db_num_rows($sameq)>1){if($manage)cancel_transaction();$error='transition_replay_ambiguous';return false;}
    if(db_num_rows($sameq)===1){
        $same=db_fetch_assoc($sameq);$same_parity=$same['parity_id']===null?null:(int)$same['parity_id'];$asked_parity=$parity_id===null?null:(int)$parity_id;
        if((string)$same['to_state']!==$target||(int)$same['expected_sequence_no']!==$expected_sequence_no||$same_parity!==$asked_parity||(int)$same['actor_id']!==$actor){if($manage)cancel_transaction();$error='conflicting_duplicate_command';return false;}
        if($manage)commit_transaction();return array('transition_id'=>(int)$same['transition_id'],'transition_sha256'=>$same['transition_sha256'],'state'=>$same['to_state'],'sequence_no'=>(int)$same['sequence_no'],'replayed'=>true);
    }

    $state=hrm_pay_core_010_state_for_scope($scope,true,$se);if($state===false){if($manage)cancel_transaction();$error=$se;return false;}
    if($expected_sequence_no!==(int)$state['sequence_no']){if($manage)cancel_transaction();$error='stale_expected_sequence';return false;}

    $parity=false;$parity_sha=null;
    if(in_array($target,array('cutover_ready','active_new'),true)){
        $pq=db_query('SELECT parity_id,payroll_period_id,group_version_id,legal_entity_id,parity_status,parity_sha256,reviewer_id FROM '.TB_PREF.'hrm_pay_core_010_parity_evidence WHERE parity_id='.(int)$parity_id.' LIMIT 2 FOR UPDATE');
        $parity=$pq&&db_num_rows($pq)===1?db_fetch_assoc($pq):false;
        if(!$parity||(int)$parity['legal_entity_id']!==(int)$scope['legal_entity_id']||(string)$parity['parity_status']!=='match'||!hrm_pay_core_010_is_sha256($parity['parity_sha256'])){if($manage)cancel_transaction();$error='matching_parity_required';return false;}
        $period_scope=hrm_pay_core_010_period_scope((int)$parity['payroll_period_id'],false,$pe);
        if($period_scope===false||(int)$period_scope['payroll_group_id']!==(int)$scope['payroll_group_id']||(int)$period_scope['group_version_id']!==(int)$parity['group_version_id']){if($manage)cancel_transaction();$error='parity_scope_stale';return false;}
        $parity_sha=$parity['parity_sha256'];
        if((int)$parity['reviewer_id']===$actor){if($manage)cancel_transaction();$error='reviewer_executor_separation_required';return false;}
    }
    if($target==='active_new'&&$state['state']==='cutover_ready'&&(int)$state['actor_id']===$actor){if($manage)cancel_transaction();$error='checker_executor_separation_required';return false;}

    $descriptor=hrm_pay_core_010_transition(array('payroll_group_id'=>$scope['payroll_group_id'],'legal_entity_id'=>$scope['legal_entity_id'],'sequence_no'=>$expected_sequence_no+1,'from_state'=>$state['state'],'to_state'=>$target,'expected_sequence_no'=>$expected_sequence_no,'parity_sha256'=>$parity_sha,'command_key'=>$cmd,'predecessor_transition_sha256'=>$state['transition_sha256'],'actor_id'=>$actor),$de);
    if($descriptor===false){if($manage)cancel_transaction();$error=$de;return false;}
    $sql='INSERT INTO '.TB_PREF.'hrm_pay_core_010_cutover_transitions (payroll_group_id,legal_entity_id,sequence_no,from_state,to_state,expected_sequence_no,result_contract_version,parity_id,command_key,command_sha256,predecessor_transition_sha256,transition_sha256,actor_id) VALUES ('.(int)$scope['payroll_group_id'].','.(int)$scope['legal_entity_id'].','.(int)$descriptor['sequence_no'].','.db_escape($descriptor['from_state']).','.db_escape($descriptor['to_state']).','.(int)$descriptor['expected_sequence_no'].','.db_escape(HRM_PAY_CORE_010_CONTRACT_VERSION).','.($parity?(int)$parity['parity_id']:'NULL').','.db_escape($cmd).','.db_escape($descriptor['command_sha256']).','.($descriptor['predecessor_transition_sha256']===null?'NULL':db_escape($descriptor['predecessor_transition_sha256'])).','.db_escape($descriptor['transition_sha256']).','.$actor.')';
    if(!db_query($sql,'could not append PAY-CORE-010 cutover transition')){if($manage)cancel_transaction();$error='transition_insert_failed';return false;}
    $id=(int)db_insert_id();if($manage)commit_transaction();return array('transition_id'=>$id,'transition_sha256'=>$descriptor['transition_sha256'],'state'=>$target,'sequence_no'=>(int)$descriptor['sequence_no'],'replayed'=>false);
}

