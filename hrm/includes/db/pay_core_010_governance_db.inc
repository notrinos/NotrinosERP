function hrm_pay_core_010_actor(){return isset($_SESSION['wa_current_user']->user)?(int)$_SESSION['wa_current_user']->user:0;}
function hrm_pay_core_010_access($token){return function_exists('user_check_access')&&user_check_access($token);}
function hrm_pay_core_010_one($sql,$message='PAY-CORE-010 row lookup failed'){$q=db_query($sql,$message);if(!$q||db_num_rows($q)!==1)return false;return db_fetch_assoc($q);}
function hrm_pay_core_010_table_ready(){return function_exists('hrm_migration_table_exists')&&hrm_migration_table_exists('hrm_pay_core_010_cutover_transitions');}
function hrm_pay_core_010_manage_transaction(){return empty($GLOBALS['transaction_level']);}

/** Resolve one legacy payroll period through the accepted PAY-CORE-002 mapping chain. */
function hrm_pay_core_010_period_scope($period_id,$for_update=false,&$error=null)
{
    $error=null;$period_id=(int)$period_id;if($period_id<=0){$error='period_scope_invalid';return false;}
    $sql='SELECT p.period_id,p.period_name,p.from_date,p.to_date,p.status,p.created_by,'
        .'r.calendar_period_id,mp.group_version_id,mp.legal_entity_id,gv.payroll_group_id,cp.period_sha256,mp.mapping_plan_sha256,r.conversion_sha256 '
        .'FROM '.TB_PREF.'payroll_periods p '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_legacy_period_conversion_receipts r ON r.legacy_period_id=p.period_id '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_legacy_period_mapping_plans mp ON mp.mapping_plan_id=r.mapping_plan_id AND mp.legacy_period_id=r.legacy_period_id '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_calendar_periods cp ON cp.calendar_period_id=r.calendar_period_id AND cp.calendar_version_id=mp.calendar_version_id '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_group_versions gv ON gv.group_version_id=mp.group_version_id AND gv.calendar_version_id=mp.calendar_version_id '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_groups g ON g.payroll_group_id=gv.payroll_group_id AND g.legal_entity_id=mp.legal_entity_id '
        .'WHERE p.period_id='.$period_id.' AND EXISTS (SELECT 1 FROM '.TB_PREF.'hrm_payroll_legacy_period_reconciliations rr '
        .'WHERE rr.conversion_receipt_id=r.conversion_receipt_id AND rr.status_token=\'reconciled\' '
        .'AND NOT EXISTS (SELECT 1 FROM '.TB_PREF.'hrm_payroll_legacy_period_reconciliations newer WHERE newer.conversion_receipt_id=rr.conversion_receipt_id AND newer.reconciliation_id>rr.reconciliation_id)) '
        .'LIMIT 2'.($for_update?' FOR UPDATE':'');
    $q=db_query($sql,'could not resolve PAY-CORE-010 payroll-period scope');if(!$q){$error='period_scope_lookup_failed';return false;}if(db_num_rows($q)!==1){$error='period_scope_ambiguous_or_missing';return false;}$r=db_fetch_assoc($q);
    foreach(array('calendar_period_id','group_version_id','legal_entity_id','payroll_group_id') as $k)if((int)$r[$k]<=0){$error='period_scope_incomplete';return false;}
    return $r;
}

/** Read the latest append-only cutover state. Absence is the explicit legacy state. */
function hrm_pay_core_010_state_for_scope(array $scope,$for_update=false,&$error=null)
{
    $error=null;$s=hrm_pay_core_010_scope($scope,$se);if($s===false){$error=$se;return false;}
    if(!hrm_pay_core_010_table_ready())return array('state'=>'legacy','sequence_no'=>0,'transition_id'=>null,'transition_sha256'=>null,'actor_id'=>null,'parity_id'=>null)+$s;
    $q=db_query('SELECT transition_id,sequence_no,from_state,to_state,parity_id,transition_sha256,actor_id FROM '.TB_PREF.'hrm_pay_core_010_cutover_transitions WHERE payroll_group_id='.$s['payroll_group_id'].' AND legal_entity_id='.$s['legal_entity_id'].' ORDER BY sequence_no DESC,transition_id DESC LIMIT 2'.($for_update?' FOR UPDATE':''),'could not read PAY-CORE-010 cutover state');
    if(!$q){$error='cutover_state_lookup_failed';return false;}if(db_num_rows($q)===0)return array('state'=>'legacy','sequence_no'=>0,'transition_id'=>null,'transition_sha256'=>null,'actor_id'=>null,'parity_id'=>null)+$s;if(db_num_rows($q)>1){$a=db_fetch_assoc($q);$b=db_fetch_assoc($q);if((int)$a['sequence_no']===(int)$b['sequence_no']){$error='cutover_state_ambiguous';return false;}$r=$a;}else $r=db_fetch_assoc($q);
    if(!in_array($r['to_state'],hrm_pay_core_010_states(),true)||!hrm_pay_core_010_is_sha256($r['transition_sha256'])){$error='cutover_state_invalid';return false;}
    return array('state'=>$r['to_state'],'sequence_no'=>(int)$r['sequence_no'],'transition_id'=>(int)$r['transition_id'],'transition_sha256'=>$r['transition_sha256'],'actor_id'=>(int)$r['actor_id'],'parity_id'=>$r['parity_id']===null?null:(int)$r['parity_id'])+$s;
}
function hrm_pay_core_010_state_for_period($period_id,$for_update=false,&$error=null){$p=hrm_pay_core_010_period_scope($period_id,$for_update,$error);if($p===false)return false;return hrm_pay_core_010_state_for_scope(array('payroll_group_id'=>$p['payroll_group_id'],'legal_entity_id'=>$p['legal_entity_id']),$for_update,$error);}
function hrm_pay_core_010_legacy_writer_allowed($period_id,&$error=null){$error=null;if(!hrm_pay_core_010_table_ready())return true;$s=hrm_pay_core_010_state_for_period($period_id,false,$error);if($s===false)return false;if($s['state']==='active_new'){$error='pay_core_010_active_new_denies_legacy_writer';return false;}return true;}

/** Return exact current, integrity-verified, unsuperseded PAY-CORE results for one governed period/group. */
function hrm_pay_core_010_result_set_for_period($period_id,$for_update=false,&$error=null)
{
    $error=null;$scope=hrm_pay_core_010_period_scope($period_id,$for_update,$error);if($scope===false)return false;
    $sql='SELECT r.result_id,r.result_sha256,r.gross_amount,r.deduction_amount,r.net_amount,r.currency,r.snapshot_id,s.snapshot_sha256,s.snapshot_payload_json,s.payroll_relationship_id,s.assignment_id,s.calendar_period_id,s.legal_entity_id '
        .'FROM '.TB_PREF.'hrm_pay_core_004_results r INNER JOIN '.TB_PREF.'hrm_pay_core_004_snapshots s ON s.snapshot_id=r.snapshot_id '
        .'INNER JOIN '.TB_PREF.'hrm_pay_core_004_integrity_evidence i ON i.result_id=r.result_id AND i.result_sha256=r.result_sha256 AND i.snapshot_sha256=s.snapshot_sha256 '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_group_enrollments ge ON ge.payroll_relationship_id=s.payroll_relationship_id AND ge.group_version_id='.(int)$scope['group_version_id'].' '
        .'WHERE s.calendar_period_id='.(int)$scope['calendar_period_id'].' AND s.legal_entity_id='.(int)$scope['legal_entity_id'].' AND i.verification_status=\'verified\' '
        .'AND i.integrity_evidence_id=(SELECT MAX(i2.integrity_evidence_id) FROM '.TB_PREF.'hrm_pay_core_004_integrity_evidence i2 WHERE i2.result_id=r.result_id) '
        .'AND ge.effective_from<='.db_escape($scope['from_date']).' AND (ge.effective_to IS NULL OR ge.effective_to>='.db_escape($scope['to_date']).') '
        .'AND NOT EXISTS (SELECT 1 FROM '.TB_PREF.'hrm_pay_core_004_correction_lineage cl WHERE cl.predecessor_result_id=r.result_id) '
        .'ORDER BY s.payroll_relationship_id,r.result_id'.($for_update?' FOR UPDATE':'');
    $q=db_query($sql,'could not read PAY-CORE-010 immutable result set');if(!$q){$error='result_set_lookup_failed';return false;}$rows=array();$relationships=array();while($r=db_fetch_assoc($q)){if(isset($relationships[(int)$r['payroll_relationship_id']])){$error='current_result_ambiguous';return false;}$relationships[(int)$r['payroll_relationship_id']]=true;$rows[]=$r;}
    $set=hrm_pay_core_010_result_set($rows,$error);if($set===false)return false;return array('scope'=>$scope,'rows'=>$rows,'set'=>$set);
}

/** Reverse exact normalized relationship/assignment scope to one legacy employee identity. */
function hrm_pay_core_010_employee_for_result(array $result_scope,array $period_scope,&$error=null)
{
    $error=null;$sql='SELECT m.employee_id,m.employee_number,a.legacy_department_id department_id,a.legacy_position_id position_id,a.legacy_grade_id grade_id FROM '.TB_PREF.'hrm_employee_worker_map m '
        .'INNER JOIN '.TB_PREF.'hrm_workers w ON w.worker_id=m.worker_id '
        .'INNER JOIN '.TB_PREF.'hrm_employments h ON h.worker_id=m.worker_id AND h.legacy_employee_number=m.employee_number '
        .'INNER JOIN '.TB_PREF.'hrm_assignments a ON a.employment_id=h.employment_id AND a.assignment_id='.(int)$result_scope['assignment_id'].' '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_relationships pr ON pr.worker_id=m.worker_id AND pr.employment_id=h.employment_id AND pr.payroll_relationship_id='.(int)$result_scope['payroll_relationship_id'].' '
        .'INNER JOIN '.TB_PREF.'hrm_payroll_relationship_members rm ON rm.payroll_relationship_id=pr.payroll_relationship_id AND rm.assignment_id=a.assignment_id '
        .'WHERE m.retired_at IS NULL AND pr.legal_entity_id='.(int)$period_scope['legal_entity_id'].' '
        .'AND pr.effective_from<='.db_escape($period_scope['from_date']).' AND (pr.effective_to IS NULL OR pr.effective_to>='.db_escape($period_scope['to_date']).') '
        .'AND rm.effective_from<='.db_escape($period_scope['from_date']).' AND (rm.effective_to IS NULL OR rm.effective_to>='.db_escape($period_scope['to_date']).') LIMIT 2';
    $q=db_query($sql,'could not reverse PAY-CORE-010 employee scope');if(!$q||db_num_rows($q)!==1){$error=$q?'employee_scope_ambiguous_or_missing':'employee_scope_lookup_failed';return false;}return db_fetch_assoc($q);
}

/** Compatibility context must be content-addressed inside the sealed snapshot source/configuration identity set. */
function hrm_pay_core_010_validate_projection_context($snapshot_payload_json,array $context,array $employee,array $period,&$error=null)
{
    $error=null;$payload=json_decode((string)$snapshot_payload_json,true);if(!is_array($payload)||!isset($payload['identity_sets'])||!is_array($payload['identity_sets'])){$error='snapshot_payload_invalid';return false;}
    $required=array('context_version','employee_id','from_date','to_date','tran_date','working_days','worked_days','overtime_hours','leave_days','absent_days','leaves','deductable_leaves','loan_deduction');foreach($required as $k)if(!array_key_exists($k,$context)){$error='projection_context_missing_'.$k;return false;}
    if($context['context_version']!==HRM_PAY_CORE_010_PROJECTION_CONTRACT_VERSION||(string)$context['employee_id']!==(string)$employee['employee_id']||(string)$context['from_date']!==(string)$period['from_date']||(string)$context['to_date']!==(string)$period['to_date']){$error='projection_context_scope_mismatch';return false;}
    foreach(array('from_date','to_date','tran_date') as $k){$d=DateTimeImmutable::createFromFormat('!Y-m-d',(string)$context[$k]);if(!$d||$d->format('Y-m-d')!==(string)$context[$k]){$error='projection_context_date_invalid';return false;}}
    foreach(array('working_days','worked_days','overtime_hours','leave_days','absent_days','loan_deduction') as $k)if(hrm_pay_core_010_decimal($context[$k])===false){$error='projection_context_decimal_invalid';return false;}foreach(array('leaves','deductable_leaves') as $k)if(filter_var($context[$k],FILTER_VALIDATE_INT)===false||(int)$context[$k]<0){$error='projection_context_integer_invalid';return false;}
    $hash=hrm_pay_core_010_hash($context);$allowed=array();foreach(array('source_events','configuration') as $set)if(isset($payload['identity_sets'][$set])&&is_array($payload['identity_sets'][$set]))$allowed=array_merge($allowed,$payload['identity_sets'][$set]);if($hash===false||!in_array($hash,$allowed,true)){$error='projection_context_not_bound_to_snapshot';return false;}
    return array('context'=>$context,'context_sha256'=>$hash);
}

/** Resolve one accepted PAY-CORE-003 legacy pay-element mapping for a governed element version. */
function hrm_pay_core_010_legacy_element_for_version($element_version_id,&$error=null)
{
    $error=null;$element_version_id=(int)$element_version_id;if($element_version_id<=0){$error='element_version_invalid';return false;}
    $sql='SELECT c.conversion_receipt_id,c.source_row_id,c.source_sha256,c.target_set_json FROM '.TB_PREF.'hrm_pay_core_003_legacy_conversion_receipts c '
        .'WHERE c.source_kind=\'pay_element\' AND c.target_kind=\'element_version_bundle\' '
        .'AND CAST(JSON_UNQUOTE(JSON_EXTRACT(c.target_set_json,\'$.element_version_id\')) AS UNSIGNED)='.$element_version_id.' '
        .'AND EXISTS (SELECT 1 FROM '.TB_PREF.'hrm_pay_core_003_legacy_conversion_reconciliations rr WHERE rr.conversion_receipt_id=c.conversion_receipt_id AND rr.status_token=\'reconciled\' AND NOT EXISTS (SELECT 1 FROM '.TB_PREF.'hrm_pay_core_003_legacy_conversion_reconciliations newer WHERE newer.conversion_receipt_id=rr.conversion_receipt_id AND newer.reconciliation_id>rr.reconciliation_id)) '
        .'AND EXISTS (SELECT 1 FROM '.TB_PREF.'hrm_pay_core_003_compatibility_parity_evidence pe WHERE pe.conversion_receipt_id=c.conversion_receipt_id AND pe.status_token=\'match\') LIMIT 2';
    $q=db_query($sql,'could not resolve PAY-CORE-010 legacy element mapping');if(!$q||db_num_rows($q)!==1){$error=$q?'legacy_element_mapping_missing_or_ambiguous':'legacy_element_mapping_lookup_failed';return false;}$m=db_fetch_assoc($q);$legacy=hrm_pay_core_003_read_legacy_source('pay_element',(int)$m['source_row_id'],false);$sha=$legacy?hrm_pay_core_003_legacy_source_sha256('pay_element',$legacy):false;if($sha===false||!hash_equals((string)$m['source_sha256'],$sha)){$error='legacy_element_source_drift';return false;}$legacy['conversion_receipt_id']=(int)$m['conversion_receipt_id'];return $legacy;
}

