    $sql='INSERT INTO '.TB_PREF.'hrm_pay_core_010_approval_intents (payroll_period_id,calendar_period_id,payroll_group_id,group_version_id,legal_entity_id,result_set_sha256,result_count,gross_amount,deduction_amount,net_amount,projection_contract_version,projection_set_sha256,cutover_transition_sha256,command_key,command_sha256,maker_id,intent_sha256) VALUES ('.(int)$period_id.','.(int)$scope['calendar_period_id'].','.(int)$scope['payroll_group_id'].','.(int)$scope['group_version_id'].','.(int)$scope['legal_entity_id'].','.db_escape($x['result_set_sha256']).','.(int)$x['result_count'].','.db_escape($x['gross_amount']).','.db_escape($x['deduction_amount']).','.db_escape($x['net_amount']).','.db_escape(HRM_PAY_CORE_010_PROJECTION_CONTRACT_VERSION).','.db_escape($x['projection_set_sha256']).','.db_escape($x['cutover_transition_sha256']).','.db_escape($x['command_key']).','.db_escape($x['command_sha256']).','.$maker.','.db_escape($x['intent_sha256']).')';if(!db_query($sql,'could not append PAY-CORE-010 approval intent')){$q=db_query('SELECT approval_intent_id,command_sha256,intent_sha256 FROM '.TB_PREF.'hrm_pay_core_010_approval_intents WHERE payroll_group_id='.(int)$scope['payroll_group_id'].' AND command_key='.db_escape($x['command_key']).' LIMIT 2');if(!$q||db_num_rows($q)!==1){$error='approval_intent_insert_failed';return false;}$r=db_fetch_assoc($q);if(!hash_equals($r['command_sha256'],$x['command_sha256'])||!hash_equals($r['intent_sha256'],$x['intent_sha256'])){$error='approval_intent_conflicting_duplicate';return false;}$id=(int)$r['approval_intent_id'];}else $id=(int)db_insert_id();$x['approval_intent_id']=$id;return $x;
