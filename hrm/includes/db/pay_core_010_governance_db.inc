/** Verify active-new draft binding and append immutable approval evidence in the caller transaction. */
function hrm_pay_core_010_verify_and_record_approval($period_id,array $draft_data,$draft_id,&$error=null)
{
    $error=null;$approver=hrm_pay_core_010_actor();if($approver<=0||!hrm_pay_core_010_access('SA_HRM_APPROVE_PAY_CORE_RESULT')){$error='pay_core_010_approval_access_denied';return false;}$state=hrm_pay_core_010_state_for_period($period_id,true,$error);if($state===false)return false;if($state['state']!=='active_new')return array('applicable'=>false);
    $required=array('pay_core_010_contract_version','pay_core_010_approval_intent_id','pay_core_010_intent_sha256','pay_core_010_result_set_sha256','pay_core_010_projection_set_sha256','pay_core_010_cutover_transition_sha256','pay_core_010_maker_id');foreach($required as $k)if(!isset($draft_data[$k])){$error='pay_core_010_approval_binding_missing';return false;}
    if($draft_data['pay_core_010_contract_version']!==HRM_PAY_CORE_010_CONTRACT_VERSION||(int)$draft_data['pay_core_010_maker_id']===$approver){$error=(int)$draft_data['pay_core_010_maker_id']===$approver?'pay_core_010_self_approval_denied':'pay_core_010_contract_mismatch';return false;}
    $intent=hrm_pay_core_010_one('SELECT * FROM '.TB_PREF.'hrm_pay_core_010_approval_intents WHERE approval_intent_id='.(int)$draft_data['pay_core_010_approval_intent_id'].' AND payroll_period_id='.(int)$period_id.' LIMIT 2 FOR UPDATE','could not lock PAY-CORE-010 approval intent');if(!$intent){$error='pay_core_010_approval_intent_missing';return false;}
    foreach(array('intent_sha256'=>'pay_core_010_intent_sha256','result_set_sha256'=>'pay_core_010_result_set_sha256','projection_set_sha256'=>'pay_core_010_projection_set_sha256','cutover_transition_sha256'=>'pay_core_010_cutover_transition_sha256') as $db=>$draft)if(!hash_equals((string)$intent[$db],(string)$draft_data[$draft])){$error='pay_core_010_stale_approval_intent';return false;}
    $rs=hrm_pay_core_010_result_set_for_period($period_id,false,$re);$ps=$rs!==false?hrm_pay_core_010_existing_projection_set($period_id,$pe):false;if($rs===false||$ps===false||!hash_equals($intent['result_set_sha256'],$rs['set']['result_set_sha256'])||!hash_equals($intent['projection_set_sha256'],$ps['projection_set_sha256'])||!hash_equals($intent['cutover_transition_sha256'],$state['transition_sha256'])){$error=$re?:($pe?:'pay_core_010_stale_result_or_projection');return false;}
    $a=hrm_pay_core_010_approval(array('intent_id'=>(int)$intent['approval_intent_id'],'payroll_period_id'=>$period_id,'result_set_sha256'=>$intent['result_set_sha256'],'projection_set_sha256'=>$intent['projection_set_sha256'],'intent_sha256'=>$intent['intent_sha256'],'approval_draft_id'=>(int)$draft_id,'decision_token'=>'approved','approver_id'=>$approver,'maker_id'=>(int)$intent['maker_id']),$ae);if($a===false){$error=$ae;return false;}
    $sql='INSERT INTO '.TB_PREF.'hrm_pay_core_010_approvals (approval_intent_id,payroll_period_id,result_set_sha256,projection_set_sha256,intent_sha256,approval_draft_id,decision_token,approver_id,approval_sha256) VALUES ('.(int)$intent['approval_intent_id'].','.(int)$period_id.','.db_escape($a['result_set_sha256']).','.db_escape($a['projection_set_sha256']).','.db_escape($a['intent_sha256']).','.(int)$draft_id.',\'approved\','.$approver.','.db_escape($a['approval_sha256']).')';if(!db_query($sql,'could not append PAY-CORE-010 approval evidence')){$q=db_query('SELECT approval_id,approval_sha256 FROM '.TB_PREF.'hrm_pay_core_010_approvals WHERE approval_draft_id='.(int)$draft_id.' LIMIT 2');if(!$q||db_num_rows($q)!==1){$error='pay_core_010_approval_evidence_failed';return false;}$r=db_fetch_assoc($q);if(!hash_equals($r['approval_sha256'],$a['approval_sha256'])){$error='pay_core_010_conflicting_approval_replay';return false;}$id=(int)$r['approval_id'];}else $id=(int)db_insert_id();return array('applicable'=>true,'approval_id'=>$id,'approval_sha256'=>$a['approval_sha256'],'result_set_sha256'=>$a['result_set_sha256']);
}

function hrm_pay_core_010_record_usage_locked(array $scope,$consumer,$mode,$source,$period_id,$actor,&$error=null)
{
    $error=null;$consumer=hrm_pay_core_010_token($consumer,64);$source=hrm_pay_core_010_token($source,48);if($consumer===false||$source===false||!in_array($mode,hrm_pay_core_010_states(),true)||(int)$actor<=0){$error='usage_event_invalid';return false;}$payload=array('payroll_group_id'=>(int)$scope['payroll_group_id'],'legal_entity_id'=>(int)$scope['legal_entity_id'],'payroll_period_id'=>$period_id===null?null:(int)$period_id,'consumer_token'=>$consumer,'authority_mode'=>$mode,'source_token'=>$source,'recorded_by'=>(int)$actor);$sha=hrm_pay_core_010_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_pay_core_010_usage_events (payroll_group_id,legal_entity_id,payroll_period_id,consumer_token,authority_mode,source_token,event_sha256,recorded_by) VALUES ('.(int)$scope['payroll_group_id'].','.(int)$scope['legal_entity_id'].','.($period_id===null?'NULL':(int)$period_id).','.db_escape($consumer).','.db_escape($mode).','.db_escape($source).','.db_escape($sha).','.(int)$actor.')';if(!db_query($sql,'could not append PAY-CORE-010 usage event')){$q=db_query('SELECT usage_event_id FROM '.TB_PREF.'hrm_pay_core_010_usage_events WHERE event_sha256='.db_escape($sha).' LIMIT 2');if(!$q||db_num_rows($q)!==1){$error='usage_event_insert_failed';return false;}$r=db_fetch_assoc($q);return (int)$r['usage_event_id'];}return (int)db_insert_id();
}
function hrm_pay_core_010_record_usage($period_id,$consumer,$source,&$error=null){$actor=hrm_pay_core_010_actor();if($actor<=0||!hrm_pay_core_010_access('SA_HRM_VIEW_PAY_CORE_PROJECTION')){$error='usage_access_denied';return false;}$p=hrm_pay_core_010_period_scope($period_id,false,$error);if($p===false)return false;$s=hrm_pay_core_010_state_for_scope(array('payroll_group_id'=>$p['payroll_group_id'],'legal_entity_id'=>$p['legal_entity_id']),false,$error);if($s===false)return false;return hrm_pay_core_010_record_usage_locked($p,$consumer,$s['state'],$source,$period_id,$actor,$error);}
function hrm_pay_core_010_record_legacy_writer_usage($period_id,$consumer,&$error=null){$error=null;if(!hrm_pay_core_010_table_ready())return true;$actor=hrm_pay_core_010_actor();if($actor<=0){$error='legacy_usage_actor_missing';return false;}$p=hrm_pay_core_010_period_scope($period_id,false,$pe);if($p===false){$error=null;return true;}$s=hrm_pay_core_010_state_for_scope(array('payroll_group_id'=>$p['payroll_group_id'],'legal_entity_id'=>$p['legal_entity_id']),false,$error);if($s===false)return false;if($s['state']==='active_new'){$error='pay_core_010_active_new_denies_legacy_writer';return false;}return hrm_pay_core_010_record_usage_locked($p,$consumer,$s['state'],'legacy_payslip_writer',$period_id,$actor,$error);}
function hrm_pay_core_010_record_recovery($payroll_group_id,$period_id,$transition_id,$action,$evidence_sha256,&$error=null){$error=null;$reviewer=hrm_pay_core_010_actor();$action=hrm_pay_core_010_token($action,64);if($reviewer<=0||!hrm_pay_core_010_access('SA_HRM_RECOVER_PAY_CORE_PROJECTION')||$action===false||!hrm_pay_core_010_is_sha256($evidence_sha256)){$error='recovery_access_or_evidence_invalid';return false;}$g=hrm_pay_core_010_one('SELECT payroll_group_id,legal_entity_id FROM '.TB_PREF.'hrm_payroll_groups WHERE payroll_group_id='.(int)$payroll_group_id.' LIMIT 2');if(!$g){$error='recovery_scope_missing';return false;}$payload=array('payroll_group_id'=>(int)$g['payroll_group_id'],'legal_entity_id'=>(int)$g['legal_entity_id'],'payroll_period_id'=>$period_id===null?null:(int)$period_id,'transition_id'=>$transition_id===null?null:(int)$transition_id,'recovery_action'=>$action,'evidence_sha256'=>$evidence_sha256,'reviewer_id'=>$reviewer);$sha=hrm_pay_core_010_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_pay_core_010_recovery_evidence (payroll_group_id,legal_entity_id,payroll_period_id,transition_id,recovery_action,evidence_sha256,recovery_sha256,reviewer_id) VALUES ('.(int)$g['payroll_group_id'].','.(int)$g['legal_entity_id'].','.($period_id===null?'NULL':(int)$period_id).','.($transition_id===null?'NULL':(int)$transition_id).','.db_escape($action).','.db_escape($evidence_sha256).','.db_escape($sha).','.$reviewer.')';if(!db_query($sql,'could not append PAY-CORE-010 recovery evidence')){$error='recovery_evidence_failed';return false;}return (int)db_insert_id();}
