    $detail_payload=array();$compat_detail_payload=array();$mapped=array();while($line=db_fetch_assoc($q)){$legacy=hrm_pay_core_010_legacy_element_for_version((int)$line['element_version_id'],$me);if($legacy===false){$error=$me;return false;}$amount=(float)$line['amount'];$is_deduction=!empty($legacy['is_deduction'])||$line['line_kind']==='deduction';if($line['line_kind']==='employer_contribution')$doc->employer_contributions+=$amount;elseif($line['line_kind']==='earning')$doc->total_earnings+=$amount;if((int)$legacy['element_category']===0)$doc->basic_salary+=$amount;
        $doc->add_line((int)$legacy['element_id'],(string)$legacy['element_name'],(int)$legacy['element_category'],$is_deduction?1:0,(int)$legacy['amount_type'],$amount,(float)$line['rate'],$amount,$amount,(string)$legacy['account_code'],null,!empty($legacy['is_taxable']),isset($legacy['display_order'])?(int)$legacy['display_order']:(int)$line['line_no']);
        $compat=array('element_id'=>(int)$legacy['element_id'],'element_name'=>(string)$legacy['element_name'],'element_category'=>(int)$legacy['element_category'],'is_deduction'=>$is_deduction?1:0,'amount_type'=>(int)$legacy['amount_type'],'base_amount'=>number_format($amount,6,'.',''),'rate'=>number_format((float)$line['rate'],6,'.',''),'calculated_amount'=>number_format($amount,6,'.',''),'final_amount'=>number_format($amount,6,'.',''),'account_code'=>(string)$legacy['account_code'],'is_taxable'=>!empty($legacy['is_taxable'])?1:0,'display_order'=>isset($legacy['display_order'])?(int)$legacy['display_order']:(int)$line['line_no']);
        $d=array('line_no'=>(int)$line['line_no'],'legacy_element_id'=>(int)$legacy['element_id'],'element_version_id'=>(int)$line['element_version_id'],'line_kind'=>$line['line_kind'],'amount'=>(string)$line['amount'],'quantity'=>(string)$line['quantity'],'rate'=>(string)$line['rate'],'line_sha256'=>$line['line_sha256'],'mapping_receipt_id'=>(int)$legacy['conversion_receipt_id'],'compatibility'=>$compat);$d['detail_sha256']=hrm_pay_core_010_hash($d);$detail_payload[]=$d;$compat_detail_payload[]=$compat;$mapped[]=(int)$legacy['element_id'];}
    if(empty($detail_payload)){$error='projection_detail_empty';return false;}$doc->total_cost=$doc->gross_salary+$doc->employer_contributions;
    $header=array('payroll_period_id'=>(int)$period['period_id'],'employee_id_sha256'=>hash('sha256',(string)$employee['employee_id']),'from_date'=>$period['from_date'],'to_date'=>$period['to_date'],'tran_date'=>$context['tran_date'],'department_id'=>$employee['department_id']===null?null:(int)$employee['department_id'],'position_id'=>$employee['position_id']===null?null:(int)$employee['position_id'],'grade_id'=>$employee['grade_id']===null?null:(int)$employee['grade_id'],'basic_salary'=>number_format($doc->basic_salary,6,'.',''),'total_earnings'=>number_format($doc->total_earnings,6,'.',''),'gross_salary'=>number_format($doc->gross_salary,6,'.',''),'total_deductions'=>number_format($doc->total_deductions,6,'.',''),'net_salary'=>number_format($doc->net_salary,6,'.',''),'employer_contributions'=>number_format($doc->employer_contributions,6,'.',''),'total_cost'=>number_format($doc->total_cost,6,'.',''),'working_days'=>number_format((float)$context['working_days'],6,'.',''),'worked_days'=>number_format((float)$context['worked_days'],6,'.',''),'overtime_hours'=>number_format((float)$context['overtime_hours'],6,'.',''),'leave_days'=>number_format((float)$context['leave_days'],6,'.',''),'absent_days'=>number_format((float)$context['absent_days'],6,'.',''),'leaves'=>(int)$context['leaves'],'deductable_leaves'=>(int)$context['deductable_leaves'],'loan_deduction'=>number_format((float)$context['loan_deduction'],6,'.',''),'payable_amount'=>number_format($doc->net_salary,6,'.',''),'salary_amount'=>number_format($doc->gross_salary,6,'.',''),'source_result_sha256'=>$result['result_sha256'],'context_sha256'=>$bound['context_sha256']);
