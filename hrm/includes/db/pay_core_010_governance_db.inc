/** Active-new writer: one atomic projection of immutable PAY-CORE results into legacy read tables. */
function hrm_pay_core_010_project_period($period_id,array $contexts,$command_key,&$error=null)
{
    global $path_to_root;
    if(!function_exists('payroll_persist_legacy_payslip_result'))include_once($path_to_root.'/hrm/includes/payroll_engine.inc');
