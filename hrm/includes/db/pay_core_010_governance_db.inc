/**
 * PAY-CORE-010 governed approval, legacy projection, parity and cutover service.
 *
 * The legacy payslip tables remain a compatibility read model.  This service
 * never calculates payroll, posts GL, executes payment, reads bank secrets, or
 * files statutory returns.
 */
include_once(dirname(dirname(__FILE__)).'/payroll/pay_core_010_contract.inc');
include_once(dirname(__FILE__).'/pay_core_010_schema_db.inc');
include_once(dirname(__FILE__).'/payroll_db.inc');
