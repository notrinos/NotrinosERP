    return array('document'=>$doc,'header'=>$header,'details'=>$detail_payload,'descriptor'=>$pd,'context_sha256'=>$bound['context_sha256'],'compat_header_sha256'=>$compat_header_sha,'compat_detail_set_sha256'=>$compat_detail_sha);
}

