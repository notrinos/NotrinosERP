function hrm_cmp_001_actor(){return isset($_SESSION['wa_current_user']->user)?(int)$_SESSION['wa_current_user']->user:0;}
function hrm_cmp_001_access($area){return function_exists('user_check_access')&&user_check_access($area);}
function hrm_cmp_001_tables_ready(){return function_exists('employee_table_exists')&&employee_table_exists('hrm_comp_salary_ranges')&&employee_table_exists('hrm_comp_award_receipts')&&employee_table_exists('hrm_comp_cutover_receipts');}
function hrm_cmp_001_insert_idempotent($table,$id_col,$sha_col,$sha,$sql,&$error){$q=db_query('SELECT '.$id_col.','.$sha_col.' FROM '.TB_PREF.$table.' WHERE '.$sha_col.'='.db_escape($sha).' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){$error='idempotency_state_invalid';return false;}if(db_num_rows($q)===1){$r=db_fetch_assoc($q);return (int)$r[$id_col];}if(!db_query($sql,'could not append HRM-CMP-001 custody')){$error='insert_failed';return false;}return (int)db_insert_id();}

/** Server-derived Worker/Employment/Assignment/Legal Entity scope; caller scope is never authoritative. */
function hrm_cmp_001_resolve_employee_scope($employee_id,$as_of,$for_update=false,&$error=null)
{
    $error=null;$date=hrm_cmp_001_date($as_of);$employee_id=trim((string)$employee_id);
    if($employee_id===''||strlen($employee_id)>20||$date===false){$error='employee_scope_invalid';return false;}
    $de=db_escape($date);$sql='SELECT m.worker_id,m.employee_id,m.employee_number,h.employment_id,h.legal_entity_id,a.assignment_id,a.grade_id,a.legacy_grade_id,a.legacy_position_id,e.personal_salary '
        .'FROM '.TB_PREF.'hrm_employee_worker_map m INNER JOIN '.TB_PREF.'hrm_employments h ON h.worker_id=m.worker_id INNER JOIN '.TB_PREF.'hrm_assignments a ON a.employment_id=h.employment_id INNER JOIN '.TB_PREF.'employees e ON e.employee_number=m.employee_number '
        .'WHERE m.employee_id='.db_escape($employee_id).' AND m.retired_at IS NULL AND (h.start_date IS NULL OR h.start_date<='.$de.') AND (h.end_date IS NULL OR h.end_date>='.$de.') AND (a.effective_from IS NULL OR a.effective_from<='.$de.') AND (a.effective_to IS NULL OR a.effective_to>='.$de.') AND a.primary_flag=1 LIMIT 2'.($for_update?' FOR UPDATE':'');
    $q=db_query($sql,'could not resolve HRM-CMP-001 employee scope');if(!$q||db_num_rows($q)!==1){$error='employee_scope_ambiguous_or_missing';return false;}$r=db_fetch_assoc($q);
    $cq=db_query('SELECT a.assignment_id FROM '.TB_PREF.'hrm_assignments a INNER JOIN '.TB_PREF.'hrm_employments h ON h.employment_id=a.employment_id WHERE h.worker_id='.(int)$r['worker_id'].' AND (h.start_date IS NULL OR h.start_date<='.$de.') AND (h.end_date IS NULL OR h.end_date>='.$de.') AND (a.effective_from IS NULL OR a.effective_from<='.$de.') AND (a.effective_to IS NULL OR a.effective_to>='.$de.') LIMIT 2'.($for_update?' FOR UPDATE':''));if(!$cq||db_num_rows($cq)!==1){$error='concurrent_assignment_compensation_ambiguous';return false;}
    foreach(array('worker_id','employee_number','employment_id','legal_entity_id','assignment_id') as $k)if((int)$r[$k]<=0){$error='employee_scope_incomplete';return false;}
    $grade=!empty($r['grade_id'])?(int)$r['grade_id']:(!empty($r['legacy_grade_id'])?(int)$r['legacy_grade_id']:0);if($grade<=0){$error='grade_scope_missing';return false;}
    return array('worker_id'=>(int)$r['worker_id'],'employee_id'=>(string)$r['employee_id'],'employee_number'=>(int)$r['employee_number'],'employment_id'=>(int)$r['employment_id'],'assignment_id'=>(int)$r['assignment_id'],'legal_entity_id'=>(int)$r['legal_entity_id'],'grade_id'=>$grade,'position_id'=>empty($r['legacy_position_id'])?0:(int)$r['legacy_position_id'],'personal_salary'=>(int)$r['personal_salary']);
}
function hrm_cmp_001_basic_element(&$error=null){$error=null;$q=db_query("SELECT element_id,element_code,inactive,amount_type FROM ".TB_PREF."pay_elements WHERE element_code='HRM_ELEM_BASIC' LIMIT 2");if(!$q||db_num_rows($q)!==1){$error='basic_element_ambiguous_or_missing';return false;}$r=db_fetch_assoc($q);if((int)$r['element_id']<=0||(int)$r['inactive']!==0){$error='basic_element_inactive';return false;}return $r;}

/** Read exactly one legacy base source as opening evidence; no currency or basis is invented. */
function hrm_cmp_001_legacy_base_source(array $scope,$as_of,$for_update=false,&$error=null)
{
    $error=null;$date=hrm_cmp_001_date($as_of);$basic=hrm_cmp_001_basic_element($error);if($date===false||$basic===false)return false;$lock=$for_update?' FOR UPDATE':'';
    if((int)$scope['personal_salary']===1){$sql='SELECT salary_id AS row_id,amount,effective_from,effective_to,formula,reference FROM '.TB_PREF.'employee_salary WHERE employee_id='.db_escape($scope['employee_id']).' AND element_id='.(int)$basic['element_id'].' AND is_active=1 AND effective_from<='.db_escape($date).' AND (effective_to IS NULL OR effective_to=\'0000-00-00\' OR effective_to>='.db_escape($date).') ORDER BY effective_from DESC,salary_id DESC LIMIT 2'.$lock;$q=db_query($sql,'could not read legacy employee base salary');if(!$q||db_num_rows($q)!==1){$error='legacy_personal_base_ambiguous_or_missing';return false;}$r=db_fetch_assoc($q);$kind='employee_salary';
    } else {$sql='SELECT structure_id AS row_id,pay_amount AS amount,effective_from,effective_to,formula FROM '.TB_PREF.'salary_structure WHERE position_id='.(int)$scope['position_id'].' AND grade_id='.(int)$scope['grade_id'].' AND element_id='.(int)$basic['element_id'].' AND is_active=1 AND effective_from<='.db_escape($date).' AND (effective_to IS NULL OR effective_to=\'0000-00-00\' OR effective_to>='.db_escape($date).') ORDER BY effective_from DESC,structure_id DESC LIMIT 2'.$lock;$q=db_query($sql,'could not read legacy structured base salary');if(!$q||db_num_rows($q)!==1){$error='legacy_structured_base_ambiguous_or_missing';return false;}$r=db_fetch_assoc($q);$kind='salary_structure';}
    $amount=hrm_cmp_001_decimal($r['amount']);if($amount===false){$error='legacy_base_amount_invalid';return false;}$sha=hrm_cmp_001_hash(array('source_kind'=>$kind,'row_id'=>(int)$r['row_id'],'employee_id'=>$scope['employee_id'],'assignment_id'=>$scope['assignment_id'],'element_id'=>(int)$basic['element_id'],'amount'=>$amount,'effective_from'=>$r['effective_from'],'effective_to'=>$r['effective_to'],'formula'=>isset($r['formula'])?(string)$r['formula']:'','reference'=>isset($r['reference'])?(string)$r['reference']:''));return array('source_kind'=>$kind,'row_id'=>(int)$r['row_id'],'source_sha256'=>$sha,'amount'=>$amount,'basic_element_id'=>(int)$basic['element_id']);
}

function hrm_cmp_001_create_salary_range(array $x,&$error=null)
{
    $error=null;$actor=hrm_cmp_001_actor();if($actor<=0||!hrm_cmp_001_access('SA_HRM_MANAGE_COMPENSATION')){$error='access_denied';return false;}if(!hrm_cmp_001_validate_range($x)){$error='range_invalid';return false;}$pred=empty($x['predecessor_range_version_id'])?null:(int)$x['predecessor_range_version_id'];begin_transaction();if($pred!==null){$q=db_query('SELECT legal_entity_id,grade_id,range_code,currency_code,pay_basis FROM '.TB_PREF.'hrm_comp_salary_ranges WHERE range_version_id='.$pred.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||(int)$p['legal_entity_id']!==(int)$x['legal_entity_id']||(int)$p['grade_id']!==(int)$x['grade_id']||$p['range_code']!==$x['range_code']||$p['currency_code']!==strtoupper($x['currency_code'])||$p['pay_basis']!==$x['pay_basis']){cancel_transaction();$error='range_predecessor_scope_mismatch';return false;}$q=db_query('SELECT range_version_id FROM '.TB_PREF.'hrm_comp_salary_ranges WHERE predecessor_range_version_id='.$pred.' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='range_predecessor_already_superseded';return false;}}
    $payload=array('legal_entity_id'=>(int)$x['legal_entity_id'],'grade_id'=>(int)$x['grade_id'],'range_code'=>$x['range_code'],'version_token'=>$x['version_token'],'effective_from'=>$x['effective_from'],'effective_to'=>empty($x['effective_to'])?null:$x['effective_to'],'currency_code'=>strtoupper($x['currency_code']),'pay_basis'=>$x['pay_basis'],'minimum_amount'=>hrm_cmp_001_decimal($x['minimum_amount']),'midpoint_amount'=>hrm_cmp_001_decimal($x['midpoint_amount']),'maximum_amount'=>hrm_cmp_001_decimal($x['maximum_amount']),'source_kind'=>$x['source_kind'],'source_ref'=>isset($x['source_ref'])?substr(trim((string)$x['source_ref']),0,160):'','source_evidence_sha256'=>strtolower($x['source_evidence_sha256']),'predecessor_range_version_id'=>$pred,'created_by'=>$actor);$sha=hrm_cmp_001_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_comp_salary_ranges (legal_entity_id,grade_id,range_code,version_token,effective_from,effective_to,currency_code,pay_basis,minimum_amount,midpoint_amount,maximum_amount,source_kind,source_ref,source_evidence_sha256,predecessor_range_version_id,range_sha256,created_by) VALUES ('.$payload['legal_entity_id'].','.$payload['grade_id'].','.db_escape($payload['range_code']).','.db_escape($payload['version_token']).','.db_escape($payload['effective_from']).','.($payload['effective_to']===null?'NULL':db_escape($payload['effective_to'])).','.db_escape($payload['currency_code']).','.db_escape($payload['pay_basis']).','.db_escape($payload['minimum_amount']).','.db_escape($payload['midpoint_amount']).','.db_escape($payload['maximum_amount']).','.db_escape($payload['source_kind']).','.db_escape($payload['source_ref']).','.db_escape($payload['source_evidence_sha256']).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$actor.')';$id=hrm_cmp_001_insert_idempotent('hrm_comp_salary_ranges','range_version_id','range_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('range_version_id'=>$id,'range_sha256'=>$sha);
}

