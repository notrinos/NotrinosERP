function hrm_cmp_001_inventory_opening($employee_id,$as_of,$currency_code,$pay_basis,$evidence_sha256,&$error=null)
{
    $error=null;$actor=hrm_cmp_001_actor();$date=hrm_cmp_001_date($as_of);$currency=hrm_cmp_001_currency($currency_code);$basis=hrm_cmp_001_pay_basis($pay_basis);$evidence=hrm_cmp_001_sha256($evidence_sha256);if($actor<=0||!hrm_cmp_001_access('SA_HRM_MIGRATE_COMPENSATION')){$error='access_denied';return false;}if($date===false||$currency===false||$basis===false||$evidence===false){$error='opening_input_invalid';return false;}begin_transaction();$scope=hrm_cmp_001_resolve_employee_scope($employee_id,$date,true,$error);$legacy=$scope?hrm_cmp_001_legacy_base_source($scope,$date,true,$error):false;if($legacy===false){cancel_transaction();return false;}$payload=array('worker_id'=>$scope['worker_id'],'employment_id'=>$scope['employment_id'],'assignment_id'=>$scope['assignment_id'],'legal_entity_id'=>$scope['legal_entity_id'],'employee_id'=>$scope['employee_id'],'as_of_date'=>$date,'legacy_source_kind'=>$legacy['source_kind'],'legacy_source_row_id'=>$legacy['row_id'],'legacy_source_sha256'=>$legacy['source_sha256'],'base_amount'=>$legacy['amount'],'currency_code'=>$currency,'pay_basis'=>$basis,'basic_element_id'=>$legacy['basic_element_id'],'evidence_sha256'=>$evidence,'inventoried_by'=>$actor);$sha=hrm_cmp_001_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_comp_opening_inventory (worker_id,employment_id,assignment_id,legal_entity_id,employee_id,as_of_date,legacy_source_kind,legacy_source_row_id,legacy_source_sha256,base_amount,currency_code,pay_basis,basic_element_id,evidence_sha256,inventory_sha256,inventoried_by) VALUES ('.$payload['worker_id'].','.$payload['employment_id'].','.$payload['assignment_id'].','.$payload['legal_entity_id'].','.db_escape($payload['employee_id']).','.db_escape($date).','.db_escape($legacy['source_kind']).','.$legacy['row_id'].','.db_escape($legacy['source_sha256']).','.db_escape($legacy['amount']).','.db_escape($currency).','.db_escape($basis).','.$legacy['basic_element_id'].','.db_escape($evidence).','.db_escape($sha).','.$actor.')';$id=hrm_cmp_001_insert_idempotent('hrm_comp_opening_inventory','opening_inventory_id','inventory_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('opening_inventory_id'=>$id,'inventory_sha256'=>$sha);
}
function hrm_cmp_001_review_opening($opening_inventory_id,$decision,$evidence_sha256,&$error=null)
{
    $error=null;$actor=hrm_cmp_001_actor();$decision=(string)$decision;$evidence=hrm_cmp_001_sha256($evidence_sha256);if($actor<=0||!hrm_cmp_001_access('SA_HRM_REVIEW_COMPENSATION')||!in_array($decision,array('approved','rejected'),true)||$evidence===false){$error='access_or_review_invalid';return false;}begin_transaction();$q=db_query('SELECT * FROM '.TB_PREF.'hrm_comp_opening_inventory WHERE opening_inventory_id='.(int)$opening_inventory_id.' LIMIT 2 FOR UPDATE');$inv=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$inv||$actor===(int)$inv['inventoried_by']){cancel_transaction();$error='distinct_opening_reviewer_required';return false;}$sha=hrm_cmp_001_hash(array('opening_inventory_id'=>(int)$opening_inventory_id,'inventory_sha256'=>$inv['inventory_sha256'],'decision_token'=>$decision,'evidence_sha256'=>$evidence,'reviewed_by'=>$actor));$sql='INSERT INTO '.TB_PREF.'hrm_comp_opening_reviews (opening_inventory_id,inventory_sha256,decision_token,evidence_sha256,review_sha256,reviewed_by) VALUES ('.(int)$opening_inventory_id.','.db_escape($inv['inventory_sha256']).','.db_escape($decision).','.db_escape($evidence).','.db_escape($sha).','.$actor.')';$id=hrm_cmp_001_insert_idempotent('hrm_comp_opening_reviews','opening_review_id','review_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('opening_review_id'=>$id,'review_sha256'=>$sha);
