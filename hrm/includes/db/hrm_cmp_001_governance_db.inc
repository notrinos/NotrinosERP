    $error=null;$actor=hrm_cmp_001_actor();$key=hrm_cmp_001_token($execution_key,128);if($actor<=0||!hrm_cmp_001_access('SA_HRM_EXECUTE_COMPENSATION')||$key===false){$error='access_or_execution_key_invalid';return false;}begin_transaction();$q=db_query('SELECT * FROM '.TB_PREF.'hrm_comp_award_commands WHERE award_command_id='.(int)$award_command_id." AND command_status IN ('approved','completed') AND row_version IN (2,3) LIMIT 2 FOR UPDATE");$c=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$c||$actor===(int)$c['requested_by']||$actor===(int)$c['approved_by']||(int)$c['requested_by']===(int)$c['approved_by']){cancel_transaction();$error='three_party_award_separation_required';return false;}$q=db_query('SELECT * FROM '.TB_PREF.'hrm_comp_award_receipts WHERE award_command_id='.(int)$award_command_id.' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){cancel_transaction();$error='award_receipt_state_invalid';return false;}if(db_num_rows($q)===1){$old=db_fetch_assoc($q);if((string)$c['command_status']!=='completed'||(int)$c['row_version']!==3||(int)$old['executed_by']!==$actor||!hash_equals((string)$old['execution_key_hash'],hash('sha256',$key))){cancel_transaction();$error='award_execution_replay_mismatch';return false;}commit_transaction();return $old;}if((string)$c['command_status']!=='approved'||(int)$c['row_version']!==2){cancel_transaction();$error='award_command_not_executable';return false;}
    $scope=hrm_cmp_001_resolve_employee_scope($c['employee_id'],$c['effective_date'],true,$error);$current=$scope?hrm_cmp_001_current_base($scope['assignment_id'],$c['effective_date'],true,$error):false;$range=$scope?hrm_cmp_001_resolve_range_db($scope,$c['currency_code'],$c['pay_basis'],$c['effective_date'],true,$error):false;$cb=$scope?hrm_cmp_001_resolve_cycle_budget((int)$c['review_cycle_id'],$scope,$c['currency_code'],$c['effective_date'],true,$error):false;if(!$scope||!$current||!$range||!$cb){cancel_transaction();return false;}list($cycle,$budget)=$cb;$dq=db_query('SELECT award_receipt_id FROM '.TB_PREF.'hrm_comp_award_receipts WHERE assignment_id='.(int)$c['assignment_id'].' AND effective_date='.db_escape($c['effective_date']).' LIMIT 1 FOR UPDATE');if(!$dq){cancel_transaction();$error='award_effective_date_conflict_check_failed';return false;}if(db_num_rows($dq)>0){cancel_transaction();$error='award_effective_date_conflict';return false;}if((int)$scope['assignment_id']!==(int)$c['assignment_id']||(int)$range['range_version_id']!==(int)$c['range_version_id']||(int)$budget['budget_version_id']!==(int)$c['budget_version_id']||hrm_cmp_001_decimal_compare($current['amount'],$c['old_amount'])!==0){cancel_transaction();$error='award_stale_state_rejected';return false;}$v=hrm_cmp_001_validate_base_award($current['amount'],$c['new_amount'],$range);$spent=hrm_cmp_001_budget_spent($budget,$error);$remaining=$spent===false?false:hrm_cmp_001_decimal_subtract($budget['budget_amount'],$spent);if($v===false||$remaining===false||hrm_cmp_001_decimal_compare($v['budget_impact'],$remaining)>0||hrm_cmp_001_decimal_compare($v['budget_impact'],$c['budget_impact'])!==0){cancel_transaction();$error='award_budget_or_range_revalidation_failed';return false;}
    $pred=$current['predecessor_award_receipt_id'];$receipt_sha=hrm_cmp_001_hash(array('award_command_id'=>(int)$c['award_command_id'],'assignment_id'=>(int)$c['assignment_id'],'review_cycle_id'=>(int)$c['review_cycle_id'],'range_version_id'=>(int)$c['range_version_id'],'budget_version_id'=>(int)$c['budget_version_id'],'award_kind'=>$c['award_kind'],'effective_date'=>$c['effective_date'],'old_amount'=>$c['old_amount'],'new_amount'=>$c['new_amount'],'currency_code'=>$c['currency_code'],'pay_basis'=>$c['pay_basis'],'budget_impact'=>$c['budget_impact'],'purpose_code'=>$c['purpose_code'],'request_sha256'=>$c['request_sha256'],'predecessor_award_receipt_id'=>$pred,'execution_key_hash'=>hash('sha256',$key),'executed_by'=>$actor));$sql='INSERT INTO '.TB_PREF.'hrm_comp_award_receipts (award_command_id,assignment_id,review_cycle_id,range_version_id,budget_version_id,award_kind,effective_date,old_amount,new_amount,currency_code,pay_basis,budget_impact,purpose_code,request_sha256,predecessor_award_receipt_id,execution_key_hash,receipt_sha256,executed_by) VALUES ('.(int)$c['award_command_id'].','.(int)$c['assignment_id'].','.(int)$c['review_cycle_id'].','.(int)$c['range_version_id'].','.(int)$c['budget_version_id'].','.db_escape($c['award_kind']).','.db_escape($c['effective_date']).','.db_escape($c['old_amount']).','.db_escape($c['new_amount']).','.db_escape($c['currency_code']).','.db_escape($c['pay_basis']).','.db_escape($c['budget_impact']).','.db_escape($c['purpose_code']).','.db_escape($c['request_sha256']).','.($pred===null?'NULL':(int)$pred).','.db_escape(hash('sha256',$key)).','.db_escape($receipt_sha).','.$actor.')';if(!db_query($sql)){cancel_transaction();$error='award_receipt_insert_failed';return false;}$receipt_id=(int)db_insert_id();$basic=hrm_cmp_001_basic_element($error);if(!$basic){cancel_transaction();return false;}$employee_id=$c['employee_id'];$assignment_id=(int)$c['assignment_id'];$amount=$c['new_amount'];$date=$c['effective_date'];$salary_id=hrm_cmp_001_with_projection_context($employee_id,$assignment_id,function() use($employee_id,$assignment_id,$basic,$amount,$date){return add_employee_salary($employee_id,(int)$basic['element_id'],$amount,$date,'','','CMP-001 award projection');});if($salary_id===false){cancel_transaction();$error='legacy_projection_insert_failed';return false;}$projection_sha=hrm_cmp_001_hash(array('award_receipt_id'=>$receipt_id,'employee_id'=>$employee_id,'basic_element_id'=>(int)$basic['element_id'],'employee_salary_id'=>(int)$salary_id,'effective_date'=>$date,'amount'=>$amount,'source_sha256'=>$receipt_sha,'created_by'=>$actor));if(!db_query('INSERT INTO '.TB_PREF.'hrm_comp_legacy_projection_receipts (award_receipt_id,employee_id,basic_element_id,employee_salary_id,effective_date,amount,source_sha256,projection_sha256,created_by) VALUES ('.$receipt_id.','.db_escape($employee_id).','.(int)$basic['element_id'].','.(int)$salary_id.','.db_escape($date).','.db_escape($amount).','.db_escape($receipt_sha).','.db_escape($projection_sha).','.$actor.')')){cancel_transaction();$error='projection_receipt_insert_failed';return false;}if(!db_query('UPDATE '.TB_PREF.'hrm_comp_award_commands SET command_status=\'completed\',row_version=3,executed_by='.$actor.',completed_at=NOW() WHERE award_command_id='.(int)$award_command_id." AND command_status='approved' AND row_version=2")){cancel_transaction();$error='award_command_completion_race';return false;}commit_transaction();return array('award_receipt_id'=>$receipt_id,'receipt_sha256'=>$receipt_sha,'projection_salary_id'=>(int)$salary_id,'projection_sha256'=>$projection_sha);
}

function hrm_cmp_001_create_payroll_mapping(array $x,&$error=null)
{
    $error=null;$actor=hrm_cmp_001_actor();foreach(array('legal_entity_id','currency_code','pay_basis','effective_from','element_version_id','input_definition_id') as $k)if(!isset($x[$k])){$error='mapping_field_missing';return false;}if($actor<=0||!hrm_cmp_001_access('SA_HRM_MAP_COMPENSATION_PAYROLL')){$error='access_denied';return false;}$currency=hrm_cmp_001_currency($x['currency_code']);$basis=hrm_cmp_001_pay_basis($x['pay_basis']);$from=hrm_cmp_001_date($x['effective_from']);$to=empty($x['effective_to'])?null:hrm_cmp_001_date($x['effective_to']);$pred=empty($x['predecessor_mapping_id'])?null:(int)$x['predecessor_mapping_id'];if((int)$x['legal_entity_id']<=0||$currency===false||$basis===false||$from===false||($to!==null&&($to===false||$to<$from))||(int)$x['element_version_id']<=0||(int)$x['input_definition_id']<=0){$error='mapping_invalid';return false;}begin_transaction();if($pred!==null){$q=db_query('SELECT legal_entity_id,currency_code,pay_basis FROM '.TB_PREF.'hrm_comp_payroll_mappings WHERE mapping_id='.$pred.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||(int)$p['legal_entity_id']!==(int)$x['legal_entity_id']||$p['currency_code']!==$currency||$p['pay_basis']!==$basis){cancel_transaction();$error='mapping_predecessor_scope_mismatch';return false;}$q=db_query('SELECT mapping_id FROM '.TB_PREF.'hrm_comp_payroll_mappings WHERE predecessor_mapping_id='.$pred.' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='mapping_predecessor_already_superseded';return false;}}$payload=array('legal_entity_id'=>(int)$x['legal_entity_id'],'currency_code'=>$currency,'pay_basis'=>$basis,'effective_from'=>$from,'effective_to'=>$to,'element_version_id'=>(int)$x['element_version_id'],'input_definition_id'=>(int)$x['input_definition_id'],'predecessor_mapping_id'=>$pred,'created_by'=>$actor);$sha=hrm_cmp_001_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_comp_payroll_mappings (legal_entity_id,currency_code,pay_basis,effective_from,effective_to,element_version_id,input_definition_id,predecessor_mapping_id,mapping_sha256,created_by) VALUES ('.$payload['legal_entity_id'].','.db_escape($currency).','.db_escape($basis).','.db_escape($from).','.($to===null?'NULL':db_escape($to)).','.$payload['element_version_id'].','.$payload['input_definition_id'].','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$actor.')';$id=hrm_cmp_001_insert_idempotent('hrm_comp_payroll_mappings','mapping_id','mapping_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('mapping_id'=>$id,'mapping_sha256'=>$sha);
}

/** PAY-CORE-003 is the only payroll value handoff. CMP cannot calculate/post/pay/tax. */
function hrm_cmp_001_send_award_to_payroll($award_receipt_id,$payroll_period_id,$command_key,&$error=null)
{
    $error=null;$actor=hrm_cmp_001_actor();$cmd=hrm_cmp_001_token($command_key,128);if($actor<=0||!hrm_cmp_001_access('SA_HRM_EXECUTE_COMPENSATION_PAYROLL')||!hrm_cmp_001_access('SA_HRM_EXECUTE_PAY_CORE_INPUT')||$cmd===false){$error='access_or_command_invalid';return false;}begin_transaction();$q=db_query('SELECT a.*,c.legal_entity_id,c.employee_id FROM '.TB_PREF.'hrm_comp_award_receipts a INNER JOIN '.TB_PREF.'hrm_comp_award_commands c ON c.award_command_id=a.award_command_id WHERE a.award_receipt_id='.(int)$award_receipt_id.' LIMIT 2 FOR UPDATE');$a=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$a){cancel_transaction();$error='award_receipt_missing';return false;}$q=db_query('SELECT * FROM '.TB_PREF.'hrm_comp_payroll_handoffs WHERE command_key='.db_escape($cmd).' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){cancel_transaction();$error='handoff_command_state_invalid';return false;}if(db_num_rows($q)===1){$old=db_fetch_assoc($q);if((int)$old['award_receipt_id']!==(int)$award_receipt_id){cancel_transaction();$error='handoff_replay_mismatch';return false;}commit_transaction();return $old;}$rel=hrm_tim_001_resolve_payroll_relationship((int)$a['assignment_id'],$a['effective_date'],true,$error);if($rel===false){cancel_transaction();return false;}$q=db_query('SELECT c.calendar_period_id FROM '.TB_PREF.'payroll_periods lp INNER JOIN '.TB_PREF.'hrm_payroll_legacy_period_conversion_receipts c ON c.legacy_period_id=lp.period_id WHERE lp.period_id='.(int)$payroll_period_id.' AND lp.from_date<='.db_escape($a['effective_date']).' AND lp.to_date>='.db_escape($a['effective_date']).' LIMIT 2 FOR UPDATE');$period=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$period){cancel_transaction();$error='payroll_period_out_of_scope';return false;}$q=db_query('SELECT * FROM '.TB_PREF.'hrm_comp_payroll_mappings WHERE legal_entity_id='.(int)$a['legal_entity_id'].' AND currency_code='.db_escape($a['currency_code']).' AND pay_basis='.db_escape($a['pay_basis']).' AND effective_from<='.db_escape($a['effective_date']).' AND (effective_to IS NULL OR effective_to>='.db_escape($a['effective_date']).') AND mapping_id NOT IN (SELECT predecessor_mapping_id FROM '.TB_PREF.'hrm_comp_payroll_mappings WHERE predecessor_mapping_id IS NOT NULL AND effective_from<='.db_escape($a['effective_date']).') ORDER BY effective_from DESC,mapping_id DESC LIMIT 2 FOR UPDATE');$map=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$map){cancel_transaction();$error='payroll_mapping_ambiguous_or_missing';return false;}$source=hrm_cmp_001_hash(array('receipt_sha256'=>$a['receipt_sha256'],'mapping_sha256'=>$map['mapping_sha256'],'adapter_version'=>HRM_CMP_001_PAYROLL_ADAPTER_VERSION));$candidate=array('payroll_relationship_id'=>(int)$rel['payroll_relationship_id'],'assignment_id'=>(int)$a['assignment_id'],'element_version_id'=>(int)$map['element_version_id'],'input_definition_id'=>(int)$map['input_definition_id'],'effective_date'=>$a['effective_date'],'value_type'=>'decimal','value'=>$a['new_amount'],'source_kind'=>'hrm_cmp_001_base_award','source_event_id'=>(string)$award_receipt_id,'source_sha256'=>$source,'approval_evidence_sha256'=>$a['request_sha256']);$pc3=hrm_pay_core_003_write_approved_input($candidate,$error);if($pc3===false){cancel_transaction();return false;}$sha=hrm_cmp_001_hash(array('award_receipt_id'=>(int)$award_receipt_id,'payroll_relationship_id'=>(int)$rel['payroll_relationship_id'],'payroll_period_id'=>(int)$payroll_period_id,'calendar_period_id'=>(int)$period['calendar_period_id'],'assignment_id'=>(int)$a['assignment_id'],'approved_input_id'=>(int)$pc3['approved_input_id'],'approved_input_sha256'=>$pc3['input_sha256'],'adapter_version'=>HRM_CMP_001_PAYROLL_ADAPTER_VERSION,'command_key'=>$cmd,'executed_by'=>$actor));$sql='INSERT INTO '.TB_PREF.'hrm_comp_payroll_handoffs (award_receipt_id,payroll_relationship_id,payroll_period_id,calendar_period_id,assignment_id,approved_input_id,approved_input_sha256,adapter_version,command_key,handoff_sha256,executed_by) VALUES ('.(int)$award_receipt_id.','.(int)$rel['payroll_relationship_id'].','.(int)$payroll_period_id.','.(int)$period['calendar_period_id'].','.(int)$a['assignment_id'].','.(int)$pc3['approved_input_id'].','.db_escape($pc3['input_sha256']).','.db_escape(HRM_CMP_001_PAYROLL_ADAPTER_VERSION).','.db_escape($cmd).','.db_escape($sha).','.$actor.')';if(!db_query($sql)){cancel_transaction();$error='payroll_handoff_insert_failed';return false;}$id=(int)db_insert_id();commit_transaction();return array('handoff_id'=>$id,'handoff_sha256'=>$sha,'approved_input_id'=>(int)$pc3['approved_input_id'],'approved_input_sha256'=>$pc3['input_sha256']);
}

function hrm_cmp_001_reconcile_assignment($assignment_id,$as_of,$status,$evidence_sha256,$predecessor_id=null,&$error=null)
{
    $error=null;$actor=hrm_cmp_001_actor();$date=hrm_cmp_001_date($as_of);$evidence=hrm_cmp_001_sha256($evidence_sha256);if($actor<=0||!hrm_cmp_001_access('SA_HRM_RECOVER_COMPENSATION')||$date===false||$evidence===false||!in_array($status,array('match','mismatch','quarantined','recovered'),true)){$error='reconciliation_invalid_or_unauthorized';return false;}begin_transaction();$current=hrm_cmp_001_current_base((int)$assignment_id,$date,true,$error);if(!$current){cancel_transaction();return false;}$q=db_query('SELECT employee_id FROM '.TB_PREF.'hrm_comp_cutover_receipts WHERE assignment_id='.(int)$assignment_id.' LIMIT 2 FOR UPDATE');$cut=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;$scope=$cut?hrm_cmp_001_resolve_employee_scope($cut['employee_id'],$date,true,$error):false;$legacy=$scope?hrm_cmp_001_legacy_base_source($scope,$date,true,$error):false;if(!$legacy){cancel_transaction();return false;}$a=hrm_cmp_001_decimal($current['amount']);$b=hrm_cmp_001_decimal($legacy['amount']);$diff=hrm_cmp_001_decimal_compare($a,$b)>=0?hrm_cmp_001_decimal_subtract($a,$b):hrm_cmp_001_decimal_subtract($b,$a);if(($status==='match')!==($diff==='0.000000')){cancel_transaction();$error='reconciliation_status_mismatch';return false;}$pred=$predecessor_id===null?null:(int)$predecessor_id;$q=db_query('SELECT reconciliation_id FROM '.TB_PREF.'hrm_comp_reconciliations WHERE assignment_id='.(int)$assignment_id.' ORDER BY reconciliation_id DESC LIMIT 1 FOR UPDATE');$latest=$q&&db_num_rows($q)===1?(int)db_fetch_assoc($q)['reconciliation_id']:null;if(($latest===null&&$pred!==null)||($latest!==null&&$pred!==$latest)){cancel_transaction();$error='reconciliation_predecessor_mismatch';return false;}$sha=hrm_cmp_001_hash(array('assignment_id'=>(int)$assignment_id,'as_of_date'=>$date,'governed_amount'=>$a,'legacy_amount'=>$b,'difference_amount'=>$diff,'status_token'=>$status,'evidence_sha256'=>$evidence,'predecessor_reconciliation_id'=>$pred,'reviewed_by'=>$actor));$sql='INSERT INTO '.TB_PREF.'hrm_comp_reconciliations (assignment_id,as_of_date,governed_amount,legacy_amount,difference_amount,status_token,evidence_sha256,predecessor_reconciliation_id,reconciliation_sha256,reviewed_by) VALUES ('.(int)$assignment_id.','.db_escape($date).','.db_escape($a).','.db_escape($b).','.db_escape($diff).','.db_escape($status).','.db_escape($evidence).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$actor.')';$id=hrm_cmp_001_insert_idempotent('hrm_comp_reconciliations','reconciliation_id','reconciliation_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('reconciliation_id'=>$id,'reconciliation_sha256'=>$sha);
}
function hrm_cmp_001_record_recovery($reconciliation_id,$action_token,$evidence_sha256,&$error=null)
{
    $error=null;$actor=hrm_cmp_001_actor();$action=hrm_cmp_001_token($action_token,48);$evidence=hrm_cmp_001_sha256($evidence_sha256);if($actor<=0||!hrm_cmp_001_access('SA_HRM_RECOVER_COMPENSATION')||$action===false||$evidence===false){$error='recovery_invalid_or_unauthorized';return false;}begin_transaction();$q=db_query('SELECT reconciliation_sha256,status_token,reviewed_by FROM '.TB_PREF.'hrm_comp_reconciliations WHERE reconciliation_id='.(int)$reconciliation_id.' LIMIT 2 FOR UPDATE');$r=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$r||$actor===(int)$r['reviewed_by']||!in_array($r['status_token'],array('mismatch','quarantined'),true)){cancel_transaction();$error='distinct_recovery_executor_required';return false;}$sha=hrm_cmp_001_hash(array('reconciliation_id'=>(int)$reconciliation_id,'action_token'=>$action,'source_sha256'=>$r['reconciliation_sha256'],'evidence_sha256'=>$evidence,'executed_by'=>$actor));$sql='INSERT INTO '.TB_PREF.'hrm_comp_recovery_evidence (reconciliation_id,action_token,source_sha256,evidence_sha256,recovery_sha256,executed_by) VALUES ('.(int)$reconciliation_id.','.db_escape($action).','.db_escape($r['reconciliation_sha256']).','.db_escape($evidence).','.db_escape($sha).','.$actor.')';$id=hrm_cmp_001_insert_idempotent('hrm_comp_recovery_evidence','recovery_evidence_id','recovery_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('recovery_evidence_id'=>$id,'recovery_sha256'=>$sha);
}
