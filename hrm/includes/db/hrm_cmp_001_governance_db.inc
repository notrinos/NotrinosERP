{
    $error=null;$actor=hrm_cmp_001_actor();foreach(array('legal_entity_id','cycle_code','version_token','open_date','close_date','award_effective_from','award_effective_to','status_token','purpose_code','evidence_sha256') as $k)if(!isset($x[$k])){$error='cycle_field_missing';return false;}if($actor<=0||!hrm_cmp_001_access('SA_HRM_MANAGE_COMPENSATION')){$error='access_denied';return false;}$o=hrm_cmp_001_date($x['open_date']);$c=hrm_cmp_001_date($x['close_date']);$a=hrm_cmp_001_date($x['award_effective_from']);$b=hrm_cmp_001_date($x['award_effective_to']);$status=(string)$x['status_token'];$pred=empty($x['predecessor_review_cycle_id'])?null:(int)$x['predecessor_review_cycle_id'];if((int)$x['legal_entity_id']<=0||hrm_cmp_001_token($x['cycle_code'],64)===false||hrm_cmp_001_token($x['version_token'],64)===false||$o===false||$c===false||$c<$o||$a===false||$b===false||$b<$a||!in_array($status,array('planned','open','closed'),true)||hrm_cmp_001_token($x['purpose_code'],64)===false||hrm_cmp_001_sha256($x['evidence_sha256'])===false){$error='cycle_invalid';return false;}begin_transaction();if($pred!==null){$q=db_query('SELECT legal_entity_id,cycle_code FROM '.TB_PREF.'hrm_comp_review_cycles WHERE review_cycle_id='.$pred.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||(int)$p['legal_entity_id']!==(int)$x['legal_entity_id']||$p['cycle_code']!==$x['cycle_code']){cancel_transaction();$error='cycle_predecessor_scope_mismatch';return false;}$q=db_query('SELECT review_cycle_id FROM '.TB_PREF.'hrm_comp_review_cycles WHERE predecessor_review_cycle_id='.$pred.' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='cycle_predecessor_already_superseded';return false;}}
