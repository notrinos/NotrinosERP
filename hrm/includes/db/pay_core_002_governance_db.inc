<?php
/** PAY-CORE-002 governed writers. Not production-loaded by payroll_engine.inc. */
include_once(dirname(dirname(__FILE__)).'/payroll/pay_core_002_governance.inc');
include_once(dirname(dirname(__FILE__)).'/payroll/pay_core_002_relationship_policy.inc');
function hrm_pay_core_002_actor(){return isset($_SESSION['wa_current_user']->user)?(int)$_SESSION['wa_current_user']->user:0;}
function hrm_pay_core_002_access($p){return function_exists('user_check_access')&&user_check_access($p);}
function hrm_pay_core_002_insert_idempotent($table,$hash_col,$hash,$sql,$id_col,&$error){$q=db_query('SELECT '.$id_col.','.$hash_col.' FROM '.TB_PREF.$table.' WHERE '.$hash_col.'='.db_escape($hash).' LIMIT 2 FOR UPDATE');if(!$q){$error='lookup_failed';return false;}if(db_num_rows($q)===1){$x=db_fetch_assoc($q);return (int)$x[$id_col];}if(db_num_rows($q)>1){$error='ambiguous_replay';return false;}if(!db_query($sql,'could not append PAY-CORE-002 custody')){$error='insert_failed';return false;}return (int)db_insert_id();}
function hrm_pay_core_002_propose_seed(array $x,&$error=null){$error=null;$maker=hrm_pay_core_002_actor();if($maker<=0||!hrm_pay_core_002_access('SA_HRM_MANAGE_PAY_CORE')){$error='access_denied';return false;}if(!hrm_pay_core_002_validate_seed_proposal($x)){$error='invalid_proposal';return false;}$key=hrm_pay_core_002_token($x['proposal_key']??'',96);if($key===false){$error='invalid_proposal_key';return false;}$periods=hrm_pay_core_002_validate_period_plan($x['frequency'],$x['period_plan'],$x['effective_from']);if($periods===false){$error='invalid_period_plan';return false;}$plan_json=json_encode($x['period_plan'],JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE);$plan_sha=hash('sha256',$plan_json);$payload=array('proposal_key'=>$key,'legal_entity_id'=>(int)$x['legal_entity_id'],'currency_code'=>$x['currency_code'],'calendar_code'=>$x['calendar_code'],'calendar_name'=>trim($x['calendar_name']),'group_code'=>$x['group_code'],'group_name'=>trim($x['group_name']),'frequency_token'=>$x['frequency'],'timezone_name'=>$x['timezone_name'],'effective_from'=>$x['effective_from'],'period_plan_sha256'=>$plan_sha,'maker_id'=>$maker);$h=hrm_pay_core_002_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_payroll_seed_proposals (proposal_key,legal_entity_id,currency_code,calendar_code,calendar_name,group_code,group_name,frequency_token,timezone_name,effective_from,period_plan_json,period_plan_sha256,proposal_sha256,maker_id) VALUES ('.db_escape($key).','.(int)$x['legal_entity_id'].','.db_escape($x['currency_code']).','.db_escape($x['calendar_code']).','.db_escape(trim($x['calendar_name'])).','.db_escape($x['group_code']).','.db_escape(trim($x['group_name'])).','.db_escape($x['frequency']).','.db_escape($x['timezone_name']).','.db_escape($x['effective_from']).','.db_escape($plan_json).','.db_escape($plan_sha).','.db_escape($h).','.$maker.')';return hrm_pay_core_002_insert_idempotent('hrm_payroll_seed_proposals','proposal_sha256',$h,$sql,'proposal_id',$error);}
function hrm_pay_core_002_approve_seed($proposal_id,$evidence_sha256,&$error=null){$error=null;$checker=hrm_pay_core_002_actor();$evidence_sha256=hrm_pay_core_002_sha($evidence_sha256);if($checker<=0||!hrm_pay_core_002_access('SA_HRM_REVIEW_PAY_CORE')||$evidence_sha256===false){$error='access_or_evidence_invalid';return false;}$q=db_query('SELECT proposal_id,proposal_sha256,maker_id FROM '.TB_PREF.'hrm_payroll_seed_proposals WHERE proposal_id='.(int)$proposal_id.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||(int)$p['maker_id']===$checker){$error='distinct_checker_required';return false;}$h=hrm_pay_core_002_hash(array('proposal_id'=>(int)$proposal_id,'proposal_sha256'=>$p['proposal_sha256'],'decision_token'=>'approved','evidence_sha256'=>$evidence_sha256,'checker_id'=>$checker));$sql='INSERT INTO '.TB_PREF.'hrm_payroll_seed_approvals (proposal_id,proposal_sha256,decision_token,evidence_sha256,approval_sha256,checker_id) VALUES ('.(int)$proposal_id.','.db_escape($p['proposal_sha256']).",'approved',".db_escape($evidence_sha256).','.db_escape($h).','.$checker.')';return hrm_pay_core_002_insert_idempotent('hrm_payroll_seed_approvals','approval_sha256',$h,$sql,'approval_id',$error);}
function hrm_pay_core_002_execute_seed($proposal_id,&$error=null){$error=null;$executor=hrm_pay_core_002_actor();if($executor<=0||!hrm_pay_core_002_access('SA_HRM_EXECUTE_PAY_CORE')){$error='access_denied';return false;}$q=db_query('SELECT p.*,a.approval_id,a.approval_sha256,a.checker_id FROM '.TB_PREF.'hrm_payroll_seed_proposals p INNER JOIN '.TB_PREF.'hrm_payroll_seed_approvals a ON a.proposal_id=p.proposal_id AND a.proposal_sha256=p.proposal_sha256 WHERE p.proposal_id='.(int)$proposal_id." AND a.decision_token='approved' LIMIT 2 FOR UPDATE");$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||$executor===(int)$p['maker_id']||$executor===(int)$p['checker_id']||((int)$p['maker_id']===(int)$p['checker_id'])){$error='three_party_separation_required';return false;}$q=db_query('SELECT execution_id,executor_id FROM '.TB_PREF.'hrm_payroll_seed_executions WHERE proposal_id='.(int)$proposal_id.' LIMIT 2 FOR UPDATE');if($q&&db_num_rows($q)===1){$x=db_fetch_assoc($q);if((int)$x['executor_id']!==$executor){$error='replay_executor_mismatch';return false;}return (int)$x['execution_id'];}if(!$q||db_num_rows($q)>1){$error='execution_state_invalid';return false;}
    $leq=db_query('SELECT legal_entity_id,base_currency,entity_status FROM '.TB_PREF.'hrm_legal_entities WHERE legal_entity_id='.(int)$p['legal_entity_id'].' LIMIT 2 FOR UPDATE');$le=$leq&&db_num_rows($leq)===1?db_fetch_assoc($leq):false;if(!$le||$le['entity_status']!=='active'||$le['base_currency']!==$p['currency_code']){$error='legal_entity_currency_mismatch';return false;}$plan=json_decode($p['period_plan_json'],true);if(!is_array($plan)||!hash_equals((string)$p['period_plan_sha256'],hash('sha256',$p['period_plan_json']))||($periods=hrm_pay_core_002_validate_period_plan($p['frequency_token'],$plan,$p['effective_from']))===false){$error='approved_period_plan_invalid';return false;}
    $manage=empty($GLOBALS['transaction_level']);if($manage)begin_transaction();$ok=true;
    $ch=hrm_pay_core_002_hash(array('calendar_code'=>$p['calendar_code'],'legal_entity_id'=>(int)$p['legal_entity_id']));if(!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_calendars (calendar_code,calendar_name,legal_entity_id,calendar_sha256,created_by) VALUES ('.db_escape($p['calendar_code']).','.db_escape($p['calendar_name']).','.(int)$p['legal_entity_id'].','.db_escape($ch).','.$executor.')'))$ok=false;$cal=(int)db_insert_id();
    $cvh=hrm_pay_core_002_hash(array('calendar_id'=>$cal,'version_no'=>1,'frequency_token'=>$p['frequency_token'],'effective_from'=>$p['effective_from'],'timezone_name'=>$p['timezone_name']));if($ok&&!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_calendar_versions (calendar_id,version_no,frequency_token,effective_from,effective_to,timezone_name,version_sha256,created_by) VALUES ('.$cal.',1,'.db_escape($p['frequency_token']).','.db_escape($p['effective_from']).',NULL,'.db_escape($p['timezone_name']).','.db_escape($cvh).','.$executor.')'))$ok=false;$calv=(int)db_insert_id();
    $period_hashes=array();if($ok){foreach($periods as $period){$ph=hrm_pay_core_002_hash(array('calendar_version_id'=>$calv,'period_key'=>$period['period_key'],'period_start'=>$period['period_start'],'period_end'=>$period['period_end'],'cutoff_date'=>$period['cutoff_date'],'pay_date'=>$period['pay_date'],'post_date'=>$period['post_date'],'file_date'=>$period['file_date'],'run_type'=>$period['run_type']));if(!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_calendar_periods (calendar_version_id,period_key,period_start,period_end,cutoff_date,pay_date,post_date,file_date,run_type,period_sha256,created_by) VALUES ('.$calv.','.db_escape($period['period_key']).','.db_escape($period['period_start']).','.db_escape($period['period_end']).','.db_escape($period['cutoff_date']).','.db_escape($period['pay_date']).','.db_escape($period['post_date']).','.db_escape($period['file_date']).','.db_escape($period['run_type']).','.db_escape($ph).','.$executor.')')){$ok=false;$error='period_generation_insert_failed';break;}$period_hashes[]=$ph;}}$period_set_sha=hash('sha256',implode('|',$period_hashes));
    $gh=hrm_pay_core_002_hash(array('group_code'=>$p['group_code'],'legal_entity_id'=>(int)$p['legal_entity_id']));if($ok&&!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_groups (group_code,group_name,legal_entity_id,group_sha256,created_by) VALUES ('.db_escape($p['group_code']).','.db_escape($p['group_name']).','.(int)$p['legal_entity_id'].','.db_escape($gh).','.$executor.')'))$ok=false;$grp=(int)db_insert_id();
    $gvh=hrm_pay_core_002_hash(array('payroll_group_id'=>$grp,'version_no'=>1,'calendar_version_id'=>$calv,'effective_from'=>$p['effective_from']));if($ok&&!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_group_versions (payroll_group_id,version_no,calendar_version_id,effective_from,effective_to,version_sha256,created_by) VALUES ('.$grp.',1,'.$calv.','.db_escape($p['effective_from']).',NULL,'.db_escape($gvh).','.$executor.')'))$ok=false;$grpv=(int)db_insert_id();
    $eh=hrm_pay_core_002_hash(array('proposal_sha256'=>$p['proposal_sha256'],'approval_sha256'=>$p['approval_sha256'],'calendar_version_id'=>$calv,'group_version_id'=>$grpv,'currency_code'=>$p['currency_code'],'period_count'=>count($period_hashes),'period_set_sha256'=>$period_set_sha,'executor_id'=>$executor));if($ok&&!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_seed_executions (proposal_id,approval_id,calendar_id,calendar_version_id,payroll_group_id,group_version_id,currency_code,period_count,period_set_sha256,execution_sha256,executor_id) VALUES ('.(int)$proposal_id.','.(int)$p['approval_id'].','.$cal.','.$calv.','.$grp.','.$grpv.','.db_escape($p['currency_code']).','.(int)count($period_hashes).','.db_escape($period_set_sha).','.db_escape($eh).','.$executor.')'))$ok=false;$id=(int)db_insert_id();if($manage){if($ok)commit_transaction();else cancel_transaction();}if(!$ok){$error='seed_execution_failed';return false;}return $id;
}
