include_once(dirname(__FILE__).'/hrm_ben_001_governance_db.inc');
function hrm_ben_001_append_adapter_version($kind,array $x,&$error=null){$error=null;$actor=hrm_ben_001_actor();if(!in_array($kind,array('pack','provider'),true)){$error='adapter_kind_invalid';return false;}$perm=$kind==='pack'?'SA_HRM_MANAGE_BENEFIT_PACK':'SA_HRM_MANAGE_BENEFIT_PROVIDER';foreach(array('adapter_code','version_token','effective_from','capability_json','data_contract_sha256','mapping_sha256') as $k)if(!isset($x[$k])){$error='adapter_field_missing';return false;}$from=hrm_ben_001_date($x['effective_from']);$to=empty($x['effective_to'])?null:hrm_ben_001_date($x['effective_to']);$cap=json_decode((string)$x['capability_json'],true);if($actor<=0||!hrm_ben_001_access($perm)||hrm_ben_001_token($x['adapter_code'],64)===false||hrm_ben_001_token($x['version_token'],64)===false||$from===false||($to!==null&&($to===false||$to<$from))||!is_array($cap)||hrm_ben_001_sha256($x['data_contract_sha256'])===false||hrm_ben_001_sha256($x['mapping_sha256'])===false){$error='adapter_invalid_or_unauthorized';return false;}if($kind==='provider'&&hrm_ben_001_sha256($x['minimization_sha256']??'')===false){$error='provider_minimization_missing';return false;}$table=$kind==='pack'?'hrm_ben_pack_adapter_versions':'hrm_ben_provider_adapter_versions';$idc=$kind==='pack'?'pack_adapter_version_id':'provider_adapter_version_id';$pred=empty($x['predecessor_adapter_version_id'])?null:(int)$x['predecessor_adapter_version_id'];$p=array('adapter_code'=>$x['adapter_code'],'version_token'=>$x['version_token'],'effective_from'=>$from,'effective_to'=>$to,'capability_json'=>json_encode(hrm_ben_001_canonicalize($cap),JSON_UNESCAPED_SLASHES),'data_contract_sha256'=>strtolower($x['data_contract_sha256']),'mapping_sha256'=>strtolower($x['mapping_sha256']),'predecessor_adapter_version_id'=>$pred);if($kind==='provider')$p['minimization_sha256']=strtolower($x['minimization_sha256']);$sha=hrm_ben_001_hash($p);begin_transaction();if($pred!==null){$q=db_query('SELECT adapter_code,effective_from FROM '.TB_PREF.$table.' WHERE '.$idc.'='.$pred.' LIMIT 2 FOR UPDATE');$old=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$old||$old['adapter_code']!==$p['adapter_code']||$from<=(string)$old['effective_from']){cancel_transaction();$error='adapter_predecessor_or_effective_order_invalid';return false;}$q=db_query('SELECT '.$idc.' FROM '.TB_PREF.$table.' WHERE predecessor_adapter_version_id='.$pred.' LIMIT 1 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='adapter_predecessor_already_superseded';return false;}}$cols='adapter_code,version_token,effective_from,effective_to,capability_json,data_contract_sha256,mapping_sha256'.($kind==='provider'?',minimization_sha256':'').',predecessor_adapter_version_id,adapter_sha256,created_by';$vals=db_escape($p['adapter_code']).','.db_escape($p['version_token']).','.db_escape($from).','.($to===null?'NULL':db_escape($to)).','.db_escape($p['capability_json']).','.db_escape($p['data_contract_sha256']).','.db_escape($p['mapping_sha256']).($kind==='provider'?','.db_escape($p['minimization_sha256']):'').','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$actor;$id=hrm_ben_001_insert_idempotent($table,$idc,'adapter_sha256',$sha,'INSERT INTO '.TB_PREF.$table.' ('.$cols.') VALUES ('.$vals.')',$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array($idc=>$id,'adapter_sha256'=>$sha);}
function hrm_ben_001_create_plan($legal_entity_id,$plan_code,&$error=null){$error=null;$a=hrm_ben_001_actor();$c=hrm_ben_001_token($plan_code,64);if($a<=0||!hrm_ben_001_access('SA_HRM_MANAGE_BENEFITS')||(int)$legal_entity_id<=0||$c===false){$error='plan_invalid_or_unauthorized';return false;}$sha=hrm_ben_001_hash(array('legal_entity_id'=>(int)$legal_entity_id,'plan_code'=>$c));begin_transaction();$id=hrm_ben_001_insert_idempotent('hrm_ben_plans','plan_id','identity_sha256',$sha,'INSERT INTO '.TB_PREF.'hrm_ben_plans (legal_entity_id,plan_code,identity_sha256,created_by) VALUES ('.(int)$legal_entity_id.','.db_escape($c).','.db_escape($sha).','.$a.')',$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('plan_id'=>$id,'identity_sha256'=>$sha);}
function hrm_ben_001_append_plan_version(array $x,&$error=null){$error=null;$a=hrm_ben_001_actor();foreach(array('plan_id','version_token','effective_from','status_token','coverage_basis_code','contribution_basis_code','source_evidence_sha256') as $k)if(!isset($x[$k])){$error='plan_version_field_missing';return false;}$from=hrm_ben_001_date($x['effective_from']);$to=empty($x['effective_to'])?null:hrm_ben_001_date($x['effective_to']);if($a<=0||!hrm_ben_001_access('SA_HRM_MANAGE_BENEFITS')||(int)$x['plan_id']<=0||hrm_ben_001_token($x['version_token'],64)===false||$from===false||($to!==null&&($to===false||$to<$from))||!in_array($x['status_token'],array('draft','active','closed'),true)||hrm_ben_001_token($x['coverage_basis_code'],64)===false||hrm_ben_001_token($x['contribution_basis_code'],64)===false||hrm_ben_001_sha256($x['source_evidence_sha256'])===false){$error='plan_version_invalid_or_unauthorized';return false;}$pred=empty($x['predecessor_plan_version_id'])?null:(int)$x['predecessor_plan_version_id'];$pack=empty($x['pack_adapter_version_id'])?null:(int)$x['pack_adapter_version_id'];$provider=empty($x['provider_adapter_version_id'])?null:(int)$x['provider_adapter_version_id'];$p=array('plan_id'=>(int)$x['plan_id'],'version_token'=>$x['version_token'],'effective_from'=>$from,'effective_to'=>$to,'status_token'=>$x['status_token'],'coverage_basis_code'=>$x['coverage_basis_code'],'contribution_basis_code'=>$x['contribution_basis_code'],'pack_adapter_version_id'=>$pack,'provider_adapter_version_id'=>$provider,'source_evidence_sha256'=>strtolower($x['source_evidence_sha256']),'predecessor_plan_version_id'=>$pred);$sha=hrm_ben_001_hash($p);begin_transaction();$q=db_query('SELECT plan_version_id FROM '.TB_PREF.'hrm_ben_plan_versions WHERE plan_id='.$p['plan_id'].' AND effective_from='.db_escape($from).' LIMIT 1 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='plan_version_effective_date_conflict';return false;}if($pred!==null){$q=db_query('SELECT plan_id,effective_from FROM '.TB_PREF.'hrm_ben_plan_versions WHERE plan_version_id='.$pred.' LIMIT 2 FOR UPDATE');$old=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$old||(int)$old['plan_id']!==$p['plan_id']||$from<=(string)$old['effective_from']){cancel_transaction();$error='plan_version_predecessor_scope_or_order_mismatch';return false;}$q=db_query('SELECT plan_version_id FROM '.TB_PREF.'hrm_ben_plan_versions WHERE predecessor_plan_version_id='.$pred.' LIMIT 1 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='plan_version_predecessor_already_superseded';return false;}}$sql='INSERT INTO '.TB_PREF.'hrm_ben_plan_versions (plan_id,version_token,effective_from,effective_to,status_token,coverage_basis_code,contribution_basis_code,pack_adapter_version_id,provider_adapter_version_id,source_evidence_sha256,predecessor_plan_version_id,version_sha256,created_by) VALUES ('.$p['plan_id'].','.db_escape($p['version_token']).','.db_escape($from).','.($to===null?'NULL':db_escape($to)).','.db_escape($p['status_token']).','.db_escape($p['coverage_basis_code']).','.db_escape($p['contribution_basis_code']).','.($pack===null?'NULL':$pack).','.($provider===null?'NULL':$provider).','.db_escape($p['source_evidence_sha256']).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_plan_versions','plan_version_id','version_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('plan_version_id'=>$id,'version_sha256'=>$sha);}
function hrm_ben_001_resolve_plan_version($plan_id,$as_of,$for_update=false,&$error=null){$error=null;$d=hrm_ben_001_date($as_of);if((int)$plan_id<=0||$d===false){$error='plan_version_scope_invalid';return false;}$q=db_query('SELECT p.legal_entity_id,p.plan_code,v.* FROM '.TB_PREF.'hrm_ben_plan_versions v INNER JOIN '.TB_PREF.'hrm_ben_plans p ON p.plan_id=v.plan_id WHERE v.plan_id='.(int)$plan_id.' AND v.effective_from<='.db_escape($d).' AND (v.effective_to IS NULL OR v.effective_to>='.db_escape($d).') AND v.status_token='.db_escape('active').' ORDER BY v.effective_from DESC LIMIT 2'.($for_update?' FOR UPDATE':''));if(!$q||db_num_rows($q)<1){$error='plan_version_missing';return false;}$r=db_fetch_assoc($q);if(db_num_rows($q)===2){$n=db_fetch_assoc($q);if((string)$n['effective_from']===(string)$r['effective_from']){$error='plan_version_ambiguous';return false;}}return $r;}
function hrm_ben_001_append_eligibility_version(array $x,&$error=null){$error=null;$a=hrm_ben_001_actor();foreach(array('plan_version_id','effective_from','resolver_code','rule_payload_json','rule_artifact_sha256') as $k)if(!isset($x[$k])){$error='eligibility_field_missing';return false;}$from=hrm_ben_001_date($x['effective_from']);$to=empty($x['effective_to'])?null:hrm_ben_001_date($x['effective_to']);$rule=json_decode((string)$x['rule_payload_json'],true);$probe=hrm_ben_001_eligibility_predicates();if($a<=0||!hrm_ben_001_access('SA_HRM_MANAGE_BENEFITS')||(int)$x['plan_version_id']<=0||$from===false||($to!==null&&($to===false||$to<$from))||$x['resolver_code']!=='scope_match_v1'||!is_array($rule)||hrm_ben_001_sha256($x['rule_artifact_sha256'])===false){$error='eligibility_invalid_or_unauthorized';return false;}foreach($rule as $k=>$v)if(!isset($probe[$k])||(is_array($v)&&count($v)<1)){$error='eligibility_predicate_unsupported';return false;}$pred=empty($x['predecessor_eligibility_version_id'])?null:(int)$x['predecessor_eligibility_version_id'];$canon=json_encode(hrm_ben_001_canonicalize($rule),JSON_UNESCAPED_SLASHES);$p=array('plan_version_id'=>(int)$x['plan_version_id'],'effective_from'=>$from,'effective_to'=>$to,'resolver_code'=>'scope_match_v1','rule_payload_json'=>$canon,'rule_artifact_sha256'=>strtolower($x['rule_artifact_sha256']),'predecessor_eligibility_version_id'=>$pred);$sha=hrm_ben_001_hash($p);begin_transaction();$q=db_query('SELECT eligibility_version_id FROM '.TB_PREF.'hrm_ben_eligibility_versions WHERE plan_version_id='.$p['plan_version_id'].' AND effective_from='.db_escape($from).' LIMIT 1 FOR UPDATE');if(!$q||db_num_rows($q)>0){cancel_transaction();$error='eligibility_effective_date_conflict';return false;}$sql='INSERT INTO '.TB_PREF.'hrm_ben_eligibility_versions (plan_version_id,effective_from,effective_to,resolver_code,rule_payload_json,rule_artifact_sha256,predecessor_eligibility_version_id,eligibility_sha256,created_by) VALUES ('.$p['plan_version_id'].','.db_escape($from).','.($to===null?'NULL':db_escape($to)).',\'scope_match_v1\','.db_escape($canon).','.db_escape($p['rule_artifact_sha256']).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_eligibility_versions','eligibility_version_id','eligibility_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('eligibility_version_id'=>$id,'eligibility_sha256'=>$sha);}
function hrm_ben_001_resolve_eligibility(array $scope,$plan_version_id,$as_of,$for_update=false,&$error=null){$error=null;$d=hrm_ben_001_date($as_of);if($d===false){$error='eligibility_date_invalid';return false;}$q=db_query('SELECT * FROM '.TB_PREF.'hrm_ben_eligibility_versions WHERE plan_version_id='.(int)$plan_version_id.' AND effective_from<='.db_escape($d).' AND (effective_to IS NULL OR effective_to>='.db_escape($d).') ORDER BY effective_from DESC LIMIT 2'.($for_update?' FOR UPDATE':''));if(!$q||db_num_rows($q)<1){$error='eligibility_missing';return false;}$r=db_fetch_assoc($q);if(db_num_rows($q)===2){$n=db_fetch_assoc($q);if((string)$n['effective_from']===(string)$r['effective_from']){$error='eligibility_ambiguous';return false;}}if($r['resolver_code']!=='scope_match_v1'||!hrm_ben_001_evaluate_scope_match($scope,$r['rule_payload_json'])){$error='eligibility_denied_or_invalid';return false;}return $r;}
function hrm_ben_001_append_window(array $x,&$error=null){$error=null;$a=hrm_ben_001_actor();foreach(array('plan_version_id','window_code','window_start','window_end','qualifying_basis_code','evidence_sha256') as $k)if(!isset($x[$k])){$error='window_field_missing';return false;}$s=hrm_ben_001_date($x['window_start']);$e=hrm_ben_001_date($x['window_end']);if($a<=0||!hrm_ben_001_access('SA_HRM_MANAGE_BENEFITS')||(int)$x['plan_version_id']<=0||hrm_ben_001_token($x['window_code'],64)===false||$s===false||$e===false||$e<$s||hrm_ben_001_token($x['qualifying_basis_code'],64)===false||hrm_ben_001_sha256($x['evidence_sha256'])===false){$error='window_invalid_or_unauthorized';return false;}$pred=empty($x['predecessor_window_id'])?null:(int)$x['predecessor_window_id'];$p=array('plan_version_id'=>(int)$x['plan_version_id'],'window_code'=>$x['window_code'],'window_start'=>$s,'window_end'=>$e,'qualifying_basis_code'=>$x['qualifying_basis_code'],'evidence_sha256'=>strtolower($x['evidence_sha256']),'predecessor_window_id'=>$pred);$sha=hrm_ben_001_hash($p);begin_transaction();$sql='INSERT INTO '.TB_PREF.'hrm_ben_enrollment_windows (plan_version_id,window_code,window_start,window_end,qualifying_basis_code,evidence_sha256,predecessor_window_id,window_sha256,created_by) VALUES ('.$p['plan_version_id'].','.db_escape($p['window_code']).','.db_escape($s).','.db_escape($e).','.db_escape($p['qualifying_basis_code']).','.db_escape($p['evidence_sha256']).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$a.')';$id=hrm_ben_001_insert_idempotent('hrm_ben_enrollment_windows','window_id','window_sha256',$sha,$sql,$error);if($id===false){cancel_transaction();return false;}commit_transaction();return array('window_id'=>$id,'window_sha256'=>$sha);}
