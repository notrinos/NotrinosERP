function pay_rec_001_review_trigger_valid($table,$operation){$prefix=hrm_migration_active_table_prefix();$code=pay_rec_001_review_trigger_code($table);$physical=hrm_migration_physical_table_name($table);if($prefix===false||$code===false||$physical===false)return false;$name=$prefix.'pr1_'.$code.'_'.(strtoupper($operation)==='UPDATE'?'u':'d');$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$row=db_fetch_assoc($q);$expected="SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='PAY-REC-001 immutable ".$table." row cannot be ".strtolower($operation)."d'";$norm=function($v){$v=preg_replace('/\\s+/',' ',trim((string)$v));$v=preg_replace('/\\s*=\\s*/','=',$v);return strtolower($v);};return strtoupper((string)$row['EVENT_MANIPULATION'])===strtoupper($operation)&&(string)$row['EVENT_OBJECT_TABLE']===$physical&&strtoupper((string)$row['ACTION_TIMING'])==='BEFORE'&&$norm($row['ACTION_STATEMENT'])===$norm($expected);}
function pay_rec_001_require_evidence_review_contract_source($patch){$c=pay_rec_001_evidence_review_contract();$runtime_status=isset($c['runtime_status'])?$c['runtime_status']:'';$evidence_kinds=isset($c['evidence_kinds'])?$c['evidence_kinds']:null;if($runtime_status!=='APPEND_ONLY_EVIDENCE_REVIEW_APPROVAL_ENABLED_CLOSE_DISABLED'||$evidence_kinds!==array('payroll','gl','payment','filing')||empty($c['independent_source_recomputation_required'])||empty($c['maker_reviewer_separation_required'])||empty($c['reviewer_approver_separation_required'])||empty($c['maker_approver_separation_required']))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-REC-001 evidence/review authority contract incomplete.');foreach(array('close_state_mutation_enabled','production_close_allowed','gl_posting_authority_allowed','payment_execution_authority_allowed','filing_submission_authority_allowed','network_authority_allowed','payroll_calculation_authority_allowed','historical_payroll_accounting_filing_mutation_allowed','automatic_role_grant_allowed') as $k)if(!array_key_exists($k,$c)||$c[$k]!==false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-REC-001 evidence/review authority ceiling mismatch: '.$k);return true;}
function pay_rec_001_require_review_schema($patch){$prefix=hrm_migration_active_table_prefix();if($prefix===false)return false;$indexes=pay_rec_001_review_index_specs();$fks=pay_rec_001_review_foreign_keys();foreach(pay_rec_001_review_tables() as $table=>$columns){if(pay_fil_001_table_columns($table)!==$columns||!pay_fil_001_table_innodb($table))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-REC-001 review table projection mismatch: '.$table);$ai=pay_fil_001_table_index_projection($table);$ei=$indexes[$table];ksort($ei,SORT_STRING);if(!is_array($ai)||$ai!==$ei)return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-REC-001 review index projection mismatch: '.$table);$af=pay_fil_001_table_foreign_key_projection($table);$ef=$fks[$table];foreach($ef as $name=>$spec)$ef[$name]['referenced_table']=$prefix.$spec['referenced_table'];ksort($ef,SORT_STRING);if(!is_array($af)||$af!==$ef)return hrm_migration_fail($patch,HRM_MIGRATION_FK_MISMATCH,'PAY-REC-001 review foreign-key projection mismatch: '.$table);foreach(array('UPDATE','DELETE') as $op)if(!pay_rec_001_review_trigger_valid($table,$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-REC-001 immutable review trigger mismatch: '.$table.'.'.$op);}return true;}
function pay_rec_001_require_review_zero_rows($patch){foreach(pay_rec_001_review_tables() as $table=>$columns){$q=db_query('SELECT COUNT(*) AS c FROM '.TB_PREF.$table);$r=$q?db_fetch_assoc($q):false;if(!$r||(int)$r['c']!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-REC-001 review custody must activate zero-seed: '.$table);}return true;}
function pay_rec_001_require_evidence_runtime_source($patch){global $path_to_root;$runtime=@file_get_contents($path_to_root.'/hrm/includes/db/pay_rec_001_evidence_runtime_db.inc');if(!is_string($runtime))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-REC-001 evidence runtime source missing.');foreach(array('pay_rec_001_prepare_reconciliation','pay_rec_001_runtime_recompute_payroll','hrm_pay_core_009_run_state_from_row','hrm_pay_core_010_result_set_for_period','hrm_pay_core_010_projection_descriptor','pay_rec_001_runtime_recompute_gl','pay_rec_001_runtime_recompute_payment','pay_rec_001_runtime_recompute_filing','pay_rec_001_review_reconciliation','pay_rec_001_approve_reconciliation','close_state_mutation_authorized','production_close_authorized') as $token)if(strpos($runtime,$token)===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-REC-001 evidence runtime contract token missing: '.$token);foreach(array('curl_','fsockopen(','stream_socket_client(','add_gl_trans(','write_bank_transaction(','calculate_employee_payslip(','hrm_pay_core_009_run_chunk(','hrm_pay_core_010_project_period(','pay_fil_001_submit','UPDATE ' ."'.TB_PREF.'".'hrm_pay_rec_001','DELETE FROM ' ."'.TB_PREF.'".'hrm_pay_rec_001') as $token)if(stripos($runtime,$token)!==false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-REC-001 evidence runtime exceeds authority ceiling: '.$token);return true;}
function pay_rec_001_install_review_schema($patch){global $path_to_root;if(!pay_rec_001_require_evidence_review_contract_source($patch)||!pay_rec_001_require_custody_schema($patch))return false;$raw=@file_get_contents($path_to_root.'/sql/upgrade_pay_rec_001_review_approval_custody.sql');if(!is_string($raw)||strpos($raw,'-- PAY-REC-001 GROUP independent_review_approval_custody')===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-REC-001 review schema source missing.');$prefix=hrm_migration_active_table_prefix();if($prefix===false)return false;$clean=preg_replace('/^--.*$/m','',$raw);$statements=preg_split('/;\s*(?:\r?\n|$)/',$clean);foreach($statements as $statement){$statement=trim($statement);if($statement===''||strpos($statement,'CREATE TRIGGER')===0)continue;$statement=str_replace('`0_','`'.$prefix,$statement);if(!db_query($statement))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-REC-001 review schema statement failed.');}foreach(pay_rec_001_review_tables() as $table=>$columns){foreach(array('UPDATE','DELETE') as $op){if(pay_rec_001_review_trigger_valid($table,$op))continue;$code=pay_rec_001_review_trigger_code($table);$name=$prefix.'pr1_'.$code.'_'.($op==='UPDATE'?'u':'d');$physical=hrm_migration_physical_table_name($table);$message='PAY-REC-001 immutable '.$table.' row cannot be '.strtolower($op).'d';if(!db_query('CREATE TRIGGER `'.$name.'` BEFORE '.$op.' ON `'.$physical.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape($message)))return false;}}return pay_rec_001_require_review_schema($patch)&&pay_rec_001_require_review_zero_rows($patch);}
