function hrm_pay_core_007_actor(){return isset($_SESSION['wa_current_user']->user)?(int)$_SESSION['wa_current_user']->user:0;}
function hrm_pay_core_007_access($p){return function_exists('user_check_access')&&user_check_access($p);}
function hrm_pay_core_007_manage_transaction(){return empty($GLOBALS['transaction_level']);}
function hrm_pay_core_007_one($sql){$r=db_query($sql);if(!$r)return false;$x=db_fetch_assoc($r);if(!$x)return false;if(db_fetch_assoc($r))return false;return $x;}
function hrm_pay_core_007_sql_id($v){return $v===null?'NULL':(string)(int)$v;}
function hrm_pay_core_007_sql_token($v){return $v===null?'NULL':db_escape($v);}

/** Object-level scope/BOLA: relationship -> legal entity/worker/person/assignment must agree. */
function hrm_pay_core_007_assert_object_scope(array $scope,&$error=null)
{
    $error=null;$s=hrm_pay_core_007_scope($scope,$error);if($s===false)return false;
    $rel=hrm_pay_core_007_one('SELECT worker_id,legal_entity_id FROM '.TB_PREF.'hrm_payroll_relationships WHERE payroll_relationship_id='.(int)$s['payroll_relationship_id'].' LIMIT 2');if(!$rel){$error='payroll_relationship_missing';return false;}
    if((int)$rel['legal_entity_id']!==$s['legal_entity_id']){$error='legal_entity_scope_mismatch';return false;}$worker=(int)$rel['worker_id'];if($s['worker_id']!==null&&$worker!==$s['worker_id']){$error='worker_scope_mismatch';return false;}
    if($s['person_id']!==null){$w=hrm_pay_core_007_one('SELECT person_id FROM '.TB_PREF.'hrm_workers WHERE worker_id='.$worker.' LIMIT 2');if(!$w||(int)$w['person_id']!==$s['person_id']){$error='person_scope_mismatch';return false;}}
    if($s['assignment_id']!==null){$m=hrm_pay_core_007_one('SELECT relationship_member_id FROM '.TB_PREF.'hrm_payroll_relationship_members WHERE payroll_relationship_id='.$s['payroll_relationship_id'].' AND assignment_id='.$s['assignment_id'].' LIMIT 2');if(!$m){$error='assignment_scope_mismatch';return false;}}
    return $s;
}
function hrm_pay_core_007_event_scope_from_row(array $r){return array('legal_entity_id'=>(int)$r['legal_entity_id'],'payroll_relationship_id'=>(int)$r['payroll_relationship_id'],'worker_id'=>$r['worker_id']===null?null:(int)$r['worker_id'],'person_id'=>$r['person_id']===null?null:(int)$r['person_id'],'assignment_id'=>$r['assignment_id']===null?null:(int)$r['assignment_id']);}
function hrm_pay_core_007_event_from_row(array $r,&$error=null){$x=array_merge(hrm_pay_core_007_event_scope_from_row($r),array('source_family'=>$r['source_family'],'source_system'=>$r['source_system'],'source_type'=>$r['source_type'],'source_key'=>$r['source_key'],'source_sha256'=>$r['source_sha256'],'effective_from'=>$r['effective_from'],'effective_to'=>$r['effective_to'],'evidence_sha256'=>$r['evidence_sha256']));$e=hrm_pay_core_007_event($x,$error);if($e===false||!hash_equals((string)$r['event_sha256'],$e['event_sha256'])){$error=$e===false?$error:'event_hash_drift';return false;}return $e;}

function hrm_pay_core_007_append_event(array $input,&$error=null)
{
    $error=null;$actor=hrm_pay_core_007_actor();if($actor<=0||!hrm_pay_core_007_access('SA_HRM_MANAGE_PAY_CORE_RETRO')){$error='access_denied';return false;}$e=hrm_pay_core_007_event($input,$error);if($e===false)return false;$s=hrm_pay_core_007_assert_object_scope($e['scope'],$error);if($s===false)return false;
    $manage=hrm_pay_core_007_manage_transaction();if($manage)begin_transaction();$existing=hrm_pay_core_007_one('SELECT retro_event_id,event_sha256,source_sha256 FROM '.TB_PREF.'hrm_pay_retro_events WHERE payroll_relationship_id='.$s['payroll_relationship_id'].' AND source_family='.db_escape($e['source_family']).' AND source_system='.db_escape($e['source_system']).' AND source_key='.db_escape($e['source_key']).' LIMIT 2 FOR UPDATE');
    if($existing){if(!hash_equals((string)$existing['event_sha256'],$e['event_sha256'])||!hash_equals((string)$existing['source_sha256'],$e['source_sha256'])){if($manage)cancel_transaction();$error='retro_source_conflict';return false;}$id=(int)$existing['retro_event_id'];if($manage)commit_transaction();return $id;}
    $sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_events (legal_entity_id,payroll_relationship_id,worker_id,person_id,assignment_id,source_family,source_system,source_type,source_key,source_sha256,effective_from,effective_to,evidence_sha256,event_sha256,recorded_by) VALUES ('.$s['legal_entity_id'].','.$s['payroll_relationship_id'].','.hrm_pay_core_007_sql_id($s['worker_id']).','.hrm_pay_core_007_sql_id($s['person_id']).','.hrm_pay_core_007_sql_id($s['assignment_id']).','.db_escape($e['source_family']).','.db_escape($e['source_system']).','.db_escape($e['source_type']).','.db_escape($e['source_key']).','.db_escape($e['source_sha256']).','.db_escape($e['effective_from']).','.hrm_pay_core_007_sql_token($e['effective_to']).','.db_escape($e['evidence_sha256']).','.db_escape($e['event_sha256']).','.$actor.')';if(!db_query($sql)){if($manage)cancel_transaction();$error='retro_event_insert_failed';return false;}$id=(int)db_insert_id();if($manage)commit_transaction();return $id;
}

/** Deterministically discovers only immutable CORE-004 results whose period overlaps the event. */
function hrm_pay_core_007_discover_and_record_affected_results($retro_event_id,&$error=null)
{
    $error=null;$actor=hrm_pay_core_007_actor();$retro_event_id=(int)$retro_event_id;if($actor<=0||!hrm_pay_core_007_access('SA_HRM_REVIEW_PAY_CORE_RETRO')||$retro_event_id<=0){$error='access_denied';return false;}$row=hrm_pay_core_007_one('SELECT * FROM '.TB_PREF.'hrm_pay_retro_events WHERE retro_event_id='.$retro_event_id.' LIMIT 2');if(!$row){$error='retro_event_missing';return false;}$e=hrm_pay_core_007_event_from_row($row,$error);if($e===false||hrm_pay_core_007_assert_object_scope($e['scope'],$error)===false)return false;
    $q=db_query('SELECT r.result_id,r.result_sha256,r.snapshot_sha256,s.calendar_period_id,s.legal_entity_id,s.payroll_relationship_id,s.assignment_id,p.period_start,p.period_end FROM '.TB_PREF.'hrm_pay_core_004_results r INNER JOIN '.TB_PREF.'hrm_pay_core_004_snapshots s ON s.snapshot_id=r.snapshot_id INNER JOIN '.TB_PREF.'hrm_payroll_calendar_periods p ON p.calendar_period_id=s.calendar_period_id WHERE s.payroll_relationship_id='.$e['scope']['payroll_relationship_id'].' AND s.legal_entity_id='.$e['scope']['legal_entity_id']);if(!$q){$error='affected_result_read_failed';return false;}$c=array();while($x=db_fetch_assoc($q))$c[]=$x;$found=hrm_pay_core_007_discover_affected_results(array_merge($e['scope'],$e),$c,$error);if($found===false)return false;
    $manage=hrm_pay_core_007_manage_transaction();if($manage)begin_transaction();$ids=array();foreach($found as $d){$existing=hrm_pay_core_007_one('SELECT affected_result_id,discovery_sha256 FROM '.TB_PREF.'hrm_pay_retro_affected_results WHERE retro_event_id='.$retro_event_id.' AND original_result_id='.(int)$d['result_id'].' LIMIT 2 FOR UPDATE');if($existing){if(!hash_equals((string)$existing['discovery_sha256'],$d['discovery_sha256'])){if($manage)cancel_transaction();$error='affected_result_conflict';return false;}$ids[]=(int)$existing['affected_result_id'];continue;}$sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_affected_results (retro_event_id,original_result_id,original_result_sha256,original_snapshot_sha256,calendar_period_id,period_start,period_end,discovery_sha256,discovered_by) VALUES ('.$retro_event_id.','.(int)$d['result_id'].','.db_escape($d['result_sha256']).','.db_escape($d['snapshot_sha256']).','.(int)$d['calendar_period_id'].','.db_escape($d['period_start']).','.db_escape($d['period_end']).','.db_escape($d['discovery_sha256']).','.$actor.')';if(!db_query($sql)){if($manage)cancel_transaction();$error='affected_result_insert_failed';return false;}$ids[]=(int)db_insert_id();}if($manage)commit_transaction();return $ids;
}

function hrm_pay_core_007_record_historical_context($affected_result_id,array $context,&$error=null)
{
    $error=null;$actor=hrm_pay_core_007_actor();$affected_result_id=(int)$affected_result_id;if($actor<=0||!hrm_pay_core_007_access('SA_HRM_REVIEW_PAY_CORE_RETRO')||$affected_result_id<=0){$error='access_denied';return false;}$a=hrm_pay_core_007_one('SELECT a.*,e.legal_entity_id,e.payroll_relationship_id,e.worker_id,e.person_id,e.assignment_id FROM '.TB_PREF.'hrm_pay_retro_affected_results a INNER JOIN '.TB_PREF.'hrm_pay_retro_events e ON e.retro_event_id=a.retro_event_id WHERE a.affected_result_id='.$affected_result_id.' LIMIT 2');if(!$a){$error='affected_result_missing';return false;}if(hrm_pay_core_007_assert_object_scope(hrm_pay_core_007_event_scope_from_row($a),$error)===false)return false;
    $snap=hrm_pay_core_007_one('SELECT s.*,r.result_sha256 FROM '.TB_PREF.'hrm_pay_core_004_results r INNER JOIN '.TB_PREF.'hrm_pay_core_004_snapshots s ON s.snapshot_id=r.snapshot_id WHERE r.result_id='.(int)$a['original_result_id'].' LIMIT 2');if(!$snap){$error='original_result_missing';return false;}
    $context['affected_result_id']=$affected_result_id;$context['original_result_id']=(int)$a['original_result_id'];$context['original_result_sha256']=$snap['result_sha256'];$context['original_snapshot_sha256']=$snap['snapshot_sha256'];foreach(array('approved_inputs_sha256','element_versions_sha256','eligibility_sha256','rule_artifacts_sha256','source_events_sha256','configuration_sha256') as $k)$context[$k]=$snap[$k];
    $c=hrm_pay_core_007_historical_context($context,$error);if($c===false)return false;$payload=hrm_pay_core_005_canonical_json($c);$gaps=json_encode($c['gap_codes'],JSON_UNESCAPED_SLASHES);$recompute=$c['recompute_snapshot_material']===null?null:$c['recompute_snapshot_material']['snapshot_sha256'];
    $sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_contexts (affected_result_id,original_result_id,original_result_sha256,original_snapshot_sha256,approved_inputs_sha256,element_versions_sha256,eligibility_sha256,rule_artifacts_sha256,jurisdiction_resolution_sha256,source_events_sha256,configuration_sha256,recompute_snapshot_sha256,context_payload_json,provenance_state,gap_codes_json,context_sha256,recorded_by) VALUES ('.$affected_result_id.','.$c['original_result_id'].','.db_escape($c['original_result_sha256']).','.db_escape($c['original_snapshot_sha256']).','.db_escape($c['approved_inputs_sha256']).','.db_escape($c['element_versions_sha256']).','.db_escape($c['eligibility_sha256']).','.db_escape($c['rule_artifacts_sha256']).','.db_escape($c['jurisdiction_resolution_sha256']).','.db_escape($c['source_events_sha256']).','.db_escape($c['configuration_sha256']).','.hrm_pay_core_007_sql_token($recompute).','.db_escape($payload).','.db_escape($c['provenance_state']).','.db_escape($gaps).','.db_escape($c['context_sha256']).','.$actor.')';if(!db_query($sql)){$same=hrm_pay_core_007_one('SELECT context_id FROM '.TB_PREF.'hrm_pay_retro_contexts WHERE context_sha256='.db_escape($c['context_sha256']).' LIMIT 2');if($same)return (int)$same['context_id'];$error='historical_context_insert_failed';return false;}return (int)db_insert_id();
}
function hrm_pay_core_007_context_from_row(array $r,&$error=null){$x=json_decode((string)$r['context_payload_json'],true);if(!is_array($x)){$error='context_payload_invalid';return false;}$c=hrm_pay_core_007_historical_context($x,$error);if($c===false||!hash_equals((string)$r['context_sha256'],$c['context_sha256'])){$error=$c===false?$error:'context_hash_drift';return false;}return $c;}

/** Recalculate from the bound historical snapshot and append deterministic deltas. */
function hrm_pay_core_007_compute_and_record_deltas($context_id,array $historical_plan,&$error=null)
{
    $error=null;$actor=hrm_pay_core_007_actor();$context_id=(int)$context_id;if($actor<=0||!hrm_pay_core_007_access('SA_HRM_EXECUTE_PAY_CORE_RETRO')||!hrm_pay_core_007_access('SA_HRM_EXECUTE_PAY_CORE_CALC')||$context_id<=0){$error='access_denied';return false;}$r=hrm_pay_core_007_one('SELECT * FROM '.TB_PREF.'hrm_pay_retro_contexts WHERE context_id='.$context_id.' LIMIT 2');if(!$r){$error='context_missing';return false;}$c=hrm_pay_core_007_context_from_row($r,$error);if($c===false)return false;$bundle=hrm_pay_core_007_recalculate($c,$historical_plan,$error);if($bundle===false)return false;
    $q=db_query('SELECT line_no,element_version_id,line_kind,currency,amount,quantity,rate,source_sha256 FROM '.TB_PREF.'hrm_pay_core_004_result_lines WHERE result_id='.(int)$c['original_result_id'].' ORDER BY line_no');if(!$q){$error='original_lines_read_failed';return false;}$old=array();while($x=db_fetch_assoc($q))$old[]=$x;$d=hrm_pay_core_007_compute_deltas($old,$bundle['lines'],$error);if($d===false)return false;
    $manage=hrm_pay_core_007_manage_transaction();if($manage)begin_transaction();foreach($d['rows'] as $x){$existing=hrm_pay_core_007_one('SELECT delta_sha256 FROM '.TB_PREF.'hrm_pay_retro_deltas WHERE context_id='.$context_id.' AND delta_key='.db_escape($x['delta_key']).' LIMIT 2 FOR UPDATE');if($existing){if(!hash_equals((string)$existing['delta_sha256'],$x['delta_sha256'])){if($manage)cancel_transaction();$error='delta_conflict';return false;}continue;}$sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_deltas (affected_result_id,context_id,delta_key,element_version_id,line_kind,currency,original_amount,recomputed_amount,delta_amount,delta_sha256,computed_by) VALUES ('.(int)$c['affected_result_id'].','.$context_id.','.db_escape($x['delta_key']).','.(int)$x['element_version_id'].','.db_escape($x['line_kind']).','.db_escape($x['currency']).','.db_escape($x['original_amount']).','.db_escape($x['recomputed_amount']).','.db_escape($x['delta_amount']).','.db_escape($x['delta_sha256']).','.$actor.')';if(!db_query($sql)){if($manage)cancel_transaction();$error='delta_insert_failed';return false;}}if($manage)commit_transaction();return array('bundle'=>$bundle,'deltas'=>$d);
}

