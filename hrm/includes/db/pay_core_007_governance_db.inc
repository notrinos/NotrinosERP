/** Executor materializes the exact approved deterministic plan; originals remain immutable. */
function hrm_pay_core_007_materialize_successor($retro_plan_id,array $historical_plan,&$error=null)
{
    $error=null;$executor=hrm_pay_core_007_actor();$retro_plan_id=(int)$retro_plan_id;if($executor<=0||!hrm_pay_core_007_access('SA_HRM_EXECUTE_PAY_CORE_RETRO')||!hrm_pay_core_007_access('SA_HRM_EXECUTE_PAY_CORE_CALC')||!hrm_pay_core_007_access('SA_HRM_SEAL_PAY_CORE_RESULT')||!hrm_pay_core_007_access('SA_HRM_WRITE_PAY_CORE_RESULT')){$error='access_denied';return false;}
    $p=hrm_pay_core_007_one('SELECT p.*,a.approval_id,a.approval_sha256,a.approval_evidence_sha256,a.checker_id,c.context_payload_json FROM '.TB_PREF.'hrm_pay_retro_plans p INNER JOIN '.TB_PREF.'hrm_pay_retro_approvals a ON a.retro_plan_id=p.retro_plan_id INNER JOIN '.TB_PREF.'hrm_pay_retro_contexts c ON c.context_id=p.context_id WHERE p.retro_plan_id='.$retro_plan_id.' LIMIT 2');if(!$p){$error='approved_plan_missing';return false;}if($executor===(int)$p['maker_id']||$executor===(int)$p['checker_id']){$error='maker_checker_executor_separation_required';return false;}
    $v=hrm_pay_core_005_validate_plan($historical_plan,$error);if($v===false||!hash_equals((string)$p['historical_plan_sha256'],$v['plan_sha256'])){$error=$v===false?$error:'historical_plan_hash_mismatch';return false;}$ctx=json_decode($p['context_payload_json'],true);if(!is_array($ctx)){$error='context_payload_invalid';return false;}$bundle=hrm_pay_core_007_recalculate($ctx,$historical_plan,$error);if($bundle===false)return false;
    $manage=hrm_pay_core_007_manage_transaction();if($manage)begin_transaction();
    $material=$historical_plan['snapshot_material'];$snapshot_id=hrm_pay_core_004_seal_snapshot($material['descriptor'],$material['identity_sets'],$error);if($snapshot_id===false){if($manage)cancel_transaction();return false;}$totals=$bundle['result'];$result_id=hrm_pay_core_004_append_result($snapshot_id,$totals,$bundle['lines'],$bundle['traces'],$error);if($result_id===false){if($manage)cancel_transaction();return false;}$row=hrm_pay_core_007_one('SELECT result_sha256 FROM '.TB_PREF.'hrm_pay_core_004_results WHERE result_id='.(int)$result_id.' LIMIT 2');if(!$row||!hash_equals((string)$row['result_sha256'],$bundle['result']['result_sha256'])){if($manage)cancel_transaction();$error='successor_result_hash_mismatch';return false;}if($manage)commit_transaction();return array('snapshot_id'=>(int)$snapshot_id,'result_id'=>(int)$result_id,'result_sha256'=>$row['result_sha256'],'bundle'=>$bundle);
}

/** The independent checker binds CORE-004 correction/reversal lineage after materialization. */
function hrm_pay_core_007_finalize_lineage($retro_plan_id,$successor_result_id,&$error=null)
{
    $error=null;$checker=hrm_pay_core_007_actor();if($checker<=0||!hrm_pay_core_007_access('SA_HRM_REVIEW_PAY_CORE_RETRO')||!hrm_pay_core_007_access('SA_HRM_REVIEW_PAY_CORE')){$error='access_denied';return false;}$p=hrm_pay_core_007_one('SELECT p.*,a.approval_evidence_sha256,a.checker_id,x.original_result_id FROM '.TB_PREF.'hrm_pay_retro_plans p INNER JOIN '.TB_PREF.'hrm_pay_retro_approvals a ON a.retro_plan_id=p.retro_plan_id INNER JOIN '.TB_PREF.'hrm_pay_retro_affected_results x ON x.affected_result_id=p.affected_result_id WHERE p.retro_plan_id='.(int)$retro_plan_id.' LIMIT 2');if(!$p||$checker!==(int)$p['checker_id']){$error='approved_checker_required';return false;}$kind=$p['plan_type']==='reversal'?'reversal':'correction';return hrm_pay_core_004_record_lineage((int)$p['original_result_id'],(int)$successor_result_id,$kind,$p['reason_code'],$p['approval_evidence_sha256'],$error);
}

/** Final execution receipt requires the same independent lineage plus the original calc executor. */
function hrm_pay_core_007_record_execution($retro_plan_id,$successor_result_id,$balance_movement_set_sha256=null,&$error=null)
{
    $error=null;$executor=hrm_pay_core_007_actor();if($executor<=0||!hrm_pay_core_007_access('SA_HRM_EXECUTE_PAY_CORE_RETRO')){$error='access_denied';return false;}$p=hrm_pay_core_007_one('SELECT p.*,a.approval_id,a.approval_sha256,a.checker_id,x.original_result_id,r.snapshot_id successor_snapshot_id,r.result_sha256 successor_result_sha256,r.executor_id,l.lineage_id FROM '.TB_PREF.'hrm_pay_retro_plans p INNER JOIN '.TB_PREF.'hrm_pay_retro_approvals a ON a.retro_plan_id=p.retro_plan_id INNER JOIN '.TB_PREF.'hrm_pay_retro_affected_results x ON x.affected_result_id=p.affected_result_id INNER JOIN '.TB_PREF.'hrm_pay_core_004_results r ON r.result_id='.(int)$successor_result_id.' INNER JOIN '.TB_PREF.'hrm_pay_core_004_correction_lineage l ON l.predecessor_result_id=x.original_result_id AND l.successor_result_id=r.result_id WHERE p.retro_plan_id='.(int)$retro_plan_id.' LIMIT 2');if(!$p){$error='lineage_bound_successor_required';return false;}if($executor!==(int)$p['executor_id']||$executor===(int)$p['maker_id']||$executor===(int)$p['checker_id']){$error='execution_actor_mismatch';return false;}$plan=hrm_pay_core_007_plan_from_row($p);$approval=array('plan_sha256'=>$p['plan_sha256'],'approval_sha256'=>$p['approval_sha256'],'maker_id'=>(int)$p['maker_id'],'checker_id'=>(int)$p['checker_id']);$d=hrm_pay_core_007_execution_descriptor($plan,$approval,$executor,$p['original_result_id'],$successor_result_id,$p['successor_result_sha256'],$balance_movement_set_sha256,$error);if($d===false)return false;
    $sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_executions (retro_plan_id,approval_id,original_result_id,successor_snapshot_id,successor_result_id,execution_kind,successor_result_sha256,delta_set_sha256,balance_movement_set_sha256,core004_lineage_id,execution_sha256,executor_id) VALUES ('.(int)$retro_plan_id.','.(int)$p['approval_id'].','.(int)$p['original_result_id'].','.(int)$p['successor_snapshot_id'].','.(int)$successor_result_id.','.db_escape($d['execution_kind']).','.db_escape($d['successor_result_sha256']).','.db_escape($d['delta_set_sha256']).','.hrm_pay_core_007_sql_token($d['balance_movement_set_sha256']).','.(int)$p['lineage_id'].','.db_escape($d['execution_sha256']).','.$executor.')';if(!db_query($sql)){$same=hrm_pay_core_007_one('SELECT execution_id,execution_sha256 FROM '.TB_PREF.'hrm_pay_retro_executions WHERE retro_plan_id='.(int)$retro_plan_id.' LIMIT 2');if($same&&hash_equals((string)$same['execution_sha256'],$d['execution_sha256']))return (int)$same['execution_id'];$error='execution_conflict';return false;}return (int)db_insert_id();
}

function hrm_pay_core_007_record_downstream_obligations($execution_id,array $states,$evidence_sha256,&$error=null)
{
    $error=null;$actor=hrm_pay_core_007_actor();$execution_id=(int)$execution_id;if($actor<=0||!hrm_pay_core_007_access('SA_HRM_EXECUTE_PAY_CORE_RETRO')||!hrm_pay_core_007_is_sha256($evidence_sha256)){$error='access_or_evidence_invalid';return false;}$x=hrm_pay_core_007_one('SELECT execution_sha256 FROM '.TB_PREF.'hrm_pay_retro_executions WHERE execution_id='.$execution_id.' LIMIT 2');if(!$x){$error='execution_missing';return false;}$rows=hrm_pay_core_007_downstream_obligations($x['execution_sha256'],$states,$error);if($rows===false)return false;$manage=hrm_pay_core_007_manage_transaction();if($manage)begin_transaction();$ids=array();foreach($rows as $r){$sha=hrm_pay_core_007_hash(array('obligation'=>$r,'evidence_sha256'=>$evidence_sha256));$sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_downstream_obligations (execution_id,domain,obligation_kind,original_evidence_sha256,predecessor_obligation_id,obligation_state,evidence_sha256,obligation_sha256,recorded_by) VALUES ('.$execution_id.','.db_escape($r['domain']).','.db_escape($r['obligation_kind']).','.db_escape($r['original_evidence_sha256']).',NULL,\'open\','.db_escape($evidence_sha256).','.db_escape($sha).','.$actor.')';if(!db_query($sql)){$same=hrm_pay_core_007_one('SELECT obligation_id FROM '.TB_PREF.'hrm_pay_retro_downstream_obligations WHERE obligation_sha256='.db_escape($sha).' LIMIT 2');if(!$same){if($manage)cancel_transaction();$error='downstream_obligation_insert_failed';return false;}$ids[]=(int)$same['obligation_id'];}else $ids[]=(int)db_insert_id();}if($manage)commit_transaction();return $ids;
}

function hrm_pay_core_007_record_reconciliation($execution_id,$source_sha256,$expected,$actual,$evidence_sha256,&$error=null)
{
    $error=null;$reviewer=hrm_pay_core_007_actor();if($reviewer<=0||!hrm_pay_core_007_access('SA_HRM_REVIEW_PAY_CORE_RETRO')){$error='access_denied';return false;}$x=hrm_pay_core_007_one('SELECT execution_sha256,executor_id FROM '.TB_PREF.'hrm_pay_retro_executions WHERE execution_id='.(int)$execution_id.' LIMIT 2');if(!$x){$error='execution_missing';return false;}if($reviewer===(int)$x['executor_id']){$error='independent_reviewer_required';return false;}$r=hrm_pay_core_007_reconciliation($x['execution_sha256'],$source_sha256,$expected,$actual,$evidence_sha256,$error);if($r===false)return false;$sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_reconciliations (execution_id,source_sha256,expected_delta_amount,actual_delta_amount,difference_amount,reconciliation_state,evidence_sha256,reconciliation_sha256,reviewed_by) VALUES ('.(int)$execution_id.','.db_escape($r['source_sha256']).','.db_escape($r['expected_delta_amount']).','.db_escape($r['actual_delta_amount']).','.db_escape($r['difference_amount']).','.db_escape($r['reconciliation_state']).','.db_escape($r['evidence_sha256']).','.db_escape($r['reconciliation_sha256']).','.$reviewer.')';if(!db_query($sql)){$same=hrm_pay_core_007_one('SELECT reconciliation_id FROM '.TB_PREF.'hrm_pay_retro_reconciliations WHERE reconciliation_sha256='.db_escape($r['reconciliation_sha256']).' LIMIT 2');if($same)return (int)$same['reconciliation_id'];$error='reconciliation_insert_failed';return false;}return (int)db_insert_id();
}
function hrm_pay_core_007_record_recovery($reconciliation_id,$action_token,$source_sha256,$evidence_sha256,&$error=null)
{
    $error=null;$actor=hrm_pay_core_007_actor();if($actor<=0||!hrm_pay_core_007_access('SA_HRM_EXECUTE_PAY_CORE_RETRO')){$error='access_denied';return false;}$r=hrm_pay_core_007_one('SELECT reconciliation_sha256 FROM '.TB_PREF.'hrm_pay_retro_reconciliations WHERE reconciliation_id='.(int)$reconciliation_id.' LIMIT 2');if(!$r){$error='reconciliation_missing';return false;}$x=hrm_pay_core_007_recovery($r['reconciliation_sha256'],$action_token,$source_sha256,$evidence_sha256,$error);if($x===false)return false;$sql='INSERT INTO '.TB_PREF.'hrm_pay_retro_recovery_evidence (reconciliation_id,action_token,source_sha256,evidence_sha256,recovery_sha256,executed_by) VALUES ('.(int)$reconciliation_id.','.db_escape($x['action_token']).','.db_escape($x['source_sha256']).','.db_escape($x['evidence_sha256']).','.db_escape($x['recovery_sha256']).','.$actor.')';if(!db_query($sql)){$same=hrm_pay_core_007_one('SELECT recovery_evidence_id FROM '.TB_PREF.'hrm_pay_retro_recovery_evidence WHERE recovery_sha256='.db_escape($x['recovery_sha256']).' LIMIT 2');if($same)return (int)$same['recovery_evidence_id'];$error='recovery_insert_failed';return false;}return (int)db_insert_id();
