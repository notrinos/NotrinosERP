function hrm_lve_001_sync_legacy_projection($employee_id,$leave_id,$fiscal_year,$as_of,&$error=null){$error=null;$scope=hrm_lve_001_resolve_employee_scope($employee_id,$as_of,false,$error);if($scope===false)return false;$q=db_query('SELECT e.entitlement_id,e.entitlement_units FROM '.TB_PREF.'hrm_leave_entitlements e WHERE e.worker_id='.$scope['worker_id'].' AND e.leave_id='.(int)$leave_id.' AND e.cycle_start<='.db_escape($as_of).' AND e.cycle_end>='.db_escape($as_of).' ORDER BY e.entitlement_id DESC LIMIT 1');$e=$q?db_fetch_assoc($q):false;if(!$e){$error='governed_entitlement_missing';return false;}$p=hrm_lve_001_projection((int)$e['entitlement_id'],$as_of,$error);if($p===false)return false;$taken=$p['consumed_units'];$pending=$p['reserved_units'];$entitled=(float)$p['available_units']+(float)$pending+(float)$taken;$carried=$p['carried_units'];$adjusted=0;return hrm_lve_001_with_projection_write(function()use($employee_id,$leave_id,$fiscal_year,$entitled,$carried,$taken,$pending,$adjusted){return save_leave_balance($employee_id,$leave_id,$fiscal_year,$entitled,$carried,$taken,$pending,$adjusted);});}
function hrm_lve_001_append_adjustment($entitlement_id,$kind,$units,$reason_sha256,$predecessor_movement_id=null,&$error=null){$error=null;$actor=hrm_lve_001_actor();$perm=$kind==='donation_out'||$kind==='donation_in'?'SA_HRM_DONATE_LEAVE':($kind==='cashout'?'SA_HRM_CASHOUT_LEAVE':'SA_HRM_RECOVER_LEAVE');if($actor<=0||!hrm_lve_001_access($perm)||!hrm_tim_001_is_sha256($reason_sha256)){$error='access_or_evidence_invalid';return false;}if(in_array($kind,array('correction','reversal'),true)&&empty($predecessor_movement_id)){$error='adjustment_predecessor_required';return false;}$q=db_query('SELECT e.*,p.* FROM '.TB_PREF.'hrm_leave_entitlements e INNER JOIN '.TB_PREF.'hrm_leave_policy_versions p ON p.policy_version_id=e.policy_version_id WHERE e.entitlement_id='.(int)$entitlement_id.' LIMIT 2');$r=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$r){$error='entitlement_missing';return false;}if(($kind==='donation_out'||$kind==='donation_in')&&!$r['donation_allowed']){$error='donation_not_allowed';return false;}if($kind==='cashout'&&!$r['cashout_allowed']){$error='cashout_not_allowed';return false;}if(!in_array($kind,array('donation_out','donation_in','cashout','correction','reversal'),true)){$error='adjustment_kind_invalid';return false;}$proj=hrm_lve_001_projection($entitlement_id,date('Y-m-d'),$error);if($proj===false)return false;if(in_array($kind,array('donation_out','cashout'),true)&&!hrm_lve_001_can_consume($proj['available_units'],$r['negative_balance_limit_units'],$units,$error)){$error='insufficient_governed_leave_balance';return false;}$cmd='adjust:'.$kind.':'.$entitlement_id.':'.substr($reason_sha256,0,32);return hrm_lve_001_append_movement($r,$r,date('Y-m-d'),$kind,$units,'governed_adjustment',$kind,$reason_sha256,null,$predecessor_movement_id,$cmd,$error);}
function hrm_lve_001_record_recovery_evidence($reconciliation_id,$action_token,$source_sha256,$evidence_sha256,&$error=null){$error=null;$actor=hrm_lve_001_actor();$action=hrm_tim_001_token($action_token,64);if($actor<=0||!hrm_lve_001_access('SA_HRM_RECOVER_LEAVE')||$action===false||!hrm_tim_001_is_sha256($source_sha256)||!hrm_tim_001_is_sha256($evidence_sha256)){$error='recovery_evidence_invalid';return false;}$q=db_query('SELECT reconciliation_sha256 FROM '.TB_PREF.'hrm_leave_reconciliations WHERE reconciliation_id='.(int)$reconciliation_id.' LIMIT 2');if(!$q||db_num_rows($q)!==1){$error='reconciliation_missing';return false;}$r=db_fetch_assoc($q);$sha=hrm_tim_001_hash(array('reconciliation_sha256'=>$r['reconciliation_sha256'],'action_token'=>$action,'source_sha256'=>$source_sha256,'evidence_sha256'=>$evidence_sha256,'executed_by'=>$actor));$sql='INSERT INTO '.TB_PREF.'hrm_leave_recovery_evidence (reconciliation_id,action_token,source_sha256,evidence_sha256,recovery_sha256,executed_by) VALUES ('.(int)$reconciliation_id.','.db_escape($action).','.db_escape($source_sha256).','.db_escape($evidence_sha256).','.db_escape($sha).','.$actor.')';$id=hrm_lve_001_insert_idempotent('hrm_leave_recovery_evidence','recovery_evidence_id','recovery_sha256',$sha,$sql,$error);return $id===false?false:array('recovery_evidence_id'=>$id,'recovery_sha256'=>$sha);}

function hrm_lve_001_apply_cycle_boundary($entitlement_id,$successor_date,&$error=null){$error=null;$actor=hrm_lve_001_actor();if($actor<=0||!hrm_lve_001_access('SA_HRM_EXECUTE_LEAVE_LEDGER')){$error='access_denied';return false;}begin_transaction();$q=db_query('SELECT e.*,p.* FROM '.TB_PREF.'hrm_leave_entitlements e INNER JOIN '.TB_PREF.'hrm_leave_policy_versions p ON p.policy_version_id=e.policy_version_id WHERE e.entitlement_id='.(int)$entitlement_id.' LIMIT 2 FOR UPDATE');$x=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$x||$successor_date<=$x['cycle_end']){cancel_transaction();$error='cycle_boundary_invalid';return false;}$proj=hrm_lve_001_projection($entitlement_id,$x['cycle_end'],$error);if($proj===false){cancel_transaction();return false;}$scope=hrm_lve_001_resolve_assignment_scope((int)$x['assignment_id'],$successor_date,true,$error);if($scope===false){cancel_transaction();return false;}$policy=hrm_lve_001_policy_for_scope($scope,(int)$x['leave_id'],$successor_date,$error);if($policy===false){cancel_transaction();return false;}$next=hrm_lve_001_get_or_create_entitlement($scope,$policy,$successor_date,$error);if($next===false){cancel_transaction();return false;}$amount=0.0;if(!empty($x['carryover_enabled'])){$amount=max(0.0,(float)$proj['available_units']);if($x['carryover_cap_units']!==null)$amount=min($amount,(float)$x['carryover_cap_units']);}if($amount>0.0000005){$src=hrm_tim_001_hash(array('predecessor_entitlement_sha256'=>$x['entitlement_sha256'],'predecessor_movement_set_sha256'=>$proj['movement_set_sha256'],'successor_entitlement_sha256'=>$next['entitlement_sha256'],'carryover_units'=>hrm_lve_001_decimal($amount,(int)$policy['rounding_scale'])));$m=hrm_lve_001_append_movement($next,$policy,$successor_date,'carryover',hrm_lve_001_decimal($amount,(int)$policy['rounding_scale']),'cycle_boundary','entitlement-'.$entitlement_id,$src,null,null,'carryover:'.$entitlement_id.':'.$next['entitlement_id'],$error);if($m===false){cancel_transaction();return false;}}commit_transaction();return array('successor_entitlement_id'=>(int)$next['entitlement_id'],'carryover_units'=>hrm_lve_001_decimal($amount,(int)$policy['rounding_scale']));}
function hrm_lve_001_expire_carryover_through($entitlement_id,$as_of,&$error=null){$error=null;$actor=hrm_lve_001_actor();if($actor<=0||!hrm_lve_001_access('SA_HRM_EXECUTE_LEAVE_LEDGER')){$error='access_denied';return false;}$q=db_query('SELECT e.*,p.* FROM '.TB_PREF.'hrm_leave_entitlements e INNER JOIN '.TB_PREF.'hrm_leave_policy_versions p ON p.policy_version_id=e.policy_version_id WHERE e.entitlement_id='.(int)$entitlement_id.' LIMIT 2');$x=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$x){$error='entitlement_missing';return false;}if($x['expiry_days']===null)return true;$expiry=(new DateTimeImmutable($x['cycle_start'],new DateTimeZone('UTC')))->modify('+'.(int)$x['expiry_days'].' days')->format('Y-m-d');if($as_of<$expiry)return true;
 $q=db_query('SELECT COALESCE(SUM(CASE WHEN movement_kind=\'carryover\' THEN units ELSE 0 END),0) carry_units,COALESCE(SUM(CASE WHEN movement_kind=\'expiry\' THEN units ELSE 0 END),0) expired_units,COALESCE(SUM(CASE WHEN movement_kind IN (\'consumption\',\'donation_out\',\'cashout\') THEN units ELSE 0 END),0) debit_units,COALESCE(SUM(CASE WHEN movement_kind IN (\'opening\',\'grant\',\'accrual\',\'donation_in\',\'correction\',\'reversal\') THEN units ELSE 0 END),0) current_units FROM '.TB_PREF.'hrm_leave_movements WHERE entitlement_id='.(int)$entitlement_id.' AND effective_date<='.db_escape($as_of));$r=$q?db_fetch_assoc($q):false;if(!$r){$error='expiry_state_unreadable';return false;}$carry=max(0.0,(float)$r['carry_units']-(float)$r['expired_units']);$debits=max(0.0,(float)$r['debit_units']);$current=max(0.0,(float)$r['current_units']);if($x['carryover_consumption_order']==='carryover_first')$remaining=max(0.0,$carry-$debits);elseif($x['carryover_consumption_order']==='current_first')$remaining=max(0.0,$carry-max(0.0,$debits-$current));else{$error='carryover_consumption_order_invalid';return false;}if($remaining<=0.0000005)return true;$src=hrm_tim_001_hash(array('entitlement_sha256'=>$x['entitlement_sha256'],'expiry_date'=>$expiry,'carryover_consumption_order'=>$x['carryover_consumption_order'],'carryover_remaining'=>hrm_lve_001_decimal($remaining,(int)$x['rounding_scale'])));return hrm_lve_001_append_movement($x,$x,$expiry,'expiry',hrm_lve_001_decimal($remaining,(int)$x['rounding_scale']),'policy_expiry','entitlement-'.$entitlement_id,$src,null,null,'expiry:'.$entitlement_id.':'.$expiry,$error)!==false;}
function hrm_lve_001_donate($from_entitlement_id,$to_entitlement_id,$units,$evidence_sha256,&$error=null){$error=null;$actor=hrm_lve_001_actor();if($actor<=0||!hrm_lve_001_access('SA_HRM_DONATE_LEAVE')||!hrm_tim_001_is_sha256($evidence_sha256)){$error='access_or_evidence_invalid';return false;}if((int)$from_entitlement_id===(int)$to_entitlement_id){$error='donation_self_target_invalid';return false;}begin_transaction();$rows=array();foreach(array($from_entitlement_id,$to_entitlement_id) as $id){$q=db_query('SELECT e.*,p.* FROM '.TB_PREF.'hrm_leave_entitlements e INNER JOIN '.TB_PREF.'hrm_leave_policy_versions p ON p.policy_version_id=e.policy_version_id WHERE e.entitlement_id='.(int)$id.' LIMIT 2 FOR UPDATE');$r=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$r||empty($r['donation_allowed'])){cancel_transaction();$error='donation_entitlement_not_allowed';return false;}$rows[]=$r;}if($rows[0]['unit_code']!==$rows[1]['unit_code']||(int)$rows[0]['leave_id']!==(int)$rows[1]['leave_id']||(int)$rows[0]['legal_entity_id']!==(int)$rows[1]['legal_entity_id']){cancel_transaction();$error='donation_scope_mismatch';return false;}$p=hrm_lve_001_projection((int)$from_entitlement_id,date('Y-m-d'),$error);if($p===false||!hrm_lve_001_can_consume($p['available_units'],$rows[0]['negative_balance_limit_units'],$units,$error)){cancel_transaction();if($error===null)$error='insufficient_governed_leave_balance';return false;}$u=hrm_lve_001_decimal($units,(int)$rows[0]['rounding_scale']);$src=hrm_tim_001_hash(array('from'=>$rows[0]['entitlement_sha256'],'to'=>$rows[1]['entitlement_sha256'],'units'=>$u,'evidence_sha256'=>$evidence_sha256));$out=hrm_lve_001_append_movement($rows[0],$rows[0],date('Y-m-d'),'donation_out',$u,'leave_donation','to-'.$to_entitlement_id,$src,null,null,'donation:'.$from_entitlement_id.':'.$to_entitlement_id.':out:'.substr($evidence_sha256,0,20),$error);if($out===false){cancel_transaction();return false;}$in=hrm_lve_001_append_movement($rows[1],$rows[1],date('Y-m-d'),'donation_in',$u,'leave_donation','from-'.$from_entitlement_id,$src,null,null,'donation:'.$from_entitlement_id.':'.$to_entitlement_id.':in:'.substr($evidence_sha256,0,20),$error);if($in===false){cancel_transaction();return false;}commit_transaction();return array('donation_out_movement_id'=>$out['movement_id'],'donation_in_movement_id'=>$in['movement_id']);}

