 $q=db_query('SELECT * FROM '.TB_PREF.'hrm_leave_policy_versions WHERE '.implode(' AND ',$where).' ORDER BY priority_rank DESC,effective_from DESC,policy_version_id DESC LIMIT 8');$rows=array();while($q&&$r=db_fetch_assoc($q))$rows[]=$r;return hrm_lve_001_resolve_policy_candidates($rows,$error);
