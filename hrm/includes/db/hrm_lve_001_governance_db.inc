function hrm_lve_001_fiscal_bounds($date,&$error=null){$error=null;if(!function_exists('get_leave_balance_fiscal_year_for_date')||!function_exists('get_leave_balance_fiscal_year_bounds')){$error='fiscal_calendar_unavailable';return false;}$fy=get_leave_balance_fiscal_year_for_date($date);if($fy<=0){$error='fiscal_calendar_unresolved';return false;}$b=get_leave_balance_fiscal_year_bounds($fy);if(!is_array($b)||count($b)!==2||hrm_tim_001_date($b[0])===false||hrm_tim_001_date($b[1])===false||$date<$b[0]||$date>$b[1]){$error='fiscal_calendar_invalid';return false;}return array('fiscal_year'=>$fy,'start'=>$b[0],'end'=>$b[1]);}
function hrm_lve_001_policy_cycle(array $policy,array $scope,$date,&$error=null){$f=hrm_lve_001_fiscal_bounds($date,$error);if($f===false)return false;$b=hrm_lve_001_cycle_bounds($policy['cycle_basis'],$date,$scope['employment_start'],$f['start'],$f['end'],$error);if($b===false)return false;return array('start'=>$b[0],'end'=>$b[1],'fiscal_year'=>$f['fiscal_year']);}
function hrm_lve_001_get_or_create_entitlement(array $scope,array $policy,$date,&$error=null){
 $error=null;$cycle=hrm_lve_001_policy_cycle($policy,$scope,$date,$error);if($cycle===false)return false;$q=db_query('SELECT * FROM '.TB_PREF.'hrm_leave_entitlements WHERE policy_version_id='.(int)$policy['policy_version_id'].' AND worker_id='.(int)$scope['worker_id'].' AND assignment_id='.(int)$scope['assignment_id'].' AND cycle_start='.db_escape($cycle['start']).' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){$error='entitlement_state_invalid';return false;}if(db_num_rows($q)===1)return db_fetch_assoc($q);
 $sched=hrm_lve_001_scheduled_minutes_between($scope['assignment_id'],$cycle['start'],$cycle['end'],$error);if($sched===false)return false;$cycle_days=(int)((strtotime($cycle['end'].' UTC')-strtotime($cycle['start'].' UTC'))/86400)+1;$eligible_start=max($cycle['start'],$scope['employment_start']);$eligible_days=max(0,(int)((strtotime($cycle['end'].' UTC')-strtotime($eligible_start.' UTC'))/86400)+1);$service=max(0,(int)((strtotime($cycle['end'].' UTC')-strtotime($scope['employment_start'].' UTC'))/86400)+1);
 $ctx=array('service_days'=>$service,'eligible_days'=>$eligible_days,'cycle_days'=>$cycle_days,'scheduled_minutes'=>$sched['minutes'],'reference_minutes'=>(int)$policy['reference_cycle_minutes'],'elapsed_periods'=>0);$units=hrm_lve_001_entitlement_units($policy,$ctx,$error);if($units===false)return false;
 $cmd='entitlement:'.(int)$policy['policy_version_id'].':'.(int)$scope['worker_id'].':'.(int)$scope['assignment_id'].':'.$cycle['start'];$payload=array('policy_version_id'=>(int)$policy['policy_version_id'],'worker_id'=>(int)$scope['worker_id'],'employment_id'=>(int)$scope['employment_id'],'assignment_id'=>(int)$scope['assignment_id'],'legal_entity_id'=>(int)$scope['legal_entity_id'],'leave_id'=>(int)$policy['leave_id'],'cycle_start'=>$cycle['start'],'cycle_end'=>$cycle['end'],'unit_code'=>$policy['unit_code'],'entitlement_units'=>$units,'policy_sha256'=>$policy['policy_sha256'],'schedule_sha256'=>$sched['schedule_sha256'],'command_key'=>$cmd);$sha=hrm_tim_001_hash($payload);$actor=hrm_lve_001_actor();
 $sql='INSERT INTO '.TB_PREF.'hrm_leave_entitlements (policy_version_id,worker_id,employment_id,assignment_id,legal_entity_id,leave_id,cycle_start,cycle_end,unit_code,entitlement_units,policy_sha256,schedule_sha256,command_key,entitlement_sha256,created_by) VALUES ('.(int)$policy['policy_version_id'].','.(int)$scope['worker_id'].','.(int)$scope['employment_id'].','.(int)$scope['assignment_id'].','.(int)$scope['legal_entity_id'].','.(int)$policy['leave_id'].','.db_escape($cycle['start']).','.db_escape($cycle['end']).','.db_escape($policy['unit_code']).','.db_escape($units).','.db_escape($policy['policy_sha256']).','.db_escape($sched['schedule_sha256']).','.db_escape($cmd).','.db_escape($sha).','.$actor.')';$id=hrm_lve_001_insert_idempotent('hrm_leave_entitlements','entitlement_id','entitlement_sha256',$sha,$sql,$error);if($id===false)return false;$q=db_query('SELECT * FROM '.TB_PREF.'hrm_leave_entitlements WHERE entitlement_id='.$id.' LIMIT 1');return $q?db_fetch_assoc($q):false;
}

/** Append-only movement writer with deterministic command replay and one-successor lineage. */
function hrm_lve_001_append_movement(array $entitlement,array $policy,$date,$kind,$units,$source_type,$source_key,$source_sha,$request_id,$predecessor_id,$command_key,&$error=null){
 $error=null;$kind=hrm_lve_001_allowed_movement($kind);$date=hrm_tim_001_date($date);$units=hrm_lve_001_decimal($units,(int)$policy['rounding_scale']);$source_type=hrm_tim_001_token($source_type,48);$source_key=hrm_tim_001_token($source_key,128);$command_key=hrm_tim_001_token($command_key,160);if($kind===false||$date===false||$units===false||$source_type===false||$source_key===false||$command_key===false||!hrm_tim_001_is_sha256($source_sha)||((float)$units<0&&!in_array($kind,array('opening','correction','reversal'),true))){$error='movement_descriptor_invalid';return false;}$actor=hrm_lve_001_actor();if($actor<=0){$error='actor_missing';return false;}$pred=$predecessor_id===null?null:(int)$predecessor_id;
 $lineage=hrm_tim_001_hash(array('entitlement_id'=>(int)$entitlement['entitlement_id'],'kind'=>$kind,'predecessor_movement_id'=>$pred,'source_sha256'=>$source_sha,'command_key'=>$command_key));$payload=array('entitlement_id'=>(int)$entitlement['entitlement_id'],'policy_version_id'=>(int)$policy['policy_version_id'],'worker_id'=>(int)$entitlement['worker_id'],'employment_id'=>(int)$entitlement['employment_id'],'assignment_id'=>(int)$entitlement['assignment_id'],'legal_entity_id'=>(int)$entitlement['legal_entity_id'],'leave_id'=>(int)$entitlement['leave_id'],'effective_date'=>$date,'unit_code'=>$entitlement['unit_code'],'movement_kind'=>$kind,'units'=>$units,'source_type'=>$source_type,'source_key'=>$source_key,'source_sha256'=>$source_sha,'request_id'=>$request_id===null?null:(int)$request_id,'predecessor_movement_id'=>$pred,'command_key'=>$command_key,'lineage_sha256'=>$lineage,'created_by'=>$actor);$sha=hrm_tim_001_hash($payload);
 $q=db_query('SELECT movement_id,movement_sha256 FROM '.TB_PREF.'hrm_leave_movements WHERE command_key='.db_escape($command_key).' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){$error='movement_command_state_invalid';return false;}if(db_num_rows($q)===1){$old=db_fetch_assoc($q);if(!hash_equals((string)$old['movement_sha256'],$sha)){$error='movement_command_replay_mismatch';return false;}return array('movement_id'=>(int)$old['movement_id'],'movement_sha256'=>$sha,'replay'=>true);}
 if($pred!==null){$q=db_query('SELECT movement_id,entitlement_id FROM '.TB_PREF.'hrm_leave_movements WHERE movement_id='.$pred.' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)!==1){$error='movement_predecessor_missing';return false;}$pr=db_fetch_assoc($q);if((int)$pr['entitlement_id']!==(int)$entitlement['entitlement_id']){$error='movement_predecessor_scope_mismatch';return false;}$q=db_query('SELECT movement_id FROM '.TB_PREF.'hrm_leave_movements WHERE predecessor_movement_id='.$pred.' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>0){$error='movement_predecessor_already_superseded';return false;}}
 $sql='INSERT INTO '.TB_PREF.'hrm_leave_movements (entitlement_id,policy_version_id,worker_id,employment_id,assignment_id,legal_entity_id,leave_id,effective_date,unit_code,movement_kind,units,source_type,source_key,source_sha256,request_id,predecessor_movement_id,command_key,lineage_sha256,movement_sha256,created_by) VALUES ('.(int)$entitlement['entitlement_id'].','.(int)$policy['policy_version_id'].','.(int)$entitlement['worker_id'].','.(int)$entitlement['employment_id'].','.(int)$entitlement['assignment_id'].','.(int)$entitlement['legal_entity_id'].','.(int)$entitlement['leave_id'].','.db_escape($date).','.db_escape($entitlement['unit_code']).','.db_escape($kind).','.db_escape($units).','.db_escape($source_type).','.db_escape($source_key).','.db_escape($source_sha).','.($request_id===null?'NULL':(int)$request_id).','.($pred===null?'NULL':$pred).','.db_escape($command_key).','.db_escape($lineage).','.db_escape($sha).','.$actor.')';if(!db_query($sql,'could not append leave movement')){$error='movement_insert_failed';return false;}return array('movement_id'=>(int)db_insert_id(),'movement_sha256'=>$sha,'replay'=>false);
}
function hrm_lve_001_projection($entitlement_id,$as_of,&$error=null){$error=null;$q=db_query('SELECT movement_kind,units,movement_sha256 FROM '.TB_PREF.'hrm_leave_movements WHERE entitlement_id='.(int)$entitlement_id.' AND effective_date<='.db_escape($as_of).' ORDER BY effective_date,movement_id');if(!$q){$error='movement_projection_unreadable';return false;}$m=array();while($r=db_fetch_assoc($q))$m[]=$r;return hrm_lve_001_project_movements($m,6,$error);}
function hrm_lve_001_persist_projection($entitlement_id,$as_of,&$error=null){$p=hrm_lve_001_projection($entitlement_id,$as_of,$error);if($p===false)return false;$actor=hrm_lve_001_actor();$payload=$p+array('entitlement_id'=>(int)$entitlement_id,'as_of_date'=>$as_of,'built_by'=>$actor);$sha=hrm_tim_001_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_leave_projection_snapshots (entitlement_id,as_of_date,available_units,reserved_units,consumed_units,accrued_units,carried_units,expired_units,donated_units,cashed_out_units,movement_set_sha256,projection_sha256,built_by) VALUES ('.(int)$entitlement_id.','.db_escape($as_of).','.db_escape($p['available_units']).','.db_escape($p['reserved_units']).','.db_escape($p['consumed_units']).','.db_escape($p['accrued_units']).','.db_escape($p['carried_units']).','.db_escape($p['expired_units']).','.db_escape($p['donated_units']).','.db_escape($p['cashed_out_units']).','.db_escape($p['movement_set_sha256']).','.db_escape($sha).','.$actor.')';$id=hrm_lve_001_insert_idempotent('hrm_leave_projection_snapshots','projection_id','projection_sha256',$sha,$sql,$error);return $id===false?false:($p+array('projection_id'=>$id,'projection_sha256'=>$sha));}
function hrm_lve_001_elapsed_periods(array $policy,$cycle_start,$through){$start=new DateTimeImmutable($cycle_start,new DateTimeZone('UTC'));$end=new DateTimeImmutable($through,new DateTimeZone('UTC'));if($end<$start)return 0;$months=((int)$end->format('Y')-(int)$start->format('Y'))*12+((int)$end->format('n')-(int)$start->format('n'))+1;return $policy['accrual_period']==='quarterly'?min(4,(int)ceil($months/3)):min(12,$months);}
