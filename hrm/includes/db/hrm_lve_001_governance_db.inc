 $error=null;$d=hrm_tim_001_date($as_of);if(trim((string)$employee_id)===''||$d===false){$error='employee_scope_invalid';return false;}$de=db_escape($d);
 $sql='SELECT m.worker_id,m.employee_id,h.employment_id,h.legal_entity_id,h.start_date,a.assignment_id,a.grade_id,a.legacy_grade_id,a.work_location_id,c.legacy_employment_type '
  .'FROM '.TB_PREF.'hrm_employee_worker_map m INNER JOIN '.TB_PREF.'hrm_employments h ON h.worker_id=m.worker_id INNER JOIN '.TB_PREF.'hrm_assignments a ON a.employment_id=h.employment_id '
  .'LEFT JOIN '.TB_PREF.'hrm_contracts c ON c.employment_id=h.employment_id AND (c.effective_from IS NULL OR c.effective_from<='.$de.') AND (c.effective_to IS NULL OR c.effective_to>='.$de.') '
  .'WHERE m.employee_id='.db_escape((string)$employee_id).' AND m.retired_at IS NULL AND (h.start_date IS NULL OR h.start_date<='.$de.') AND (h.end_date IS NULL OR h.end_date>='.$de.') '
  .'AND (a.effective_from IS NULL OR a.effective_from<='.$de.') AND (a.effective_to IS NULL OR a.effective_to>='.$de.') LIMIT 2'.($for_update?' FOR UPDATE':'');
 $q=db_query($sql,'could not resolve HRM-LVE-001 employee scope');if(!$q||db_num_rows($q)!==1){$error='employee_scope_ambiguous_or_missing';return false;}$r=db_fetch_assoc($q);
 foreach(array('worker_id','employment_id','legal_entity_id','assignment_id') as $k)if((int)$r[$k]<=0){$error='employee_scope_incomplete';return false;}
 return array('employee_id'=>(string)$r['employee_id'],'worker_id'=>(int)$r['worker_id'],'employment_id'=>(int)$r['employment_id'],'assignment_id'=>(int)$r['assignment_id'],'legal_entity_id'=>(int)$r['legal_entity_id'],'employment_start'=>(string)$r['start_date'],'grade_id'=>empty($r['grade_id'])?null:(int)$r['grade_id'],'legacy_grade_id'=>empty($r['legacy_grade_id'])?null:(int)$r['legacy_grade_id'],'work_location_id'=>empty($r['work_location_id'])?null:(int)$r['work_location_id'],'employment_type'=>$r['legacy_employment_type']===null?null:(int)$r['legacy_employment_type']);
}
function hrm_lve_001_resolve_assignment_scope($assignment_id,$as_of,$for_update=false,&$error=null){
 $error=null;$d=hrm_tim_001_date($as_of);if((int)$assignment_id<=0||$d===false){$error='assignment_scope_invalid';return false;}$de=db_escape($d);
