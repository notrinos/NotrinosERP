function hrm_lve_001_send_movement_to_payroll($movement_id,$payroll_period_id,$command_key,&$error=null){$error=null;$actor=hrm_lve_001_actor();if($actor<=0||!hrm_lve_001_access('SA_HRM_EXECUTE_LEAVE_PAYROLL')){$error='access_denied';return false;}$cmd=hrm_tim_001_token($command_key,160);if($cmd===false){$error='command_key_invalid';return false;}begin_transaction();$q=db_query('SELECT m.*,p.policy_sha256 FROM '.TB_PREF.'hrm_leave_movements m INNER JOIN '.TB_PREF.'hrm_leave_policy_versions p ON p.policy_version_id=m.policy_version_id WHERE m.movement_id='.(int)$movement_id.' AND m.movement_kind=\'consumption\' LIMIT 2 FOR UPDATE');$m=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$m){cancel_transaction();$error='approved_leave_movement_missing';return false;}$q=db_query('SELECT * FROM '.TB_PREF.'hrm_leave_payroll_handoffs WHERE command_key='.db_escape($cmd).' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){cancel_transaction();$error='handoff_command_state_invalid';return false;}if(db_num_rows($q)===1){$old=db_fetch_assoc($q);if((int)$old['movement_id']!==(int)$movement_id){cancel_transaction();$error='handoff_replay_mismatch';return false;}commit_transaction();return $old;}$rel=hrm_tim_001_resolve_payroll_relationship((int)$m['assignment_id'],$m['effective_date'],true,$error);if($rel===false){cancel_transaction();return false;}$q=db_query('SELECT c.calendar_period_id FROM '.TB_PREF.'payroll_periods lp INNER JOIN '.TB_PREF.'hrm_payroll_legacy_period_conversion_receipts c ON c.legacy_period_id=lp.period_id WHERE lp.period_id='.(int)$payroll_period_id.' AND lp.from_date<='.db_escape($m['effective_date']).' AND lp.to_date>='.db_escape($m['effective_date']).' LIMIT 2 FOR UPDATE');$period=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$period){cancel_transaction();$error='payroll_period_out_of_scope';return false;}$q=db_query('SELECT * FROM '.TB_PREF.'hrm_leave_payroll_mappings WHERE legal_entity_id='.(int)$m['legal_entity_id'].' AND leave_id='.(int)$m['leave_id'].' AND effective_from<='.db_escape($m['effective_date']).' AND (effective_to IS NULL OR effective_to>='.db_escape($m['effective_date']).') ORDER BY effective_from DESC,mapping_id DESC LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)!==1){cancel_transaction();$error='leave_payroll_mapping_ambiguous_or_missing';return false;}$map=db_fetch_assoc($q);if($map['unit_code']!==$m['unit_code']){cancel_transaction();$error='leave_payroll_unit_mismatch';return false;}$source=hrm_tim_001_hash(array('movement_sha256'=>$m['movement_sha256'],'mapping_sha256'=>$map['mapping_sha256'],'adapter_version'=>HRM_LVE_001_PAYROLL_ADAPTER_VERSION));$candidate=array('payroll_relationship_id'=>(int)$rel['payroll_relationship_id'],'assignment_id'=>(int)$m['assignment_id'],'element_version_id'=>(int)$map['element_version_id'],'input_definition_id'=>(int)$map['input_definition_id'],'effective_date'=>$m['effective_date'],'value_type'=>'decimal','value'=>$m['units'],'source_kind'=>'hrm_lve_001_approved_leave','source_event_id'=>(string)$movement_id,'source_sha256'=>$source,'approval_evidence_sha256'=>$m['source_sha256']);$pc3=hrm_pay_core_003_write_approved_input($candidate,$error);if($pc3===false){cancel_transaction();return false;}$sha=hrm_tim_001_hash(array('movement_id'=>(int)$movement_id,'payroll_relationship_id'=>(int)$rel['payroll_relationship_id'],'payroll_period_id'=>(int)$payroll_period_id,'calendar_period_id'=>(int)$period['calendar_period_id'],'approved_input_id'=>(int)$pc3['approved_input_id'],'approved_input_sha256'=>$pc3['input_sha256'],'adapter_version'=>HRM_LVE_001_PAYROLL_ADAPTER_VERSION,'command_key'=>$cmd,'executed_by'=>$actor));$sql='INSERT INTO '.TB_PREF.'hrm_leave_payroll_handoffs (movement_id,payroll_relationship_id,payroll_period_id,calendar_period_id,assignment_id,unit_code,approved_input_id,approved_input_sha256,adapter_version,command_key,handoff_sha256,executed_by) VALUES ('.(int)$movement_id.','.(int)$rel['payroll_relationship_id'].','.(int)$payroll_period_id.','.(int)$period['calendar_period_id'].','.(int)$m['assignment_id'].','.db_escape($m['unit_code']).','.(int)$pc3['approved_input_id'].','.db_escape($pc3['input_sha256']).','.db_escape(HRM_LVE_001_PAYROLL_ADAPTER_VERSION).','.db_escape($cmd).','.db_escape($sha).','.$actor.')';if(!db_query($sql)){cancel_transaction();$error='payroll_handoff_insert_failed';return false;}$id=(int)db_insert_id();commit_transaction();return array('handoff_id'=>$id,'handoff_sha256'=>$sha,'approved_input_id'=>(int)$pc3['approved_input_id'],'approved_input_sha256'=>$pc3['input_sha256']);}
function hrm_lve_001_create_payroll_mapping(array $x,&$error=null){$error=null;$actor=hrm_lve_001_actor();if($actor<=0||!hrm_lve_001_access('SA_HRM_MAP_LEAVE_PAYROLL')){$error='access_denied';return false;}foreach(array('legal_entity_id','leave_id','effective_from','element_version_id','input_definition_id','unit_code') as $k)if(!isset($x[$k])){$error='mapping_field_missing';return false;}$from=hrm_tim_001_date($x['effective_from']);$to=empty($x['effective_to'])?null:hrm_tim_001_date($x['effective_to']);$unit=hrm_lve_001_allowed_unit($x['unit_code']);if((int)$x['legal_entity_id']<=0||(int)$x['leave_id']<=0||$from===false||($to!==null&&($to===false||$to<$from))||(int)$x['element_version_id']<=0||(int)$x['input_definition_id']<=0||$unit===false){$error='mapping_invalid';return false;}$pred=empty($x['predecessor_mapping_id'])?null:(int)$x['predecessor_mapping_id'];$payload=array('legal_entity_id'=>(int)$x['legal_entity_id'],'leave_id'=>(int)$x['leave_id'],'effective_from'=>$from,'effective_to'=>$to,'element_version_id'=>(int)$x['element_version_id'],'input_definition_id'=>(int)$x['input_definition_id'],'unit_code'=>$unit,'predecessor_mapping_id'=>$pred,'created_by'=>$actor);$sha=hrm_tim_001_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_leave_payroll_mappings (legal_entity_id,leave_id,effective_from,effective_to,element_version_id,input_definition_id,unit_code,predecessor_mapping_id,mapping_sha256,created_by) VALUES ('.$payload['legal_entity_id'].','.$payload['leave_id'].','.db_escape($from).','.($to===null?'NULL':db_escape($to)).','.$payload['element_version_id'].','.$payload['input_definition_id'].','.db_escape($unit).','.($pred===null?'NULL':$pred).','.db_escape($sha).','.$actor.')';$id=hrm_lve_001_insert_idempotent('hrm_leave_payroll_mappings','mapping_id','mapping_sha256',$sha,$sql,$error);return $id===false?false:array('mapping_id'=>$id,'mapping_sha256'=>$sha);}
