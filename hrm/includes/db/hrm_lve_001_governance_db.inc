function hrm_lve_001_with_projection_write($callable){$old=!empty($GLOBALS['hrm_lve_001_projection_write']);$GLOBALS['hrm_lve_001_projection_write']=true;try{return $callable();}finally{$GLOBALS['hrm_lve_001_projection_write']=$old;}}
function hrm_lve_001_terminal_status_write_allowed(){return !hrm_lve_001_tables_ready()||!empty($GLOBALS['hrm_lve_001_terminal_status_authorized']);}
function hrm_lve_001_with_terminal_status_write($callable){$old=!empty($GLOBALS['hrm_lve_001_terminal_status_authorized']);$GLOBALS['hrm_lve_001_terminal_status_authorized']=true;try{return $callable();}finally{$GLOBALS['hrm_lve_001_terminal_status_authorized']=$old;}}

/** Server-derived Worker/Employment/Assignment/Legal Entity scope; caller scope is never trusted. */
