/** HRM-TIM-001 is authoritative for schedule-aware leave quantity. */
function hrm_lve_001_schedule_day($assignment_id,$date,&$error=null){
 $error=null;$d=hrm_tim_001_date($date);if((int)$assignment_id<=0||$d===false){$error='schedule_date_invalid';return false;}
 $q=db_query('SELECT * FROM '.TB_PREF.'hrm_time_work_patterns WHERE assignment_id='.(int)$assignment_id.' AND effective_from<='.db_escape($d).' AND (effective_to IS NULL OR effective_to>='.db_escape($d).') ORDER BY effective_from DESC,work_pattern_id DESC LIMIT 2');if(!$q||db_num_rows($q)!==1){$error='work_pattern_ambiguous_or_missing';return false;}$p=db_fetch_assoc($q);$cycle=(int)$p['cycle_days'];if($cycle<=0||!hrm_tim_001_is_sha256($p['pattern_sha256'])){$error='work_pattern_invalid';return false;}
 $days=(int)floor((strtotime($d.' UTC')-strtotime($p['effective_from'].' UTC'))/86400);if($days<0){$error='work_pattern_date_invalid';return false;}$cycle_day=($days%$cycle)+1;
 $q=db_query('SELECT paid_minutes,break_minutes,rest_minutes,segment_sha256 FROM '.TB_PREF.'hrm_time_work_pattern_segments WHERE work_pattern_id='.(int)$p['work_pattern_id'].' AND cycle_day='.$cycle_day.' ORDER BY segment_sequence,segment_id');if(!$q){$error='work_pattern_segments_unreadable';return false;}$minutes=0;$segs=array();while($r=db_fetch_assoc($q)){$minutes+=(int)$r['paid_minutes'];$segs[]=$r['segment_sha256'];}sort($segs,SORT_STRING);
 return array('date'=>$d,'work_pattern_id'=>(int)$p['work_pattern_id'],'pattern_sha256'=>$p['pattern_sha256'],'cycle_day'=>$cycle_day,'scheduled_minutes'=>$minutes,'schedule_day_sha256'=>hrm_tim_001_hash(array('pattern_sha256'=>$p['pattern_sha256'],'date'=>$d,'cycle_day'=>$cycle_day,'segments'=>$segs,'scheduled_minutes'=>$minutes)));
}
function hrm_lve_001_schedule_range($assignment_id,$from,$to,&$error=null){$error=null;$a=hrm_tim_001_date($from);$b=hrm_tim_001_date($to);if($a===false||$b===false||$b<$a){$error='schedule_range_invalid';return false;}$out=array();$hashes=array();$d=new DateTimeImmutable($a,new DateTimeZone('UTC'));$end=new DateTimeImmutable($b,new DateTimeZone('UTC'));for(;$d<=$end;$d=$d->modify('+1 day')){$x=hrm_lve_001_schedule_day($assignment_id,$d->format('Y-m-d'),$error);if($x===false)return false;$out[]=$x;$hashes[]=$x['schedule_day_sha256'];}return array('days'=>$out,'schedule_sha256'=>hrm_tim_001_hash($hashes));}
function hrm_lve_001_scheduled_minutes_between($assignment_id,$from,$to,&$error=null){$r=hrm_lve_001_schedule_range($assignment_id,$from,$to,$error);if($r===false)return false;$n=0;foreach($r['days'] as $d)$n+=(int)$d['scheduled_minutes'];return array('minutes'=>$n,'schedule_sha256'=>$r['schedule_sha256']);}

function hrm_lve_001_policy_for_scope(array $s,$leave_id,$date,&$error=null){
 $error=null;$employment_type=$s['employment_type']===null?-999999:(int)$s['employment_type'];$grade_id=empty($s['grade_id'])?0:(int)$s['grade_id'];$work_location_id=empty($s['work_location_id'])?0:(int)$s['work_location_id'];
