function hrm_lve_001_units_for_day(array $policy,array $day,$half_day=false){$minutes=(int)$day['scheduled_minutes'];if($minutes<=0)return '0';$factor=$half_day?0.5:1.0;if($policy['unit_code']==='minutes')return hrm_lve_001_decimal($minutes*$factor,(int)$policy['rounding_scale']);if($policy['unit_code']==='hours')return hrm_lve_001_decimal(($minutes/60)*$factor,(int)$policy['rounding_scale']);return hrm_lve_001_decimal(1*$factor,(int)$policy['rounding_scale']);}
