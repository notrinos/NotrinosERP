 $q=db_query($sql,'could not resolve leave assignment scope');if(!$q||db_num_rows($q)!==1){$error='assignment_scope_ambiguous_or_missing';return false;}$r=db_fetch_assoc($q);foreach(array('assignment_id','employment_id','worker_id','legal_entity_id') as $k)if((int)$r[$k]<=0){$error='assignment_scope_incomplete';return false;}
 return array('assignment_id'=>(int)$r['assignment_id'],'employment_id'=>(int)$r['employment_id'],'worker_id'=>(int)$r['worker_id'],'legal_entity_id'=>(int)$r['legal_entity_id'],'grade_id'=>empty($r['grade_id'])?null:(int)$r['grade_id'],'legacy_grade_id'=>empty($r['legacy_grade_id'])?null:(int)$r['legacy_grade_id'],'work_location_id'=>empty($r['work_location_id'])?null:(int)$r['work_location_id'],'employment_type'=>$r['legacy_employment_type']===null?null:(int)$r['legacy_employment_type'],'employment_start'=>(string)$r['start_date']);
