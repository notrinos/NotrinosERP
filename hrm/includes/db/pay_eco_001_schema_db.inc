    // metadata tables can scan the whole schema on supported MariaDB builds.
    $q=db_query('SELECT CONSTRAINT_NAME,COLUMN_NAME,REFERENCED_TABLE_NAME,REFERENCED_COLUMN_NAME FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE WHERE CONSTRAINT_SCHEMA=DATABASE() AND TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical).' AND REFERENCED_TABLE_NAME IS NOT NULL ORDER BY CONSTRAINT_NAME,ORDINAL_POSITION');
    if(!$q)return false;
    $out=array();
    while($r=db_fetch_assoc($q)){
        $name=(string)$r['CONSTRAINT_NAME'];
        // PAY-ECO's required lineage projections are single-column. Reject
        // unexpected composite metadata instead of silently accepting a tail row.
        if(isset($out[$name]))return false;
        $rules=db_query('SELECT UPDATE_RULE,DELETE_RULE FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical).' AND CONSTRAINT_NAME='.db_escape($name).' LIMIT 2');
