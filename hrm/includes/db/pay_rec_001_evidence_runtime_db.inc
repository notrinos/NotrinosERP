    $run_state=hrm_pay_core_009_run_state_from_row($run,$run_error);if($run_state===false||!hash_equals((string)$run['state_sha256'],(string)$run_state['state_sha256']))return pay_rec_001_runtime_fail($error,'payroll_run_state_custody_mismatch');
