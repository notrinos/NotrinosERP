/** Append one profile + four independently recomputed evidence sets and, only when exact, one CloseReady checklist. */
function pay_rec_001_prepare_reconciliation(array $scope,array $policy,array $filing_completion,&$error=null)
{
    $error=null;if(!pay_rec_001_runtime_ready($error)||!pay_rec_001_runtime_require_access(PAY_REC_001_PREPARE_PERMISSION,$error))return false;
    $actor=pay_rec_001_runtime_actor();if($actor<=0||!isset($scope['company_id'])||!pay_rec_001_runtime_scope_company((int)$scope['company_id'],$error))return false;
    $recomputed=pay_rec_001_runtime_recompute_all($scope,$filing_completion,$error);if($recomputed===false)return false;
    $profile=pay_rec_001_profile_descriptor($scope,$policy,$recomputed['payroll_scope_sha256'],$error);if($profile===false)return false;
    $at=pay_rec_001_runtime_now();begin_transaction();$storedProfile=pay_rec_001_runtime_insert_profile($profile,$actor,$at,$error);if($storedProfile===false){cancel_transaction();return false;}
    $profileId=(int)$storedProfile['reconciliation_profile_id'];$stored=array();
    foreach($recomputed['descriptors'] as $kind=>$descriptor){$stored[$kind]=pay_rec_001_runtime_insert_evidence($profileId,$descriptor,$actor,$at,$error);if($stored[$kind]===false){cancel_transaction();return false;}}
    $out=array('reconciliation_profile_id'=>$profileId,'profile_sha256'=>$profile['profile_sha256'],'evidence_set_ids'=>array(),'evidence_sha256s'=>array(),'payroll_payment_exact_match'=>$recomputed['payroll_payment_exact_match'],'close_ready'=>false,'state_mutation_authorized'=>false,'production_close_authorized'=>false);
    foreach($stored as $kind=>$row){$out['evidence_set_ids'][$kind]=(int)$row['reconciliation_evidence_set_id'];$out['evidence_sha256s'][$kind]=(string)$row['evidence_sha256'];}
    if(!$recomputed['payroll_payment_exact_match']){commit_transaction();return $out;}
    $sets=array();foreach($stored as $kind=>$row)$sets[$kind]=array('evidence_sha256'=>(string)$row['evidence_sha256'],'status'=>(string)$row['status_token'],'current'=>((int)$row['current_evidence']===1));
    $readiness=pay_rec_001_evaluate_development_close_readiness($sets,$filing_completion,$policy,$error);if($readiness===false){cancel_transaction();return false;}
    $check=array('reconciliation_profile_id'=>$profileId,'payroll_evidence_set_id'=>(int)$stored['payroll']['reconciliation_evidence_set_id'],'gl_evidence_set_id'=>(int)$stored['gl']['reconciliation_evidence_set_id'],'payment_evidence_set_id'=>(int)$stored['payment']['reconciliation_evidence_set_id'],'filing_evidence_set_id'=>(int)$stored['filing']['reconciliation_evidence_set_id'],'filing_completion_receipt_sha256'=>(string)$filing_completion['completion_receipt_sha256'],'readiness_sha256'=>(string)$readiness['readiness_sha256']);
    $check['checklist_sha256']=pay_rec_001_hash($check);$check_query='SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_checklists WHERE checklist_sha256='.db_escape($check['checklist_sha256']).' LIMIT 2';
    $existing=pay_rec_001_runtime_one($check_query);
    if($existing){if(!pay_rec_001_runtime_checklist_matches($existing,$check)){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_checklist_replay_mismatch');}$checkId=(int)$existing['close_checklist_id'];}
    else{$sql='INSERT INTO '.TB_PREF.'hrm_pay_rec_001_checklists (reconciliation_profile_id,payroll_evidence_set_id,gl_evidence_set_id,payment_evidence_set_id,filing_evidence_set_id,filing_completion_receipt_sha256,readiness_sha256,checklist_sha256,prepared_by,prepared_at,created_at) VALUES ('.implode(',',array_map('db_escape',array($profileId,$check['payroll_evidence_set_id'],$check['gl_evidence_set_id'],$check['payment_evidence_set_id'],$check['filing_evidence_set_id'],$check['filing_completion_receipt_sha256'],$check['readiness_sha256'],$check['checklist_sha256'],$actor,$at,$at))).')';if(!db_query($sql)){$race=pay_rec_001_runtime_one($check_query.' FOR UPDATE');if(!$race||!pay_rec_001_runtime_checklist_matches($race,$check)){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_checklist_insert_failed');}$checkId=(int)$race['close_checklist_id'];}else $checkId=(int)db_insert_id();}
    commit_transaction();$out['close_checklist_id']=$checkId;$out['checklist_sha256']=$check['checklist_sha256'];$out['readiness_sha256']=$check['readiness_sha256'];$out['close_ready']=true;return $out;
}

/** Recompute source evidence and require exact equality with one immutable checklist. */
function pay_rec_001_runtime_revalidate_checklist($close_checklist_id,array $filing_completion,&$error=null)
{
    $error=null;$cl=pay_rec_001_runtime_one('SELECT cl.*,pf.company_id,pf.legal_entity_id,pf.payroll_period_id,pf.pay_core_run_id,pf.filing_obligation_id,pf.currency_code,pf.policy_version,pf.tolerance_sha256,pf.rounding_sha256,pf.filing_completion_policy_sha256,pf.payroll_scope_sha256,pf.profile_sha256,pf.prepared_by AS profile_prepared_by FROM '.TB_PREF.'hrm_pay_rec_001_checklists cl INNER JOIN '.TB_PREF.'hrm_pay_rec_001_profiles pf ON pf.reconciliation_profile_id=cl.reconciliation_profile_id WHERE cl.close_checklist_id='.(int)$close_checklist_id.' LIMIT 2');
    if(!$cl)return pay_rec_001_runtime_fail($error,'reconciliation_checklist_missing');
    if(!pay_rec_001_runtime_scope_company((int)$cl['company_id'],$error))return false;
    $receipt_sha=isset($filing_completion['completion_receipt_sha256'])?(string)$filing_completion['completion_receipt_sha256']:'';
    if(!hash_equals((string)$cl['filing_completion_receipt_sha256'],$receipt_sha))return pay_rec_001_runtime_fail($error,'filing_completion_receipt_changed');
    $scope=array('company_id'=>(int)$cl['company_id'],'legal_entity_id'=>(int)$cl['legal_entity_id'],'payroll_period_id'=>(int)$cl['payroll_period_id'],'pay_core_run_id'=>(int)$cl['pay_core_run_id'],'filing_obligation_id'=>(int)$cl['filing_obligation_id'],'currency_code'=>(string)$cl['currency_code']);
    $recomputed=pay_rec_001_runtime_recompute_all($scope,$filing_completion,$error);
    if($recomputed===false||!$recomputed['payroll_payment_exact_match']||!hash_equals((string)$cl['payroll_scope_sha256'],(string)$recomputed['payroll_scope_sha256']))return pay_rec_001_runtime_fail($error,$error?:'reconciliation_source_evidence_changed');
    $policy=array('policy_version'=>(string)$cl['policy_version'],'tolerance_sha256'=>(string)$cl['tolerance_sha256'],'rounding_sha256'=>(string)$cl['rounding_sha256']);
    $profile=pay_rec_001_profile_descriptor($scope,$policy,$recomputed['payroll_scope_sha256'],$profile_error);
    if($profile===false||!hash_equals((string)$cl['profile_sha256'],(string)$profile['profile_sha256'])||!hash_equals((string)$cl['filing_completion_policy_sha256'],(string)$profile['filing_completion_policy_sha256']))return pay_rec_001_runtime_fail($error,$profile_error?:'reconciliation_profile_hash_mismatch');
    $ids=array('payroll'=>(int)$cl['payroll_evidence_set_id'],'gl'=>(int)$cl['gl_evidence_set_id'],'payment'=>(int)$cl['payment_evidence_set_id'],'filing'=>(int)$cl['filing_evidence_set_id']);$stored=array();$sets=array();
    foreach($ids as $kind=>$id){$row=pay_rec_001_runtime_one('SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_evidence_sets WHERE reconciliation_evidence_set_id='.$id.' LIMIT 2');$expected=$recomputed['descriptors'][$kind];if(!$row||!pay_rec_001_runtime_evidence_matches($row,(int)$cl['reconciliation_profile_id'],$expected)||(string)$row['status_token']!=='matched'||(int)$row['current_evidence']!==1||!hash_equals((string)$row['evidence_sha256'],(string)$expected['evidence_sha256']))return pay_rec_001_runtime_fail($error,'reconciliation_evidence_changed_or_tampered');$stored[$kind]=$row;$sets[$kind]=array('evidence_sha256'=>(string)$expected['evidence_sha256'],'status'=>(string)$expected['status_token'],'current'=>true);}
    $readiness=pay_rec_001_evaluate_development_close_readiness($sets,$filing_completion,$policy,$readiness_error);
    if($readiness===false||!hash_equals((string)$cl['readiness_sha256'],(string)$readiness['readiness_sha256']))return pay_rec_001_runtime_fail($error,$readiness_error?:'reconciliation_readiness_hash_mismatch');
    $check=array('reconciliation_profile_id'=>(int)$cl['reconciliation_profile_id'],'payroll_evidence_set_id'=>$ids['payroll'],'gl_evidence_set_id'=>$ids['gl'],'payment_evidence_set_id'=>$ids['payment'],'filing_evidence_set_id'=>$ids['filing'],'filing_completion_receipt_sha256'=>(string)$cl['filing_completion_receipt_sha256'],'readiness_sha256'=>(string)$readiness['readiness_sha256']);$check['checklist_sha256']=pay_rec_001_hash($check);
    if(!pay_rec_001_runtime_checklist_matches($cl,$check))return pay_rec_001_runtime_fail($error,'reconciliation_checklist_hash_mismatch');
    return array('checklist'=>$cl,'evidence'=>$stored,'recomputed'=>$recomputed);
}

/** Append an independent reviewer decision; it grants no close-state mutation authority. */
function pay_rec_001_review_reconciliation($close_checklist_id,array $filing_completion,$decision,$review_evidence_sha256,&$error=null)
{
    $error=null;if(!pay_rec_001_runtime_ready($error)||!pay_rec_001_runtime_require_access(PAY_REC_001_REVIEW_PERMISSION,$error))return false;
    $actor=pay_rec_001_runtime_actor();$validated=pay_rec_001_runtime_revalidate_checklist($close_checklist_id,$filing_completion,$error);if($validated===false)return false;
    $cl=$validated['checklist'];$descriptor=pay_rec_001_review_descriptor((int)$cl['close_checklist_id'],(string)$cl['checklist_sha256'],(string)$cl['readiness_sha256'],(int)$cl['prepared_by'],$actor,$decision,$review_evidence_sha256,$error);if($descriptor===false)return false;
    $query='SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_reviews WHERE close_checklist_id='.(int)$cl['close_checklist_id'].' LIMIT 2';$existing=pay_rec_001_runtime_one($query);
    if($existing){if(!pay_rec_001_runtime_review_matches($existing,$descriptor))return pay_rec_001_runtime_fail($error,'reconciliation_review_conflict');return pay_rec_001_runtime_review_response($existing);}
    $at=pay_rec_001_runtime_now();$sql='INSERT INTO '.TB_PREF.'hrm_pay_rec_001_reviews (close_checklist_id,checklist_sha256,readiness_sha256,decision,review_evidence_sha256,review_sha256,reviewed_by,reviewed_at,created_at) VALUES ('.implode(',',array_map('db_escape',array($descriptor['close_checklist_id'],$descriptor['checklist_sha256'],$descriptor['readiness_sha256'],$descriptor['decision'],$descriptor['review_evidence_sha256'],$descriptor['review_sha256'],$descriptor['reviewed_by'],$at,$at))).')';
    if(!db_query($sql)){$race=pay_rec_001_runtime_one($query.' FOR UPDATE');if(!$race||!pay_rec_001_runtime_review_matches($race,$descriptor))return pay_rec_001_runtime_fail($error,'reconciliation_review_insert_failed');return pay_rec_001_runtime_review_response($race);}
    $descriptor['reconciliation_review_id']=(int)db_insert_id();return pay_rec_001_runtime_review_response($descriptor);
}

/** Append a third-person approval/rejection; even an approval does not close or mutate payroll/accounting state. */
function pay_rec_001_approve_reconciliation($reconciliation_review_id,array $filing_completion,$decision,$assurance_evidence_sha256,&$error=null)
{
    $error=null;if(!pay_rec_001_runtime_ready($error)||!pay_rec_001_runtime_require_access(PAY_REC_001_APPROVE_PERMISSION,$error))return false;
    $actor=pay_rec_001_runtime_actor();$review=pay_rec_001_runtime_one('SELECT rv.*,cl.prepared_by,cl.checklist_sha256 AS authoritative_checklist_sha256,cl.readiness_sha256 AS authoritative_readiness_sha256 FROM '.TB_PREF.'hrm_pay_rec_001_reviews rv INNER JOIN '.TB_PREF.'hrm_pay_rec_001_checklists cl ON cl.close_checklist_id=rv.close_checklist_id WHERE rv.reconciliation_review_id='.(int)$reconciliation_review_id.' LIMIT 2');
    if(!$review)return pay_rec_001_runtime_fail($error,'reconciliation_review_missing');
    if(!hash_equals((string)$review['checklist_sha256'],(string)$review['authoritative_checklist_sha256'])||!hash_equals((string)$review['readiness_sha256'],(string)$review['authoritative_readiness_sha256']))return pay_rec_001_runtime_fail($error,'reconciliation_review_binding_mismatch');
    $reviewCheck=pay_rec_001_review_descriptor((int)$review['close_checklist_id'],(string)$review['checklist_sha256'],(string)$review['readiness_sha256'],(int)$review['prepared_by'],(int)$review['reviewed_by'],(string)$review['decision'],(string)$review['review_evidence_sha256'],$re);
    if($reviewCheck===false||!pay_rec_001_runtime_review_matches($review,$reviewCheck))return pay_rec_001_runtime_fail($error,$re?:'reconciliation_review_hash_mismatch');
    $validated=pay_rec_001_runtime_revalidate_checklist((int)$review['close_checklist_id'],$filing_completion,$error);if($validated===false)return false;
    if($decision==='approved'&&(string)$review['decision']!=='approved')return pay_rec_001_runtime_fail($error,'reconciliation_rejected_review_cannot_be_approved');
    $descriptor=pay_rec_001_approval_descriptor((int)$review['reconciliation_review_id'],(int)$review['close_checklist_id'],(string)$review['review_sha256'],(int)$review['prepared_by'],(int)$review['reviewed_by'],$actor,$decision,$assurance_evidence_sha256,$error);if($descriptor===false)return false;
    $query='SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_approvals WHERE reconciliation_review_id='.(int)$review['reconciliation_review_id'].' LIMIT 2';$existing=pay_rec_001_runtime_one($query);
    if($existing){if(!pay_rec_001_runtime_approval_matches($existing,$descriptor))return pay_rec_001_runtime_fail($error,'reconciliation_approval_conflict');return pay_rec_001_runtime_approval_response($existing);}
    $at=pay_rec_001_runtime_now();$sql='INSERT INTO '.TB_PREF.'hrm_pay_rec_001_approvals (reconciliation_review_id,close_checklist_id,review_sha256,decision,assurance_evidence_sha256,approval_sha256,approved_by,approved_at,created_at) VALUES ('.implode(',',array_map('db_escape',array($descriptor['reconciliation_review_id'],$descriptor['close_checklist_id'],$descriptor['review_sha256'],$descriptor['decision'],$descriptor['assurance_evidence_sha256'],$descriptor['approval_sha256'],$descriptor['approved_by'],$at,$at))).')';
    if(!db_query($sql)){$race=pay_rec_001_runtime_one($query.' FOR UPDATE');if(!$race||!pay_rec_001_runtime_approval_matches($race,$descriptor))return pay_rec_001_runtime_fail($error,'reconciliation_approval_insert_failed');return pay_rec_001_runtime_approval_response($race);}
    $descriptor['reconciliation_approval_id']=(int)db_insert_id();return pay_rec_001_runtime_approval_response($descriptor);
}
