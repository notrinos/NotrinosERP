    if(!db_query($sql)){$race=pay_rec_001_runtime_one($query.' FOR UPDATE');if($race&&pay_rec_001_runtime_evidence_matches($race,$profile_id,$d))return $race;return pay_rec_001_runtime_fail($error,'reconciliation_evidence_insert_failed');}
