        if(!$projection||(int)$projection['calendar_period_id']!==(int)$r['calendar_period_id']||(int)$projection['payroll_group_id']!==(int)$current['scope']['payroll_group_id']||(int)$projection['group_version_id']!==(int)$current['scope']['group_version_id']||(int)$projection['legal_entity_id']!==(int)$scope['legal_entity_id']||(int)$projection['payroll_relationship_id']!==(int)$r['payroll_relationship_id']||(int)$projection['assignment_id']!==(int)$r['assignment_id']||(int)$projection['result_id']!==(int)$r['result_id']||!hash_equals((string)$projection['result_sha256'],(string)$r['result_sha256'])||!hash_equals((string)$projection['employee_id_sha256'],hash('sha256',(string)$employee['employee_id'])))return pay_rec_001_runtime_fail($error,'payroll_projection_scope_or_membership_mismatch');
        $projection_descriptor=hrm_pay_core_010_projection_descriptor(array('payroll_period_id'=>(int)$projection['payroll_period_id'],'calendar_period_id'=>(int)$projection['calendar_period_id'],'payroll_group_id'=>(int)$projection['payroll_group_id'],'group_version_id'=>(int)$projection['group_version_id'],'legal_entity_id'=>(int)$projection['legal_entity_id'],'payroll_relationship_id'=>(int)$projection['payroll_relationship_id'],'assignment_id'=>(int)$projection['assignment_id'],'employee_id_sha256'=>(string)$projection['employee_id_sha256'],'result_id'=>(int)$projection['result_id'],'result_sha256'=>(string)$projection['result_sha256'],'header_sha256'=>(string)$projection['header_sha256'],'detail_set_sha256'=>(string)$projection['detail_set_sha256']),$projection_error);
        if($projection_descriptor===false||!hash_equals((string)$projection['projection_sha256'],(string)$projection_descriptor['projection_sha256']))return pay_rec_001_runtime_fail($error,'payroll_projection_integrity_mismatch');
