'source_link_sha256'],(string)$canonical['source_link_sha256']))return pay_rec_001_runtime_fail($error,'filing_source_link_custody_mismatch');$basis_links[]=$base;}if(!hash_equals((string)$set['source_set_sha256'],(string)pay_fil_001_hash(array('obligation_sha256'=>(string)$ob['obligation_sha256'],'source_links'=>$basis_links))))return pay_rec_001_runtime_fail($error,'filing_source_set_custody_mismatch');$liability=pay_rec_001_uint($set['liability_total_minor']);if($liability===false)return pay_rec_001_runtime_fail($error,'filing_liability_total_invalid');$evidence=pay_rec_001_filing_evidence_source((int)$set['filing_source_set_id'],(string)$set['source_set_sha256'],(string)$completion['completion_receipt_sha256'],$liability,pay_fil_001_hash(pay_fil_001_authority_contract()),$evidence_error);if($evidence===false)return pay_rec_001_runtime_fail($error,$evidence_error?:'filing_evidence_source_invalid');return $evidence;
