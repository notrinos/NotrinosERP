/** Recompute all four source sets without trusting PAY-REC rows. */
function pay_rec_001_runtime_recompute_all(array $scope,array $completion,&$error=null)
{
    $error=null;$payroll=pay_rec_001_runtime_recompute_payroll($scope,$error);if($payroll===false)return false;$gl=pay_rec_001_runtime_recompute_gl($scope,$error);if($gl===false)return false;$payment=pay_rec_001_runtime_recompute_payment($scope,$error);if($payment===false)return false;$filing=pay_rec_001_runtime_recompute_filing($scope,$completion,$error);if($filing===false)return false;
    if(count($payment['result_set_sha256s'])!==1||!hash_equals((string)$payroll['result_set_sha256'],(string)$payment['result_set_sha256s'][0]))return pay_rec_001_runtime_fail($error,'payroll_payment_result_set_mismatch');if($gl['journal_sha256s']!==$payment['journal_sha256s'])return pay_rec_001_runtime_fail($error,'gl_payment_journal_membership_mismatch');
    $payMembership=pay_rec_001_evidence_membership('payroll',$payroll['members'],$error);if($payMembership===false)return false;$pmtMembership=pay_rec_001_evidence_membership('payment',$payment['members'],$error);if($pmtMembership===false)return false;$crossStatus=$payMembership['amount_minor']===$pmtMembership['amount_minor']?'matched':'mismatch';$descriptors=array();foreach(array('payroll'=>$payroll,'gl'=>$gl,'payment'=>$payment,'filing'=>$filing) as $kind=>$x){$status=in_array($kind,array('payroll','payment'),true)?$crossStatus:'matched';$descriptors[$kind]=pay_rec_001_evidence_descriptor($kind,$x['members'],$status,$x['source_contract_sha256'],$error);if($descriptors[$kind]===false)return false;}return array('descriptors'=>$descriptors,'payroll_scope_sha256'=>$payroll['scope_sha256'],'payroll_payment_exact_match'=>$crossStatus==='matched');
}

function pay_rec_001_runtime_insert_profile(array $profile,$actor,$at,&$error)
{
    $query='SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_profiles WHERE profile_sha256='.db_escape($profile['profile_sha256']).' LIMIT 2';
    $existing=pay_rec_001_runtime_one($query);
    if($existing){if(!pay_rec_001_runtime_profile_matches($existing,$profile))return pay_rec_001_runtime_fail($error,'reconciliation_profile_replay_mismatch');return $existing;}
    $scope=pay_rec_001_runtime_rows('SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_profiles WHERE company_id='.(int)$profile['company_id'].' AND legal_entity_id='.(int)$profile['legal_entity_id'].' AND payroll_period_id='.(int)$profile['payroll_period_id'].' AND pay_core_run_id='.(int)$profile['pay_core_run_id'].' AND filing_obligation_id='.(int)$profile['filing_obligation_id'].' AND policy_version='.db_escape($profile['policy_version']).' AND tolerance_sha256='.db_escape($profile['tolerance_sha256']).' AND rounding_sha256='.db_escape($profile['rounding_sha256']).' LIMIT 2');
    if($scope===false||count($scope)>0)return pay_rec_001_runtime_fail($error,'reconciliation_profile_scope_conflict');
    $sql='INSERT INTO '.TB_PREF.'hrm_pay_rec_001_profiles (company_id,legal_entity_id,payroll_period_id,pay_core_run_id,filing_obligation_id,currency_code,policy_version,tolerance_sha256,rounding_sha256,filing_completion_policy_sha256,payroll_scope_sha256,profile_sha256,prepared_by,prepared_at,created_at) VALUES ('.implode(',',array_map('db_escape',array($profile['company_id'],$profile['legal_entity_id'],$profile['payroll_period_id'],$profile['pay_core_run_id'],$profile['filing_obligation_id'],$profile['currency_code'],$profile['policy_version'],$profile['tolerance_sha256'],$profile['rounding_sha256'],$profile['filing_completion_policy_sha256'],$profile['payroll_scope_sha256'],$profile['profile_sha256'],$actor,$at,$at))).')';
    if(!db_query($sql)){$race=pay_rec_001_runtime_one($query.' FOR UPDATE');if($race&&pay_rec_001_runtime_profile_matches($race,$profile))return $race;return pay_rec_001_runtime_fail($error,'reconciliation_profile_insert_failed');}
    $profile['reconciliation_profile_id']=(int)db_insert_id();$profile['prepared_by']=$actor;return $profile;
}
function pay_rec_001_runtime_insert_evidence($profile_id,array $d,$actor,$at,&$error)
