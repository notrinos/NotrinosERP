function pay_api_001_trigger_valid($t,$op){$p=hrm_migration_active_table_prefix();$c=pay_api_001_trigger_code($t);$phys=hrm_migration_physical_table_name($t);$operation=strtoupper($op);if($p===false||$c===false||$phys===false||!in_array($operation,array('UPDATE','DELETE'),true))return false;$name=$p.'papi1_'.$c.'_'.($operation==='UPDATE'?'u':'d');$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);$expected_action="SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='PAY-API-001 immutable ".$t.' row cannot be '.strtolower($operation).'d'."'";return strtoupper((string)$r['EVENT_MANIPULATION'])===$operation&&(string)$r['EVENT_OBJECT_TABLE']===$phys&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&trim((string)$r['ACTION_STATEMENT'])===$expected_action;}
function pay_api_001_index_columns($t,$name){$p=hrm_migration_physical_table_name($t);if($p===false||!is_string($name)||$name==='')return false;$q=db_query('SELECT COLUMN_NAME,NON_UNIQUE FROM INFORMATION_SCHEMA.STATISTICS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($p).' AND INDEX_NAME='.db_escape($name).' ORDER BY SEQ_IN_INDEX');if(!$q)return false;$cols=array();$non_unique=null;while($r=db_fetch_assoc($q)){$cols[]=(string)$r['COLUMN_NAME'];$non_unique=(int)$r['NON_UNIQUE'];}return array('columns'=>$cols,'unique'=>$non_unique===0);}
function pay_api_001_require_unique_index($patch,$t,$name,array $columns){$i=pay_api_001_index_columns($t,$name);return is_array($i)&&$i['unique']===true&&$i['columns']===$columns?true:hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 index projection mismatch: '.$t.'.'.$name);}
/** Verify an exact one-column foreign key with restrictive update/delete rules. */
function pay_api_001_require_restrictive_foreign_key($patch,$table,$constraint,$column,$referenced_table,$referenced_column)
{
 $physical_table=hrm_migration_physical_table_name($table);$physical_referenced_table=hrm_migration_physical_table_name($referenced_table);
 if($physical_table===false||$physical_referenced_table===false)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 foreign-key table projection unavailable: '.$constraint);
 $sql='SELECT TABLE_NAME,COLUMN_NAME,REFERENCED_TABLE_NAME,REFERENCED_COLUMN_NAME FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE WHERE CONSTRAINT_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical_table).' AND CONSTRAINT_NAME='.db_escape($constraint).' ORDER BY ORDINAL_POSITION';
 $q=db_query($sql);if(!$q||db_num_rows($q)!==1)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 foreign-key projection mismatch: '.$constraint);
 $r=db_fetch_assoc($q);
 if((string)$r['COLUMN_NAME']!==$column||(string)$r['REFERENCED_TABLE_NAME']!==$physical_referenced_table||(string)$r['REFERENCED_COLUMN_NAME']!==$referenced_column)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 foreign-key projection mismatch: '.$constraint);
 $sql='SELECT UPDATE_RULE,DELETE_RULE FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical_table).' AND CONSTRAINT_NAME='.db_escape($constraint);
 $q=db_query($sql);if(!$q||db_num_rows($q)!==1)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 foreign-key rule projection mismatch: '.$constraint);
 $rules=db_fetch_assoc($q);if(strtoupper((string)$rules['UPDATE_RULE'])!=='RESTRICT'||strtoupper((string)$rules['DELETE_RULE'])!=='RESTRICT')return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 foreign-key rule projection mismatch: '.$constraint);
 return true;
}
/** Verify an exact ordered multi-column foreign key with restrictive update/delete rules. */
function pay_api_001_require_restrictive_foreign_key_columns($patch,$table,$constraint,array $columns,$referenced_table,array $referenced_columns)
{
 if(count($columns)!==count($referenced_columns)||count($columns)<2)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 composite foreign-key definition invalid: '.$constraint);
 $physical_table=hrm_migration_physical_table_name($table);$physical_referenced_table=hrm_migration_physical_table_name($referenced_table);
 if($physical_table===false||$physical_referenced_table===false)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 foreign-key table projection unavailable: '.$constraint);
 $sql='SELECT COLUMN_NAME,REFERENCED_TABLE_NAME,REFERENCED_COLUMN_NAME FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE WHERE CONSTRAINT_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical_table).' AND CONSTRAINT_NAME='.db_escape($constraint).' ORDER BY ORDINAL_POSITION';
 $q=db_query($sql);if(!$q||db_num_rows($q)!==count($columns))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 composite foreign-key projection mismatch: '.$constraint);
 $i=0;while($r=db_fetch_assoc($q)){if((string)$r['COLUMN_NAME']!==$columns[$i]||(string)$r['REFERENCED_TABLE_NAME']!==$physical_referenced_table||(string)$r['REFERENCED_COLUMN_NAME']!==$referenced_columns[$i])return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 composite foreign-key projection mismatch: '.$constraint);$i++;}
 $sql='SELECT UPDATE_RULE,DELETE_RULE FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical_table).' AND CONSTRAINT_NAME='.db_escape($constraint);
 $q=db_query($sql);if(!$q||db_num_rows($q)!==1)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 composite foreign-key rule projection mismatch: '.$constraint);
 $rules=db_fetch_assoc($q);if(strtoupper((string)$rules['UPDATE_RULE'])!=='RESTRICT'||strtoupper((string)$rules['DELETE_RULE'])!=='RESTRICT')return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 composite foreign-key rule projection mismatch: '.$constraint);
 return $i===count($columns);
}
function pay_api_001_install_unique_index($patch,$t,$name,array $columns){$i=pay_api_001_index_columns($t,$name);if(is_array($i)&&count($i['columns'])>0)return pay_api_001_require_unique_index($patch,$t,$name,$columns);$phys=hrm_migration_physical_table_name($t);if($phys===false)return false;$quoted=array();foreach($columns as $c)$quoted[]='`'.str_replace('`','',$c).'`';if(!db_query('ALTER TABLE `'.$phys.'` ADD UNIQUE KEY `'.$name.'` ('.implode(',',$quoted).')'))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 unique index creation failed: '.$t.'.'.$name);return pay_api_001_require_unique_index($patch,$t,$name,$columns);}
function pay_api_001_require_table($patch,$t){$cols=pay_api_001_schema_columns();if(!isset($cols[$t])||pay_api_001_table_columns($t)!==$cols[$t]||!pay_api_001_table_innodb($t))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 table projection mismatch: '.$t);foreach(array('UPDATE','DELETE') as $op)if(!pay_api_001_trigger_valid($t,$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-API-001 immutable trigger mismatch: '.$t.'.'.$op);return true;}
function pay_api_001_require_zero_rows($patch,array $tables){foreach($tables as $t){$q=db_query('SELECT COUNT(*) n FROM '.TB_PREF.$t);$r=$q?db_fetch_assoc($q):false;if(!$r||(int)$r['n']!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 foundation must remain zero-seed: '.$t);}return true;}
function pay_api_001_install_sql_group($patch,$rel,array $tables){global $path_to_root;$raw=@file_get_contents($path_to_root.'/'.$rel);if(!is_string($raw)||strpos($raw,'PAY-API-001 GROUP')===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-API-001 schema source missing: '.$rel);$p=hrm_migration_active_table_prefix();if($p===false)return pay_api_001_fail_patch($patch,'PAY-API-001 table prefix unavailable.');$raw=preg_replace('/^--.*$/m','',$raw);$stmts=preg_split('/;\s*(?:\r?\n|$)/',$raw);foreach($stmts as $s){$s=trim($s);if($s===''||strpos($s,'CREATE TRIGGER')===0)continue;$s=str_replace('`0_','`'.$p,$s);if(!db_query($s))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-API-001 schema statement failed: '.$rel);}foreach($tables as $t)foreach(array('UPDATE','DELETE') as $op){if(pay_api_001_trigger_valid($t,$op))continue;$code=pay_api_001_trigger_code($t);$tn=$p.'papi1_'.$code.'_'.($op==='UPDATE'?'u':'d');$phys=hrm_migration_physical_table_name($t);$msg='PAY-API-001 immutable '.$t.' row cannot be '.strtolower($op).'d';if(!db_query('CREATE TRIGGER `'.$tn.'` BEFORE '.$op.' ON `'.$phys.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape($msg)))return false;}foreach($tables as $t)if(!pay_api_001_require_table($patch,$t))return false;return pay_api_001_require_zero_rows($patch,$tables);}
