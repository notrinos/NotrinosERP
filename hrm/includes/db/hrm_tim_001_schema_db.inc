function hrm_tim_001_required_indexes(){$out=array();foreach(hrm_tim_001_required_index_specs() as $table=>$specs)$out[$table]=array_keys($specs);return $out;}
function hrm_tim_001_index_spec($table,$name)
{
    $physical=hrm_migration_physical_table_name($table);if($physical===false)return false;
    $q=db_query('SELECT NON_UNIQUE,SEQ_IN_INDEX,COLUMN_NAME FROM INFORMATION_SCHEMA.STATISTICS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($physical).' AND INDEX_NAME='.db_escape($name).' ORDER BY SEQ_IN_INDEX');
    if(!$q||db_num_rows($q)<1)return false;$columns=array();$unique=null;
    while($r=db_fetch_assoc($q)){if($unique===null)$unique=((int)$r['NON_UNIQUE']===0);elseif($unique!==((int)$r['NON_UNIQUE']===0))return false;$columns[]=(string)$r['COLUMN_NAME'];}
    return array($unique,$columns);
}
function hrm_tim_001_trigger_name($code,$op){$prefix=hrm_migration_active_table_prefix();if($prefix===false||!preg_match('/^[a-z0-9]{3}$/D',$code))return false;$name=$prefix.'tim1_'.$code.'_'.(strtoupper($op)==='UPDATE'?'u':'d');return strlen($name)<=64?$name:false;}
function hrm_tim_001_trigger_exists($table,$code,$op){$physical=hrm_migration_physical_table_name($table);$name=hrm_tim_001_trigger_name($code,$op);if($physical===false||$name===false)return false;$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);$stmt=(string)($r['ACTION_STATEMENT']??'');return strtoupper((string)$r['EVENT_MANIPULATION'])===strtoupper($op)&&(string)$r['EVENT_OBJECT_TABLE']===$physical&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&strpos($stmt,"SIGNAL SQLSTATE '45000'")!==false&&strpos($stmt,'HRM-TIM-001 immutable custody denies')!==false;}
function hrm_tim_001_table_columns($table){if(!hrm_migration_table_exists($table))return false;$q=db_query('SHOW COLUMNS FROM '.TB_PREF.$table);if(!$q)return false;$out=array();while($r=db_fetch_assoc($q))$out[]=(string)$r['Field'];return $out;}
function hrm_tim_001_table_innodb($table){$p=hrm_migration_physical_table_name($table);if($p===false)return false;$q=db_query('SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($p));$r=$q?db_fetch_assoc($q):false;return $r&&strcasecmp((string)$r['ENGINE'],'InnoDB')===0;}
function hrm_tim_001_ensure_triggers($patch,array $tables){$codes=hrm_tim_001_trigger_codes();foreach($tables as $table){if(!isset($codes[$table]))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-TIM-001 immutable trigger table is unknown.');foreach(array('UPDATE','DELETE') as $op){if(hrm_tim_001_trigger_exists($table,$codes[$table],$op))continue;$name=hrm_tim_001_trigger_name($codes[$table],$op);if($name===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-TIM-001 immutable trigger name invalid.');$sql='CREATE TRIGGER `'.$name.'` BEFORE '.$op.' ON `'.TB_PREF.$table.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape('HRM-TIM-001 immutable custody denies '.strtolower($op).' on '.$table);if(!db_query($sql,'could not create HRM-TIM-001 immutable trigger'))return false;}}return true;}
function hrm_tim_001_install_schema($patch){global $path_to_root;$src=@file_get_contents($path_to_root.'/sql/upgrade_hrm_tim_001_schema.sql');if(!is_string($src))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-TIM-001 schema SQL missing.');$columns=hrm_tim_001_schema_columns();preg_match_all('/CREATE TABLE `0_([^`]+)`.*?;(?=\s|$)/s',$src,$m,PREG_SET_ORDER);if(count($m)!==count($columns))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-TIM-001 schema SQL table count mismatch.');foreach($m as $x){$table=$x[1];if(!isset($columns[$table]))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-TIM-001 schema SQL contains unexpected table.');if(!hrm_migration_table_exists($table)&&!db_query(str_replace('0_',TB_PREF,$x[0]),'could not install HRM-TIM-001 table'))return false;}return hrm_tim_001_require_full_schema($patch,true);}
function hrm_tim_001_require_group_schema($patch,$group,$ensure=false){$groups=hrm_tim_001_schema_groups();$all=hrm_tim_001_schema_columns();$indexes=hrm_tim_001_required_indexes();if(!isset($groups[$group]))return false;$tables=$groups[$group];foreach($tables as $table){if(hrm_tim_001_table_columns($table)!==$all[$table]||!hrm_tim_001_table_innodb($table))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-TIM-001 custody schema mismatch for '.$table.'.');$actual=hrm_migration_index_names($table);if(!is_array($actual))return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'HRM-TIM-001 index metadata unavailable for '.$table.'.');$specs=hrm_tim_001_required_index_specs();foreach($indexes[$table] as $name){if(!isset($actual[$name]))return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'HRM-TIM-001 required index '.$name.' missing on '.$table.'.');$got=hrm_tim_001_index_spec($table,$name);if($got===false||$got!==$specs[$table][$name])return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'HRM-TIM-001 required index '.$name.' definition mismatch on '.$table.'.');}}if($ensure&&!hrm_tim_001_ensure_triggers($patch,$tables))return false;$codes=hrm_tim_001_trigger_codes();foreach($tables as $table)foreach(array('UPDATE','DELETE') as $op)if(!hrm_tim_001_trigger_exists($table,$codes[$table],$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-TIM-001 immutable denial trigger missing for '.$table.' '.$op.'.');return true;}
function hrm_tim_001_require_full_schema($patch,$ensure=false){foreach(array_keys(hrm_tim_001_schema_groups()) as $group)if(!hrm_tim_001_require_group_schema($patch,$group,$ensure))return false;return true;}
