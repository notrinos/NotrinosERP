<?php
/** Frozen schema helpers for PAY-RULE-006 additive immutable custody. */
include_once(dirname(__FILE__).'/migration_readiness_db.inc');
function hrm_pay_rule_006_schema_columns($table){if(!hrm_migration_table_exists($table))return false;$r=db_query('SHOW COLUMNS FROM '.TB_PREF.$table);if(!$r)return false;$o=array();while($x=db_fetch_assoc($r))$o[]=(string)$x['Field'];return $o;}
function hrm_pay_rule_006_schema_engine_innodb($table){$p=hrm_migration_physical_table_name($table);if($p===false)return false;$r=db_query('SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($p));$x=$r?db_fetch_assoc($r):false;return $x&&strcasecmp((string)$x['ENGINE'],'InnoDB')===0;}
function hrm_pay_rule_006_trigger_name($code,$op){$prefix=hrm_migration_active_table_prefix();$suffix=strtoupper($op)==='UPDATE'?'u':'d';if($prefix===false||!preg_match('/^[a-z0-9_]{1,12}$/D',$code))return false;$n=$prefix.'pr6_'.$code.'_'.$suffix;return strlen($n)<=64?$n:false;}
function hrm_pay_rule_006_trigger_exists($table,$code,$op){$p=hrm_migration_physical_table_name($table);$n=hrm_pay_rule_006_trigger_name($code,$op);if($p===false||$n===false)return false;$r=db_query('SELECT COUNT(*) n FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($n).' AND EVENT_OBJECT_TABLE='.db_escape($p).' AND EVENT_MANIPULATION='.db_escape(strtoupper($op)));$x=$r?db_fetch_assoc($r):false;return $x&&(int)$x['n']===1;}
function hrm_pay_rule_006_ensure_triggers($patch,$tables){foreach($tables as $table=>$code)foreach(array('UPDATE','DELETE') as $op){if(hrm_pay_rule_006_trigger_exists($table,$code,$op))continue;$n=hrm_pay_rule_006_trigger_name($code,$op);if($n===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-RULE-006 immutable trigger name invalid.');$sql='CREATE TRIGGER `'.$n.'` BEFORE '.$op.' ON `'.TB_PREF.$table.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape('PAY-RULE-006 immutable custody denies '.strtolower($op).' on '.$table);if(!db_query($sql,'could not create PAY-RULE-006 immutable trigger'))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-RULE-006 immutable trigger creation failed for '.$table.'.');}foreach($tables as $table=>$code)foreach(array('UPDATE','DELETE') as $op)if(!hrm_pay_rule_006_trigger_exists($table,$code,$op))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-RULE-006 immutable trigger verification failed.');return true;}
function hrm_pay_rule_006_install_tables($patch,$sql_file,$expected_columns,$trigger_codes){$root=dirname(dirname(dirname(dirname(__FILE__))));$src=@file_get_contents($root.'/sql/'.$sql_file);if($src===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-RULE-006 custody SQL missing.');preg_match_all('/CREATE TABLE `0_([^`]+)`.*?;(?=\s|$)/s',$src,$m,PREG_SET_ORDER);if(count($m)!==count($expected_columns))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-RULE-006 custody SQL table count mismatch.');foreach($m as $x)if(!isset($expected_columns[$x[1]]))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'Unexpected PAY-RULE-006 table '.$x[1].'.');foreach($m as $x)if(!hrm_migration_table_exists($x[1])&&!db_query(str_replace('0_',TB_PREF,$x[0]),'could not create PAY-RULE-006 table'))return false;foreach($expected_columns as $t=>$cols){if(hrm_pay_rule_006_schema_columns($t)!==$cols||!hrm_pay_rule_006_schema_engine_innodb($t))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-RULE-006 custody schema mismatch for '.$t.'.');}return hrm_pay_rule_006_ensure_triggers($patch,$trigger_codes);}
function hrm_pay_rule_006_require_zero_rows($patch,$tables){foreach($tables as $t){$r=db_query('SELECT COUNT(*) n FROM '.TB_PREF.$t);$x=$r?db_fetch_assoc($r):false;if(!$x||(int)$x['n']!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-RULE-006 custody must activate with zero rows in '.$t.'.');}return true;}
