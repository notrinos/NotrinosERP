<?php
/**
 * PAY-REC-001 append-only development close/recovery runtime.
 * Serializes state-event appends per accepted PAY-CORE run + filing obligation, freshly revalidates
 * independent reconciliation evidence before close, and never posts/mutates payroll, GL, payment or filing state.
 */
include_once(dirname(__FILE__).'/pay_rec_001_close_state_db.inc');
include_once(dirname(__FILE__).'/pay_rec_001_evidence_runtime_db.inc');

function pay_rec_001_close_state_runtime_ready(&$error){$v=pay_rec_001_runtime_database_version();return is_string($v)&&version_compare($v,'1.0.1057','>=')?true:pay_rec_001_runtime_fail($error,'pay_rec_001_close_state_runtime_not_activated');}
function pay_rec_001_close_state_runtime_event_matches(array $row,array $event){return pay_rec_001_runtime_same_fields($row,array(
 'reconciliation_profile_id'=>$event['reconciliation_profile_id'],'close_checklist_id'=>$event['close_checklist_id'],'reconciliation_review_id'=>$event['reconciliation_review_id'],'reconciliation_approval_id'=>$event['reconciliation_approval_id'],
 'company_id'=>$event['company_id'],'legal_entity_id'=>$event['legal_entity_id'],'payroll_period_id'=>$event['payroll_period_id'],'pay_core_run_id'=>$event['pay_core_run_id'],'filing_obligation_id'=>$event['filing_obligation_id'],
 'event_sequence'=>$event['event_sequence'],'prior_event_sha256'=>$event['prior_event_sha256'],'event_type'=>$event['event_type'],'resulting_state'=>$event['resulting_state'],'reason_code'=>$event['reason_code'],
 'checklist_sha256'=>$event['checklist_sha256'],'review_sha256'=>$event['review_sha256'],'approval_sha256'=>$event['approval_sha256'],'transition_evidence_sha256'=>$event['transition_evidence_sha256'],'event_sha256'=>$event['event_sha256'],'acted_by'=>$event['acted_by']));}
function pay_rec_001_close_state_runtime_response(array $row,$replayed=false){$row['replayed']=$replayed;$row['development_close_evidence_recorded']=true;$row['production_close_authorized']=false;$row['payroll_state_mutation_authorized']=false;$row['historical_mutation_authorized']=false;return $row;}
function pay_rec_001_close_state_runtime_latest(array $scope,$for_update=true){$sql='SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_state_events WHERE company_id='.(int)$scope['company_id'].' AND pay_core_run_id='.(int)$scope['pay_core_run_id'].' AND filing_obligation_id='.(int)$scope['filing_obligation_id'].' ORDER BY event_sequence DESC LIMIT 1'.($for_update?' FOR UPDATE':'');$q=db_query($sql);if(!$q||db_num_rows($q)>1)return false;return db_num_rows($q)===1?db_fetch_assoc($q):array();}
function pay_rec_001_close_state_runtime_scope_from_profile(array $profile){return array('company_id'=>(int)$profile['company_id'],'legal_entity_id'=>(int)$profile['legal_entity_id'],'payroll_period_id'=>(int)$profile['payroll_period_id'],'pay_core_run_id'=>(int)$profile['pay_core_run_id'],'filing_obligation_id'=>(int)$profile['filing_obligation_id']);}
function pay_rec_001_close_state_runtime_bindings(array $profile,array $checklist,array $review,array $approval,$transition_evidence_sha256){return array('reconciliation_profile_id'=>(int)$profile['reconciliation_profile_id'],'close_checklist_id'=>(int)$checklist['close_checklist_id'],'reconciliation_review_id'=>(int)$review['reconciliation_review_id'],'reconciliation_approval_id'=>(int)$approval['reconciliation_approval_id'],'checklist_sha256'=>(string)$checklist['checklist_sha256'],'review_sha256'=>(string)$review['review_sha256'],'approval_sha256'=>(string)$approval['approval_sha256'],'transition_evidence_sha256'=>(string)$transition_evidence_sha256);}
function pay_rec_001_close_state_runtime_verify_event(array $row,&$error=null){$scope=array('company_id'=>(int)$row['company_id'],'legal_entity_id'=>(int)$row['legal_entity_id'],'payroll_period_id'=>(int)$row['payroll_period_id'],'pay_core_run_id'=>(int)$row['pay_core_run_id'],'filing_obligation_id'=>(int)$row['filing_obligation_id']);$bindings=array('reconciliation_profile_id'=>(int)$row['reconciliation_profile_id'],'close_checklist_id'=>(int)$row['close_checklist_id'],'reconciliation_review_id'=>(int)$row['reconciliation_review_id'],'reconciliation_approval_id'=>(int)$row['reconciliation_approval_id'],'checklist_sha256'=>(string)$row['checklist_sha256'],'review_sha256'=>(string)$row['review_sha256'],'approval_sha256'=>(string)$row['approval_sha256'],'transition_evidence_sha256'=>(string)$row['transition_evidence_sha256']);$descriptor=pay_rec_001_close_state_event_descriptor($scope,(int)$row['event_sequence'],(string)$row['prior_event_sha256'],(string)$row['event_type'],(string)$row['reason_code'],$bindings,(int)$row['acted_by'],$error);return $descriptor!==false&&pay_rec_001_close_state_runtime_event_matches($row,$descriptor)?$descriptor:pay_rec_001_runtime_fail($error,$error?:'reconciliation_state_event_hash_mismatch');}
function pay_rec_001_close_state_runtime_load_approved_basis($approval_id,&$error=null)
{
    $approval=pay_rec_001_runtime_one('SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_approvals WHERE reconciliation_approval_id='.(int)$approval_id.' LIMIT 2 FOR UPDATE');if(!$approval||(string)$approval['decision']!=='approved')return pay_rec_001_runtime_fail($error,'reconciliation_approved_basis_missing');
    $review=pay_rec_001_runtime_one('SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_reviews WHERE reconciliation_review_id='.(int)$approval['reconciliation_review_id'].' LIMIT 2 FOR UPDATE');if(!$review||(string)$review['decision']!=='approved'||(int)$review['close_checklist_id']!==(int)$approval['close_checklist_id']||!hash_equals((string)$review['review_sha256'],(string)$approval['review_sha256']))return pay_rec_001_runtime_fail($error,'reconciliation_approved_review_binding_invalid');
    $checklist=pay_rec_001_runtime_one('SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_checklists WHERE close_checklist_id='.(int)$approval['close_checklist_id'].' LIMIT 2 FOR UPDATE');if(!$checklist||!hash_equals((string)$checklist['checklist_sha256'],(string)$review['checklist_sha256'])||!hash_equals((string)$checklist['readiness_sha256'],(string)$review['readiness_sha256']))return pay_rec_001_runtime_fail($error,'reconciliation_approved_checklist_binding_invalid');
    $profile=pay_rec_001_runtime_one('SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_profiles WHERE reconciliation_profile_id='.(int)$checklist['reconciliation_profile_id'].' LIMIT 2 FOR UPDATE');if(!$profile)return pay_rec_001_runtime_fail($error,'reconciliation_approved_profile_missing');
    $review_check=pay_rec_001_review_descriptor((int)$review['close_checklist_id'],(string)$review['checklist_sha256'],(string)$review['readiness_sha256'],(int)$checklist['prepared_by'],(int)$review['reviewed_by'],(string)$review['decision'],(string)$review['review_evidence_sha256'],$review_error);if($review_check===false||!pay_rec_001_runtime_review_matches($review,$review_check))return pay_rec_001_runtime_fail($error,$review_error?:'reconciliation_review_hash_mismatch');
    $approval_check=pay_rec_001_approval_descriptor((int)$approval['reconciliation_review_id'],(int)$approval['close_checklist_id'],(string)$approval['review_sha256'],(int)$checklist['prepared_by'],(int)$review['reviewed_by'],(int)$approval['approved_by'],(string)$approval['decision'],(string)$approval['assurance_evidence_sha256'],$approval_error);if($approval_check===false||!pay_rec_001_runtime_approval_matches($approval,$approval_check))return pay_rec_001_runtime_fail($error,$approval_error?:'reconciliation_approval_hash_mismatch');
    return array('profile'=>$profile,'checklist'=>$checklist,'review'=>$review,'approval'=>$approval);
}
function pay_rec_001_close_state_runtime_lock_run($run_id,&$error=null){$q=db_query('SELECT run_id FROM '.TB_PREF.'hrm_pay_core_009_runs WHERE run_id='.(int)$run_id.' LIMIT 2 FOR UPDATE');return $q&&db_num_rows($q)===1?true:pay_rec_001_runtime_fail($error,'reconciliation_pay_run_lock_failed');}
function pay_rec_001_close_state_runtime_insert(array $event,&$error=null){$at=pay_rec_001_runtime_now();$cols=array('reconciliation_profile_id','close_checklist_id','reconciliation_review_id','reconciliation_approval_id','company_id','legal_entity_id','payroll_period_id','pay_core_run_id','filing_obligation_id','event_sequence','prior_event_sha256','event_type','resulting_state','reason_code','checklist_sha256','review_sha256','approval_sha256','transition_evidence_sha256','event_sha256','acted_by');$values=array();foreach($cols as $c)$values[]=$event[$c];$values[]=$at;$values[]=$at;$sql='INSERT INTO '.TB_PREF.'hrm_pay_rec_001_state_events ('.implode(',',$cols).',acted_at,created_at) VALUES ('.implode(',',array_map('db_escape',$values)).')';if(!db_query($sql))return pay_rec_001_runtime_fail($error,'reconciliation_state_event_insert_failed');$event['reconciliation_state_event_id']=(int)db_insert_id();$event['acted_at']=$at;$event['created_at']=$at;return $event;}

/** Append a serialized, freshly revalidated development-close evidence event. No production close or source-state mutation occurs. */
function pay_rec_001_append_development_close($reconciliation_approval_id,array $filing_completion,$transition_evidence_sha256,&$error=null)
{
    $error=null;if(!pay_rec_001_close_state_runtime_ready($error)||!pay_rec_001_runtime_require_access(PAY_REC_001_CLOSE_PERMISSION,$error)||!pay_rec_001_sha($transition_evidence_sha256))return false;$actor=pay_rec_001_runtime_actor();if($actor<=0)return pay_rec_001_runtime_fail($error,'reconciliation_close_actor_invalid');
    begin_transaction();$basis=pay_rec_001_close_state_runtime_load_approved_basis($reconciliation_approval_id,$error);if($basis===false){cancel_transaction();return false;}$profile=$basis['profile'];$checklist=$basis['checklist'];$review=$basis['review'];$approval=$basis['approval'];$scope=pay_rec_001_close_state_runtime_scope_from_profile($profile);
    if(!pay_rec_001_runtime_scope_company($scope['company_id'],$error)||!pay_rec_001_close_state_runtime_lock_run($scope['pay_core_run_id'],$error)){cancel_transaction();return false;}if($actor===(int)$approval['approved_by']){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_closer_cannot_be_approver');}
    $validated=pay_rec_001_runtime_revalidate_checklist((int)$checklist['close_checklist_id'],$filing_completion,$error);if($validated===false){cancel_transaction();return false;}
    $latest=pay_rec_001_close_state_runtime_latest($scope,true);if($latest===false){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_state_lookup_failed');}
    $prior_state=null;$sequence=1;$prior_sha=str_repeat('0',64);if(count($latest)){$verified=pay_rec_001_close_state_runtime_verify_event($latest,$error);if($verified===false){cancel_transaction();return false;}$prior_state=(string)$latest['resulting_state'];$sequence=(int)$latest['event_sequence']+1;$prior_sha=(string)$latest['event_sha256'];if($prior_state==='DEVELOPMENT_CLOSED'){$same=pay_rec_001_close_state_event_descriptor($scope,(int)$latest['event_sequence'],(string)$latest['prior_event_sha256'],'development_close','approved_reconciliation',pay_rec_001_close_state_runtime_bindings($profile,$checklist,$review,$approval,$transition_evidence_sha256),$actor,$same_error);if($same!==false&&pay_rec_001_close_state_runtime_event_matches($latest,$same)){commit_transaction();return pay_rec_001_close_state_runtime_response($latest,true);}cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_already_development_closed');}if((int)$latest['reconciliation_approval_id']===(int)$approval['reconciliation_approval_id']){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_reclose_requires_new_approval');}}
    if(!pay_rec_001_close_state_transition_allowed($prior_state,'development_close')){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_close_transition_denied');}
    $event=pay_rec_001_close_state_event_descriptor($scope,$sequence,$prior_sha,'development_close','approved_reconciliation',pay_rec_001_close_state_runtime_bindings($profile,$checklist,$review,$approval,$transition_evidence_sha256),$actor,$error);if($event===false){cancel_transaction();return false;}$inserted=pay_rec_001_close_state_runtime_insert($event,$error);if($inserted===false){$race=pay_rec_001_close_state_runtime_latest($scope,true);if($race&&pay_rec_001_close_state_runtime_event_matches($race,$event)){commit_transaction();return pay_rec_001_close_state_runtime_response($race,true);}cancel_transaction();return false;}commit_transaction();return pay_rec_001_close_state_runtime_response($inserted,false);
}

/** Append a serialized recovery marker from the current development-closed event; all predecessor custody remains immutable. */
function pay_rec_001_append_recovery_event($reconciliation_state_event_id,$event_type,$reason_code,$transition_evidence_sha256,&$error=null)
{
    $error=null;if(!pay_rec_001_close_state_runtime_ready($error)||!pay_rec_001_runtime_require_access(PAY_REC_001_RECOVER_PERMISSION,$error)||!in_array($event_type,array('reopen_for_correction','mark_reversal_required'),true)||!pay_rec_001_sha($transition_evidence_sha256))return false;$actor=pay_rec_001_runtime_actor();if($actor<=0)return pay_rec_001_runtime_fail($error,'reconciliation_recovery_actor_invalid');
    begin_transaction();$target=pay_rec_001_runtime_one('SELECT * FROM '.TB_PREF.'hrm_pay_rec_001_state_events WHERE reconciliation_state_event_id='.(int)$reconciliation_state_event_id.' LIMIT 2 FOR UPDATE');if(!$target||pay_rec_001_close_state_runtime_verify_event($target,$error)===false){cancel_transaction();return pay_rec_001_runtime_fail($error,$error?:'reconciliation_recovery_target_invalid');}$scope=array('company_id'=>(int)$target['company_id'],'legal_entity_id'=>(int)$target['legal_entity_id'],'payroll_period_id'=>(int)$target['payroll_period_id'],'pay_core_run_id'=>(int)$target['pay_core_run_id'],'filing_obligation_id'=>(int)$target['filing_obligation_id']);if(!pay_rec_001_runtime_scope_company($scope['company_id'],$error)||!pay_rec_001_close_state_runtime_lock_run($scope['pay_core_run_id'],$error)){cancel_transaction();return false;}
    $latest=pay_rec_001_close_state_runtime_latest($scope,true);if($latest===false||!count($latest)){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_state_lookup_failed');}$bindings=array('reconciliation_profile_id'=>(int)$target['reconciliation_profile_id'],'close_checklist_id'=>(int)$target['close_checklist_id'],'reconciliation_review_id'=>(int)$target['reconciliation_review_id'],'reconciliation_approval_id'=>(int)$target['reconciliation_approval_id'],'checklist_sha256'=>(string)$target['checklist_sha256'],'review_sha256'=>(string)$target['review_sha256'],'approval_sha256'=>(string)$target['approval_sha256'],'transition_evidence_sha256'=>(string)$transition_evidence_sha256);
    $candidate=pay_rec_001_close_state_event_descriptor($scope,(int)$target['event_sequence']+1,(string)$target['event_sha256'],$event_type,$reason_code,$bindings,$actor,$error);if($candidate===false){cancel_transaction();return false;}
    if((int)$latest['reconciliation_state_event_id']!==(int)$target['reconciliation_state_event_id']){if(pay_rec_001_close_state_runtime_event_matches($latest,$candidate)){commit_transaction();return pay_rec_001_close_state_runtime_response($latest,true);}cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_recovery_target_not_current');}
    if((string)$target['resulting_state']!=='DEVELOPMENT_CLOSED'||!pay_rec_001_close_state_transition_allowed((string)$target['resulting_state'],$event_type)){cancel_transaction();return pay_rec_001_runtime_fail($error,'reconciliation_recovery_transition_denied');}
    $inserted=pay_rec_001_close_state_runtime_insert($candidate,$error);if($inserted===false){$race=pay_rec_001_close_state_runtime_latest($scope,true);if($race&&pay_rec_001_close_state_runtime_event_matches($race,$candidate)){commit_transaction();return pay_rec_001_close_state_runtime_response($race,true);}cancel_transaction();return false;}commit_transaction();return pay_rec_001_close_state_runtime_response($inserted,false);
}
?>
