function pay_pmt_001_trigger_code($t){$m=array('hrm_pay_pmt_001_payment_intents'=>'pi','hrm_pay_pmt_001_payment_items'=>'it','hrm_pay_pmt_001_item_allocations'=>'al','hrm_pay_pmt_001_batches'=>'ba','hrm_pay_pmt_001_batch_items'=>'bi');return isset($m[$t])?$m[$t]:false;}
function pay_pmt_001_table_columns($t){if(!hrm_migration_table_exists($t))return false;$q=db_query('SHOW COLUMNS FROM '.TB_PREF.$t);if(!$q)return false;$a=array();while($r=db_fetch_assoc($q))$a[]=(string)$r['Field'];return $a;}
function pay_pmt_001_table_innodb($t){$p=hrm_migration_physical_table_name($t);if($p===false)return false;$q=db_query('SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='.db_escape($p));$r=$q?db_fetch_assoc($q):false;return $r&&strcasecmp((string)$r['ENGINE'],'InnoDB')===0;}
