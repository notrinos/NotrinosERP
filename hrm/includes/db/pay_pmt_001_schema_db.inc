function pay_pmt_001_trigger_valid($t,$op){$name=pay_pmt_001_trigger_name($t,$op);$phys=hrm_migration_physical_table_name($t);if($name===false||$phys===false)return false;$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);return strtoupper((string)$r['EVENT_MANIPULATION'])===strtoupper($op)&&(string)$r['EVENT_OBJECT_TABLE']===$phys&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&strpos((string)$r['ACTION_STATEMENT'],'PAY-PMT-001 immutable')!==false;}
function pay_pmt_001_require_schema($patch){$cols=pay_pmt_001_schema_columns();$ix=pay_pmt_001_schema_indexes();foreach(pay_pmt_001_schema_tables() as $t){if(pay_pmt_001_table_columns($t)!==$cols[$t]||!pay_pmt_001_table_innodb($t))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-PMT-001 table projection mismatch: '.$t);$actual=hrm_migration_index_names($t);if(!is_array($actual))return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-PMT-001 index metadata unavailable: '.$t);$got=array_keys($actual);$want=$ix[$t];sort($got,SORT_STRING);sort($want,SORT_STRING);if($got!==$want)return hrm_migration_fail($patch,HRM_MIGRATION_INDEX_MISMATCH,'PAY-PMT-001 exact index projection mismatch: '.$t);foreach(array('UPDATE','DELETE') as $op)if(!pay_pmt_001_trigger_valid($t,$op))return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-PMT-001 immutable trigger mismatch: '.$t.'.'.$op);}return true;}
function pay_pmt_001_install_schema($patch){global $path_to_root;$raw=@file_get_contents($path_to_root.'/sql/upgrade_pay_pmt_001_custody_schema.sql');if(!is_string($raw)||strpos($raw,'-- PAY-PMT-001 GROUP payment_custody')===false)return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'PAY-PMT-001 schema source missing.');$p=hrm_migration_active_table_prefix();if($p===false)return false;$raw=preg_replace('/^--.*$/m','',$raw);$stmts=preg_split('/;\s*(?:\r?\n|$)/',$raw);foreach($stmts as $s){$s=trim($s);if($s===''||strpos($s,'CREATE TRIGGER')===0)continue;$s=str_replace('`0_','`'.$p,$s);if(!db_query($s))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'PAY-PMT-001 schema statement failed.');}foreach(pay_pmt_001_schema_tables() as $t)foreach(array('UPDATE','DELETE') as $op){if(pay_pmt_001_trigger_valid($t,$op))continue;$name=pay_pmt_001_trigger_name($t,$op);$phys=hrm_migration_physical_table_name($t);$msg='PAY-PMT-001 immutable '.$t.' row cannot be '.strtolower($op).'d';$sql='CREATE TRIGGER `'.$name.'` BEFORE '.$op.' ON `'.$phys.'` FOR EACH ROW SIGNAL SQLSTATE \'45000\' SET MESSAGE_TEXT='.db_escape($msg);if(!db_query($sql))return false;}return pay_pmt_001_require_schema($patch);}
