/** PAY-CORE-002 payroll relationship/enrollment writers and explicit migration custody. */
include_once(dirname(__FILE__).'/pay_core_002_governance_db.inc');
function hrm_pay_core_002_create_relationship(array $x,&$error=null){$error=null;$actor=hrm_pay_core_002_actor();if($actor<=0||!hrm_pay_core_002_access('SA_HRM_EXECUTE_PAY_CORE')||!hrm_pay_core_002_relationship_contract($x)){$error='access_or_contract_invalid';return false;}$key=hrm_pay_core_002_relationship_key($x['worker_id'],$x['employment_id'],$x['legal_entity_id']);$to=$x['effective_to']??null;$eq=db_query('SELECT worker_id,legal_entity_id,start_date,end_date FROM '.TB_PREF.'hrm_employments WHERE employment_id='.(int)$x['employment_id'].' LIMIT 2');$e=$eq&&db_num_rows($eq)===1?db_fetch_assoc($eq):false;if(!$e||(int)$e['worker_id']!==(int)$x['worker_id']||(int)$e['legal_entity_id']!==(int)$x['legal_entity_id']||(!empty($e['start_date'])&&$x['effective_from']<$e['start_date'])||(!empty($e['end_date'])&&($to===null||$to===''||$to>$e['end_date']))){$error='employment_authority_mismatch';return false;}$q=db_query('SELECT payroll_relationship_id,effective_from,effective_to FROM '.TB_PREF.'hrm_payroll_relationships WHERE worker_id='.(int)$x['worker_id'].' AND employment_id='.(int)$x['employment_id'].' AND legal_entity_id='.(int)$x['legal_entity_id'].' ORDER BY payroll_relationship_id FOR UPDATE');while($q&&($r=db_fetch_assoc($q))){if(hrm_pay_core_002_intervals_overlap($x['effective_from'],$to,$r['effective_from'],$r['effective_to'])){$error='overlapping_relationship';return false;}}$h=hrm_pay_core_002_hash(array('relationship_key'=>$key,'effective_from'=>$x['effective_from'],'effective_to'=>$to));if(!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_relationships (worker_id,employment_id,legal_entity_id,relationship_key,effective_from,effective_to,relationship_sha256,created_by) VALUES ('.(int)$x['worker_id'].','.(int)$x['employment_id'].','.(int)$x['legal_entity_id'].','.db_escape($key).','.db_escape($x['effective_from']).','.($to?db_escape($to):'NULL').','.db_escape($h).','.$actor.')')){$error='relationship_insert_failed';return false;}return (int)db_insert_id();}
function hrm_pay_core_002_add_relationship_member($relationship_id,$assignment_id,$from,$to=null,&$error=null){$error=null;$actor=hrm_pay_core_002_actor();if($actor<=0||!hrm_pay_core_002_access('SA_HRM_EXECUTE_PAY_CORE')||(int)$relationship_id<=0||(int)$assignment_id<=0||!hrm_pay_core_002_interval_valid($from,$to)){$error='invalid_member';return false;}$aq=db_query('SELECT r.employment_id,r.effective_from relationship_from,r.effective_to relationship_to,a.employment_id assignment_employment_id,a.effective_from assignment_from,a.effective_to assignment_to FROM '.TB_PREF.'hrm_payroll_relationships r INNER JOIN '.TB_PREF.'hrm_assignments a ON a.assignment_id='.(int)$assignment_id.' WHERE r.payroll_relationship_id='.(int)$relationship_id.' LIMIT 2');$a=$aq&&db_num_rows($aq)===1?db_fetch_assoc($aq):false;if(!$a||(int)$a['employment_id']!==(int)$a['assignment_employment_id']||$from<$a['relationship_from']||(!empty($a['relationship_to'])&&($to===null||$to===''||$to>$a['relationship_to']))||(!empty($a['assignment_from'])&&$from<$a['assignment_from'])||(!empty($a['assignment_to'])&&($to===null||$to===''||$to>$a['assignment_to']))){$error='assignment_authority_mismatch';return false;}$q=db_query('SELECT relationship_member_id,effective_from,effective_to FROM '.TB_PREF.'hrm_payroll_relationship_members WHERE payroll_relationship_id='.(int)$relationship_id.' AND assignment_id='.(int)$assignment_id.' FOR UPDATE');while($q&&($r=db_fetch_assoc($q)))if(hrm_pay_core_002_intervals_overlap($from,$to,$r['effective_from'],$r['effective_to'])){$error='overlapping_assignment_membership';return false;}$h=hrm_pay_core_002_hash(array('payroll_relationship_id'=>(int)$relationship_id,'assignment_id'=>(int)$assignment_id,'effective_from'=>$from,'effective_to'=>$to));if(!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_relationship_members (payroll_relationship_id,assignment_id,effective_from,effective_to,member_sha256,created_by) VALUES ('.(int)$relationship_id.','.(int)$assignment_id.','.db_escape($from).','.($to?db_escape($to):'NULL').','.db_escape($h).','.$actor.')')){$error='member_insert_failed';return false;}return (int)db_insert_id();}
function hrm_pay_core_002_enroll_group($relationship_id,$group_version_id,$from,$to=null,&$error=null){$error=null;$actor=hrm_pay_core_002_actor();if($actor<=0||!hrm_pay_core_002_access('SA_HRM_EXECUTE_PAY_CORE')||!hrm_pay_core_002_interval_valid($from,$to)){$error='invalid_enrollment';return false;}$q=db_query('SELECT r.legal_entity_id relationship_legal_entity_id,r.effective_from relationship_from,r.effective_to relationship_to,g.legal_entity_id group_legal_entity_id,gv.effective_from group_from,gv.effective_to group_to FROM '.TB_PREF.'hrm_payroll_relationships r INNER JOIN '.TB_PREF.'hrm_payroll_group_versions gv ON gv.group_version_id='.(int)$group_version_id.' INNER JOIN '.TB_PREF.'hrm_payroll_groups g ON g.payroll_group_id=gv.payroll_group_id WHERE r.payroll_relationship_id='.(int)$relationship_id.' LIMIT 2');$c=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$c||(int)$c['relationship_legal_entity_id']!==(int)$c['group_legal_entity_id']){$error='legal_entity_mismatch';return false;}if($from<$c['relationship_from']||(!empty($c['relationship_to'])&&($to===null||$to===''||$to>$c['relationship_to']))||$from<$c['group_from']||(!empty($c['group_to'])&&($to===null||$to===''||$to>$c['group_to']))){$error='enrollment_interval_outside_authority';return false;}$q=db_query('SELECT effective_from,effective_to FROM '.TB_PREF.'hrm_payroll_group_enrollments WHERE payroll_relationship_id='.(int)$relationship_id.' FOR UPDATE');while($q&&($e=db_fetch_assoc($q)))if(hrm_pay_core_002_intervals_overlap($from,$to,$e['effective_from'],$e['effective_to'])){$error='overlapping_enrollment';return false;}$h=hrm_pay_core_002_hash(array('payroll_relationship_id'=>(int)$relationship_id,'group_version_id'=>(int)$group_version_id,'effective_from'=>$from,'effective_to'=>$to));if(!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_group_enrollments (payroll_relationship_id,group_version_id,effective_from,effective_to,enrollment_sha256,created_by) VALUES ('.(int)$relationship_id.','.(int)$group_version_id.','.db_escape($from).','.($to?db_escape($to):'NULL').','.db_escape($h).','.$actor.')')){$error='enrollment_insert_failed';return false;}return (int)db_insert_id();}
function hrm_pay_core_002_propose_relationship_migration(array $x,&$error=null){$error=null;$maker=hrm_pay_core_002_actor();foreach(array('worker_id','employment_id','assignment_id','legal_entity_id','group_version_id','effective_from') as $k)if(!array_key_exists($k,$x)){$error='migration_plan_incomplete';return false;}if($maker<=0||!hrm_pay_core_002_access('SA_HRM_MANAGE_PAY_CORE')||(int)$x['assignment_id']<=0||(int)$x['group_version_id']<=0||!hrm_pay_core_002_relationship_contract($x)){$error='migration_plan_invalid';return false;}$sq=db_query('SELECT w.worker_id,w.worker_status,e.employment_id,e.worker_id employment_worker_id,e.legal_entity_id,e.start_date,e.end_date,e.employment_status,a.assignment_id,a.employment_id assignment_employment_id,a.effective_from assignment_from,a.effective_to assignment_to,a.primary_flag,a.assignment_type_code FROM '.TB_PREF.'hrm_workers w INNER JOIN '.TB_PREF.'hrm_employments e ON e.worker_id=w.worker_id INNER JOIN '.TB_PREF.'hrm_assignments a ON a.employment_id=e.employment_id WHERE w.worker_id='.(int)$x['worker_id'].' AND e.employment_id='.(int)$x['employment_id'].' AND a.assignment_id='.(int)$x['assignment_id'].' LIMIT 2');$src=$sq&&db_num_rows($sq)===1?db_fetch_assoc($sq):false;if(!$src||(int)$src['employment_worker_id']!==(int)$x['worker_id']||(int)$src['assignment_employment_id']!==(int)$x['employment_id']||(int)$src['legal_entity_id']!==(int)$x['legal_entity_id']){$error='normalized_source_mismatch';return false;}$source_sha=hrm_pay_core_002_hash($src);$payload=array('worker_id'=>(int)$x['worker_id'],'employment_id'=>(int)$x['employment_id'],'assignment_id'=>(int)$x['assignment_id'],'legal_entity_id'=>(int)$x['legal_entity_id'],'group_version_id'=>(int)$x['group_version_id'],'effective_from'=>$x['effective_from'],'effective_to'=>$x['effective_to']??null,'source_identity_sha256'=>$source_sha,'maker_id'=>$maker);$h=hrm_pay_core_002_hash($payload);$sql='INSERT INTO '.TB_PREF.'hrm_payroll_relationship_migration_plans (worker_id,employment_id,assignment_id,legal_entity_id,group_version_id,effective_from,effective_to,source_identity_sha256,relationship_plan_sha256,maker_id) VALUES ('.(int)$x['worker_id'].','.(int)$x['employment_id'].','.(int)$x['assignment_id'].','.(int)$x['legal_entity_id'].','.(int)$x['group_version_id'].','.db_escape($x['effective_from']).','.(!empty($x['effective_to'])?db_escape($x['effective_to']):'NULL').','.db_escape($source_sha).','.db_escape($h).','.$maker.')';return hrm_pay_core_002_insert_idempotent('hrm_payroll_relationship_migration_plans','relationship_plan_sha256',$h,$sql,'relationship_plan_id',$error);}
function hrm_pay_core_002_approve_relationship_migration($plan_id,$evidence_sha256,&$error=null){$error=null;$checker=hrm_pay_core_002_actor();$evidence_sha256=hrm_pay_core_002_sha($evidence_sha256);if($checker<=0||!hrm_pay_core_002_access('SA_HRM_REVIEW_PAY_CORE')||$evidence_sha256===false){$error='access_or_evidence_invalid';return false;}$q=db_query('SELECT relationship_plan_sha256,maker_id FROM '.TB_PREF.'hrm_payroll_relationship_migration_plans WHERE relationship_plan_id='.(int)$plan_id.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||(int)$p['maker_id']===$checker){$error='distinct_checker_required';return false;}$h=hrm_pay_core_002_hash(array('relationship_plan_id'=>(int)$plan_id,'relationship_plan_sha256'=>$p['relationship_plan_sha256'],'evidence_sha256'=>$evidence_sha256,'checker_id'=>$checker));$sql='INSERT INTO '.TB_PREF.'hrm_payroll_relationship_migration_approvals (relationship_plan_id,relationship_plan_sha256,evidence_sha256,approval_sha256,checker_id) VALUES ('.(int)$plan_id.','.db_escape($p['relationship_plan_sha256']).','.db_escape($evidence_sha256).','.db_escape($h).','.$checker.')';return hrm_pay_core_002_insert_idempotent('hrm_payroll_relationship_migration_approvals','approval_sha256',$h,$sql,'relationship_approval_id',$error);}
function hrm_pay_core_002_execute_relationship_migration($plan_id,&$error=null){$error=null;$executor=hrm_pay_core_002_actor();if($executor<=0||!hrm_pay_core_002_access('SA_HRM_EXECUTE_PAY_CORE')){$error='access_denied';return false;}$q=db_query('SELECT p.*,a.relationship_approval_id,a.approval_sha256,a.checker_id FROM '.TB_PREF.'hrm_payroll_relationship_migration_plans p INNER JOIN '.TB_PREF.'hrm_payroll_relationship_migration_approvals a ON a.relationship_plan_id=p.relationship_plan_id AND a.relationship_plan_sha256=p.relationship_plan_sha256 WHERE p.relationship_plan_id='.(int)$plan_id.' LIMIT 2 FOR UPDATE');$p=$q&&db_num_rows($q)===1?db_fetch_assoc($q):false;if(!$p||$executor===(int)$p['maker_id']||$executor===(int)$p['checker_id']){$error='three_party_separation_required';return false;}$q=db_query('SELECT relationship_receipt_id,executor_id FROM '.TB_PREF.'hrm_payroll_relationship_migration_receipts WHERE relationship_plan_id='.(int)$plan_id.' LIMIT 2 FOR UPDATE');if($q&&db_num_rows($q)===1){$x=db_fetch_assoc($q);if((int)$x['executor_id']!==$executor){$error='replay_executor_mismatch';return false;}return (int)$x['relationship_receipt_id'];}
    $sq=db_query('SELECT w.worker_id,w.worker_status,e.employment_id,e.worker_id employment_worker_id,e.legal_entity_id,e.start_date,e.end_date,e.employment_status,a.assignment_id,a.employment_id assignment_employment_id,a.effective_from assignment_from,a.effective_to assignment_to,a.primary_flag,a.assignment_type_code FROM '.TB_PREF.'hrm_workers w INNER JOIN '.TB_PREF.'hrm_employments e ON e.worker_id=w.worker_id INNER JOIN '.TB_PREF.'hrm_assignments a ON a.employment_id=e.employment_id WHERE w.worker_id='.(int)$p['worker_id'].' AND e.employment_id='.(int)$p['employment_id'].' AND a.assignment_id='.(int)$p['assignment_id'].' LIMIT 2 FOR UPDATE');$src=$sq&&db_num_rows($sq)===1?db_fetch_assoc($sq):false;if(!$src||!hash_equals((string)$p['source_identity_sha256'],hrm_pay_core_002_hash($src))){$error='normalized_source_changed';return false;}
    $manage=empty($GLOBALS['transaction_level']);if($manage)begin_transaction();$rel=hrm_pay_core_002_create_relationship(array('worker_id'=>(int)$p['worker_id'],'employment_id'=>(int)$p['employment_id'],'legal_entity_id'=>(int)$p['legal_entity_id'],'effective_from'=>$p['effective_from'],'effective_to'=>$p['effective_to']),$error);$mem=$rel?hrm_pay_core_002_add_relationship_member($rel,(int)$p['assignment_id'],$p['effective_from'],$p['effective_to'],$error):false;$enr=$mem?hrm_pay_core_002_enroll_group($rel,(int)$p['group_version_id'],$p['effective_from'],$p['effective_to'],$error):false;$ok=$rel&&$mem&&$enr;$h=$ok?hrm_pay_core_002_hash(array('relationship_plan_sha256'=>$p['relationship_plan_sha256'],'approval_sha256'=>$p['approval_sha256'],'payroll_relationship_id'=>$rel,'relationship_member_id'=>$mem,'enrollment_id'=>$enr,'executor_id'=>$executor)):false;if($ok&&!db_query('INSERT INTO '.TB_PREF.'hrm_payroll_relationship_migration_receipts (relationship_plan_id,relationship_approval_id,payroll_relationship_id,relationship_member_id,enrollment_id,receipt_sha256,executor_id) VALUES ('.(int)$plan_id.','.(int)$p['relationship_approval_id'].','.$rel.','.$mem.','.$enr.','.db_escape($h).','.$executor.')'))$ok=false;$id=(int)db_insert_id();if($manage){if($ok)commit_transaction();else cancel_transaction();}if(!$ok){if(!$error)$error='relationship_migration_failed';return false;}return $id;}
