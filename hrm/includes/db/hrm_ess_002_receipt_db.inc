<?php
/** Immutable ESS-002 orchestration replay receipts. Domain state remains owned upstream. */
include_once($path_to_root.'/hrm/includes/hrm_ess_002_contract.inc');
function hrm_ess_002_receipt_material($command,array $context,array $payload,$nonce){$command=hrm_ess_002_token($command,32);if($command===false||!hrm_ess_002_action_nonce_format_valid($nonce)||empty($context['worker_id'])||empty($context['assignment_id'])||empty($context['legal_entity_id'])||hrm_ess_002_actor_id()<=0)return false;ksort($payload,SORT_STRING);$json=json_encode($payload,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE);if(!is_string($json))return false;return array('command_type'=>$command,'idempotency_hash'=>hash('sha256','ess2|'.hrm_ess_002_actor_id().'|'.$context['worker_id'].'|'.$command.'|'.$nonce),'payload_sha256'=>hash('sha256',$json));}
function hrm_ess_002_receipt_replay(array $m,&$error=null){$q=db_query('SELECT payload_sha256,result_json FROM '.TB_PREF.'hrm_ess_002_command_receipts WHERE idempotency_hash='.db_escape($m['idempotency_hash']).' LIMIT 2 FOR UPDATE');if(!$q||db_num_rows($q)>1){$error='idempotency_state_invalid';return false;}if(db_num_rows($q)===0)return null;$row=db_fetch_assoc($q);if(!hash_equals((string)$row['payload_sha256'],(string)$m['payload_sha256'])){$error='idempotency_replay_mismatch';return false;}$out=json_decode((string)$row['result_json'],true);if(!is_array($out)){$error='idempotency_receipt_invalid';return false;}return $out;}
function hrm_ess_002_receipt_record(array $m,array $context,array $result,&$error=null){$j=json_encode($result,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE);if(!is_string($j)||strlen($j)>65535){$error='idempotency_result_invalid';return false;}$sql='INSERT INTO '.TB_PREF.'hrm_ess_002_command_receipts (actor_user_id,worker_id,assignment_id,legal_entity_id,command_type,idempotency_hash,payload_sha256,result_json,created_at) VALUES ('.hrm_ess_002_actor_id().','.(int)$context['worker_id'].','.(int)$context['assignment_id'].','.(int)$context['legal_entity_id'].','.db_escape($m['command_type']).','.db_escape($m['idempotency_hash']).','.db_escape($m['payload_sha256']).','.db_escape($j).',NOW())';if(!db_query($sql)){$error='idempotency_receipt_insert_failed';return false;}return true;}
?>
