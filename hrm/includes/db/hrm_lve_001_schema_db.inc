function hrm_lve_001_table_columns($table){if(!hrm_migration_table_exists($table))return false;$q=db_query('SHOW COLUMNS FROM '.TB_PREF.$table);if(!$q)return false;$o=array();while($r=db_fetch_assoc($q))$o[]=(string)$r['Field'];return $o;}
function hrm_lve_001_trigger_name($code,$op){$p=hrm_migration_active_table_prefix();if($p===false)return false;return $p.'lve1_'.$code.'_'.(strtoupper($op)==='UPDATE'?'u':'d');}
function hrm_lve_001_trigger_exists($table,$code,$op){$physical=hrm_migration_physical_table_name($table);$name=hrm_lve_001_trigger_name($code,$op);if($physical===false||$name===false)return false;$q=db_query('SELECT EVENT_MANIPULATION,EVENT_OBJECT_TABLE,ACTION_TIMING,ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME='.db_escape($name).' LIMIT 2');if(!$q||db_num_rows($q)!==1)return false;$r=db_fetch_assoc($q);$stmt=(string)($r['ACTION_STATEMENT']??'');return strtoupper((string)$r['EVENT_MANIPULATION'])===strtoupper($op)&&(string)$r['EVENT_OBJECT_TABLE']===$physical&&strtoupper((string)$r['ACTION_TIMING'])==='BEFORE'&&strpos($stmt,"SIGNAL SQLSTATE '45000'")!==false&&strpos($stmt,'HRM-LVE-001 immutable custody denies')!==false;}
