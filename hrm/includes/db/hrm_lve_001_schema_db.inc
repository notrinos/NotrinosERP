function hrm_lve_001_install_schema($patch){global $path_to_root;$present=0;foreach(hrm_lve_001_schema_columns() as $t=>$x)if(hrm_migration_table_exists($t))$present++;if($present===count(hrm_lve_001_schema_columns()))return hrm_lve_001_require_schema($patch,true);if($present!==0)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-LVE-001 schema is partially installed; forward recovery required.');$src=@file_get_contents($path_to_root.'/sql/upgrade_hrm_lve_001_schema.sql');if(!is_string($src)||$src==='')return hrm_migration_fail($patch,HRM_MIGRATION_TAMPER_SUSPECT,'HRM-LVE-001 schema SQL missing.');$prefix=hrm_migration_active_table_prefix();if($prefix===false)return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-LVE-001 table prefix invalid.');$src=str_replace('`0_','`'.$prefix,$src);$stmts=preg_split('/;\s*(?:\r?\n|$)/',$src);foreach($stmts as $stmt){$stmt=trim($stmt);if($stmt!==''&&!db_query($stmt))return hrm_migration_fail($patch,HRM_MIGRATION_PROJECTION_MISMATCH,'HRM-LVE-001 schema statement failed.');}return hrm_lve_001_require_schema($patch,true);}
